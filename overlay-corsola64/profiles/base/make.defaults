# Initial value just for style purposes.
USE=""

USE="${USE} corsola64"
USE="${USE} -tpm tpm2"

# Disable features for corsola64
USE="${USE} -bootimage -coreboot -cros_ec -nacl"

BOARD_COMPILER_FLAGS="-march=armv8-a+crc --unwindlib=libunwind"

VIDEO_CARDS="mediatek"

# Include the elan_i2chid firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} elan_i2chid"
