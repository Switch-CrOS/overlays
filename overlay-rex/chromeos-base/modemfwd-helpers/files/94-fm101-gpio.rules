# M.2 modem card reset on net WWAN_RTS_L is connected to
# 111 + 573 (/sys/class/gpio/gpiochip573/base) which ends up being gpio 684
ACTION=="add", DEVPATH=="/devices/pci0000:00/INTC1083:00/gpiochip0/gpio/gpio684", \
    RUN+="/bin/chown modem:modem /sys/class/gpio/gpio684/direction /sys/class/gpio/gpio684/value"
