# Force switch-t210 to use patched ebuilds from this overlay.  If one of these
# disappears, fail the build instead of falling back to the parent overlay.
chromeos-base/chromeos-chrome::chromiumos
chromeos-base/libbrillo::chromiumos
chromeos-base/shill::chromiumos

# Keep switch-t210 image packages on the pinned stable libbrillo ABI.
=chromeos-base/libbrillo-9999
