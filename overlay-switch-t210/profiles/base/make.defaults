# Initial value just for style purposes.
USE=""

CHROMEOS_KERNEL_SPLITCONFIG="chromiumos-arm64-generic"

BOARD_COMPILER_FLAGS="-march=armv8-a"
# N.B., Rust's minimum arm64 arch is v8.1.
BOARD_RUSTFLAGS=""
USE="${USE} march_armv8-a"

# Add the linker option to fix hardware errata. Refer bug here -
# https://code.google.com/p/chrome-os-partner/issues/detail?id=39170
LDFLAGS="-Wl,--fix-cortex-a53-843419"

USE="${USE} containers"

USE="${USE} legacy_keyboard legacy_power_button"
USE="${USE} -opengl opengles"
USE="${USE} kernel-5_15 device_tree"

# Disable binary options that are not ported yet.
USE="${USE} -pepper_flash -netflix -internal"

# Enable llvm for mesa.
USE="${USE} llvm"

# Enable chromeos-config.
USE="${USE} unibuild has_chromeos_config_bsp"

# Use legacy pre-Groot UI for initramfs and init script screens.
USE="${USE} legacy_firmware_ui"

# Work around builf failure.
USE="${USE} exclude_crosier"

# Include many firmwares as this is a "generic" board and might run on a
# wide variety of platforms with who knows what kind of hardware.
LINUX_FIRMWARE="iwlwifi-all"

VIDEO_CARDS="llvmpipe"

# No support for zero-copy on virtual machines.
USE="${USE} -video_capture_use_gpu_memory_buffer"

# Enable HW codecs using V4L2 API.
USE="${USE} v4l2_codec"

# Enable fscrypt v2 usage on 5.4+
USE="${USE} direncription_allow_v2"

# Enable VKMS and drm_atomic for compositor testing on VMs
USE="${USE} vkms drm_atomic"

# Set mosys_platform USE flag since it was removed from base arm64 overlays
USE="${USE} mosys_platform_generic"

# Only support TPM2.0 on arm64
USE="${USE} -tpm tpm2"

# The Switch has no hardware TPM. Run ChromeOS's userspace TPM2 simulator
# (chromeos-base/tpm2-simulator) backed by the kernel vTPM proxy
# (CONFIG_TCG_VTPM_PROXY, enabled in the L4T kernel build). This gives the
# hwsec stack (trunks/tpm_manager/chaps/attestation/cryptohome) a real TPM2
# backend so login and guest sessions work, instead of disabling the stack.
#  * tpm2_simulator              — install + use the software TPM2 daemon
#  * tpm2_simulator_manufacturer — let the simulator self-provision EK/SRK
#  * vtpm_proxy                  — simulator registers via /dev/vtpmx -> /dev/tpm0
USE="${USE} tpm2_simulator tpm2_simulator_manufacturer vtpm_proxy"

# Do NOT apply no_new_privs to the Chrome browser process.  session_manager
# (login_manager/subprocess.cc) sets PR_SET_NO_NEW_PRIVS on the browser when
# login_apply_no_new_privs is on (it is +default in chromeos-login).  On the
# L4T 4.9 kernel that breaks SELinux: NNP blocks any domain transition that is
# not a typebounds-bounded one, and 4.9 predates the process2/nnp_transition
# permission (added in 4.14) that newer kernels + policy use to allow it.  So
# the cros_session_manager -> cros_browser auto-transition is silently dropped
# (check_nnp_nosuid -> fallback to the old SID), Chrome runs as
# cros_session_manager instead of cros_browser, and mojo_service_manager then
# denies every Chromium-side service (CrosHealthd*, CrosCameraService,
# CrosSystemEventMonitor, IioSensor, ...), e.g. the Diagnostics app is blank.
# Disabling NNP for the top-level browser lets the transition fire; the
# renderer/zygote/gpu children still set their own NNP via the Chrome sandbox.
USE="${USE} -login_apply_no_new_privs"

# We build Chrome with -build_tests (no test targets), so the Crosier test
# artifacts (fake_chrome, chromeos_integration_tests, etc.) are never
# produced.  chromeos-base/crosier-chrome is still pulled in by
# virtual/target-chromium-os-test, but with exclude_crosier it installs only
# metadata and skips deploying the (nonexistent) test binaries.  This is the
# same flag overlay-amd64-generic uses for the same reason.
USE="${USE} exclude_crosier"
