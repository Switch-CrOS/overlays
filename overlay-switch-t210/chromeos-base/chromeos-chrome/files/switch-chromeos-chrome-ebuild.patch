+	# Install SwiftShader Vulkan ICD for software rendering on Switch.
+	# deploy_chrome only includes this for test builds; install it explicitly
+	# here so ANGLE can use SwiftShader as a Vulkan backend without a real GPU.
+	local from="${CHROME_CACHE_DIR}/src/${BUILD_OUT}/${BUILDTYPE}"
+	if [[ -f "${from}/libvk_swiftshader.so" ]]; then
+		insinto "${CHROME_DIR}"
+		doins "${from}/libvk_swiftshader.so"
+		[[ -f "${from}/vk_swiftshader_icd.json" ]] && \
+			doins "${from}/vk_swiftshader_icd.json"
+	fi
+
