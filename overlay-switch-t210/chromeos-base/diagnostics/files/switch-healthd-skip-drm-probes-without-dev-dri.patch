 void Executor::GetConnectedExternalDisplayConnectors(
     const std::optional<std::vector<uint32_t>>& last_known_connectors,
     GetConnectedExternalDisplayConnectorsCallback callback) {
+  // Boards with no DRM node (e.g. NVIDIA L4T, which drives the display through
+  // a proprietary stack and never exposes /dev/dri) can't run the DRM delegate:
+  // its /dev/dri bind-mount fails and the half-set-up sandboxed process wedges
+  // unreapable on kernels predating the 4.14 NNP/PID-namespace reap fixes
+  // ("Failed to kill jail process"), stalling the whole executor and hanging
+  // callers like the Diagnostics app. Short-circuit to the same result a failed
+  // delegate launch would yield, without spawning anything.
+  if (!base::PathExists(base::FilePath{path::kDrmDevice})) {
+    std::move(callback).Run(
+        base::flat_map<uint32_t, mojom::ExternalDisplayInfoPtr>{},
+        /*err=*/std::nullopt);
+    return;
+  }
   auto delegate = CreateDelegateProcess(
       seccomp_file::kDrm,
       SandboxedProcess::Options{
