CHROMEOS_DTBS="mt8189-*.dtb"

# Initial value just for style purposes.
USE=""

# Initial value just for style purposes.
LINUX_FIRMWARE=""

# Add EC logging
USE="${USE} eclog"

# Tell powerd to use elogtool to log system events.
USE="${USE} powerd_manual_eventlog_add"

# Enable Chrome's tablet mode
USE="${USE} touchview"

# Enable for daisydog
USE="${USE} watchdog"

# Google USBPD peripheral firmwares
LINUX_FIRMWARE="${LINUX_FIRMWARE} cros-pd"

# Enable miniOS support
USE="${USE} minios"

# Set mosys_platform
# TODO: Update to mosys_platform_skywalker once it's ready
USE="${USE} mosys_platform_generic"

# Enable eMMC utility
USE="${USE} mmc"

# Use Vulkan for raster/composite in Chrome
USE="${USE} vulkan_chrome"
