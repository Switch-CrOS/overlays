# Initial value just for style purposes.
USE=""
LINUX_FIRMWARE=""

USE="${USE} herobrine"

# Enable unibuild
USE="${USE} unibuild"

# Use ext4 crypto
USE="${USE} direncryption"

# Enable QMI support in ModemManager
USE="${USE} qmi qrtr"

# TODO: Renable bootimage when ready
# Disable Firmware Build
USE="${USE} -bootimage"

# Enable Cellular SAR hack on herobrine
USE="${USE} herobrine_sar_hack"

# TODO: Enable EC when ready
# USE="${USE} cros_ec"

# TODO: change EC_FIRMWARE to herobrine
# All firmwares to build from the EC code base
# EC_FIRMWARE="trogdor"

# Include the elan_i2chid firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} elan_i2chid"
