# Initial value just for style purposes.
USE=""
LINUX_FIRMWARE=""

USE="${USE} herobrine"

# Enable biod
USE="${USE} biod"

# Enable unibuild
USE="${USE} unibuild"
USE="${USE} has_chromeos_config_bsp"

# Use ext4 crypto
USE="${USE} direncryption"

# Enable QMI support in ModemManager
USE="${USE} qmi qrtr"

# Enable Firmware Build
USE="${USE} bootimage"

# Enable Zephyr firmware.
USE="${USE} zephyr_ec zephyr_v2_7"

# Fingerprint firmware
FPMCU_FIRMWARE="dartmonkey"

# Include the elan_i2chid firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} elan_i2chid"
