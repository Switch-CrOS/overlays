# Initial value just for style purposes.
LINUX_FIRMWARE=""
USE=""
VIDEO_CARDS=""

# Add EC logging
USE="${USE} eclog"

# Build kernel with serial driver
USE="${USE} pcserial"
USE="${USE} tty_console_ttyS0"

# Enable serial console
TTY_CONSOLE="ttyS0"

# Enable NVMe utility
USE="${USE} nvme"

# Allow Chrome to use Tablet mode
USE="${USE} touchview"

# Enable Type-C daemon
USE="${USE} typecd"

# Enable external PCI device security
USE="${USE} pciguard"

# Enable eMMC tools
USE="${USE} mmc"

# TODO (b/220483437): Enable miniOS support
#USE="${USE} minios"

# Enable GpuMemoryBuffers backed by dma-bufs.
USE="${USE} native_gpu_memory_buffers"

# Enable vulkan
USE="${USE} vulkan"

# Enable Intel media-driver.
VIDEO_CARDS="${VIDEO_CARDS} iHD"

# Enable libglvnd for big GL support
USE="${USE} libglvnd"
