CHROMEOS_KERNEL_SPLITCONFIG="chromiumos-qualcomm"
CHROMEOS_KERNEL_ARCH="arm64"

BOARD_COMPILER_FLAGS="-march=armv8-a+crc -ftree-vectorize"

# Initial value just for style purposes.
USE=""

USE="${USE} big_little"
USE="${USE} device_tree"
USE="${USE} drm_atomic"
USE="${USE} hardfp"
USE="${USE} kernel-5_4"
USE="${USE} native_gpu_memory_buffers"
USE="${USE} neon"
USE="${USE} qc845"

# GPU sandboxing needs to be started early as GPU process spawns
# multiple threads.
USE="${USE} gpu_sandbox_start_early"

# Disable CrOS video decoder on this board because we haven't implement V4L2
# stateful VideoDecoder.
USE="${USE} disable_cros_video_decoder"

# Enable HW codecs using V4L2 API.
USE="${USE} v4l2_codec"

# Use legacy pre-Groot UI for initramfs and init script screens.
USE="${USE} legacy_firmware_ui"
