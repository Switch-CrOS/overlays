# udev rules to start firmware update on the PS175 i2c device.
SUBSYSTEM=="i2c", ACTION=="add", ATTR{name}=="1AF80175:00", \
  RUN+="/sbin/initctl emit fwupdtool-update PLUGIN=flashrom GUID=f8887c5d-6236-50cd-bbc4-b188a4a3b198"
