# Initial value just for style purposes.
USE=""

USE="${USE} containers"

USE="${USE} direncryption"

USE="${USE} chell has_keyboard_backlight"

# Allow consumer kiosk.
# NOTE: Deprecating feature. New board should NOT have it.
USE="${USE} allow_consumer_kiosk"

# All firmwares to build from the EC code base
EC_FIRMWARE="chell"
EC_FIRMWARE_EXTRA="chell_pd"
PD_FIRMWARE="chell_pd"

# Uncomment this line to activate the serial port.
#TTY_CONSOLE="ttyS0"

# Enable Cryptohome UserDataAuth interface.
USE="${USE} cryptohome_userdataauth_interface"

# Disable on-device grammar check for boards with 2GB rootfs.
USE="${USE} -ondevice_grammar"

# Disable on-device text suggestions for boards with 2GB rootfs.
USE="${USE} -ondevice_text_suggestions"

# Disable on-device handwriting for boards with 2GB rootfs.
USE="${USE} -ondevice_handwriting"

# Disable Floss Bluetooth for boards with 2GB rootfs.
USE="${USE} -floss"
