+	spin_lock_irqsave(&smi_prot_lock, flags);
+	if (larb->prot_status == SMI_PROT_STA_REFUSE_TO_CHANGE) {
+		dev_err(larbdev, "refuse to change protection\n");
+		goto clamp_out;
