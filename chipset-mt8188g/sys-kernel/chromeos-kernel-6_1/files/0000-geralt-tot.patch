+static int mtk_imgsys_videoc_g_fmt(struct file *file, void *fh,
+				   struct v4l2_format *f)
+{
+	struct mtk_imgsys_video_device *node = mtk_imgsys_file_to_node(file);
+
+	*f = node->vdev_fmt;
+
+	return 0;
+}
