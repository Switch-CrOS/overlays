+
+		memset((char *)logbuf_final, 0x0, log_length * 4);
+		logbuf_final[strlen(logbuf_final)] = '\0';
+		memset((char *)logbuf_temp, 0x0, log_length);
+		logbuf_temp[strlen(logbuf_temp)] = '\0';
+		if (debug0_req[1] == 1) {
+			ret = snprintf(logbuf_temp, log_length,
