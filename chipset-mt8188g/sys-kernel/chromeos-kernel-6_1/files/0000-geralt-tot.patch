+	__u32			reserved[11];
+#else
+	__u64			reserved[2];
+#endif
+};
+
+#define IMGBUF_MAX_PLANES (3)
+
+struct v4l2_ext_buffer {
+#ifndef COMPACT_USE
+	__u32			index;
+	__u32			type;
+	__u32			flags;
+	__u32			field;
+	__u64			timestamp;
+	__u32			sequence;
+	__u32			memory;
+#endif
+	struct v4l2_ext_plane	planes[IMGBUF_MAX_PLANES];
+	__u32			num_planes;
+#ifndef COMPACT_USE
+	__u32			reserved[11];
+#else
+	__u64			reserved[2];
+#endif
+};
