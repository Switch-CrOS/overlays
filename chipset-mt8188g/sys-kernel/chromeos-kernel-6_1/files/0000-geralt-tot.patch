+ * @mem_priv:     vb2_dc_buf
+ * @d_buf:        dma_buf
+ * @fd:         buffer fd
+ */
+struct mtk_hcp_reserve_mblock {
+	const char *name;
+	unsigned int num;
+	phys_addr_t start_phys;
+	void *start_virt;
+	phys_addr_t start_dma;
+	phys_addr_t size;
