+static int mtk_cam_seninf_is_mux_used(struct seninf_ctx *ctx, int mux)
+{
+	void *pSeninf_mux = ctx->reg_if_mux[mux];
+
+	return SENINF_READ_BITS(pSeninf_mux, SENINF_MUX_CTRL_0, SENINF_MUX_EN);
