-	       (hz_to_config(freq_tbl[1], base_freq_hz) << 8) |
-	       (hz_to_config(freq_tbl[2], base_freq_hz) << 16) |
-	       (hz_to_config(freq_tbl[3], base_freq_hz) << 24),
-	       mt->thermal_base + SVS_BANK_FREQPCT30);
-
