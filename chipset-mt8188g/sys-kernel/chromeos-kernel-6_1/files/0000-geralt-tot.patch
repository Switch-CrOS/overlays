+		}
+
+		i2c_client = i2c_new_client_device(tp_bus, cbas_ec.tp_info);
+		if (IS_ERR(i2c_client)) {
+			dev_err(cbas_ec.dev, "cannot create i2c client\n");
+			ret = PTR_ERR(cbas_ec.tp_i2c_client);
