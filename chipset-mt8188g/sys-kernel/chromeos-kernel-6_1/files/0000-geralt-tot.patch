+static unsigned int exe_dbg_cmd(struct mtk_imgsys_dev *imgsys_dev,
+				void __iomem *p_reg_ba,
+				unsigned int dbd_sel,
+				unsigned int dbg_out,
+				unsigned int dbg_cmd)
