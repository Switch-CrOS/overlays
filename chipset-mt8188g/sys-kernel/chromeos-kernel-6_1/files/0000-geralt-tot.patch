+void mtk_smi_larb_clamp(struct device *larbdev, bool on)
+{
+	struct mtk_smi_larb *larb = dev_get_drvdata(larbdev);
+	const struct mtk_smi_larb_gen *larb_gen;
+	unsigned long flags;
+
+	if (!larb)
