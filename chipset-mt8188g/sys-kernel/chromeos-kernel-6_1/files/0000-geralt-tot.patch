+static int cam_open(struct inode *inode, struct file *filp)
+{
+	struct mtk_cam_ut *ut =	container_of(inode->i_cdev,
+					     struct mtk_cam_ut, cdev);
+	int i, ret;
+
+	dev_info(ut->dev, "cam_ut | trigger %s\n", __func__);
+	get_device(ut->dev);
+
+	ret = pm_runtime_resume_and_get(ut->dev);
+	if (ret < 0) {
+		dev_info(ut->dev, "failed at pm_runtime_resume_and_get\n");
+		return ret;
+	}
+
+	for (i = 0; i < ut->num_raw; i++) {
+		pr_info("get_sync raw %d\n", i);
+		ret = pm_runtime_resume_and_get(ut->raw[i]);
+		if (ret < 0) {
+			dev_info(ut->raw[i], "failed at pm_runtime_resume_and_get\n");
+			return ret;
+		}
+	}
+
+	for (i = 0; i < ut->num_camsv; i++) {
+		pr_info("get_sync camsv %d\n", i);
+		ret = pm_runtime_resume_and_get(ut->camsv[i]);
+		if (ret < 0) {
+			dev_info(ut->camsv[i], "failed at pm_runtime_resume_and_get\n");
+			return ret;
+		}
+	}
+
+	/* Note: seninf's dts have no power-domains now, so do it after raw's */
+	ret = pm_runtime_resume_and_get(ut->seninf);
+	if (ret < 0) {
+		dev_info(ut->seninf, "failed at pm_runtime_resume_and_get\n");
+		return ret;
+	}
+
+	filp->private_data = ut;
+
+	cam_composer_init(ut);
+
+	return 0;
+}
+
+static int cam_release(struct inode *inode, struct file *filp)
+{
+	struct mtk_cam_ut *ut = filp->private_data;
+	int i;
+
+	dev_info(ut->dev, "cam_ut | trigger %s\n", __func__);
+
+	cam_composer_uninit(ut);
+
+	pm_runtime_put(ut->seninf);
+
+	for (i = 0; i < ut->num_camsv; i++)
+		pm_runtime_put(ut->camsv[i]);
+
+	for (i = 0; i < ut->num_raw; i++)
+		pm_runtime_put(ut->raw[i]);
+
+	pm_runtime_put(ut->dev);
+	put_device(ut->dev);
+
+	return 0;
+}
+
+static const struct file_operations cam_file_oper = {
+	.owner = THIS_MODULE,
+	.open = cam_open,
+	.release = cam_release,
+	.unlocked_ioctl = cam_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl   = compat_ptr_ioctl,
+#endif
+};
