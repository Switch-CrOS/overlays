+	dev_info(imgsys_dev->dev, "%s: dump nr3d ctl regs\n", __func__);
+	for (i = NR3D_CTL_OFFSET; i <= NR3D_CTL_OFFSET + NR3D_CTL_RANGE; i += 0x10) {
