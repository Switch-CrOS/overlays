+static int mtk_cam_seninf_disable_all_mux(struct seninf_ctx *ctx)
+{
+	int i;
+	void *pSeninf_mux;
+
+	for (i = 0; i < _seninf_ops->mux_num; i++) {
+		pSeninf_mux = ctx->reg_if_mux[i];
+		SENINF_BITS(pSeninf_mux, SENINF_MUX_CTRL_0, SENINF_MUX_EN, 0);
+	}
+
+	return 0;
+}
