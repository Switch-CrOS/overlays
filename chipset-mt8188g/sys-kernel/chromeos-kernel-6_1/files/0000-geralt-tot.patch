+	}
+	dev_info(imgsys_dev->dev, "%s: ===(%s): %s DBG INFO===",
+		 __func__, logbuf_path, logbuf_inport);
+	dev_info(imgsys_dev->dev, "%s:  0x%08X %08X", __func__,
