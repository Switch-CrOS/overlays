+static int mtk_imgsys_sd_subscribe_event(struct v4l2_subdev *subdev,
+					 struct v4l2_fh *fh,
+					 struct v4l2_event_subscription *sub)
+{
+	switch (sub->type) {
+	case V4L2_EVENT_FRAME_SYNC:
+		return v4l2_event_subscribe(fh, sub, 64, NULL);
+	default:
+		return -EINVAL;
