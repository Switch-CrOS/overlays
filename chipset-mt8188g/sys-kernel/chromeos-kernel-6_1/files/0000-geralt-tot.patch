+ccflags-y += -I$(srctree)/drivers/media/platform/mediatek/isp/isp_7x/mtk-hcp
+ccflags-$(CONFIG_MTK_CMDQ_MBOX_EXT) += -I$(srctree)/drivers/misc/mediatek/cmdq/mailbox/
