+		&mtk_camsys_hw_mode, NULL);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_EXECUTE_ON_WRITE;
+
+	v4l2_ctrl_new_custom(ctrl_hdlr, &mstream_exposure, NULL);
+	pipe->res_config.hwn_limit_max = hwn_limit.def;
