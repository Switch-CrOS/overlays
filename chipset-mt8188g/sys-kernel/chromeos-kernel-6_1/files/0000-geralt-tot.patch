-	       (hz_to_config(freq_tbl[5], base_freq_hz) << 8) |
-	       (hz_to_config(freq_tbl[6], base_freq_hz) << 16) |
-	       (hz_to_config(freq_tbl[7], base_freq_hz) << 24),
-	       mt->thermal_base + SVS_BANK_FREQPCT74);
