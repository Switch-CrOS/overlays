+	fd->fd_mem_size += size;
+
+	va = dma_alloc_coherent(dev, size, &dma_handle, GFP_KERNEL);
+	if (!va || dma_handle == 0)
+		return -ENOMEM;
+
+	bufinfo->va = va;
+	bufinfo->pa = dma_handle;
+	bufinfo->size = size;
+
+	dev_dbg(fd->dev,
+		"%s: vAddr(0x%p) pAddr(0x%pad) size(%d)\n",
+		__func__,
+		va,
+		&dma_handle,
+		size
+	);
+
+	return 0;
+}
+
+static void aie_imem_free(struct mtk_aie_dev *fd, struct imem_buf_info *bufinfo)
+{
+	dev_dbg(fd->dev,
+		"%s: vAddr(0x%p) pAddr(0x%pad) size(%d)\n",
+		__func__,
+		bufinfo->va,
+		&bufinfo->pa,
+		bufinfo->size
+	);
+
+	if (bufinfo->va)
+		dma_free_coherent(fd->dev,
+				  bufinfo->size,
+				  bufinfo->va,
+				  bufinfo->pa
+		);
+}
