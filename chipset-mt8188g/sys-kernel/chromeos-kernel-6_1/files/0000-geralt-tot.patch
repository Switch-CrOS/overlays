+	char *pqdip_name;
+	char file_name[256] = "\0";
+	ssize_t ret;
+	uint32_t *cq_va = NULL;
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	struct file *cfile;
+	loff_t pos = 0;
+#endif
+	// Check for valid engine enum
+	if (frm_dump_info->eng_e < IMGSYS_NDD_ENG_PQDIP_A || frm_dump_info->eng_e > IMGSYS_NDD_ENG_PQDIP_B) {
+		dev_err(imgsys_dev->dev, "%s wrong ndd pqdip eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	// Get base address of the registers
+	cq_va = (uint32_t *)((uint64_t)mtk_hcp_get_reserve_mem_virt(imgsys_dev->scp_pdev, PQDIP_MEM_C_ID) + frm_dump_info->cq_ofst[frm_dump_info->eng_e]);
+	if (cq_va == NULL) {
+		dev_err(imgsys_dev->dev, "%s get null pqdip cq_va with ofst 0x%llx\n", __func__, frm_dump_info->cq_ofst[frm_dump_info->eng_e]);
+		return;
+	}
+
+	// Construct appropriate pqdip_name based on the engine enum
+	switch (frm_dump_info->eng_e) {
+	case IMGSYS_NDD_ENG_PQDIP_A:
+		pqdip_name = frm_dump_info->user_buffer ? "REG_PQDIP_A_pqdipa.reg" : "REG_PQDIP_A_pqdipa.regKernel";
+		break;
+	case IMGSYS_NDD_ENG_PQDIP_B:
+		pqdip_name = frm_dump_info->user_buffer ? "REG_PQDIP_B_pqdipb.reg" : "REG_PQDIP_B_pqdipb.regKernel";
+		break;
+	default:
+		dev_err(imgsys_dev->dev, "%s invalid pqdip eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	// Construct file name
+	ret = snprintf(file_name, sizeof(file_name), "%s%s", frm_dump_info->fp, pqdip_name);
+	if ((ret < 0) || (ret >= sizeof(file_name))) {
+		dev_err(imgsys_dev->dev, "wrong pqdip ndd file name %s\n", file_name);
+		return;
+	}
+
+	// Debug print
+	dev_dbg(imgsys_dev->dev, "%s: pqdip ndd dump from 0x%llx to file %s +\n", __func__, (uint64_t)cq_va, file_name);
+
+	// Depending on whether user_buffer is non-null, copy data to user or write to file
+	if (frm_dump_info->user_buffer) {
+		ret = copy_to_user(frm_dump_info->user_buffer, (u8 *)file_name, FP_SIZE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy file name to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += FP_SIZE;
+
+		ret = copy_to_user(frm_dump_info->user_buffer, (u8 *)cq_va, PQDIP_REG_RANGE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy register data to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += PQDIP_REG_RANGE;
+	// Consider increasing user_buffer pointer if you return the buffer to userspace
+	} else {
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+		cfile = filp_open(file_name, O_CREAT | O_RDWR, 0666);
+		if (IS_ERR(cfile)) {
+			dev_err(imgsys_dev->dev, "%s open file %s failed\n", __func__, file_name);
+			return;
+		}
+
+		ret = kernel_write(cfile, (void *)cq_va, PQDIP_REG_RANGE, &pos);
+		if (ret < 0) {
+			dev_err(imgsys_dev->dev, "%s failed to write register data to file\n", __func__);
+			filp_close(cfile, NULL);
+			return;
+		}
+		filp_close(cfile, NULL);
+#endif // IMGSYS_NDD_FROM_KERNEL
+	}
+
+    // End of debug print
+    dev_dbg(imgsys_dev->dev, "%s: -\n", __func__);
+}
+EXPORT_SYMBOL(imgsys_pqdip_ndd_dump);
+
+void imgsys_pqdip_uninit(struct mtk_imgsys_dev *imgsys_dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < PQDIP_HW_SET; i++) {
+		iounmap(gpqdip_reg_base[i]);
+		gpqdip_reg_base[i] = NULL;
+	}
+}
+EXPORT_SYMBOL(imgsys_pqdip_uninit);
