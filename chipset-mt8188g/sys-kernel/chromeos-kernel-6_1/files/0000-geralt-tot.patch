+	GCE_REC_TILE_BLOCK
+};
+
+enum GCE_REC_MODE_ENUM {
+	GCE_REC_APPEND_MODE = 0,
+	GCE_REC_REPLACE_MODE
+};
+
+struct gce_recorder {
+	u32            header_code;
+	u32            cmd_offset;
+	u32            check_pre;
+	u32            *p_output;
+	u32            check_post;
+	u32            *p_buffer;
+	u32            max_length;
+	u32            curr_length;
+
+	struct block_record  frame_record[GCE_REC_MAX_FRAME_BLOCK];
+	u32            frame_block;
+	u32            curr_frame;
+
+	struct block_record  tile_record[GCE_REC_MAX_TILE_BLOCK];
+	u32            tile_block;
+	u32            curr_tile;
+
+	enum GCE_REC_BLOCK_ENUM  curr_block;
+	enum GCE_REC_MODE_ENUM   curr_mode;
+
+	u32            orig_index;
+	u32            *p_orig_out;
+	u32            curr_label;
+
+	enum GCE_REC_BLOCK_ENUM  label_block;
+
+	u32            frame_label[GCE_REC_MAX_LABEL_COUNT];
+	u32            frame_count;
+
+	u32            tile_label[GCE_REC_MAX_LABEL_COUNT];
+	u32            tile_count;
+
+	u32            footer_code;
+};
