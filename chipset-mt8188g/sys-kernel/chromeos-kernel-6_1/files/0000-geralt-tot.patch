+void imgsys_main_set_init(struct mtk_imgsys_dev *imgsys_dev)
+{
+	void __iomem *wpe_reg_base = 0L;
+	void __iomem *adl_reg_base = 0L;
+	void __iomem *wpe_ctrl = 0L;
+	unsigned int hw_idx = 0;
+	u32 count;
+	u32 value;
+
+	iowrite32(0xFFFFFFFF, (void *)(dip_reg_base + SW_RST));
+	iowrite32(0xFFFFFFFF, (void *)(dip1_reg_base + SW_RST));
+
+	for (hw_idx = 0; hw_idx < WPE_HW_SET; hw_idx++) {
+		if (hw_idx == 0)
+			wpe_reg_base = wpe_dip1_reg_base;
+		else if (hw_idx == 1)
+			wpe_reg_base = wpe_dip2_reg_base;
+		else
+			wpe_reg_base = wpe_dip3_reg_base;
+
+		/* Wpe Macro HW Reset */
+		wpe_ctrl = (void *)(wpe_reg_base + SW_RST);
+		iowrite32(0xFFFFFFFF, wpe_ctrl);
+		/* Clear HW Reset */
+		iowrite32(0x0, wpe_ctrl);
+	}
+
+	if (adla_reg_base || adlb_reg_base) {
+		/* Reset ADL A */
+		for (hw_idx = 0; hw_idx < ADL_HW_SET; hw_idx++) {
+			if (hw_idx == 0)
+				adl_reg_base = adla_reg_base;
+			else if (hw_idx == 1)
+				adl_reg_base = adlb_reg_base;
+
+			if (!adl_reg_base)
+				continue;
+
+			value = ioread32(adl_reg_base + 0x300);
+			value |= ((0x1 << 8) | (0x1 << 9));
+			iowrite32(value, (adl_reg_base + 0x300));
+
+			count = 0;
+			while (count < 1000000) {
+				value = ioread32(adl_reg_base + 0x300);
+				if ((value & 0x3) == 0x3)
+					break;
+				count++;
+			}
+
+			value = ioread32(adl_reg_base + 0x300);
+			value &= ~((0x1 << 8) | (0x1 << 9));
+			iowrite32(value, adl_reg_base + 0x300);
+		}
+	}
+
+	iowrite32(0x00CF00FF, (void *)(imgsys_main_reg_base + SW_RST));
+	iowrite32(0x0, (void *)(imgsys_main_reg_base + SW_RST));
+
+	iowrite32(0x0, (void *)(dip_reg_base + SW_RST));
+	iowrite32(0x0, (void *)(dip1_reg_base + SW_RST));
+
+	for (hw_idx = 0; hw_idx < WPE_HW_SET; hw_idx++) {
+		if (hw_idx == 0)
+			wpe_reg_base = wpe_dip1_reg_base;
+		else if (hw_idx == 1)
+			wpe_reg_base = wpe_dip2_reg_base;
+		else
+			wpe_reg_base = wpe_dip3_reg_base;
+
+		/* Wpe Macro HW Reset */
+		wpe_ctrl = (void *)(wpe_reg_base + SW_RST);
+		iowrite32(0xFFFFFFFF, wpe_ctrl);
+		/* Clear HW Reset */
+		iowrite32(0x0, wpe_ctrl);
+	}
+
+	iowrite32(0x00CF00FF, (void *)(imgsys_main_reg_base + SW_RST));
+	iowrite32(0x0, (void *)(imgsys_main_reg_base + SW_RST));
+}
+
+void imgsys_main_uninit(struct mtk_imgsys_dev *imgsys_dev)
+{
+	if (imgsys_main_reg_base) {
+		iounmap(imgsys_main_reg_base);
+		imgsys_main_reg_base = 0L;
+	}
+
+	if (wpe_dip1_reg_base) {
+		iounmap(wpe_dip1_reg_base);
+		wpe_dip1_reg_base = 0L;
+	}
+
+	if (wpe_dip2_reg_base) {
+		iounmap(wpe_dip2_reg_base);
+		wpe_dip2_reg_base = 0L;
+	}
+
+	if (wpe_dip3_reg_base) {
+		iounmap(wpe_dip3_reg_base);
+		wpe_dip3_reg_base = 0L;
+	}
+
+	if (dip_reg_base) {
+		iounmap(dip_reg_base);
+		dip_reg_base = 0L;
+	}
+
+	if (dip1_reg_base) {
+		iounmap(dip1_reg_base);
+		dip1_reg_base = 0L;
+	}
+
+	if (adla_reg_base) {
+		iounmap(adla_reg_base);
+		adla_reg_base = 0L;
+	}
+
+	if (adlb_reg_base) {
+		iounmap(adlb_reg_base);
+		adlb_reg_base = 0L;
+	}
+}
