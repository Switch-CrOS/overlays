+	INIT_LIST_HEAD(&core->list_mux);
+	for (i = 0; i < g_seninf_ops->mux_num; i++) {
+		core->mux[i].idx = i;
+		list_add_tail(&core->mux[i].list, &core->list_mux);
+	}
+
+#ifdef SENINF_DEBUG
+	INIT_LIST_HEAD(&core->list_cam_mux);
+	for (i = 0; i < g_seninf_ops->cam_mux_num; i++) {
+		core->cam_mux[i].idx = i;
