+	dev_info(imgsys_dev->dev, "%s:  0x%08X %08X", __func__,
+		 (0x15520000 + 0xA8), wpe_pqdip_mux2_v);
+	dev_info(imgsys_dev->dev, "%s:  0x%08X %08X", __func__,
