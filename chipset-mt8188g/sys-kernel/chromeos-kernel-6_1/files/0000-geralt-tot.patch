+static int mtk_cam_seninf_mux(struct seninf_ctx *ctx, int mux)
+{
+	void *pSeninf_mux = ctx->reg_if_mux[mux];
+
+	SENINF_BITS(pSeninf_mux, SENINF_MUX_CTRL_0, SENINF_MUX_EN, 1);
+	return 0;
