+	strscpy(cap->driver, pipe->desc->name, sizeof(cap->driver));
+	strscpy(cap->card, pipe->desc->name, sizeof(cap->card));
+	snprintf(cap->bus_info, sizeof(cap->bus_info),
+		 "platform:%s", dev_name(pipe->imgsys_dev->mdev.dev));
