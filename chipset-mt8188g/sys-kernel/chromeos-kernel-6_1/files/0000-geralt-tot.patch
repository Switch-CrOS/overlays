+static int imgsys_send(struct platform_device *pdev, enum hcp_id id,
+		       void *buf, unsigned int  len, int req_fd,
+		       unsigned int wait)
+{
+	int ret;
+
+	if (wait)
+		ret = mtk_hcp_send(pdev, id, buf, len, req_fd);
+	else
+		ret = mtk_hcp_send_async(pdev, id, buf, len, req_fd);
+
+	return ret;
+}
