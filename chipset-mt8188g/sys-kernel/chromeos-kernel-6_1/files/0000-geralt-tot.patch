+	CAMSV_WRITE_BITS(sv_dev->base + REG_CAMSV_CLK_EN,
+		CAMSV_CLK_EN, PAK_DP_CK_EN, 1);
+	CAMSV_WRITE_BITS(sv_dev->base + REG_CAMSV_CLK_EN,
