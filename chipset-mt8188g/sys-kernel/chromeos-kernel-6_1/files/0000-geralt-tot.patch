+    - "IPE_FDVT"
+    - "IPE_SMI_LARB12"
+    - "IPE_TOP"
+  operating-points-v2: ["&opp_table_ipe"]
+  dvfsrc-vcore-supply: ["&vmm_proxy_label"]
+
