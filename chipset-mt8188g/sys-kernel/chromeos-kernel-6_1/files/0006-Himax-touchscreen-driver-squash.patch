-static int himax_sram_write_crc_check(struct himax_ts_data *ts,
-				      u8 *addr, const u8 *data, u32 len)
-{
-	int retry = 0;
-	int crc = -1;
-
-	do {
-		g_core_fp.fp_write_sram_0f(ts, addr, data, len);
-		crc = g_core_fp.fp_check_crc(ts, addr, len);
-		retry++;
-		I("HW CRC %s in %d time",
-		  (crc == 0) ? "OK" : "Fail", retry);
-	} while (crc != 0 && retry < 3);
-
-	return crc;
-}
