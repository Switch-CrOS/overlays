-void himax_shutdown(struct spi_device *spi)
-{
-	struct himax_ts_data *ts = spi_get_drvdata(spi);
-	int ret = 0;
-
-	I("enter");
-	if (!ts->initialized) {
-		E("init not ready, skip!");
-		return;
-	}
-	if (ts->suspended) {
-		I("Already suspended, skip...");
-		return;
-	}
-
-	himax_int_enable(ts, false);
-
-	if (!ts->use_irq) {
-		s32 cancel_state;
-
-		cancel_state = cancel_work_sync(&ts->work);
-		if (cancel_state)
-			himax_int_enable(ts, true);
-	}
-
-	atomic_set(&ts->suspend_mode, 1);
-
-	if (ts->pdata) {
-		if (ts->pdata->gpio_reset)
-			gpio_direction_output(ts->pdata->gpio_reset, 0);
-		if (ts->pdata->power_off_3v3) {
-			if (ts->pdata->vcca_supply)
-				ret = regulator_disable(ts->pdata->vcca_supply);
-		}
-	}
-
-	hx_hid_remove(ts);
