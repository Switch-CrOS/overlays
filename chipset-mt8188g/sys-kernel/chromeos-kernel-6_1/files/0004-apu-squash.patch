+static int debug_sqopen_lock(struct inode *inode, struct file *file)
+{
+	int res = seq_open(file, &seq_ops_lock);
+
+	if (!res)
+		((struct seq_file *)file->private_data)->private = inode->i_private;
+	else
+		pr_err("%s: seq_open failed\n", __func__);
+
+	return res;
+}
