diff --git a/drivers/soc/mediatek/apusys/apu-pwr-ipi-rx.c b/drivers/soc/mediatek/apusys/apu-pwr-ipi-rx.c
new file mode 100644
index 000000000000..f63cddfb8b53
--- /dev/null
+++ b/drivers/soc/mediatek/apusys/apu-pwr-ipi-rx.c
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 MediaTek Inc.
+ */
+
+#include <linux/completion.h>
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of_device.h>
+#include <linux/rpmsg.h>
+#include <linux/thermal.h>
+
+#include "apu-pwr.h"
+
+struct apu_power_rpmsg {
+	struct rpmsg_endpoint *ept;
+	struct rpmsg_device *rpdev;
+	struct mutex lock;
+	struct completion comp;
+	enum apupwr_rpmsg_cmd curr_rpmsg_cmd;
+	int initialized;
+
+	/* thermal */
+	struct thermal_zone_device *apu_tz;
+};
+
+static int apu_power_rx_send(struct apu_power_rpmsg *power_rpmsg,
+				struct apupwr_rpmsg_data *rpmsg_data)
+{
+	int ret = 0;
+
+	mutex_lock(&power_rpmsg->lock);
+	reinit_completion(&power_rpmsg->comp);
+
+	ret = rpmsg_send(power_rpmsg->ept, (void *)rpmsg_data,
+			sizeof(struct apupwr_rpmsg_data));
+	if (ret)
+		pr_info("%s: failed to send rx msg to remote, ret=%d\n",
+				__func__, ret);
+
+	mutex_unlock(&power_rpmsg->lock);
+
+	return ret;
+}
+
+static int apu_power_rx_callback(struct rpmsg_device *rpdev, void *data,
+		int len, void *priv, u32 src)
+{
+	struct device *dev = &rpdev->dev;
+	struct apu_power_rpmsg *power_rpmsg = dev_get_drvdata(&rpdev->dev);
+	int cmd = *((int*)data);
+	int ret = 0, temp = -1;
+	struct apupwr_rpmsg_data rpmsg_data;
+
+	if (!power_rpmsg || !power_rpmsg->initialized) {
+		dev_err(&rpdev->dev, "%s: rpmsg not valid\n", __func__);
+		return -EINVAL;
+	}
+
+	if (!len) {
+		dev_err(dev, "apu power rpmsg received empty rply\n");
+		complete(&power_rpmsg->comp);
+		return -EINVAL;
+	}
+
+	switch ((enum apupwr_rpmsg_cmd)cmd) {
+	case APUPWR_THERMAL_GET_TEMP:
+		if (power_rpmsg->apu_tz == NULL) {
+			dev_err(dev, "%s: thermal zone not found\n", __func__);;
+			break;
+		}
+
+		ret = thermal_zone_get_temp(power_rpmsg->apu_tz, &temp);
+		if (ret) {
+			dev_err(dev, "%s: thermal zone get temp failed\n", __func__);
+			temp = THERMAL_TEMP_INVALID;
+		}
+
+		rpmsg_data.cmd = APUPWR_THERMAL_GET_TEMP;
+		rpmsg_data.data0 = temp;	/* thermal temperature */
+
+		ret = apu_power_rx_send(power_rpmsg, &rpmsg_data);
+		break;
+	default:
+		dev_err(dev, "%s: invalid cmd: %d\n", __func__, cmd);
+		ret = -EINVAL;
+		break;
+	}
+	complete(&power_rpmsg->comp);
+
+	return ret;
+}
+
+static int apu_power_rx_probe(struct rpmsg_device *rpdev)
+{
+	struct device *dev = &rpdev->dev;
+	struct rpmsg_channel_info chinfo = {};
+	struct rpmsg_endpoint *ept;
+	struct apu_power_rpmsg *power_rpmsg;
+	struct device_node *node = dev->of_node;
+	const char *tz_name;
+
+	dev_info(dev, "%s: name=%s, src=%d\n", __func__,
+			rpdev->id.name, rpdev->src);
+
+	power_rpmsg = devm_kzalloc(dev,
+				   sizeof(struct apu_power_rpmsg), GFP_KERNEL);
+	if (!power_rpmsg)
+		return -ENOMEM;
+
+	strscpy(chinfo.name, rpdev->id.name, RPMSG_NAME_SIZE);
+	chinfo.src = rpdev->src;
+	chinfo.dst = RPMSG_ADDR_ANY;
+	ept = rpmsg_create_ept(rpdev, apu_power_rx_callback, NULL, chinfo);
+	if (!ept) {
+		dev_err(dev, "failed to create ept\n");
+		return -ENODEV;
+	}
+
+	init_completion(&power_rpmsg->comp);
+	mutex_init(&power_rpmsg->lock);
+	power_rpmsg->ept = ept;
+	power_rpmsg->rpdev = rpdev;
+	power_rpmsg->initialized = 1;
+
+	if (of_property_read_string(node, "apusys,thermal-zones", &tz_name)) {
+		dev_err(dev, "%s: mtk apu thermal-zones name no found\n", __func__);
+	} else {
+		power_rpmsg->apu_tz = thermal_zone_get_zone_by_name(tz_name);
+		if (IS_ERR(power_rpmsg->apu_tz)) {
+			dev_err(dev, "%s: thermal zone %s not found\n", __func__, tz_name);
+			power_rpmsg->apu_tz = NULL;
+		}
+	}
+
+	dev_set_drvdata(dev, power_rpmsg);
+
+	return 0;
+}
+
+static void apu_power_rx_remove(struct rpmsg_device *rpdev)
+{
+	struct apu_power_rpmsg *power_rpmsg = dev_get_drvdata(&rpdev->dev);
+
+	rpmsg_destroy_ept(power_rpmsg->ept);
+	power_rpmsg->apu_tz = NULL;
+}
+
+static const struct of_device_id apupwr_rx_rpmsg_of_match[] = {
+	{ .compatible = "mediatek,apupwr-rx-rpmsg", },
+	{ /* end of list */ },
+};
+MODULE_DEVICE_TABLE(of, apupwr_rx_rpmsg_of_match);
+
+static struct rpmsg_driver pwr_rx_rpmsg_drv = {
+	.drv	= {
+		.name	= "apupwr-rx-rpmsg",
+		.owner = THIS_MODULE,
+		.of_match_table = apupwr_rx_rpmsg_of_match,
+	},
+	.probe = apu_power_rx_probe,
+	.remove = apu_power_rx_remove,
+};
+
+module_rpmsg_driver(pwr_rx_rpmsg_drv);
+MODULE_LICENSE("GPL v2");
+MODULE_DESCRIPTION("apu-rx-ipi rpmsg driver");
