+static void vdec_av1_slice_vsi_to_remote(struct vdec_av1_slice_vsi *vsi,
+					 struct vdec_av1_slice_vsi *remote_vsi)
+{
+	memcpy(remote_vsi, vsi, sizeof(*vsi));
