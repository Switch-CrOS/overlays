+		for (i = 0; pwr_name[i] != NULL; i++) {
+			const char *st = (pwr_status[i / 32] & BIT(i % 32)) != 0U ? "ON" : "off";
+			pr_info("[%2d]: %3s: %s\n", i, st, pwr_name[i]);
