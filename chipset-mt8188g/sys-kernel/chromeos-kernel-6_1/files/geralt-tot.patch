-	for (i = 0; i < MT8173_NUM_SVS_OPP; i++) {
-		if (!svs->freq_table[i])
-			continue;
-
-		dev_pm_opp_adjust_voltage(svs->dev, svs->freq_table[i],
-					  svs->updated_volt_table[i],
-					  svs_bank_cfgs[svs->bank_id].vmin_uV,
-					  svs_bank_cfgs[svs->bank_id].vmax_uV);
