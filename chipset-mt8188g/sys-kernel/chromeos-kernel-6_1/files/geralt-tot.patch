-		temp = ((temp & 0xff) << 8) |
-		       SVS_CALIB_BANK_CONFIG2L(buf, i);
-		svs_banks[i].config2 = temp;
-	}
-
-out:
-	kfree(buf);
-
-	return ret;
-}
