+void imgsys_ndd_swfrm_list_add(struct mtk_imgsys_dev *imgsys_dev,
+	struct swfrm_info_t *gwfrm_info)
+{
+	struct ndd_swfrm_info_t *new_ndd_swfrm = kmalloc(sizeof(struct ndd_swfrm_info_t), GFP_KERNEL);
+
+	if (!new_ndd_swfrm) {
+		dev_err(imgsys_dev->dev, "%s: Memory allocation for new_ndd_swfrm failed\n", __func__);
+    		return;
+	}
+
+	new_ndd_swfrm->imgsys_dev = imgsys_dev;
+	new_ndd_swfrm->gwfrm_info = gwfrm_info;
+
+	mutex_lock(&ndd_mutex);
+	list_add_tail(&new_ndd_swfrm->list, &ndd_swfrm_list);
+	mutex_unlock(&ndd_mutex);
+
+	dev_info(imgsys_dev->dev,
+		"%s: frame_no:%d reqfd:%d |owner:%.*s total_frmnum:%d\n",
+		__func__,
+		gwfrm_info->frame_no, gwfrm_info->request_fd,
+		(int)sizeof(gwfrm_info->frm_owner), (char *)(&(gwfrm_info->frm_owner)),
+		gwfrm_info->total_frmnum);
+}
