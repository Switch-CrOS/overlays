+#if defined(IMGSYS_NDD_FROM_KERNEL)
+static void imgsys_ndd_worker(struct work_struct *work)
+{
+	struct mtk_imgsys_request *req = NULL;
+	struct swfrm_info_t *gwfrm_info = NULL;
+	struct scp_work *gwork = NULL;
+	struct img_swfrm_info *subfrm_info = NULL;
+	struct imgsys_ndd_frm_dump_info frm_dump_info = { 0 };
+	int frm = 0;
+
+	gwork = container_of(work, struct scp_work, work);
+	gwfrm_info = (struct swfrm_info_t *)gwork->req_sbuf_kva;
+	req = gwork->req;
+
+	if (!req) {
+		pr_info("%s NULL request Address\n", __func__);
+		goto release_work;
+	}
+
+	dev_dbg(req->imgsys_pipe->imgsys_dev->dev,
+		"%s:%s:req fd/no(%d/%d)frame no(%d), total_frmnum:%d\n",
+		__func__, (char *)(&(gwfrm_info->frm_owner)), gwfrm_info->request_fd,
+		gwfrm_info->request_no,
+		gwfrm_info->frame_no,
+		gwfrm_info->total_frmnum);
+
+	for (frm = 0 ; frm < gwfrm_info->total_frmnum ; frm++) {
+		subfrm_info = &(gwfrm_info->user_info[frm]);
+		if (subfrm_info->ndd_fp[0] != '\0') {
+			frm_dump_info.user_buffer = NULL;
+			frm_dump_info.hw_comb = subfrm_info->hw_comb;
+			frm_dump_info.cq_ofst = subfrm_info->ndd_cq_ofst;
+			frm_dump_info.wpe_psp_ofst = subfrm_info->ndd_wpe_psp_ofst;
+			frm_dump_info.wpe_fp = subfrm_info->ndd_wpe_fp;
+			frm_dump_info.fp = subfrm_info->ndd_fp;
+
+			imgsys_ndd_dump_routine(req->imgsys_pipe->imgsys_dev, &frm_dump_info);
 		}
 	}
+	complete(gwfrm_info->ndd_kernel_complete);
+
+release_work:
+	kfree(gwork);
 }
+#endif
 
 static void imgsys_runner_func(struct work_struct *work)
 {
@@ -485,7 +560,9 @@ static void imgsys_runner_func(struct work_struct *work)
 	struct mtk_imgsys_dev *imgsys_dev = req->imgsys_pipe->imgsys_dev;
 	struct swfrm_info_t *frm_info;
 	int ret;
-
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	struct scp_work *nddwork = NULL;
+#endif
 	frm_info = req->swfrm_info;
 	frm_info->is_sent = true;
 
@@ -499,6 +576,18 @@ static void imgsys_runner_func(struct work_struct *work)
 	if (ret)
 		dev_info(imgsys_dev->dev,
 			 "%s: imgsys_cmdq_sendtask fail(%d)\n", __func__, ret);
+
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	if (frm_info->user_info[0].ndd_fp[0] != '\0') {
+		nddwork = kzalloc(sizeof(struct scp_work), GFP_KERNEL);
+		nddwork->req = req;
+		nddwork->req_sbuf_kva = frm_info->req_sbuf_kva;
+
+		INIT_WORK(&nddwork->work, imgsys_ndd_worker);
+		queue_work(req->imgsys_pipe->imgsys_dev->ndd_wq,
+			&nddwork->work);
+	}
+#endif
 }
 
 static void imgsys_scp_handler(void *data, unsigned int len, void *priv)
@@ -614,6 +703,16 @@ static void imgsys_scp_handler(void *data, unsigned int len, void *priv)
 
 	up(&imgsys_dev->sem);
 
+	if (swfrm_info->user_info[0].ndd_fp[0] != '\0') {
+		swfrm_info->ndd_user_complete = kzalloc(sizeof(struct completion), GFP_KERNEL);
+		init_completion(swfrm_info->ndd_user_complete);
+		imgsys_ndd_swfrm_list_add(imgsys_dev, swfrm_info);
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+		swfrm_info->ndd_kernel_complete = kzalloc(sizeof(struct completion), GFP_KERNEL);
+		init_completion(swfrm_info->ndd_kernel_complete);
+#endif
+	}
+
 	INIT_WORK(&req->runner_work, imgsys_runner_func);
 	queue_work(req->imgsys_pipe->imgsys_dev->runner_wq,
 		   &req->runner_work);
