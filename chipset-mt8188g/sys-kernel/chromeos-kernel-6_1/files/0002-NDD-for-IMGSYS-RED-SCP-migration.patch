 }
 EXPORT_SYMBOL(ipesys_me_debug_dump);
 
+void ipesys_me_ndd_dump(struct mtk_imgsys_dev *imgsys_dev,
+				struct imgsys_ndd_frm_dump_info *frm_dump_info)
+{
+	char *me_name;
+	char file_name[256] = "\0";
+	ssize_t ret;
+	uint32_t *reg_va;
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	struct file *cfile;
+	loff_t pos = 0;
+#endif
+	// Check for valid engine enum
+	if (frm_dump_info->eng_e != IMGSYS_NDD_ENG_ME) {
+		dev_err(imgsys_dev->dev, "%s wrong ndd me eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	// Map register memory space
+	reg_va = (uint32_t *)ioremap(frm_dump_info->cq_ofst[frm_dump_info->eng_e], ME_REG_RANGE);
+	if (reg_va == NULL) {
+		dev_err(imgsys_dev->dev, "%s da to va failed, ofst 0x%llx\n", __func__, frm_dump_info->cq_ofst[frm_dump_info->eng_e]);
+		return;
+	}
+
+	// Decide whether we're dumping to user space or kernel space
+	me_name = frm_dump_info->user_buffer ? "REG_ME_me.reg" : "REG_ME_me.regKernel";
+
+	ret = snprintf(file_name, sizeof(file_name), "%s%s", frm_dump_info->fp, me_name);
+	if ((ret < 0) || (ret >= sizeof(file_name))) {
+		dev_err(imgsys_dev->dev, "wrong me ndd file name %s\n", file_name);
+		iounmap(reg_va);
+		return;
+	}
+	dev_dbg(imgsys_dev->dev, "%s: ME ndd dump from 0x%llx to %s +\n", __func__,
+	    (uint64_t)reg_va, file_name);
+
+	if (frm_dump_info->user_buffer) {
+		// Copy file name to user buffer
+		ret = copy_to_user(frm_dump_info->user_buffer, file_name, FP_SIZE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy file name to user\n", __func__);
+			iounmap(reg_va);
+			return;
+		}
+		frm_dump_info->user_buffer += FP_SIZE;
+
+		// Copy ME register data to user buffer
+		ret = copy_to_user(frm_dump_info->user_buffer, reg_va, ME_REG_RANGE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy register data to user\n", __func__);
+			iounmap(reg_va);
+			return;
+		}
+		frm_dump_info->user_buffer += ME_REG_RANGE;
+	} else {
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+		cfile = filp_open(file_name, O_CREAT | O_RDWR, 0666);
+		if (IS_ERR(cfile)) {
+			dev_err(imgsys_dev->dev, "%s open file %s failed\n", __func__, file_name);
+			iounmap(reg_va);
+			return;
+		}
+
+		// Write ME register data to kernel file
+		ret = kernel_write(cfile, reg_va, ME_REG_RANGE, &pos);
+		if (ret < 0) {
+			dev_err(imgsys_dev->dev, "%s failed to write register data to file\n", __func__);
+			filp_close(cfile, NULL);
+			iounmap(reg_va);
+			return;
+		}
+		filp_close(cfile, NULL);
+#endif // IMGSYS_NDD_FROM_KERNEL
+	}
+
+	// Unmap register memory space
+	iounmap(reg_va);
+	dev_dbg(imgsys_dev->dev, "%s: -\n", __func__);
+}
+EXPORT_SYMBOL(ipesys_me_ndd_dump);
