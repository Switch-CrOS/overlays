+void imgsys_wpe_ndd_dump(struct mtk_imgsys_dev *imgsys_dev,
+				struct imgsys_ndd_frm_dump_info *frm_dump_info)
+{
+	char file_name[256] = "\0";
+	ssize_t ret;
+	uint32_t *cq_va = NULL;
+	uint32_t *psp_va = NULL;
+	uint64_t cq_ofst = 0;
+	uint64_t psp_ofst = 0;
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	struct file *cfile;
+	loff_t pos = 0;
+#endif
+	if (frm_dump_info->eng_e > IMGSYS_NDD_ENG_WPE_LITE ) {
+		dev_err(imgsys_dev->dev, "%s wrong ndd wpe eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	cq_ofst = frm_dump_info->cq_ofst[frm_dump_info->eng_e];
+	psp_ofst = frm_dump_info->wpe_psp_ofst[frm_dump_info->eng_e];
+
+	cq_va = (uint32_t *)((uint64_t)mtk_hcp_get_reserve_mem_virt(imgsys_dev->scp_pdev, WPE_MEM_C_ID) + cq_ofst);
+	if (cq_va == NULL) {
+		dev_err(imgsys_dev->dev, "%s get null wpe cq_va ofst 0x%llx\n", __func__, cq_ofst);
+		return;
+	}
+
+	psp_va = (uint32_t *)((uint64_t)mtk_hcp_get_reserve_mem_virt(imgsys_dev->scp_pdev, WPE_MEM_C_ID) + psp_ofst);
+	if (psp_va == NULL) {
+		dev_err(imgsys_dev->dev, "%s get null wpe psp ofst 0x%llx\n", __func__, psp_ofst);
+		return;
+	}
+	if (frm_dump_info->user_buffer)
+		ret = snprintf(file_name, sizeof(file_name), "%s%s", frm_dump_info->fp, frm_dump_info->wpe_fp);
+	else
+		ret = snprintf(file_name, sizeof(file_name), "%s%sKernel", frm_dump_info->fp, frm_dump_info->wpe_fp);
+
+	if ((ret < 0) || (ret >= sizeof(file_name))) {
+		dev_err(imgsys_dev->dev, "wrong wpe ndd file name %s\n", file_name);
+		return;
+	}
+
+	if (frm_dump_info->user_buffer) {
+		dev_dbg(imgsys_dev->dev, "%s: wpe ndd copy from 0x%llx to user buffer +\n",
+		        __func__, (uint64_t)cq_va);
+
+		ret = copy_to_user(frm_dump_info->user_buffer , (u8 *)file_name, FP_SIZE);
+		frm_dump_info->user_buffer += FP_SIZE;
+
+		if (psp_ofst != 0) {
+
+			ret = copy_to_user(frm_dump_info->user_buffer,
+					(u8 *)cq_va, WPE_PSP_END_OFST);
+			frm_dump_info->user_buffer += WPE_PSP_END_OFST;
+
+			ret = copy_to_user(frm_dump_info->user_buffer,
+					(u8 *)psp_va, WPE_COEF_END_OFST - WPE_PSP_END_OFST);
+			frm_dump_info->user_buffer += (WPE_COEF_END_OFST - WPE_PSP_END_OFST);
+
+			ret = copy_to_user(frm_dump_info->user_buffer,
+					(u8 *)(cq_va+(WPE_COEF_END_OFST/4)), WPE_REG_RANGE - WPE_COEF_END_OFST);
+			frm_dump_info->user_buffer += (WPE_REG_RANGE - WPE_COEF_END_OFST);
+
+		} else {
+			ret = copy_to_user(frm_dump_info->user_buffer,
+					(u8 *)cq_va, WPE_REG_RANGE);
+			frm_dump_info->user_buffer += WPE_REG_RANGE;
+		}
+	} else {
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+		cfile = filp_open(file_name, O_CREAT | O_RDWR, 0666);
+		if (IS_ERR(cfile)) {
+			dev_err(imgsys_dev->dev, "%s open file %s failed\n", __func__, file_name);
+			return;
+		}
+		dev_dbg(imgsys_dev->dev, "%s: wpe ndd dump from 0x%llx to file %s +\n",
+		        __func__, (uint64_t)cq_va, file_name);
+
+		if (psp_ofst != 0) {
+			kernel_write(cfile, (void *)cq_va, WPE_PSP_END_OFST, &pos);
+			kernel_write(cfile, (void *)psp_va, (WPE_COEF_END_OFST - WPE_PSP_END_OFST), &pos);
+			kernel_write(cfile, (void *)(cq_va+(WPE_COEF_END_OFST/4)),
+							(WPE_REG_RANGE - WPE_COEF_END_OFST), &pos);
+		} else {
+
+			kernel_write(cfile, (void *)cq_va, WPE_REG_RANGE, &pos);
+		}
+		filp_close(cfile, NULL);
+#endif
+	}
+	dev_dbg(imgsys_dev->dev, "%s: -\n", __func__);
+}
+EXPORT_SYMBOL(imgsys_wpe_ndd_dump);
