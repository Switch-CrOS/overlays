# Initial value just for style purposes.
USE=""

USE="${USE} -opengl opengles"

# TODO: Re-enable these when the corresponding packages are fixed
USE="${USE} -nacl"

VIDEO_CARDS="rockchip"

BOARD_COMPILER_FLAGS="-march=armv8-a+crc -mtune=cortex-a57 -ftree-vectorize"
BOARD_RUSTFLAGS="-Ctarget-feature=+armv8-a,+crc"

INPUT_DEVICES="wacom"

# Disable on-device grammar check for boards with 2GB rootfs.
USE="${USE} -ondevice_grammar"

# Disable on-device text suggestions for boards with 2GB rootfs.
USE="${USE} -ondevice_text_suggestions"

# Disable Floss Bluetooth for boards with 2GB rootfs.
USE="${USE} -floss"
