# Initial value just for style purposes.
USE=""

# Enable Zephyr-based EC.
USE="${USE} zephyr_ec zephyr_v2_6"

# Disable CrOS EC builds as they will be unused.
USE="${USE} -cros_ec"

# Force firmware from ToT (instead of BCS builds).
USE="${USE} tot_firmware"
