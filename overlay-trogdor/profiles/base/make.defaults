# Initial value just for style purposes.
USE=""

USE="${USE} trogdor"

# Enable firmware detachable ui
# TODO(chromium:1033815): Deprecate detachable_ui.
USE="${USE} detachable legacy_menu_ui detachable_ui"

# Enable biod
USE="${USE} biod"

# Use ext4 crypto
USE="${USE} direncryption"

# Enable QMI support in ModemManager
USE="${USE} qmi"

# All firmwares to build from the EC code base
EC_FIRMWARE="trogdor"
