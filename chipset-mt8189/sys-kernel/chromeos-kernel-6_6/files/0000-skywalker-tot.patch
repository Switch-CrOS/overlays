+static void mtk_drm_dbg_gen_gamma_lut(void)
+{
+	int i = 0;
+	struct drm_color_lut *src_lut = &gamma_lut[0];
+	struct drm_color_lut *dst_lut = &gamma_lut1[0];
+
+	mtk_drm_dbg("gen new gamma lut\n");
+
+	for (i = 0; i < MTK_LUT_SIZE; i++) {
+		dst_lut[i].red = src_lut[i].red;
+		dst_lut[i].green = src_lut[i].red;
+		dst_lut[i].blue= src_lut[i].red;
+	}
+}
