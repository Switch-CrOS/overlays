+static void proc_fclk_freq(fn_fclk_freq_proc proc, void *data)
+{
+	void *fmeter_data;
+	const struct fmeter_clk *fclk;
+	char cmd[sizeof(last_cmd)];
+	char *c = cmd;
+	char *ign;
