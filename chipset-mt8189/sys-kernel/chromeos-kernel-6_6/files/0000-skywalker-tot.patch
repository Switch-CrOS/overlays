+}
+
+static void clkchk_cg_chk(const char *name)
+{
+	struct provider_clk *pvdck;
+
+	pvdck = __clk_chk_lookup_pvdck(name);
+	if (!clkchk_pvdck_is_on(pvdck))
+		pr_notice("clk %s access without power on\n", name);
+}
+
