+static u32 mtk_drm_dbg_read_reg(u32 addr)
+{
+	u32 value = 0;
+	u32 offset;
+	struct mtk_drm_dbg_table *table;
+
+	table = mtk_drm_dbg_find_comp_with_pa(addr);
+	if (!table || !table->reg_va)
+		return value;
+
+	offset = addr - table->reg_pa;
+
+	value = readl(table->reg_va + offset);
+
+	mtk_drm_dbg(
+		"read comp %s 0x%X = 0x%X done\n",
+		table->name,
+		addr,
+		value);
+
+	return value;
+}
+
+static void mtk_drm_dbg_write_reg(u32 addr, u32 value)
+{
+	struct mtk_drm_dbg_table *table;
+	u32 offset;
+	u32 org_val;
+
+	table = mtk_drm_dbg_find_comp_with_pa(addr);
+	if (!table || !table->reg_va)
+		return;
+
+	offset = addr - table->reg_pa;
+
+	org_val = readl(table->reg_va + offset);
+
+	writel(value, table->reg_va + offset);
+
+	mtk_drm_dbg("write comp %s 0x%X = 0x%X -> 0x%X(0x%X) done\n",
+		table->name,
+		addr,
+		org_val,
+		value,
+		readl(table->reg_va + offset));
+}
+
+static void mtk_drm_dbg_enable_dsi_pattern(u32 enable, u32 pattern)
+{
+	struct mtk_drm_dbg_table *table;
+	u32 reg_pa;
+	u32 val = 0x200040;
+	u32 pat_val_offset = 0x178;
+	u32 pat_en_offset = 0x17c;
+
+	table = mtk_drm_dbg_find_comp("disp_dsi0");
+	if (!table || !table->reg_va)
+		return;
+
+	mtk_drm_dbg("enable %d pattern 0x%x\n", enable, pattern);
+
+	reg_pa = table->reg_pa;
+
+	mtk_drm_dbg_write_reg(reg_pa + pat_val_offset, pattern);
+
+	if (!enable)
+		val = 0x200000;
+	mtk_drm_dbg_write_reg(reg_pa + pat_en_offset, val);
+}
+
+static void mtk_drm_dbg_ovl_reset(u32 id)
+{
+	u32 reg_pa;
+	u32 reset_offset = 0x14;
+	struct mtk_drm_dbg_table *table;
+	char *name;
+
+	if (id == 0)
+		name = "disp_ovl0";
+	else if (id == 1)
+		name = "disp_ovl0_2l";
+	else
+		name = "disp_ovl1_2l";
+
+	table = mtk_drm_dbg_find_comp(name);
+	if (!table || !table->reg_va)
+		return;
+
+	reg_pa = table->reg_pa;
+
+	mtk_drm_dbg("reset ovl %s\n", name);
+
+	mtk_drm_dbg_write_reg(reg_pa + reset_offset, 1);
+	mtk_drm_dbg_write_reg(reg_pa + reset_offset, 0);
+}
+
+static void mtk_drm_dbg_set_ovl_bg_clr(u32 clr)
+{
+	struct mtk_drm_dbg_table *table;
+	u32 reg_pa;
+	u32 pat_val_offset = 0x28;
+	u32 layer_en_offset = 0x2c;
+
+	table = mtk_drm_dbg_find_comp("disp_ovl0");
+	if (!table || !table->reg_va)
+		return;
+
+	reg_pa = table->reg_pa;
+
+	mtk_drm_dbg("set bg clr 0x%X\n", clr);
+
+	mtk_drm_dbg_write_reg(reg_pa + pat_val_offset, clr);
+
+	if (clr >= 1)
+		mtk_ovl_bg_clr_enable = 1;
+	else
+		mtk_ovl_bg_clr_enable = 0;
+
+	mtk_drm_dbg_write_reg(reg_pa + layer_en_offset, !mtk_ovl_bg_clr_enable);
+
+	mtk_drm_dbg_ovl_reset(0);
+}
