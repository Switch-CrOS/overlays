+	dev_dbg(dpi->dev, "pclk:%ld\n",
+		 clk_get_rate(dpi->pclk));
+	dev_dbg(dpi->dev, "hf_fmm_ck:%ld\n",
+		 clk_get_rate(dpi->hf_fmm_ck));
