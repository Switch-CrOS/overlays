+	int slbc_qos_latency;
+};
+
+#define SLBC_ENTRY(id, sid, max, fix, p, extra, res, cache)	\
+{								\
+	.uid = id,						\
+	.slot_id = sid,						\
+	.max_size = max,					\
+	.fix_size = fix,					\
+	.priority = p,						\
+	.extra_slot = extra,					\
+	.res_slot = res,					\
+	.cache_mode = cache,					\
