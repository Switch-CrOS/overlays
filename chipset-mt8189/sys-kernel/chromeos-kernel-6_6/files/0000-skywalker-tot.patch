+#define INIT_TABLE(_name, _reg_pa, _dump_reg, _dump_size, _pipe) {	\
+	.name = _name,				\
+	.reg_pa = _reg_pa,			\
+	.dump_reg = _dump_reg,			\
+	.dump_size = _dump_size,		\
+	.pipe = _pipe,				\
+}
