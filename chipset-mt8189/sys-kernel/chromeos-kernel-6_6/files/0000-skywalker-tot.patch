+#ifndef __MTK_PD_CHK_H
+#define __MTK_PD_CHK_H
+
+#include <linux/pm_domain.h>
+#include "clkchk.h"
+#include "clk-mtk.h"
+
+#define PD_PWR_ON	1
+#define PD_PWR_OFF	0
+#define SWCG(_name) {						\
