+	struct mutex hdcp_mutex;
+
+	void __iomem *regs;
+	void __iomem *phyd_regs;
+	void __iomem *phy_mux_regs;
+	void __iomem *mac_power_regs;
+
+	int disp_state;
+	bool dp_ready;
+
+	struct mtk_drm_private *priv;
+	struct dp_phy_parameter phy_params[DP_PHY_LEVEL_COUNT];
+
+	bool swap_enable;
+	bool need_debounce;
+
+	bool init_property;
