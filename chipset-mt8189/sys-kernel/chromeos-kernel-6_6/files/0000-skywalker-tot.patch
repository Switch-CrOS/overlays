+		mode, 0, 0, 0, 0, 0,
+		&ares);
+
+	if (!ares.a0)
+		dvfsrc->qos_mm_mode = mode;
+
+	return count;
+}
+DEVICE_ATTR_RW(dvfsrc_qosmm_mode);
+
