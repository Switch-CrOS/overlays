+void mtk_dptx_hw_set_rate_param(u8 val)
+{
+	switch (val) {
+	case DP_LINK_RATE_RBR:
+		/// Set gear : 0x0 : RBR, 0x1 : HBR, 0x2 : HBR2, 0x3 : HBR3
+		dptx_phy_write_4byte(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_BIT_RATE, 0x0);
+		// TXPLL_IR force value for Lepin & Pichon patch
+		//dptx_write_4mask(0x003C, 0x003 << 24, BITMASK(28:24));
+		break;
+
+	case DP_LINK_RATE_HBR:
+		/// Set gear : 0x0 : RBR, 0x1 : HBR, 0x2 : HBR2, 0x3 : HBR3
+		dptx_phy_write_4byte(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_BIT_RATE, 0x1);
+		// TXPLL_IR force value for Lepin & Pichon patch
+		//dptx_write_4mask(0x003C, 0x005 << 24, BITMASK(28:24));
+		break;
+
+	case DP_LINK_RATE_HBR2:
+		/// Set gear : 0x0 : RBR, 0x1 : HBR, 0x2 : HBR2, 0x3 : HBR3
+		dptx_phy_write_4byte(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_BIT_RATE, 0x2);
+		// TXPLL_IR force value for Lepin & Pichon patch
+		//dptx_write_4mask(0x003C, 0x005 << 24, BITMASK(28:24));
+		break;
+
+	case DP_LINK_RATE_HBR3:
+		/// Set gear : 0x0 : RBR, 0x1 : HBR, 0x2 : HBR2, 0x3 : HBR3
+		dptx_phy_write_4byte(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_BIT_RATE, 0x3);
+		// TXPLL_IR force value for Lepin & Pichon patch
+		//dptx_write_4mask(0x003C, 0x002 << 24, BITMASK(28:24));
+		break;
+
+	default:
+		break;
+	}
+}
