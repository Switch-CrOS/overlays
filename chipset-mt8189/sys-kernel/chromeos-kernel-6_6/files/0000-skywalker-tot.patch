+static struct mtk_drm_dbg_buf_info *mtk_drm_dbg_find_buf_with(dma_addr_t dma_addr)
+{
+	u32 idx;
+	struct mtk_drm_dbg_buf_info *buf_info = NULL;
+
+	for (idx = 0; idx <= MAX_BUF; idx++) {
+		buf_info = &drm_dbg_buf[idx];
+
+		if (buf_info->dma_addr == dma_addr)
+			break;
+	}
+
+	return buf_info;
+}
+
+static void mtk_drm_dbg_dump_buf_info(void)
+{
+	u32 idx;
+	struct mtk_drm_dbg_buf_info *buf_info = NULL;
+
+	for (idx = 0; idx <= MAX_BUF; idx++) {
+		buf_info = &drm_dbg_buf[idx];
+
+		if (buf_info->kvaddr) {
+			mtk_drm_dbg("find %d buf cookie 0x%px dma_addr 0x%llx size %zu\n",
+				    idx, buf_info->kvaddr, buf_info->dma_addr,
+				    buf_info->size);
+		}
+	}
+}
+
+MODULE_IMPORT_NS(VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver);
+#define MAX_FILE_NAME 256
+ssize_t mtk_drm_dbg_write_file(char *file_name, char *buff, uint32_t len)
+{
+	struct file *fp = NULL;
+	ssize_t file_size;
+	int ret;
+
+	fp = filp_open(file_name, O_RDWR | O_CREAT | O_TRUNC, 0644);
+
+	if (IS_ERR(fp)) {
+		mtk_drm_err("open file %s fail %ld\n", file_name, PTR_ERR(fp));
+		return 0;
+	}
+
+	/* write data */
+	file_size = kernel_write(fp, buff, len, &fp->f_pos);
+	mtk_drm_dbg("dump %s len[%u %zd] va:%px\n",
+		    file_name, len, file_size, buff);
+	ret = filp_close(fp, NULL);
+
+	return file_size;
+}
+
+static void mtk_drm_dbg_dump_cur_frame(void)
+{
+	struct mtk_drm_dbg_table *table;
+	struct mtk_drm_dbg_buf_info *buf_info;
+	u32 cur_addr;
+	u32 addr_offset = 0xf40;
+
+	table = mtk_drm_dbg_find_comp("disp_ovl0");
+	if (!table || !table->reg_va)
+		return;
+
+	cur_addr = readl(table->reg_va + addr_offset);
+
+	mtk_drm_dbg_dump_buf_info();
+
+	mtk_drm_dbg("cur frame addr 0x%X\n", cur_addr);
+
+	buf_info = mtk_drm_dbg_find_buf_with((dma_addr_t)cur_addr);
+	if (buf_info) {
+		mtk_drm_dbg_write_file("/tmp/disp/cur_frame.bin", buf_info->kvaddr, buf_info->size);
+	}
+}
+
+static int mtk_drm_dbg_process_cmd(char *cmd)
+{
+	char *np, *opt;
+
+	DRM_INFO("dbg cmd: %s\n", cmd);
+	opt = strsep(&cmd, " ");
+
+	memset(read_buf, 0, BUF_SIZE);
+
+	if (strncmp(opt, "regr:", 5) == 0) {
+		char *p = (char *)opt + 5;
+		u32 addr = 0;
+
+		DDP_STR_CONVERT(&p, &addr, uint, goto errcode);
+
+		mtk_drm_dbg_read_reg(addr);
+	} else if (strncmp(opt, "regw:", 5) == 0) {
+		char *p = (char *)opt + 5;
+		u32 addr = 0, val = 0;
+
+		DDP_STR_CONVERT(&p, &addr, uint, goto errcode);
+
+		DDP_STR_CONVERT(&p, &val, uint, goto errcode);
+
+		mtk_drm_dbg_write_reg(addr, val);
+	} else if (strncmp(opt, "dump_comp:", 10) == 0) {
+		char *p = (char *)opt + 10;
+		char name[16];
+		u32 len = 0x100;
+		u32 offset = 0x0;
+		struct mtk_drm_dbg_table *comp;
+
+		np = strsep(&p, ",");
+		sscanf(np, "%s", name);
+
+		DDP_STR_CONVERT(&p, &len, uint, goto errcode);
+
+		DDP_STR_CONVERT(&p, &offset, uint, goto errcode);
+
+		comp = mtk_drm_dbg_find_comp(name);
+
+		mtk_drm_dbg_dump_comp_reg(comp, len, offset);
+
+	} else if (strncmp(opt, "dump_path:", 10) == 0) {
+		char *p = (char *)opt + 10;
+		u32 pipe = 0;
+
+		DDP_STR_CONVERT(&p, &pipe, uint, goto errcode);
+
+		mtk_drm_dbg_dump_path(pipe);
+
+	} else if (strncmp(opt, "dump_frame:", 11) == 0) {
+		char *p = (char *)opt + 11;
+		u32 dump_frame = 0;
+
+		DDP_STR_CONVERT(&p, &dump_frame, uint, goto errcode);
+
+		mtk_drm_dbg_dump_cur_frame();
+
+	} else if (strncmp(opt, "dump_disp:", 10) == 0) {
+		char *p = (char *)opt + 10;
+		u32 dump_frame_enable = 0;
+
+		DDP_STR_CONVERT(&p, &dump_frame_enable, uint, goto errcode);
+
+		drm_dbg_dump_frame_enable = dump_frame_enable;
+		if (dump_frame_enable) {
+			np = strsep(&p, ",");
+			if (np) {
+				char udisc_name[16];
+
+				sscanf(np, "%s", udisc_name);
+				snprintf(drm_dbg_dump_folder_name, 100, "/media/removable/%s/disp", udisc_name);
+			}
+
+			mtk_drm_dbg("dump folder name %s\n", drm_dbg_dump_folder_name);
+		}
+
+		drm_dbg_dump_frame_idx = 0;
+
+		mtk_drm_dbg("set dump frame enable %d\n", dump_frame_enable);
+
+	} else if (strncmp(opt, "dsi_pt:", 7) == 0) {
+		char *p = (char *)opt + 7;
+		u32 enable = 0, pattern = 0;
+
+		DDP_STR_CONVERT(&p, &enable, uint, goto errcode);
+
+		if (enable)
+			DDP_STR_CONVERT(&p, &pattern, uint, goto errcode);
+
+		mtk_drm_dbg_enable_dsi_pattern(enable, pattern);
+
+	} else if (strncmp(opt, "ovl_bg:", 7) == 0) {
+		char *p = (char *)opt + 7;
+		u32 clr = 0;
+
+		DDP_STR_CONVERT(&p, &clr, uint, goto errcode);
+
+		mtk_drm_dbg_set_ovl_bg_clr(clr);
+
+	} else if (strncmp(opt, "force_gamma:", 12) == 0) {
+		char *p = (char *)opt + 12;
+		u32 gamma_en = 0;
+
+		DDP_STR_CONVERT(&p, &gamma_en, uint, goto errcode);
+
+		mtk_drm_dbg_set_gamma_enable(gamma_en);
+	} else if (strncmp(opt, "dump_gamma:", 11) == 0) {
+		mtk_drm_dbg_get_gamma_lut();
+	} else {
+		goto errcode;
+	}
+
+	return 0;
+
+errcode:
+	DRM_INFO("opt %s cmd %s ", opt, cmd);
+	DRM_INFO("invalid dbg command %s\n", STR_HELP);
+	return -1;
+}
+
+static ssize_t mtk_drm_dbg_write(struct file *file, const char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	char str_buf[64];
+	size_t ret;
+
+	ret = count;
+	memset(str_buf, 0, sizeof(str_buf));
+
+	if (count > sizeof(str_buf))
+		count = sizeof(str_buf);
+
+	if (copy_from_user(str_buf, ubuf, count))
+		return -EFAULT;
+
+	str_buf[count] = 0;
+
+	mtk_drm_dbg_process_cmd(str_buf);
+
+	return ret;
+}
+
+static const struct file_operations mtk_drm_dbg_fops = {
+	.write = mtk_drm_dbg_write,
+	.open = mtk_drm_dbg_open,
+};
+
+static void mtk_drm_dbg_create_node(void)
+{
+	struct dentry *dbgfs =
+	    debugfs_create_file("mtkdrm", S_IFREG | 0444, NULL, NULL,
+				&mtk_drm_dbg_fops);
+
+	if (IS_ERR(dbgfs))
+		return;
+}
+
+void mtk_drm_dbg_dump_path(u32 pipe)
+{
+	struct mtk_drm_dbg_data *data = dbg_data;
+	struct mtk_drm_dbg_table *table;
+	struct mtk_drm_dbg_table *comp;
+	u32 i;
+
+	mtk_drm_dbg_check_ptr(data, "data");
+
+	table = data->table;
+	mtk_drm_dbg_check_ptr(table, "table");
+
+	mtk_drm_dbg("pipe %d %d\n", pipe, data->size);
+
+	mtk_drm_dbg_dump_info();
+
+	mtk_drm_dbg_dump_comp_reg(&table[0], 0x040, 0x100);
+	mtk_drm_dbg_dump_comp_reg(&table[0], 0x040, 0x100);
+	mtk_drm_dbg_dump_comp_reg(&table[0], 0x040, 0x800);
+	mtk_drm_dbg_dump_comp_reg(&table[0], 0x040, 0x800);
+
+	for (i = 0; i < data->size; i++) {
+		comp = &table[i];
+		if (!(comp->pipe & (1 << pipe)))
+			continue;
+
+		mtk_drm_dbg_dump_comp_reg(comp, 0x100, 0x000);
+		mtk_drm_dbg_dump_comp_reg(comp, 0x100, 0x000);
+		mtk_drm_dbg_dump_comp(comp);
+	}
+
+	mtk_drm_dbg("done!\n");
+}
+
+void mtk_drm_dbg_init_table(void)
+{
+	u32 idx;
+	struct mtk_drm_dbg_data *data = dbg_data;
+	struct mtk_drm_dbg_table *table;
+	struct mtk_drm_dbg_table *comp;
+
+	table = data->table;
+
+	for (idx = 0; idx < data->size; idx++) {
+		comp = &table[idx];
+
+		comp->reg_va = ioremap(comp->reg_pa, PAGE_SIZE);
+	}
+
+}
+
+void mtk_drm_dbg_init(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+
+	mtk_drm_dbg("%s\n", __func__);
+
+	mtk_drm_dbg("dev %s node 0x%px parent %s node 0x%px\n",
+		    dev_name(dev),
+		    dev->of_node,
+		    dev_name(dev->parent),
+		    dev->parent->of_node);
+
+	dbg_data = &mt8189_dbg_data;
+
+	mtk_drm_dbg_init_table();
+
+	mtk_drm_dbg_create_node();
+
+	mtk_drm_dbg_dump_info();
+}
+
+void mtk_drm_dbg_record_buf_info(void *kvaddr, dma_addr_t dma_addr, size_t size)
+{
+	u32 idx;
+	struct mtk_drm_dbg_buf_info *buf_info;
+
+	for (idx = 0; idx <= MAX_BUF; idx++) {
+		buf_info = &drm_dbg_buf[idx];
+
+		if (buf_info->kvaddr == NULL) {
+			buf_info->kvaddr = kvaddr;
+			buf_info->dma_addr = dma_addr;
+			buf_info->size = size;
+
+			mtk_drm_dbg("cookie 0x%px dma_addr %px size %zu record %d buf\n",
+				    kvaddr, &dma_addr,
+				    size, idx);
+
+			drm_dbg_buf_idx++;
+			break;
+		}
+	}
+
+	if (idx >= MAX_BUF)
+		mtk_drm_dbg("record overflow %d\n", idx);
+}
+
+void mtk_drm_dbg_remove_buf_info(void *kvaddr, dma_addr_t dma_addr)
+{
+	u32 idx;
+	struct mtk_drm_dbg_buf_info *buf_info;
+
+	for (idx = 0; idx <= MAX_BUF; idx++) {
+		buf_info = &drm_dbg_buf[idx];
+
+		if (buf_info->kvaddr == kvaddr &&
+		    buf_info->dma_addr == dma_addr) {
+			buf_info->kvaddr = NULL;
+			buf_info->dma_addr = 0;
+			buf_info->size = 0;
+
+			mtk_drm_dbg("cookie 0x%px dma_addr %px remove %d buf\n",
+				    kvaddr, &dma_addr, idx);
+
+			drm_dbg_buf_idx--;
+			break;
+		}
+	}
+
+	if (idx >= MAX_BUF)
+		mtk_drm_dbg("record overflow %d\n", idx);
+}
+
+void mtk_drm_dbg_dump_frame(dma_addr_t cur_addr)
+{
+	struct mtk_drm_dbg_buf_info *buf_info;
+
+	if (!drm_dbg_dump_frame_enable)
+		return;
+
+	buf_info = mtk_drm_dbg_find_buf_with(cur_addr);
+	if (buf_info) {
+		char file_name[100];
+		u32 frame_idx = drm_dbg_dump_frame_idx++;
+		ssize_t frame_size;
+
+		snprintf(file_name, 100, "%s/frame_%08d.bin",
+			 drm_dbg_dump_folder_name, frame_idx);
+
+		frame_size = mtk_drm_dbg_write_file(file_name, buf_info->kvaddr, buf_info->size);
+
+		if (frame_size < buf_info->size) {
+			/* drm_dbg_dump_frame_idx = 0; */
+			mtk_drm_dbg("disc is full, write frame from 1st one again\n");
+		} else {
+			mtk_drm_dbg("write frame %s cookie %px addr %px size %zu %zd\n",
+			    file_name, buf_info->kvaddr, &buf_info->dma_addr,
+			    buf_info->size, frame_size);
+		}
+	}
+}
