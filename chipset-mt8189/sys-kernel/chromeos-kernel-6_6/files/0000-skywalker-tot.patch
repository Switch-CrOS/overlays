+		if (ret) {
+			pr_err("#@# %s(%d) [LVL_ERR] ach scmi vld fail, uid:%d, gid:%d\n",
+				__func__, __LINE__, uid, gid);
+			return ret;
+		}
+	}
+
+	pr_info("#@# %s(%d) [LVL_NORM] gid:%d\n", __func__, __LINE__, gid);
+
+	return ret;
+}
