+
+#define pr_dbg(fmt, ...) \
+	pr_notice("[CLKDBG] %s:%d: " fmt, __func__, __LINE__, ##__VA_ARGS__)
+
+#include <linux/device.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
