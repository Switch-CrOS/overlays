+bool mtk_dp_phy_auto_test(struct dp_cts_auto_req *mtk_dp_test, u8 ubDPCD_201)
+{
+	u8 dpcd_201 = 0x0;
+	u8 dpcd_218 = 0x0;
+	u8 dpcd_248 = 0x0;
+	u8 dpcd_buf[10] = {0};
+	u8 temp[0x10] = {0};
+	u8 ubTempBuffer[0x10];
+	u8 test_link_rate;   // DPCD_219
+	u8 test_lane_count;  // DPCD_220
+	struct mtk_dp *mtk_dp_tk;
+
+	mtk_dp = mtk_dp_test;
+	mtk_dp_tk = container_of(mtk_dp_test, struct mtk_dp, cts_req);
+
+	pr_notice("[DPTX] shuaibo: %s enter", __func__);
+	dev_info(mtk_dp_tk->dev, "[DPTX] %s, %d\n", __func__, __LINE__);
+
+	memset(ubTempBuffer, 0x0, sizeof(ubTempBuffer));
+	pr_info("[DPTX] PHY_AutoTest Start\n");
+	pr_info("[DPTX] DPCD 201 = 0x%x\n", ubDPCD_201);
+	dev_info(mtk_dp_tk->dev, "[DPTX] DPCD 201 0x%x\n", ubDPCD_201);
+	
+
+	if (ubDPCD_201 & BIT(1)) {
+		mtk_dptx_drv_aux_write_access(DPCD_00201, &dpcd_201, 0x1);
+		usleep_range(1000, 2000);
+		mtk_dptx_drv_aux_read_access(DPCD_00218, &dpcd_218, 0x1);
+		pr_notice("[DPTX] DPCD 218 = 0x%x\n", dpcd_218);
+		dev_info(mtk_dp_tk->dev, "[DPTX] dpcd_218 0x%x\n", dpcd_218);
+
+		switch (dpcd_218 & 0xFF) {
+		case BIT(0):
+			pr_info("[DPTX] TEST_LINK_TRAINING Start\n");
+			dev_info(mtk_dp_tk->dev, "[DPTX] TEST_LINK_TRAINING Start\n");
+			
+			temp[0x0] = 0x01;
+			mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+			mtk_dptx_drv_aux_read_access(DPCD_00219, &test_link_rate, 0x1);
+			mtk_dptx_drv_aux_read_access(DPCD_00220, &test_lane_count, 0x1);
+			mtk_dp->training_info.dp_tx_auto_test_en = TRUE;
+
+			if (test_link_rate && test_lane_count) {
+				mtk_dp->training_info.link_rate = test_link_rate;
+				mtk_dp->training_info.link_lane_count = test_lane_count;
+
+				temp[0x0] = 0x0;
+				mtk_dptx_drv_aux_write_access(DPCD_00102, temp, 0x1);
+				temp[0x0] = 0x2;
+				mtk_dptx_drv_aux_write_access(DPCD_00600, temp, 0x1);
+				mtk_dptx_hal_fec_enable(FALSE);
+				#if (DP_AUTO_TEST_ENABLE == 0x1)
+				mtk_dp_set_training_start_for_cts(mtk_dp_test);
+				//mtk_dptx_hal_fec_enable(mtk_dp->has_fec);
+				#endif
+				if (drm_dp_sink_supports_fec(mtk_dp_tk->mtk_con[DP_FIRST_CON]->fec_cap))
+					mtk_dptx_hal_fec_enable(true);
+			}
+			break;
+		case BIT(1):
+			pr_info("[DPTX] TEST_PATTERN Start\n");
+			dev_info(mtk_dp_tk->dev, "[DPTX] TEST_PATTERN Start\n");
+			break;
+		case BIT(3):
+			pr_info("[DPTX] PHY_TEST_PATTERN Start\n");
+			dev_info(mtk_dp_tk->dev, "[DPTX] PHY_TEST_PATTERN Start\n");
+			mtk_dptx_drv_aux_read_access(DPCD_00248, &dpcd_248, 0x1);
+			mtk_dptx_drv_aux_read_access(DPCD_00220, &test_lane_count, 0x1);
+			pr_info("[DPTX] DPCD 248 = 0x%x", dpcd_248);
+			dev_info(mtk_dp_tk->dev, "DPCD 248 = 0x%x", dpcd_248);
+			pr_info("[DPTX] test_lane_count = %d", test_lane_count);
+			dev_info(mtk_dp_tk->dev, "[DPTX] test_lane_count = %d", test_lane_count);
+			mtk_dptx_drv_phy_set_swing_pre(test_lane_count);
+
+			switch (dpcd_248 & 0x07) {
+			case PATTERN_NONE:
+				pr_info("[DPTX] set  PATTERN_NONE\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  PATTERN_NONE\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_NONE,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				break;
+			case PATTERN_D10_2:
+				pr_info("[DPTX] set  PATTERN_D10_2\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  PATTERN_D10_2\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_D10_2,
+							     test_lane_count);
+				mdelay(2);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				break;
+			case PATTERN_SYMBOL_ERR:
+				pr_info("[DPTX] set  PATTERN_SYMBOL_ERR\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  PATTERN_SYMBOL_ERR\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_SYMBOL_ERR,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case PATTERN_PRBS7:
+				pr_info("[DPTX] set  PATTERN_PRBS7\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  PATTERN_PRBS7\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_PRBS7,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case PATTERN_80B:
+				pr_info("[DPTX] set  PATTERN_80B\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  PATTERN_80B\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_80B,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case PATTERN_HBR2_COM_EYE:
+				pr_info("[DPTX] set  PATTERN_HBR2_COM_EYE\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  PATTERN_HBR2_COM_EYE\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_HBR2_COM_EYE,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case CP2520_PATTERN3:
+				pr_info("[DPTX] set  CP2520_PATTERN3\n");
+				dev_info(mtk_dp_tk->dev, "[DPTX] set  CP2520_PATTERN3\n");
+				mtk_dptx_hal_set_training_pattern(BIT7);
+				mtk_dptx_hal_phy_set_lane_pwr(test_lane_count);
+				mtk_dptx_hal_set_lane_count(test_lane_count);
+				break;
+			default:
+				break;
+			}
+			break;
+		default:
+			temp[0x0] = 0x01;
+			mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+			pr_info("[DPTX] DPCD 218 Not support\n");
+			dev_info(mtk_dp_tk->dev, "[DPTX] DPCD 218 Not support\n");
+			return FALSE;
+		}
+	}
+	return true;
+}
