+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (C) 2025 Google Inc.
+ */
+/dts-v1/;
+#include "mt8189-skywalker-yoda.dtsi"
+
+/ {
+	model = "Google Yoda sku4 board";
+	compatible = "google,yoda-sku4", "google,yoda-sku5", "google,yoda-sku6",
+		     "google,yoda-sku7", "google,yoda-sku12", "google,yoda-sku13", "google,yoda-sku14",
+		     "google,yoda-sku15", "google,yoda", "mediatek,mt8189";
