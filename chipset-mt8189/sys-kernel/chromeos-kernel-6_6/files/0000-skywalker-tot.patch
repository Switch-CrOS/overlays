diff --git a/arch/arm64/boot/dts/mediatek/mt8196-rauru.dtsi b/arch/arm64/boot/dts/mediatek/mt8196-rauru.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..cd229523685e99256df1d26e1a34b817b27fff2b
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt8196-rauru.dtsi
@@ -0,0 +1,1370 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
