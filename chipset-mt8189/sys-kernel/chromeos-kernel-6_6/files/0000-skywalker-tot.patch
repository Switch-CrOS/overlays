+static const struct hdmi_codec_ops mtk_dp_audio_codec_ops = {
+	.hw_params = mtk_dp_audio_hw_params_v2,
+	.audio_startup = mtk_dp_audio_startup_v2,
+	.audio_shutdown = mtk_dp_audio_shutdown_v2,
+	.get_eld = mtk_dp_audio_get_eld_v2,
