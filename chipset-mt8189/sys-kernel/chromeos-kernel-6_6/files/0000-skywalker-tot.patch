+static void it61620_audio_update_connector_status(struct it61620 *it61620)
+{
+	enum drm_connector_status status;
+
+	status = it61620->connector_status;
+	if (it61620->plugged_cb && it61620->codec_dev)
+		it61620->plugged_cb(it61620->codec_dev,
+				    status == connector_status_connected);
+}
