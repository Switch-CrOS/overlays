+void mtk_dp_hpd_check_sink_event(struct mtk_dp *mtk_dp)
+{
+	u8 dpcd_20x[6];
+	u8 dpcd_2002[2];
+	u8 dpcd_200c[4];
+	//u8 sink_cnt = 0;
+	bool ret;
+	//enum dp_encoder_id encoder_id;
+	memset(dpcd_20x, 0x0, sizeof(dpcd_20x));
+	memset(dpcd_2002, 0x0, sizeof(dpcd_2002));
+	memset(dpcd_200c, 0x0, sizeof(dpcd_200c));
+
+	dev_info(mtk_dp->dev, "[DPTX] %s, %d\n", __func__, __LINE__);
+	if (mtk_dp->training_info.sink_ext_cap_en) {
+		ret = drm_dp_dpcd_read(&mtk_dp->aux, DPCD_02002,
+				       dpcd_2002, 0x2);
+		if (!ret) {
+			dev_info(mtk_dp->dev, "[DPTX] Read DPCD_02002 Fail\n");
+			return;
+		}
+		ret = drm_dp_dpcd_read(&mtk_dp->aux, DPCD_0200C,
+				       dpcd_200c, 0x4);
+		if (!ret) {
+			dev_info(mtk_dp->dev, "[DPTX] Read DPCD_0200C Fail\n");
+			return;
+		}
+	}
+	ret = drm_dp_dpcd_read(&mtk_dp->aux, DPCD_00200, dpcd_20x, 0x6);
+	if (!ret) {
+		dev_info(mtk_dp->dev, "[DPTX] Read DPCD200 Fail\n");
+		return;
+	}
+
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_2002[0] 0x%x\n", dpcd_2002[0]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_2002[1] 0x%x\n", dpcd_2002[1]);
+
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_200c[0] 0x%x\n", dpcd_200c[0]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_200c[1] 0x%x\n", dpcd_200c[1]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_200c[2] 0x%x\n", dpcd_200c[2]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_200c[3] 0x%x\n", dpcd_200c[3]);
+
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_20x[0] 0x%x\n", dpcd_20x[0]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_20x[1] 0x%x\n", dpcd_20x[1]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_20x[2] 0x%x\n", dpcd_20x[2]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_20x[3] 0x%x\n", dpcd_20x[3]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_20x[4] 0x%x\n", dpcd_20x[4]);
+	dev_info(mtk_dp->dev, "[DPTX] dpcd_20x[5] 0x%x\n", dpcd_20x[5]);
+
+	dev_info(mtk_dp->dev, "[DPTX] %s, %d\n", __func__, __LINE__);
+	mtk_dp_check_sink_esi(mtk_dp, DP_ENCODER_ID_0, dpcd_20x, dpcd_2002); /* todo */
+	dev_info(mtk_dp->dev, "[DPTX] %s, %d\n", __func__, __LINE__);
+}
