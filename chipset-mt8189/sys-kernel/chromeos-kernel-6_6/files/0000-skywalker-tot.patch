+	irq_sta = get_mt8196_reg_value(hwv, HWV_IRQ_STATUS);
+	pr_notice("hwv irq: %x\n", irq_sta);
+
+	if ((irq_sta & HWV_INT_TMOUT_TRIGGER) == HWV_INT_TMOUT_TRIGGER)
+		debug_dump(MT8196_CHK_PD_NUM, 0);
+}
