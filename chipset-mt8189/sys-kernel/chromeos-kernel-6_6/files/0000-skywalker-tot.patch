+#ifndef DDP_STR_CONVERT
+#define DDP_STR_CONVERT(p, val, base, action)			\
+do {								\
+	int ret = 0;						\
+	const char *tmp;					\
+	tmp = strsep(p, ",");					\
+	if (tmp == NULL)					\
+		break;						\
+	if (strcmp(#base, "int") == 0)				\
+		ret = kstrtoint(tmp, 0, (int *)val);		\
+	else if (strcmp(#base, "uint") == 0)			\
+		ret = kstrtouint(tmp, 0, (u32 *)val);	\
+	else if (strcmp(#base, "ul") == 0)			\
+		ret = kstrtoul(tmp, 0, (unsigned long *)val);	\
+	if (ret != 0) {						\
+		pr_info("[ERROR] strtoul return error: %d\n"	\
+			"  file : %s, line : %d\n",		\
+			ret, __FILE__, __LINE__);		\
+		action;						\
+	}							\
+} while (0)
+#endif
