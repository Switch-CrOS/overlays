+{
+	mtk_dpi_mask_v2(dpi, dvo_buf_con0, disp_buf_en, disp_buf_en);
+	mtk_dpi_mask_v2(dpi, dvo_buf_con0, fifo_underflow_done_block, fifo_underflow_done_block);
