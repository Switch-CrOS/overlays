+	struct device *dev = it61620->dev;
+
+	if (!it61620->powered)
+		return -ENODEV;
+
+	err = regmap_write(it61620->mipirx_regmap, reg, val);
+
+	if (err < 0) {
+		dev_err(dev, "write failed rx reg[0x%x] = 0x%x err = %d",
+			reg, val, err);
+		return err;
+	}
+
+	return 0;
+}
