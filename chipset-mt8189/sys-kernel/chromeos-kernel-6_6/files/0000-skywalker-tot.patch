+void mtk_dptx_hal_set_color_format(const DPTX_ENCODER_ID encoder_id,
+				   u8 color_format)
+{
+	u32 reg_offset_enc = DP_ENC_REG_OFFSET(encoder_id);
+
+	pr_info("[DPTX][Autotest] %s, color_format:%d", __func__, color_format);
+
+	dptx_write_mask(REG_3034_DP_ENCODER0_P0 + reg_offset_enc,
+			(color_format << 0x1), GENMASK(2, 1));
+
+	if ((color_format == DPTX_COLOR_FORMAT_RGB_444)
+	    || (color_format == DPTX_COLOR_FORMAT_YUV_444))
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc),
+				(0), GENMASK(6, 4));
+
+	else if (color_format == DPTX_COLOR_FORMAT_YUV_422)
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc),
+				(BIT4), GENMASK(6, 4));
+
+	else if (color_format == DPTX_COLOR_FORMAT_YUV_420)
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc),
+				(BIT5), GENMASK(6, 4));
+}
+
+void mtk_dptx_hal_set_color_depth(const DPTX_ENCODER_ID encoder_id,
+				  u8 color_depth)
+{
+	u32 reg_offset_enc = DP_ENC_REG_OFFSET(encoder_id);
+
+	pr_info("[DPTX][Autotest] %s, color_depth:%d", __func__, color_depth);
+
+	dptx_write_mask(REG_3034_DP_ENCODER0_P0 + reg_offset_enc,
+			(color_depth << 0x5), 0xE0);
+
+	switch (color_depth) {
+	case DPTX_COLOR_DEPTH_6BIT:
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc), 4, 0x07);
+		break;
+
+	case DPTX_COLOR_DEPTH_8BIT:
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc), 3, 0x07);
+		break;
+
+	case DPTX_COLOR_DEPTH_10BIT:
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc), 2, 0x07);
+		break;
+
+	case DPTX_COLOR_DEPTH_12BIT:
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc), 1, 0x07);
+		break;
+
+	case DPTX_COLOR_DEPTH_16BIT:
+		dptx_write_mask((REG_303C_DP_ENCODER0_P0 + 1 + reg_offset_enc), 0, 0x07);
+		break;
+
+	default:
+		break;
+	}
+}
