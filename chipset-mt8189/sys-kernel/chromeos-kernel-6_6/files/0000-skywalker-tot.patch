+static void mtk_dpi_config_hsync_v2(struct mtk_dpi *dpi,
+				 struct mtk_dpi_sync_param *sync)
+{
+	if (dpi->conf->hw_type == HW_TYPE_DPINTF) {
+		mtk_dpi_mask_v2(dpi, DPI_TGEN_HWIDTH, sync->sync_width << HPW,
+				dpi->conf->dimension_mask << HPW);
+		mtk_dpi_mask_v2(dpi, DPI_TGEN_HPORCH, sync->back_porch << HBP,
+				dpi->conf->dimension_mask << HBP);
+		mtk_dpi_mask_v2(dpi, DPI_TGEN_HPORCH, sync->front_porch << HFP,
+				dpi->conf->dimension_mask << HFP);
+	} else {
+		mtk_dpi_mask_v2(dpi, dvo_tgen_h0, sync->sync_width << dvo_hsync,
+		     dpi->conf->dimension_mask << dvo_hsync);
+		mtk_dpi_mask_v2(dpi, dvo_tgen_h0, sync->front_porch << dvo_hfp,
+			dpi->conf->dimension_mask << dvo_hfp);
+		mtk_dpi_mask_v2(dpi, dvo_tgen_h1, (sync->back_porch + sync->sync_width) << hsync2act,
+			dpi->conf->dimension_mask << hsync2act);
+	}
+}
+
+static void mtk_dpi_config_vsync_v2(struct mtk_dpi *dpi,
+				 struct mtk_dpi_sync_param *sync,
+				 u32 width_addr, u32 porch_addr)
+{
+	if(dpi->conf->hw_type == HW_TYPE_DPINTF) {
+		mtk_dpi_mask_v2(dpi, width_addr,
+				sync->shift_half_line << VSYNC_HALF_LINE_SHIFT,
+				VSYNC_HALF_LINE_MASK);
+		mtk_dpi_mask_v2(dpi, width_addr,
+				sync->sync_width << VSYNC_WIDTH_SHIFT,
+				dpi->conf->dimension_mask << VSYNC_WIDTH_SHIFT);
+		mtk_dpi_mask_v2(dpi, porch_addr,
+				sync->back_porch << VSYNC_BACK_PORCH_SHIFT,
+				dpi->conf->dimension_mask << VSYNC_BACK_PORCH_SHIFT);
+		mtk_dpi_mask_v2(dpi, porch_addr,
+				sync->front_porch << VSYNC_FRONT_PORCH_SHIFT,
+				dpi->conf->dimension_mask << VSYNC_FRONT_PORCH_SHIFT);
+	} else {
+		mtk_dpi_mask_v2(dpi, width_addr,
+				sync->sync_width << vsync,
+				dpi->conf->dimension_mask << vsync);
+		mtk_dpi_mask_v2(dpi, width_addr,
+				sync->front_porch << vfp,
+				dpi->conf->dimension_mask << vfp);
+		mtk_dpi_mask_v2(dpi, porch_addr,
+				(sync->back_porch + sync->sync_width) << vsync2act,
+				dpi->conf->dimension_mask << vsync2act);
+	}
+}
