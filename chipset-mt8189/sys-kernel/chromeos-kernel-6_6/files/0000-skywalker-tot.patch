diff --git a/drivers/my_driver/my_driver.c b/drivers/my_driver/my_driver.c
new file mode 100644
index 0000000000000000000000000000000000000000..75c993542166781ccfe6e4e682e5239077f6c238
--- /dev/null
+++ b/drivers/my_driver/my_driver.c
@@ -0,0 +1,46 @@
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define DRIVER_NAME "my_driver"
+
+static int my_driver_probe(struct platform_device *pdev)
+{
+    const char *version;
+    struct device_node *np = pdev->dev.of_node;
+
+    if (of_property_read_string(np, "version", &version)) {
+        dev_err(&pdev->dev, "Failed to read version from DT\n");
+        return -EINVAL;
+    }
+
+    dev_info(&pdev->dev, "Driver version: %s\n", version);
+    return 0;
+}
+
+static int my_driver_remove(struct platform_device *pdev)
+{
+    dev_info(&pdev->dev, "Driver removed\n");
+    return 0;
+}
+
+static const struct of_device_id my_driver_of_match[] = {
+    { .compatible = "mycompany,my_driver", },
+    { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, my_driver_of_match);
+
+static struct platform_driver my_driver = {
+    .probe = my_driver_probe,
+    .remove = my_driver_remove,
+    .driver = {
+        .name = DRIVER_NAME,
+        .of_match_table = my_driver_of_match,
+    },
+};
+
+module_platform_driver(my_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Your Name");
+MODULE_DESCRIPTION("A simple platform driver example");
