+static int dts_mux_set(struct typec_mux_dev *mux, struct typec_mux_state *state)
+{
+	struct dts_port_data *data = NULL;
+	struct dp_typec_selector *dts = NULL;
+
+	data = typec_mux_get_drvdata(mux);
+	if (!data)
+		return 0;
+
+	dts = data->mtk_dp->dts;
+
+	if (dts->num_typec_switches == 1)
+		return 0;
+
+	if (data->port_num > dts->num_typec_switches)
+		return 0;
+
+	mutex_lock(&dts->lock);
+
+	data->dp_connected = (state->alt && state->alt->svid == USB_TYPEC_DP_SID &&
+			      state->alt->mode == USB_TYPEC_DP_MODE);
+
+	if (data->dp_connected) {
+		drm_dbg_kms(data->mtk_dp->drm_dev, "[DPTX] mux_set dp_connected: c0=%d, c1=%d\n",
+			    dts->typec_ports[0].dp_connected, dts->typec_ports[1].dp_connected);
+		dts_typec_ports_update(data->mtk_dp);
+	}
+
+	mutex_unlock(&dts->lock);
+
+	return 0;
+}
+
+static int dts_register_mode_switch(struct device *dev, struct device_node *node,
+				    struct mtk_dp *mtk_dp)
+{
+	struct dts_port_data *port_data;
+	struct typec_mux_desc mux_desc = {};
+	char name[32];
+	u32 port_num;
+	int ret;
+
+	ret = of_property_read_u32(node, "reg", &port_num);
+	dev_dbg(dev, "[DPTX] register port_num: %d\n", port_num);
+	if (ret)
+		return ret;
+
+	if (port_num >= mtk_dp->dts->num_typec_switches) {
+		dev_err(dev, "[DPTX] Invalid port number specified: %d\n", port_num);
+		return -EINVAL;
+	}
+
+	port_data = &mtk_dp->dts->typec_ports[port_num];
+	port_data->mtk_dp = mtk_dp;
+	port_data->port_num = port_num;
+	mux_desc.fwnode = &node->fwnode;
+	mux_desc.drvdata = port_data;
+	snprintf(name, sizeof(name), "%s-%u", node->name, port_num);
+	mux_desc.name = name;
+	mux_desc.set = dts_mux_set;
+
+	port_data->typec_mux = typec_mux_register(dev, &mux_desc);
+	if (IS_ERR(port_data->typec_mux)) {
+		ret = PTR_ERR(port_data->typec_mux);
+		dev_err(dev, "[DPTX] Mode switch register for port %d failed: %d\n", port_num, ret);
+	}
+
+	return ret;
+}
+
+static void dts_unregister_typec_switches(struct mtk_dp *mtk_dp)
+{
+	int i;
+
+	for (i = 0; i < mtk_dp->dts->num_typec_switches; i++)
+		typec_mux_unregister(mtk_dp->dts->typec_ports[i].typec_mux);
+}
+
+static int dts_register_typec_switches(struct device *device, struct mtk_dp *mtk_dp)
+{
+	struct device_node *of, *sw;
+	int ret = 0;
+
+	if (!mtk_dp->dts)
+		return -ENODEV;
+
+	of = of_get_child_by_name(device->of_node, "switches");
+	if (!of)
+		return -ENODEV;
+
+	mtk_dp->dts->num_typec_switches = of_get_child_count(of);
+	if (mtk_dp->dts->num_typec_switches <= 0)
+		return -ENODEV;
+
+	mtk_dp->dts->typec_ports = devm_kzalloc(device,
+						mtk_dp->dts->num_typec_switches *
+						sizeof(struct dts_port_data),
+						GFP_KERNEL);
+	if (!mtk_dp->dts->typec_ports)
+		return -ENOMEM;
+
+	/* register for C0 and C1 */
+	for_each_available_child_of_node(of, sw) {
+		if (!of_property_read_bool(sw, "mode-switch"))
+			continue;
+		ret = dts_register_mode_switch(device, sw, mtk_dp);
+		if (ret) {
+			dev_err(device, "[DPTX] Failed to register node switch: %d\n", ret);
+			of_node_put(sw);
+			break;
+		}
+	}
+
+	if (ret)
+		dts_unregister_typec_switches(mtk_dp);
+
+	return ret;
+}
