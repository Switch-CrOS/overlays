+void mtk_dptx_hal_phy_set_lane_pwr(const DPTX_LANE_COUNT lane_count)
+{
+	// ***===power ON flow===***
+	// for 4Lane: -> 0x8 -> 0xC -> 0xE -> 0xF
+	// for 2Lane: -> 0x2 -> 0x3
+	// for 1Lane: -> 0x1
+	int power_indx = lane_count - 1;
+	u8 power_bmp = BIT(power_indx);
+
+	do {
+		power_bmp |= BIT(power_indx);
+		dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_TX_CTL_0,
+				    power_bmp << TX_LN_EN_FLDMASK_POS,
+				TX_LN_EN_FLDMASK);
+		pr_err("[DPTX][Autotest] set lane pwr %x\n", (dptx_phy_read_byte(PHYD_DIG_GLB_OFFSET
+						+ DP_PHY_DIG_TX_CTL_0) &
+					TX_LN_EN_FLDMASK) >> TX_LN_EN_FLDMASK_POS);
+	} while (--power_indx >= 0);
+}
+
+static void mtk_dptx_hal_phy_clear_lane_pwr(void)
+{
+	// ***===power OFF flow===***
+	// for 4Lane: -> 0x7 -> 0x3 -> 0x1 -> 0x0
+	// for 2Lane: -> 0x1 -> 0x0
+	// for 1Lane: -> 0x0
+	//u8 power_bmp; = (1 << lane_count) - 1;
+	u8 power_bmp = (dptx_phy_read_byte(PHYD_DIG_GLB_OFFSET
+							+ DP_PHY_DIG_TX_CTL_0) &
+						TX_LN_EN_FLDMASK) >> TX_LN_EN_FLDMASK_POS;
+
+	do {
+		power_bmp >>= 1;
+		dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_TX_CTL_0,
+				    power_bmp << TX_LN_EN_FLDMASK_POS,
+				TX_LN_EN_FLDMASK);
+		pr_err("[DPTX][Autotest] clear lane pwr %x\n", (dptx_phy_read_byte(PHYD_DIG_GLB_OFFSET
+							+ DP_PHY_DIG_TX_CTL_0) &
+						TX_LN_EN_FLDMASK) >> TX_LN_EN_FLDMASK_POS);
+	} while (power_bmp > 0);
+}
+
+void mtk_dptx_hal_phy_power_on(void)
+{
+	u8 i;
+	u8 phyd_rdy_status;
+
+	dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_0,
+			    0x1 << FORCE_PWR_STATE_EN_FLDMASK_POS, FORCE_PWR_STATE_EN_FLDMASK);
+	dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_0,
+			    0x3 << FORCE_PWR_STATE_VAL_FLDMASK_POS, FORCE_PWR_STATE_VAL_FLDMASK);
+
+	for (i = 0; i < 100; i++) {
+		phyd_rdy_status = dptx_phy_read_byte(PHYD_DIG_GLB_OFFSET +
+							DP_PHY_DIG_GLB_STATUS_02);
+		phyd_rdy_status &= RGS_BIAS_READY_FLDMASK;
+
+		if (phyd_rdy_status == RGS_BIAS_READY_FLDMASK) {
+			pr_err("[DPTX][Autotest] DPTX PHYD power on\n");
+			return;
+		}
+		pr_err("[DPTX][Autotest] Polling BIAS status %x\n", phyd_rdy_status);
+	}
+	pr_err("[DPTX][Autotest] Polling BIAS status fail %x\n", phyd_rdy_status);
+}
+
+static void mtk_dptx_hal_phy_power_down(void)
+{
+	mtk_dptx_hal_phy_clear_lane_pwr();
+
+	dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_0,
+			    0x1 << FORCE_PWR_STATE_EN_FLDMASK_POS, FORCE_PWR_STATE_EN_FLDMASK);
+	// power off TPLL and Lane;
+	dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_0,
+			    0x1 << FORCE_PWR_STATE_VAL_FLDMASK_POS, FORCE_PWR_STATE_VAL_FLDMASK);
+
+	dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_SW_RST, 0, BIT1 | BIT3);
+	dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_SW_RST, BIT1 | BIT3, BIT1 | BIT3);
+
+	pr_err("[DPTX][Autotest] DPTX PHYD power down\n");
+}
+
+static void mtk_dptx_hal_phy_check_ready(const DPTX_LANE_COUNT lane_count)
+{
+	u8 i;
+	u8 phyd_rdy_status;
+	u8 phyd_rdy_bmp = (RGS_BIAS_READY_FLDMASK | RGS_TX_LN0_READY_FLDMASK);
+
+	switch (lane_count) {
+	case DPTX_4LANE:
+		phyd_rdy_bmp |= (RGS_TX_LN3_READY_FLDMASK |
+				RGS_TX_LN2_READY_FLDMASK |
+				RGS_TX_LN1_READY_FLDMASK);
+		break;
+	case DPTX_2LANE:
+		phyd_rdy_bmp |= RGS_TX_LN1_READY_FLDMASK;
+		break;
+	default:
+		break;
+	}
+
+	for (i = 0; i < 100; i++) {
+		phyd_rdy_status = dptx_phy_read_byte(PHYD_DIG_GLB_OFFSET +
+							DP_PHY_DIG_GLB_STATUS_02);
+		phyd_rdy_status &= phyd_rdy_bmp;
+
+		if (phyd_rdy_status == phyd_rdy_bmp) {
+			pr_err("[DPTX][Autotest] Polling tx_ln status pass\n");
+			return;
+		}
+		pr_err("[DPTX][Autotest] Polling tx_ln status %x\n", phyd_rdy_status);
+	}
+	pr_err("[DPTX][Autotest] Polling tx_ln status fail %x\n", phyd_rdy_status);
+}
+
+static void mtk_dptx_hal_phy_reset_swing_pre(void)
+{
+	dptx_phy_write_4mask(PHYD_DIG_LAN0_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_VOLT_SWING_EN_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN0_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_PRE_EMPH_EN_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN1_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_VOLT_SWING_EN_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN1_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_PRE_EMPH_EN_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN2_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_VOLT_SWING_EN_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN2_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_PRE_EMPH_EN_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN3_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_VOLT_SWING_EN_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_EN_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN3_OFFSET + DRIVING_FORCE,
+			     (0x1 << DP_TX_FORCE_PRE_EMPH_EN_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_EN_FLDMASK);
+
+	dptx_phy_write_4mask(PHYD_DIG_LAN0_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN0_OFFSET + DRIVING_FORCE,
+			     (0x0  << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN1_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN1_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN2_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN2_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN3_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+	dptx_phy_write_4mask(PHYD_DIG_LAN3_OFFSET + DRIVING_FORCE,
+			     (0x0 << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+			 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+}
+
+static void mtk_dptx_hal_phy_ssc_enable(const u8 enable, const u8 ssc_delta)
+{
+	if (enable) {
+	#ifdef SSC_DELTA_PATCH
+		// Set SSC disable
+		dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_1,
+				    0x0, TPLL_SSC_EN_FLDMASK);
+		mtk_dptx_hw_ssc_set_param(ssc_delta);
+	#endif
+		// Set SSC enable
+		dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_1,
+				    0x1 << TPLL_SSC_EN_FLDMASK_POS, TPLL_SSC_EN_FLDMASK);
+	} else
+		dptx_phy_write_mask(PHYD_DIG_GLB_OFFSET + DP_PHY_DIG_PLL_CTL_1,
+				    0x0, TPLL_SSC_EN_FLDMASK);
+
+	pr_err("[DPTX][Autotest] Phy SSC enable = %d\n", enable);
+}
+
+void mtk_dptx_hal_phy_training_config(const u8 link_rate,
+				      const u8 lane_count, const u8 ssc_enable)
+{
+	const u8 ssc_delta = mtk_dp->training_info.ssc_delta;
+
+	mtk_dptx_hal_phy_reset_swing_pre();
+	mtk_dptx_hal_phy_ssc_enable(ssc_enable, ssc_delta);
+
+	//step1: phy-d power down
+	mtk_dptx_hal_phy_power_down();
+
+	//step2: phy-d set link rate
+	mtk_dptx_hal_phy_set_link_rate(link_rate);
+	mtk_dptx_hal_phy_power_on();
+
+	//step3: phy-d enable lane
+	mtk_dptx_hal_phy_set_lane_pwr(lane_count);
+
+	mtk_dptx_hal_phy_check_ready(lane_count);
+}
+
+void mtk_dptx_hal_pattern_select(DPTX_PG_TYPE val)
+{
+	pr_info("[DPTX][Autotest] Enter %s", __func__);
+	dptx_write_mask(REG_3440_DP_TRANS_P0, (val << 4), GENMASK(6, 4));
+	dptx_write_mask((REG_3440_DP_TRANS_P0 + 1), (val), GENMASK(2, 0));
+	dptx_write_mask((REG_3440_DP_TRANS_P0 + 1), (val << 4), GENMASK(6, 4));
+	dptx_write_mask(REG_3444_DP_TRANS_P0, (val), GENMASK(2, 0));
+}
+
+void mtk_dptx_hal_program_pattern_enable(u8 enable)
+{
+	pr_info("[DPTX][Autotest] Enter %s, enable:%d", __func__, enable);
+
+	if (enable)
+		dptx_write_mask(REG_3440_DP_TRANS_P0, 0x0F, GENMASK(3, 0));
+	else
+		dptx_write_mask(REG_3440_DP_TRANS_P0, 0, GENMASK(3, 0));
+}
+
+void mtk_dptx_hal_prbs_enable(u8 enable)
+{
+	pr_info("[DPTX][Autotest] Enter %s, enable:%d", __func__, enable);
+
+	if (enable)
+		dptx_write_mask(REG_3444_DP_TRANS_P0, (BIT3), BIT3);
+	else
+		dptx_write_mask(REG_3444_DP_TRANS_P0, (0), BIT3);
+}
+
+void mtk_dptx_hal_compliance_eye_enable(u8 enable)
+{
+	pr_info("[DPTX][Autotest] Enter %s, enable:%d", __func__, enable);
+
+	if (enable)
+		dptx_write_mask(REG_3478_DP_TRANS_P0, (BIT0), BIT0);
+	else
+		dptx_write_mask(REG_3478_DP_TRANS_P0, (0), BIT0);
+}
+
+void mtk_dptx_hal_phy_reset_pattern(void)
+{
+	pr_info("[DPTX][Autotest] Enter %s", __func__);
+	//reset pattern
+	mtk_dptx_hal_phy_set_lane_pwr(mtk_dp->training_info.max_link_lane_count);
+	mtk_dptx_hal_set_lane_count(mtk_dp->training_info.max_link_lane_count);
+	mtk_dptx_hal_program_pattern_enable(FALSE);
+	mtk_dptx_hal_pattern_select(0x00);
+	mtk_dptx_hal_prbs_enable(FALSE);
+	mtk_dptx_hal_compliance_eye_enable(FALSE);
+}
+
+void mtk_dptx_hal_set_program_pattern(u8  val,
+				      u8 *data)
+{
+	pr_info("[DPTX][Autotest] Enter %s", __func__);
+	//16bit RG need *2
+	dptx_write_byte((REG_3448_DP_TRANS_P0 + val * 6 * 2), data[0]);
+	dptx_write_byte((REG_3448_DP_TRANS_P0 + 1 + val * 6 * 2), data[1]);
+	dptx_write_byte((REG_344C_DP_TRANS_P0 + val * 6 * 2), data[2]);
+	dptx_write_byte((REG_344C_DP_TRANS_P0 + 1 + val * 6 * 2), data[3]);
+	dptx_write_byte((REG_3450_DP_TRANS_P0 + val * 6 * 2), data[4]);
+	dptx_write_byte((REG_3450_DP_TRANS_P0 + 1 + val * 6 * 2), 0x00);
+}
+
+u8 mtk_dptx_drv_phy_set_swing_pre(u8 lane_count)
+{
+	u8 swing;
+	u8 emhasis;
+	u8 temp[0x2] = {0};
+	u8 dpcd_buffer[0x4] = {0};
+
+	memset(dpcd_buffer, 0x0, sizeof(dpcd_buffer));
+
+	mtk_dptx_drv_aux_read_access(DPCD_00206, temp, 0x2);
+	mtk_dptx_drv_aux_write_access(DPCD_00103, dpcd_buffer, 0x4);
+
+	pr_info("[DPTX][Autotest] DPCD_206:0x%x, DPCD_103:0x%x", temp[0], dpcd_buffer[0]);
+	pr_info("[DPTX][Autotest] %s, lane_count:%d", __func__, lane_count);
+
+	if (lane_count >= 0x1) {
+		swing = (temp[0x0] & 0x3);
+		emhasis = ((temp[0x0] & 0x0C) >> 2);
+		//Adjust the swing and pre-emphasis
+		mtk_dptx_hal_set_swing_pre(DPTX_LANE0, swing, emhasis);
+		//Adjust the swing and pre-emphasis done, notify Sink Side
+		dpcd_buffer[0x0] = swing | (emhasis << 3);
+
+		//MAX_SWING_REACHED
+		if (swing == DPTX_SWING3)
+			dpcd_buffer[0x0] |= BIT2;
+
+		//MAX_PRE-EMPHASIS_REACHED
+		if (emhasis == DPTX_PREEMPHASIS3)
+			dpcd_buffer[0x0] |= BIT5;
+	}
+
+	if (lane_count >= 0x2) {
+		swing = (temp[0x0] & 0x30) >> 4;
+		emhasis = ((temp[0x0] & 0xC0) >> 6);
+		//Adjust the swing and pre-emphasis
+		mtk_dptx_hal_set_swing_pre(DPTX_LANE1, swing, emhasis);
+		//Adjust the swing and pre-emphasis done,
+		dpcd_buffer[0x1] = swing | (emhasis << 3);
+
+		//MAX_SWING_REACHED
+		if (swing == DPTX_SWING3)
+			dpcd_buffer[0x1] |= BIT2;
+
+		//MAX_PRE-EMPHASIS_REACHED
+		if (emhasis == DPTX_PREEMPHASIS3)
+			dpcd_buffer[0x1] |= BIT5;
+	}
+
+	if (lane_count == 0x4) {
+		swing = (temp[0x1] & 0x3);
+		emhasis = ((temp[0x1] & 0x0C) >> 2);
+
+		//Adjust the swing and pre-emphasis
+		mtk_dptx_hal_set_swing_pre(DPTX_LANE2, swing, emhasis);
+		//Adjust the swing and pre-emphasis done,
+		dpcd_buffer[0x2] = swing | (emhasis << 3);
+
+		//MAX_SWING_REACHED
+		if (swing == DPTX_SWING3)
+			dpcd_buffer[0x2] |= BIT2;
+
+		//MAX_PRE-EMPHASIS_REACHED
+		if (emhasis == DPTX_PREEMPHASIS3)
+			dpcd_buffer[0x2] |= BIT5;
+
+		swing = (temp[0x1] & 0x30) >> 4;
+		emhasis = ((temp[0x1] & 0xC0) >> 6);
+
+		//Adjust the swing and pre-emphasis
+		mtk_dptx_hal_set_swing_pre(DPTX_LANE3, swing, emhasis);
+		//Adjust the swing and pre-emphasis done,
+
+		//MAX_SWING_REACHED
+		dpcd_buffer[0x3] = swing | (emhasis << 3);
+
+		if (swing == DPTX_SWING3)
+			dpcd_buffer[0x3] |= BIT2;
+
+		//MAX_PRE-EMPHASIS_REACHED
+		if (emhasis == DPTX_PREEMPHASIS3)
+			dpcd_buffer[0x3] |= BIT5;
+	}
+
+	mtk_dptx_drv_aux_write_access(DPCD_00103, dpcd_buffer, 0x4);
+
+	return TRUE;
+}
+
+u8 mtk_dptx_drv_phy_set_pattern(u8 pattern_type,
+				u8 test_lane_count)
+{
+	u8 i;
+	u8 PGdata[5] = {0x1F, 0x7C, 0xF0, 0xC1, 0x07};
+
+	pr_info("[DPTX][Autotest] %s, pattern_type:%d, test_lane_count:%d",
+		__func__, pattern_type, test_lane_count);
+
+	mtk_dptx_hal_phy_reset_pattern();
+	mtk_dptx_hal_lane_pn_swap(FALSE);
+
+	switch (pattern_type) {
+	case PATTERN_NONE:
+		//Disable U02 patch code, add interskew for test pattern,
+		//lane1/2/3 select lane0 pipe delay
+		break;
+
+	case PATTERN_D10_2:
+		mtk_dptx_hal_set_training_pattern(BIT4);
+		mtk_dptx_hal_phy_set_lane_pwr(test_lane_count);
+		mtk_dptx_hal_set_lane_count(test_lane_count);
+		break;
+
+	case PATTERN_SYMBOL_ERR:
+		break;
+
+	case PATTERN_PRBS7:
+		mtk_dptx_hal_program_pattern_enable(TRUE);
+		mtk_dptx_hal_prbs_enable(TRUE);
+		mtk_dptx_hal_pattern_select(DPTX_PG_PRBS7);
+		mtk_dptx_hal_lane_pn_swap(FALSE);
+		break;
+
+	case PATTERN_80B:
+		for (i = 0x0; i < 4; i++)
+			mtk_dptx_hal_set_program_pattern(i, PGdata);
+
+		mtk_dptx_hal_program_pattern_enable(TRUE);
+		mtk_dptx_hal_pattern_select(DPTX_PG_80BIT);
+		break;
+
+	case PATTERN_HBR2_COM_EYE:
+		mtk_dptx_hal_compliance_eye_enable(TRUE);
+		break;
+	};
+
+	return TRUE;
+}
+
+bool mtk_dp_phy_auto_test(struct dp_cts_auto_req *mtk_dp_test, u8 ubDPCD_201)
+{
+	u8 dpcd_201 = 0x0;
+	u8 dpcd_218 = 0x0;
+	u8 dpcd_248 = 0x0;
+	u8 dpcd_buf[10] = {0};
+	u8 temp[0x10] = {0};
+	u8 ubTempBuffer[0x10];
+	u8 test_link_rate;   // DPCD_219
+	u8 test_lane_count;  // DPCD_220
+	struct mtk_dp *mtk_dp_tk;
+
+	mtk_dp = mtk_dp_test;
+	mtk_dp_tk = container_of(mtk_dp_test, struct mtk_dp, cts_req);
+
+	pr_notice("[DPTX][Autotest] %s, %d\n", __func__, __LINE__);
+
+	memset(ubTempBuffer, 0x0, sizeof(ubTempBuffer));
+	pr_info("[DPTX][Autotest] [DPTX] PHY_AutoTest Start\n");
+	pr_info("[DPTX][Autotest] [DPTX] DPCD 201 = 0x%x\n", ubDPCD_201);
+	
+
+	if (ubDPCD_201 & BIT(1)) {
+		mtk_dptx_drv_aux_write_access(DPCD_00201, &dpcd_201, 0x1);
+		usleep_range(1000, 2000);
+		mtk_dptx_drv_aux_read_access(DPCD_00218, &dpcd_218, 0x1);
+		pr_notice("[DPTX][Autotest] DPCD 218 = 0x%x\n", dpcd_218);
+
+		switch (dpcd_218 & 0xFF) {
+		case BIT(0):
+			pr_info("[DPTX][Autotest] TEST_LINK_TRAINING Start\n");
+			
+			temp[0x0] = 0x01;
+			mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+			mtk_dptx_drv_aux_read_access(DPCD_00219, &test_link_rate, 0x1);
+			mtk_dptx_drv_aux_read_access(DPCD_00220, &test_lane_count, 0x1);
+			mtk_dp->training_info.dp_tx_auto_test_en = TRUE;
+
+			if (test_link_rate && test_lane_count) {
+				mtk_dp->training_info.link_rate = test_link_rate;
+				mtk_dp->training_info.link_lane_count = test_lane_count;
+
+				temp[0x0] = 0x0;
+				mtk_dptx_drv_aux_write_access(DPCD_00102, temp, 0x1);
+				temp[0x0] = 0x2;
+				mtk_dptx_drv_aux_write_access(DPCD_00600, temp, 0x1);
+				mtk_dptx_hal_fec_enable(FALSE);
+				#if (DP_AUTO_TEST_ENABLE == 0x1)
+				mtk_dp_set_training_start_for_cts(mtk_dp_test);
+				//mtk_dptx_hal_fec_enable(mtk_dp->has_fec);
+				#endif
+				if (drm_dp_sink_supports_fec(mtk_dp_tk->mtk_con[DP_FIRST_CON]->fec_cap))
+					mtk_dptx_hal_fec_enable(true);
+			}
+			break;
+		case BIT(1):
+			pr_info("[DPTX][Autotest] TEST_PATTERN Start\n");
+			break;
+		case BIT(3):
+			pr_info("[DPTX][Autotest] PHY_TEST_PATTERN Start\n");
+			mtk_dptx_drv_aux_read_access(DPCD_00248, &dpcd_248, 0x1);
+			mtk_dptx_drv_aux_read_access(DPCD_00220, &test_lane_count, 0x1);
+			pr_info("[DPTX][Autotest] DPCD 248 = 0x%x", dpcd_248);
+			pr_info("[DPTX][Autotest] test_lane_count = %d", test_lane_count);
+			mtk_dptx_drv_phy_set_swing_pre(test_lane_count);
+
+			switch (dpcd_248 & 0x07) {
+			case PATTERN_NONE:
+				pr_info("[DPTX][Autotest] set  PATTERN_NONE\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_NONE,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				break;
+			case PATTERN_D10_2:
+				pr_info("[DPTX][Autotest] set  PATTERN_D10_2\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_D10_2,
+							     test_lane_count);
+				mdelay(2);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				break;
+			case PATTERN_SYMBOL_ERR:
+				pr_info("[DPTX][Autotest] set  PATTERN_SYMBOL_ERR\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_SYMBOL_ERR,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case PATTERN_PRBS7:
+				pr_info("[DPTX][Autotest] set  PATTERN_PRBS7\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_PRBS7,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case PATTERN_80B:
+				pr_info("[DPTX][Autotest] set  PATTERN_80B\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_80B,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case PATTERN_HBR2_COM_EYE:
+				pr_info("[DPTX][Autotest] set  PATTERN_HBR2_COM_EYE\n");
+				mtk_dptx_drv_phy_set_pattern(PATTERN_HBR2_COM_EYE,
+							     test_lane_count);
+				temp[0x0] = 0x01;
+				mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+				mdelay(1000);
+				mtk_dptx_drv_aux_read_access(DPCD_00210, dpcd_buf, 8);
+				break;
+			case CP2520_PATTERN3:
+				pr_info("[DPTX][Autotest] set  CP2520_PATTERN3\n");
+				mtk_dptx_hal_set_training_pattern(BIT7);
+				mtk_dptx_hal_phy_set_lane_pwr(test_lane_count);
+				mtk_dptx_hal_set_lane_count(test_lane_count);
+				break;
+			default:
+				break;
+			}
+			break;
+		default:
+			temp[0x0] = 0x01;
+			mtk_dptx_drv_aux_write_access(DPCD_00260, temp, 0x1);
+			pr_info("[DPTX][Autotest] DPCD 218 Not support\n");
+			return FALSE;
+		}
+	}
+	return true;
+}
