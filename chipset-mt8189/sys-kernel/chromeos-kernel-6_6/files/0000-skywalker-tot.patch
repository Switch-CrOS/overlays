+static int mtk_dp_dt_parse_pdata_v2(struct mtk_dp *mtk_dp,
+				 struct platform_device *pdev)
+{
+	struct resource regs;
+	struct device *dev = &pdev->dev;
+	int ret = 0;
+	u32 phy_params_int[DP_PHY_REG_COUNT] = {
+		0x20181410, 0x20241e18, 0x00003028,
+		0x10080400, 0x000c0600, 0x00000008
+	};
+	u32 phy_params_dts[DP_PHY_REG_COUNT];
+	u32 max_linkrate;
+	u32 max_lane_count;
+	int encoder_num = 0;
+	u32 phyd_dig_glb_offset = 0;
+	u32 phyd_dig_lan0_offset = 0;
+	u32 phyd_dig_lan1_offset = 0;
+	u32 phyd_dig_lan2_offset = 0;
+	u32 phyd_dig_lan3_offset = 0;
+	u32 phyd_ana_glb_offset = 0;
+	u32 phyd_ana_lan0_offset = 0;
+	u32 phyd_ana_lan1_offset = 0;
+	u32 phyd_ana_lan2_offset = 0;
+	u32 phyd_ana_lan3_offset = 0;
+
+	if (of_address_to_resource(dev->of_node, 0, &regs) != 0)
+		dev_dbg(mtk_dp->dev, "Missing reg[0] in %s node\n",
+			dev->of_node->full_name);
+
+	if (of_address_to_resource(dev->of_node, 1, &regs) != 0)
+		dev_dbg(mtk_dp->dev, "Missing reg[1] in %s node\n",
+			dev->of_node->full_name);
+
+	mtk_dp->regs = of_iomap(dev->of_node, 0);
+	mtk_dp->phyd_regs = of_iomap(dev->of_node, 1);
+	mtk_dp->phy_mux_regs = of_iomap(dev->of_node, 2);
+	mtk_dp->mac_power_regs = of_iomap(dev->of_node, 3);
+
+	ret = of_property_read_u32_array(dev->of_node, "dptx,phy_params",
+					 phy_params_dts, ARRAY_SIZE(phy_params_dts));
+	if (ret) {
+		dev_dbg(mtk_dp->dev, "get phy_params fail, use default val, ret:%d\n", ret);
+		mtk_dp_phy_param_init_v2(mtk_dp,
+					 phy_params_int, ARRAY_SIZE(phy_params_int));
+	} else {
+		mtk_dp_phy_param_init_v2(mtk_dp,
+					 phy_params_dts, ARRAY_SIZE(phy_params_dts));
+	}
+
+	ret = device_property_read_u32(dev, "max-lane-count", &max_lane_count);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read max lane count : %d\n", ret);
+		return ret;
+	}
+	if (max_lane_count < 0 || max_lane_count > 4 || max_lane_count == 3) {
+		dev_err(mtk_dp->dev, "Invalid data lane size: %d\n", max_lane_count);
+		return -EINVAL;
+	}
+	mtk_dp->training_info.max_link_lane_count = max_lane_count;
+	dev_dbg(mtk_dp->dev, "max_lane_count: %d\n", max_lane_count);
+
+	/* example:  max-linkrate-mhz = 2700 == 2.7Gbps*/
+	ret = device_property_read_u32(dev, "max-link-rate", &max_linkrate);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read max linkrate: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->training_info.max_link_rate = max_linkrate;
+	dev_dbg(mtk_dp->dev, "max_linkrate: %d\n", max_linkrate);
+
+	ret = device_property_read_u32(dev, "encoder-num", &encoder_num);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read encoder_num: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->encoder_num = encoder_num;
+	dev_dbg(mtk_dp->dev, "encoder_num: 0x%x\n", encoder_num);
+
+	/* offset */
+	ret = device_property_read_u32(dev, "phyd-dig-glb-offset", &phyd_dig_glb_offset);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read phyd_dig_glb_offset: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->phyd_dig_glb_offset = phyd_dig_glb_offset;
+	dev_dbg(mtk_dp->dev, "phyd_dig_glb_offset: 0x%x\n", phyd_dig_glb_offset);
+
+	ret = device_property_read_u32(dev, "phyd-dig-lan0-offset", &phyd_dig_lan0_offset);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read phyd_dig_lan0_offset: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->phyd_dig_lan0_offset = phyd_dig_lan0_offset;
+	dev_dbg(mtk_dp->dev, "phyd_dig_lan0_offset: 0x%x\n", phyd_dig_lan0_offset);
+
+	ret = device_property_read_u32(dev, "phyd-dig-lan1-offset", &phyd_dig_lan1_offset);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read phyd_dig_lan1_offset: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->phyd_dig_lan1_offset = phyd_dig_lan1_offset;
+	dev_dbg(mtk_dp->dev, "phyd_dig_lan1_offset: 0x%x\n", phyd_dig_lan1_offset);
+
+	ret = device_property_read_u32(dev, "phyd-dig-lan2-offset", &phyd_dig_lan2_offset);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read phyd_dig_lan2_offset: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->phyd_dig_lan2_offset = phyd_dig_lan2_offset;
+	dev_dbg(mtk_dp->dev, "phyd_dig_lan2_offset: 0x%x\n", phyd_dig_lan2_offset);
+
+	ret = device_property_read_u32(dev, "phyd-dig-lan3-offset", &phyd_dig_lan3_offset);
+	if (ret) {
+		dev_err(mtk_dp->dev, "Failed to read phyd_dig_lan3_offset: %d\n", ret);
+		return ret;
+	}
+	mtk_dp->phyd_dig_lan3_offset = phyd_dig_lan3_offset;
+	dev_dbg(mtk_dp->dev, "phyd_dig_lan3_offset: 0x%x\n", phyd_dig_lan3_offset);
+
+	ret = device_property_read_u32(dev, "phyd-ana-glb-offset", &phyd_ana_glb_offset);
+	if (ret)
+		dev_err(mtk_dp->dev, "Failed to read phyd_ana_glb_offset: %d\n", ret);
+
+	mtk_dp->phyd_ana_glb_offset = phyd_ana_glb_offset;
+	dev_dbg(mtk_dp->dev, "phyd_ana_glb_offset: 0x%x\n", phyd_ana_glb_offset);
+
+	ret = device_property_read_u32(dev, "phyd-ana-lan0-offset", &phyd_ana_lan0_offset);
+	if (ret)
+		dev_err(mtk_dp->dev, "Failed to read phyd_ana_lan0_offset: %d\n", ret);
+
+	mtk_dp->phyd_ana_lan0_offset = phyd_ana_lan0_offset;
+	dev_dbg(mtk_dp->dev, "phyd_ana_lan0_offset: 0x%x\n", phyd_ana_lan0_offset);
+
+	ret = device_property_read_u32(dev, "phyd-ana-lan1-offset", &phyd_ana_lan1_offset);
+	if (ret)
+		dev_err(mtk_dp->dev, "Failed to read phyd_ana_lan1_offset: %d\n", ret);
+
+	mtk_dp->phyd_ana_lan1_offset = phyd_ana_lan1_offset;
+	dev_dbg(mtk_dp->dev, "phyd_ana_lan1_offset: 0x%x\n", phyd_ana_lan1_offset);
+
+	ret = device_property_read_u32(dev, "phyd-ana-lan2-offset", &phyd_ana_lan2_offset);
+	if (ret)
+		dev_err(mtk_dp->dev, "Failed to read phyd_ana_lan2_offset: %d\n", ret);
+
+	mtk_dp->phyd_ana_lan2_offset = phyd_ana_lan2_offset;
+	dev_dbg(mtk_dp->dev, "phyd_ana_lan2_offset: 0x%x\n", phyd_ana_lan2_offset);
+
+	ret = device_property_read_u32(dev, "phyd-ana-lan3-offset", &phyd_ana_lan3_offset);
+	if (ret)
+		dev_err(mtk_dp->dev, "Failed to read phyd_ana_lan3_offset: %d\n", ret);
+
+	mtk_dp->phyd_ana_lan3_offset = phyd_ana_lan3_offset;
+	dev_dbg(mtk_dp->dev, "phyd_ana_lan3_offset: 0x%x\n", phyd_ana_lan3_offset);
+
+	return 0;
+}
+
+static void mtk_mt8196_dp_mac_power(struct mtk_dp *mtk_dp)
+{
+	writel((readl(mtk_dp->mac_power_regs) & ~BIT(0)), mtk_dp->mac_power_regs);
+	writel((readl(mtk_dp->mac_power_regs) | BIT(4)), mtk_dp->mac_power_regs);
+
+	writel((readl(mtk_dp->mac_power_regs) | BIT(0)), mtk_dp->mac_power_regs);
+	writel((readl(mtk_dp->mac_power_regs) & ~BIT(4)), mtk_dp->mac_power_regs);
+}
+
+static void mtk_dp_disable_mac_power_v2(struct mtk_dp *mtk_dp)
+{
+	writel((readl(mtk_dp->mac_power_regs) & ~BIT(0)), mtk_dp->mac_power_regs);
+	writel((readl(mtk_dp->mac_power_regs) | BIT(4)), mtk_dp->mac_power_regs);
+}
