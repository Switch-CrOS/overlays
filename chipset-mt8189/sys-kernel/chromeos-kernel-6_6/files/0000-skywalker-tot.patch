+		"SW_REQ 1~4",
+		dvfsrc_read(dvfsrc, DVFSRC_SW_REQ1, 0x0),
+		dvfsrc_read(dvfsrc, DVFSRC_SW_REQ1, 0x4),
+		dvfsrc_read(dvfsrc, DVFSRC_SW_REQ1, 0x8),
+		dvfsrc_read(dvfsrc, DVFSRC_SW_REQ1, 0xC));
+
+	p += snprintf(p, buff_end - p,
+		"%-12s: %08x, %08x, %08x, %08x\n",
