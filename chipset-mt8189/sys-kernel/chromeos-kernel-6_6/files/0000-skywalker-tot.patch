+		if (mtk_subsys_check[i].pd_id == parent_id)
+			print_subsys_reg_mt8196(mtk_subsys_check[i].chk_id);
+	}
+
+	if (pwr_sta)
+		clkchk_debug_dump_mt8196(debug_dump_id, "scpsys_hwv_on", pdchk_bug_on_flag, pdchk_bug_on_flag);
+	else
