+			return false;
+		else
+			return pdchk_ops->get_pd_pwr_status(pd_id);
+	}
+
+	pm = pdchk_ops->get_pd_pwr_msk(pd_id);
+
+	return pwr_hw_is_on(pm->sta_type, pm->pwr_val);
+}
