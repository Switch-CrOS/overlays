+static int it61620_regmap_init(struct i2c_client *client,
+			       struct it61620 *it61620)
+{
+	struct device *dev = it61620->dev;
+
+	it61620->it61620_i2c = client;
+
+	it61620->tx_i2c = devm_i2c_new_dummy_device(dev,
+						    client->adapter,
+						    TX_I2C_ADDRESS);
+	if (IS_ERR(it61620->tx_i2c))
+		return PTR_ERR(it61620->tx_i2c);
+
+	it61620->mipirx_i2c = devm_i2c_new_dummy_device(dev,
+							client->adapter,
+							MIPIRX_I2C_ADDRESS);
+	if (IS_ERR(it61620->mipirx_i2c))
+		return PTR_ERR(it61620->mipirx_i2c);
+
+	it61620->cec_i2c = devm_i2c_new_dummy_device(dev,
+						     client->adapter,
+						     CEC_I2C_ADDRESS);
+	if (IS_ERR(it61620->cec_i2c))
+		return PTR_ERR(it61620->cec_i2c);
+
+	it61620->it61620_regmap = devm_regmap_init_i2c(it61620->it61620_i2c,
+						       &it61620_regmap_config);
+	if (IS_ERR(it61620->it61620_regmap))
+		return PTR_ERR(it61620->it61620_regmap);
+
+	it61620->tx_regmap = devm_regmap_init_i2c(it61620->tx_i2c,
+						  &it61620_tx_regmap_config);
+	if (IS_ERR(it61620->tx_regmap))
+		return PTR_ERR(it61620->tx_regmap);
+
+	it61620->mipirx_regmap = devm_regmap_init_i2c(it61620->mipirx_i2c,
+						      &it61620_mipi_regmap_config);
+	if (IS_ERR(it61620->mipirx_regmap))
+		return PTR_ERR(it61620->mipirx_regmap);
+
+	it61620->cec_regmap = devm_regmap_init_i2c(it61620->cec_i2c,
+						   &it61620_cec_regmap_config);
+	if (IS_ERR(it61620->cec_regmap))
+		return PTR_ERR(it61620->cec_regmap);
+
+	return 0;
+}
