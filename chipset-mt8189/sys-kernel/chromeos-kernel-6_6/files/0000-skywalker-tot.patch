+static void mtk_dvo_get_gs_level(struct mtk_dpi *dpi)
+{
+	struct drm_display_mode *mode = &dpi->mode;
+	enum mtk_dvo_golden_setting_level *gsl = &dpi->gs_level;
+
+	if (mode->hdisplay == 1920 && mode->vdisplay == 1080)
+		*gsl = MTK_DVO_FHD_60FPS_1920;
+	else
+		*gsl = MTK_DVO_8K_30FPS;
+
+	dev_info(dpi->dev, "[DPI] %s gs_level %d\n",
+		__func__, dpi->gs_level);
+}
+
+static void mtk_dvo_golden_setting(struct mtk_dpi *dpi)
+{
+	struct mtk_dvo_gs_info *gs_info = NULL;
+
+	if (dpi->gs_level >= MTK_DVO_GSL_MAX) {
+		dev_info(dpi->dev, "[DPI] %s invalid gs_level %d\n",
+			__func__, dpi->gs_level);
+		return;
+	}
+
+	gs_info = &mtk_dvo_gs[dpi->gs_level];
+
+	dev_info(dpi->dev, "[DPI] %s gs_level %d sodi %d %d\n",
+		__func__, dpi->gs_level,
+		gs_info->st_dvo_buf_sodi_high,
+		gs_info->st_dvo_buf_sodi_low);
+
+	mtk_dpi_mask_v2(dpi, dvo_buf_sodi_hight, gs_info->st_dvo_buf_sodi_high, 0xfffff);
+	mtk_dpi_mask_v2(dpi, dvo_buf_sodi_low, gs_info->st_dvo_buf_sodi_low, 0xfffff);
+}
+
+static void mtk_dvo_shadow_ctrl(struct mtk_dpi *dpi)
+{
+	mtk_dpi_mask_v2(dpi, dvo_shadow_ctrl, 0, bypass_shadow);
+	mtk_dpi_mask_v2(dpi, dvo_shadow_ctrl, force_commit, force_commit);
+}
+
+static int mtk_mt8189_dpi_set_display_mode_v2(struct mtk_dpi *dpi,
+				    struct drm_display_mode *mode)
+{
+	struct mtk_dpi_polarities dpi_pol;
+	struct mtk_dpi_sync_param hsync;
+	struct mtk_dpi_sync_param vsync_lodd = { 0 };
+	struct mtk_dpi_sync_param vsync_leven = { 0 };
+	struct mtk_dpi_sync_param vsync_rodd = { 0 };
+	struct mtk_dpi_sync_param vsync_reven = { 0 };
+	struct videomode vm = { 0 };
+	unsigned long pll_rate;
+	unsigned int clksrc = TCK_26M;
+	u16 hblank;
+	u64 htotal;
+	u64 mode_htotal;
+	int ret = 0;
+
+	dev_info(dpi->dev, "mtk_mt8189_dpi_set_display_mode\n");
+
+	drm_display_mode_to_videomode(mode, &vm);
+	if (dpi->dsc_enable) {
+		hblank = mode->htotal - mode->hdisplay;
+		vm.hactive = ((vm.hactive * 8 + (12 * 8 - 1)) / (12 * 8)) * 4;
+		htotal = hblank + vm.hactive;
+		mode_htotal =  mode->htotal;
+		vm.pixelclock = ((mode->clock * 1000) * htotal) / mode_htotal;
+
+		dev_info(dpi->dev, "DSC compress mode, hactive:%d, pixelclock:%lu\n",
+			 vm.hactive, vm.pixelclock);
+		dpi->color_format = MTK_DPI_COLOR_FORMAT_RGB;
+	} else {
+		vm.pixelclock = mode->clock * 1000;
+	}
+
+	/* let pll_rate can fix the valid range of tvdpll (1G~2GHz) */
+	if (vm.pixelclock < 70000000)
+		clksrc = TVDPLL_D16;
+	else if (vm.pixelclock < 200000000)
+		clksrc = TVDPLL_D8;
+	else
+		clksrc = TVDPLL_D4;
+
+	pll_rate = vm.pixelclock * (1 << clksrc);
+
+	dev_info(dpi->dev, "pixel:%lu, clksrc:%d, pll_rate/4:%lu\n",
+		 vm.pixelclock, clksrc, pll_rate / 16);
+
+	ret = clk_set_rate(dpi->pclk_src[TVDPLL_PLL], pll_rate / 4);
+	if (ret) {
+		dev_info(dpi->dev, "cannot set pclk_src[TVDPLL_PLL]: err=%d\n",
+			 ret);
+	}
+
+	ret = clk_set_parent(dpi->pclk, dpi->pclk_src[clksrc]);
+	if (ret) {
+		dev_info(dpi->dev, "clk_set_parent dp_intf->pclk: err=%d\n",
+			 ret);
+	}
+
+	dev_info(dpi->dev, "pclk_src[TVDPLL_PLL]:%ld\n",
+		 clk_get_rate(dpi->pclk_src[TVDPLL_PLL]));
+	dev_info(dpi->dev, "pclk_src[clksrc]:%ld\n",
+		 clk_get_rate(dpi->pclk_src[clksrc]));
+	dev_info(dpi->dev, "pclk:%ld\n",
+		 clk_get_rate(dpi->pclk));
+	dev_info(dpi->dev, "hf_fmm_ck:%ld\n",
+		 clk_get_rate(dpi->hf_fmm_ck));
+	dev_info(dpi->dev, "hf_fdp_ck:%ld\n",
+		 clk_get_rate(dpi->hf_fdp_ck));
+
+	vm.pixelclock = clk_get_rate(dpi->pixel_clk);
+
+	dev_info(dpi->dev, "[DPI] Got  PLL %lu Hz, pixel clock %lu Hz\n",
+		pll_rate, vm.pixelclock);
+
+	dpi_pol.ck_pol = MTK_DPI_POLARITY_FALLING;
+	dpi_pol.de_pol = MTK_DPI_POLARITY_RISING;
+	dpi_pol.hsync_pol = vm.flags & DISPLAY_FLAGS_HSYNC_HIGH ?
+			    MTK_DPI_POLARITY_FALLING : MTK_DPI_POLARITY_RISING;
+	dpi_pol.vsync_pol = vm.flags & DISPLAY_FLAGS_VSYNC_HIGH ?
+			    MTK_DPI_POLARITY_FALLING : MTK_DPI_POLARITY_RISING;
+
+	/*
+	 * Depending on the IP version, we may output a different amount of
+	 * pixels for each iteration: divide the clock by this number and
+	 * adjust the display porches accordingly.
+	 */
+	hsync.sync_width = ((vm.hsync_len / dpi->conf->pixels_per_iter) == 0) ?
+		1 : (vm.hsync_len / dpi->conf->pixels_per_iter);
+	hsync.back_porch = ((vm.hback_porch / dpi->conf->pixels_per_iter) == 0) ?
+		1 : (vm.hback_porch / dpi->conf->pixels_per_iter);
+	hsync.front_porch = ((vm.hfront_porch / dpi->conf->pixels_per_iter) == 0) ?
+		1 : (vm.hfront_porch / dpi->conf->pixels_per_iter);
+
+	hsync.shift_half_line = false;
+	vsync_lodd.sync_width = vm.vsync_len;
+	vsync_lodd.back_porch = vm.vback_porch;
+	vsync_lodd.front_porch = vm.vfront_porch;
+	vsync_lodd.shift_half_line = false;
+
+	if (vm.flags & DISPLAY_FLAGS_INTERLACED &&
+	    mode->flags & DRM_MODE_FLAG_3D_MASK) {
+		vsync_leven = vsync_lodd;
+		vsync_rodd = vsync_lodd;
+		vsync_reven = vsync_lodd;
+		vsync_leven.shift_half_line = true;
+		vsync_reven.shift_half_line = true;
+	} else if (vm.flags & DISPLAY_FLAGS_INTERLACED &&
+		   !(mode->flags & DRM_MODE_FLAG_3D_MASK)) {
+		vsync_leven = vsync_lodd;
+		vsync_leven.shift_half_line = true;
+	} else if (!(vm.flags & DISPLAY_FLAGS_INTERLACED) &&
+		   mode->flags & DRM_MODE_FLAG_3D_MASK) {
+		vsync_rodd = vsync_lodd;
+	}
+
+	dev_dbg(dpi->dev, "[DPI] vm.hactive %d-\n", vm.hactive);
+	dev_dbg(dpi->dev, "[DPI] vm.vactive %d-\n", vm.vactive);
+	dev_dbg(dpi->dev, "[DPI] vm.vsync_le %d-\n", vm.vsync_len);
+	dev_dbg(dpi->dev, "[DPI] vm.vback_porch %d-\n", vm.vback_porch);
+	dev_dbg(dpi->dev, "[DPI] vm.vfront_porch %d-\n", vm.vfront_porch);
+	dev_dbg(dpi->dev, "[DPI] vm.hback_porch %d-\n", vm.hback_porch);
+	dev_dbg(dpi->dev, "[DPI] vm.hfront_porch %d-\n", vm.hfront_porch);
+	dev_dbg(dpi->dev, "[DPI] vm.pixelclock %ld-\n", vm.pixelclock);
+
+	dev_dbg(dpi->dev, "[DPI] reg18 %x-\n", readl(dpi->regs +0x18));
+	dev_dbg(dpi->dev, "[DPI] reg20 %x-\n", readl(dpi->regs +0x20));
+	dev_dbg(dpi->dev, "[DPI] reg24 %x-\n", readl(dpi->regs +0x24));
+	dev_dbg(dpi->dev, "[DPI] reg28 %x-\n", readl(dpi->regs +0x28));
+	dev_dbg(dpi->dev, "[DPI] reg50 %x-\n", readl(dpi->regs +0x50));
+	dev_dbg(dpi->dev, "[DPI] reg54 %x-\n", readl(dpi->regs +0x54));
+	dev_dbg(dpi->dev, "[DPI] reg58 %x-\n", readl(dpi->regs +0x58));
+	dev_dbg(dpi->dev, "[DPI] reg5C %x-\n", readl(dpi->regs +0x5C));
+
+	mtk_dpi_sw_reset_v2(dpi, true);
+	mtk_dpi_config_pol_v2(dpi, &dpi_pol);
+	mtk_dpi_config_hsync_v2(dpi, &hsync);
+	mtk_dpi_config_vsync_lodd_v2(dpi, &vsync_lodd);
+	mtk_dpi_config_interface_v2(dpi, !!(vm.flags &
+		DISPLAY_FLAGS_INTERLACED));
+	if (vm.flags & DISPLAY_FLAGS_INTERLACED)
+		mtk_dpi_config_fb_size_v2(dpi, vm.hactive, vm.vactive >> 1);
+	else
+		mtk_dpi_config_fb_size_v2(dpi, vm.hactive, vm.vactive);
+
+	mtk_dpi_mask_v2(dpi, dvo_out_hsize, vm.hactive,
+		dvo_hsize_mask);
+
+	mtk_dpi_config_bit_num_v2(dpi, dpi->bit_num);
+
+	mtk_dvo_info_queue_start(dpi);
+	mtk_dvo_buffer_ctrl(dpi);
+	mtk_dvo_trailing_blank_setting(dpi);
+
+	mtk_dvo_get_gs_level(dpi);
+	mtk_dvo_golden_setting(dpi);
+
+	if (dpi->conf->pixels_per_iter)
+		mtk_dvo_shadow_ctrl(dpi);
+
+	mtk_dpi_mask_v2(dpi, dvo_output_set, dpi->conf->out_np_sel << dvo_out_np_sel,
+		dvo_out_np_sel_mask);
+
+	mtk_dpi_sw_reset_v2(dpi, false);
+
+	dev_dbg(dpi->dev, "[DPI] reg18 %x-\n", readl(dpi->regs +0x18));
+	dev_dbg(dpi->dev, "[DPI] reg20 %x-\n", readl(dpi->regs +0x20));
+	dev_dbg(dpi->dev, "[DPI] reg24 %x-\n", readl(dpi->regs +0x24));
+	dev_dbg(dpi->dev, "[DPI] reg28 %x-\n", readl(dpi->regs +0x28));
+	dev_dbg(dpi->dev, "[DPI] reg50 %x-\n", readl(dpi->regs +0x50));
+	dev_dbg(dpi->dev, "[DPI] reg54 %x-\n", readl(dpi->regs +0x54));
+	dev_dbg(dpi->dev, "[DPI] reg58 %x-\n", readl(dpi->regs +0x58));
+	dev_dbg(dpi->dev, "[DPI] reg5C %x-\n", readl(dpi->regs +0x5C));
+
+	return 0;
+}
+
+static u32 *mtk_dpi_bridge_atomic_get_output_bus_fmts_v2(struct drm_bridge *bridge,
+						      struct drm_bridge_state *bridge_state,
+						      struct drm_crtc_state *crtc_state,
+						      struct drm_connector_state *conn_state,
+						      unsigned int *num_output_fmts)
+{
+	struct mtk_dpi *dpi = bridge_to_dpi_v2(bridge);
+	u32 *output_fmts;
+
+	*num_output_fmts = 0;
+
+	if (!dpi->conf->output_fmts) {
+		dev_err(dpi->dev, "output_fmts should not be null\n");
+		return NULL;
+	}
+
+	output_fmts = kcalloc(dpi->conf->num_output_fmts, sizeof(*output_fmts),
+			      GFP_KERNEL);
+	if (!output_fmts)
+		return NULL;
+
+	*num_output_fmts = dpi->conf->num_output_fmts;
+
+	memcpy(output_fmts, dpi->conf->output_fmts,
+	       sizeof(*output_fmts) * dpi->conf->num_output_fmts);
+
+	return output_fmts;
+}
+
+static u32 *mtk_dpi_bridge_atomic_get_input_bus_fmts_v2(struct drm_bridge *bridge,
+						     struct drm_bridge_state *bridge_state,
+						     struct drm_crtc_state *crtc_state,
+						     struct drm_connector_state *conn_state,
+						     u32 output_fmt,
+						     unsigned int *num_input_fmts)
+{
+	u32 *input_fmts;
+
+	*num_input_fmts = 0;
+
+	input_fmts = kcalloc(1, sizeof(*input_fmts),
+			     GFP_KERNEL);
+	if (!input_fmts)
+		return NULL;
+
+	*num_input_fmts = 1;
+	input_fmts[0] = MEDIA_BUS_FMT_RGB888_1X24;
+
+	return input_fmts;
+}
