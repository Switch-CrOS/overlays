+	seq_printf(s, "[%10s: %-21s: %10s, %15s, %15s, %10s, %15s]\n",
+	"clk_domain",
+	"clk_hw_name",
+	"clk_is_on",
+	"clk_is_prepared",
+	"clk_is_enabled",
+	"clk_rate",
+	"clk_parent_name");
+	seq_puts(s, "------------------------------------------------------\n");
+
+	for (; pvdck->ck != NULL; pvdck++)
+		dump_provider_clk(pvdck, s);
