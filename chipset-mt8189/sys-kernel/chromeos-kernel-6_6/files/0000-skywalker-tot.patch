+	int (*slbc_secure_off)(struct slbc_data *d);
+	int (*slbc_register_activate_ops)(struct slbc_ops *ops);
+	int (*slbc_activate_status)(struct slbc_data *d);
+	u32 (*slbc_sram_read)(u32 offset);
