+static void mtk_drm_dbg_set_gamma_enable(u32 gamma_en)
+{
+	struct mtk_drm_dbg_table *table;
+	void __iomem *reg_va;
+	struct drm_color_lut *lut_data = NULL;
+
+	table = mtk_drm_dbg_find_comp("disp_gamma0");
+	if (!table || !table->reg_va)
+		return;
+
+	reg_va = table->reg_va;
+
+	mtk_drm_dbg("set gamma enable 0x%X\n", gamma_en);
+
+	if (gamma_en == 1) {
+		lut_data = &gamma_lut[0];
+	} else if (gamma_en == 2) {
+		mtk_drm_dbg_gen_gamma_lut();
+		lut_data = &gamma_lut1[0];
+	}
+
+	force_gamma_en = gamma_en;
+	force_lut_data = lut_data;
+}
