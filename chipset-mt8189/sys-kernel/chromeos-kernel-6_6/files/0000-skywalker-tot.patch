+	char *c = cmd;
+	char *ign;
+	char *dev_name;
+	struct device *dev;
+
+	// Use strscpy instead of strncpy
+	strscpy(cmd, last_cmd, sizeof(cmd));
+
+	ign = strsep(&c, " ");
+
+	if (ign == NULL)
+		return 0;
+
+	dev_name = strsep(&c, " ");
+
+	if (dev_name == NULL)
+		return 0;
+
+	seq_printf(s, "pm_runtime_resume_and_get(%s): ", dev_name);
+
+	dev = dev_from_name(dev_name);
+	if (dev != NULL) {
+		int r = pm_runtime_resume_and_get(dev);
+
+		seq_printf(s, "%d\n", r);
+	} else {
+		seq_puts(s, "NULL\n");
+	}
+
+	return 0;
+}
