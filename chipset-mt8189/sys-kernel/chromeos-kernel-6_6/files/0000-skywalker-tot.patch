+
+	dump_lvts_controller_register_value(lvts_data);
+
+	lvts_wait_for_all_sensing_point_idle(lvts_data);
+
+	read_device_reg_when_error(lvts_data);
+	dump_lvts_device_register_value(lvts_data);
+}
