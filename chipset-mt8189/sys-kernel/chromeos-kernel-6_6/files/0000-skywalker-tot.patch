+static void mtk_dpi_enable_v2(struct mtk_dpi *dpi)
+{
+	dev_dbg(dpi->dev, "enable dpi");
+	mtk_dpi_mask_v2(dpi, DPI_EN, EN, EN);
+}
+
+static void mtk_dpi_disable_v2(struct mtk_dpi *dpi)
+{
+	mtk_dpi_mask_v2(dpi, DPI_EN, 0, EN);
+}
