+
+	for (i = 0; i < ARRAY_SIZE(pd_pwr_sta); i++) {
+		if (pd_id == pd_pwr_sta[i].pd_id) {
+			val = get_mt8189_reg_value(pd_pwr_sta[i].base, pd_pwr_sta[i].ofs);
+			if ((val & pd_pwr_sta[i].msk) == pd_pwr_sta[i].msk)
+				return 1;
+			else
+				return 0;
+		}
+	}
+
+	return 0;
+}
