+static void dts_typec_ports_update(struct mtk_dp *mtk_dp)
+{
+	if (mtk_dp->dts->typec_ports[0].dp_connected && mtk_dp->dts->typec_ports[1].dp_connected)
+		/* Both ports available, do nothing to retain the current one. */
+		return;
+
+	if (mtk_dp->dts->typec_ports[0].dp_connected)
+		mtk_dp->phy_flip_enable = false;
+	else if (mtk_dp->dts->typec_ports[1].dp_connected)
+		mtk_dp->phy_flip_enable = true;
+
+	complete(&mtk_dp->mux_completion);
+}
