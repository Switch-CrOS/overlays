+static struct mtk_drm_dbg_table *mtk_drm_dbg_find_comp(char *name)
+{
+	struct mtk_drm_dbg_data *data = dbg_data;
+	struct mtk_drm_dbg_table *table = data->table;
+	u32 size = data->size;
+	u32 i;
+
+	for (i = 0; i < size; i++) {
+		if (!strcmp(name, table[i].name))
+			return &table[i];
+	}
+
+	mtk_drm_err("can not find out comp %s\n", name);
+
+	return 0;
+}
+
+static struct mtk_drm_dbg_table *mtk_drm_dbg_find_comp_with_pa(u32 addr)
+{
+	struct mtk_drm_dbg_data *data = dbg_data;
+	struct mtk_drm_dbg_table *table = data->table;
+	u32 size = data->size;
+	u32 i;
+
+	for (i = 0; i < size; i++) {
+		if (table[i].reg_pa == (addr & 0xfffff000))
+			return &table[i];
+	}
+
+	mtk_drm_err("can not find out comp with addr 0x%x\n", addr);
+
+	return 0;
+}
