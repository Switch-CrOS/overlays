+	} else if (link_rate == DP_LINK_RATE_HBR2) {
+		phy_settings_param = mtk_dp->phy_settings_hbr2;
+	}
+
+	for (i = 0; i < 4; i++) {
+		PHY_WRITE_4BYTE(mtk_dp,
+				mtk_dp->data->phyd_dig_lan_offset[i] + DRIVING_PARAM_3,
+				phy_settings_param[0]);
+		PHY_WRITE_4BYTE(mtk_dp,
