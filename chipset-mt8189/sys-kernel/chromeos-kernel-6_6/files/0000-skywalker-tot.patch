+static void init_regbase(void)
+{
+	int i;
+	for (i = 0; i < ARRAY_SIZE(rb) - 1; i++) {
+		if (!rb[i].phys)
+			continue;
+		rb[i].virt = ioremap(rb[i].phys, 0x1000);
+	}
+}
+u32 get_mt8189_reg_value(u32 id, u32 ofs)
+{
+	if (id >= chk_sys_num)
+		return 0;
+	return clk_readl(rb[id].virt + ofs);
+}
