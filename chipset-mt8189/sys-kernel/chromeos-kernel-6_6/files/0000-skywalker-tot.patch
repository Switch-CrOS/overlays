+	for (i = 0; i < PPS_SIZE; i += PPS_BLOCK_SIZE)
+		ret |= anx7625_reg_block_write(ctx, ctx->i2c.rx_p2_client,
+				R_PPS_REG_0 + i, PPS_BLOCK_SIZE,
+				&ctx->pps_table[i]);
