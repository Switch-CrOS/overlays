+/* Register mux notifier for MFG mux */
+static int clk_mt8189_reg_mfg_mux_notifier(struct device *dev, void __iomem *base,
+					   struct clk_hw_onecell_data *clk_data)
+{
+	struct clk_hw *hw;
+	struct mtk_mux_nb *mfg_mux_nb;
+
+	hw = devm_clk_hw_register_mux(dev, "mfg_sel_mfgpll", mfg_sel_mfgpll_parents,
+				      ARRAY_SIZE(mfg_sel_mfgpll_parents),
+				      CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT,
+				      (base + 0x510), 16, 1, 0, &mt8189_clk_lock);
+	if (IS_ERR(hw))
+		return -ENOMEM;
+
+	clk_data->hws[CLK_TOP_MFG_SEL_MFGPLL] = hw;
+	mfg_mux_nb = devm_kzalloc(dev, sizeof(*mfg_mux_nb), GFP_KERNEL);
+	if (!mfg_mux_nb)
+		return -ENOMEM;
+
+	mfg_mux_nb->ops = &clk_mux_ops;
+	mfg_mux_nb->bypass_index = 0; /* Bypass to CLK_TOP_MFG_REF_SEL */
+
+	return devm_mtk_clk_mux_notifier_register(dev, hw->clk, mfg_mux_nb);
+}
