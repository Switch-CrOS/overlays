+static int clk_chk_dev_pm_resume(struct device *dev)
+{
+	if (clkchk_ops == NULL || clkchk_ops->dev_pm_resume == NULL)
+		return 0;
+
+	clkchk_ops->dev_pm_resume();
+
+	return 0;
+}
