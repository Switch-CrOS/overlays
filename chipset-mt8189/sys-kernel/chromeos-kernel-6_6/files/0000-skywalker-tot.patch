+	.mode_set = mtk_dp_encoder_mode_set_v2,
+	.disable = mtk_dp_encoder_disable_v2,
+	.enable = mtk_dp_encoder_enable_v2,
+	.atomic_check = mtk_dp_encoder_atomic_check_v2,
+};
