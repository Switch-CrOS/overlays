+	if (uid == ID_IMG)
+		atomic_inc((atomic_t *) &gid_vld_cnt[GID_IMG_SMT]);
+
+	if (local_cnt == 1) {
+		mutex_lock(&slbc_req_lock);
+		ret = _slbc_ach_scmi(IPI_SLBC_GID_VALID_FROM_AP, uid, gid, NULL);
