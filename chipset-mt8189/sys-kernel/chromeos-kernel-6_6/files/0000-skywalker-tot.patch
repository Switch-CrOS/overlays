+
+	for (i = 0; i < lvts_data->num_tc; i++) {
+		base = GET_BASE_ADDR(i);
+
+		for (j = 0; j < NUM_LVTS_CONTROLLER_REG; j++) {
+			temp = readl(g_lvts_controller_addrs[j] + base);
+			g_lvts_controller_value_e[i][j] = temp;
+		}
+	}
+}
