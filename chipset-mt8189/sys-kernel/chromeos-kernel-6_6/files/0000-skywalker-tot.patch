+static void mtk_drm_dbg_get_gamma_lut(void)
+{
+	struct mtk_drm_dbg_table *table;
+	void __iomem *reg_va;
+	int i;
+	u32 word, lut_base;
+
+	table = mtk_drm_dbg_find_comp("disp_gamma0");
+	if (!table || !table->reg_va)
+		return;
+
+	reg_va = table->reg_va;
+	lut_base = 0x700;
+
+	mtk_drm_dbg("get gamma lut 0x%px\n", reg_va);
+
+	mtk_drm_dbg_dump_comp_reg(table, 0x100, 0x0);
+
+	mtk_drm_dbg_dump_comp_reg(table, 0x800, 0x700);
+
+	for (i = 0; i < MTK_LUT_SIZE; i++) {
+		word = readl(reg_va + (lut_base + i * 4));
+		pr_info("%s lut %03d 0x%08X 0x%08X\n",
+			__func__,
+			i,
+			(lut_base + i * 4),
+			word);
+	}
+}
