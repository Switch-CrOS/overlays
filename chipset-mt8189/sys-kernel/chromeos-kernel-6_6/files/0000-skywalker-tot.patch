+		mtk_dpi_config_vsync_v2(dpi, sync, DPI_TGEN_VWIDTH, DPI_TGEN_VPORCH);
+	else
+		mtk_dpi_config_vsync_v2(dpi, sync, dvo_tgen_v0, dvo_tgen_v1);
+}
