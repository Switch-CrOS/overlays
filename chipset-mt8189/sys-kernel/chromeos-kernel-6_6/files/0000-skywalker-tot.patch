diff --git a/drivers/clk/mediatek/clk-fmeter.h b/drivers/clk/mediatek/clk-fmeter.h
new file mode 100644
index 0000000000000000000000000000000000000000..f288c7642481d0b58dd830427a5adb3890739efa
--- /dev/null
+++ b/drivers/clk/mediatek/clk-fmeter.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (c) 2021 MediaTek Inc.
+ * Author: Owen Chen <owen.chen@mediatek.com>
+ */
+
+#ifndef __CLK_FMETER_H
+#define __CLK_FMETER_H
+
+#define FM_SYS(_id)		((_id & (0xFF00)) >> 8)
+#define FM_ID(_id)		(_id & (0xFF))
+
+enum FMETER_TYPE {
+	FT_NULL,
+	ABIST,
+	CKGEN,
+	ABIST_2,
+	ABIST_CK2,
+	CKGEN_CK2,
+	SUBSYS,
+	VLPCK,
+};
+
+enum FMETER_ID {
+	FID_NULL = -1,
+	FID_DISP_PWM = 0,
