+			"aud-gpio-ap-dmic-on",
+			"aud-gpio-ap-dmic1-off",
+			"aud-gpio-ap-dmic1-on",
+			/*pcm*/
+			"aud-gpio-pcm-off",
+			"aud-gpio-pcm-on";
+	/* i2s */
+	pinctrl-0 = <&aud_gpio_i2sin0_off>;
+	pinctrl-1 = <&aud_gpio_i2sin0_on>;
+	pinctrl-2 = <&aud_gpio_i2sout0_off>;
