+#include "mtk_dp_v2.h"
+
+#define DPTX_ENCODER_NUM 2
+
+#define DP_ENC_REG_OFFSET(a)		((a) * 0xA00)
+
+#define DPTX_PHY_BASE		0
+
+static struct dp_cts_auto_req *mtk_dp;
+
+extern int mtk_dp_set_training_start_for_cts(
+			struct dp_cts_auto_req *mtk_dp_test);
+
+typedef enum {
+	DPTX_ENCODER_ID_0	= 0,
+	//DPTX_ENCODER_ID_1	= 1,
+	DPTX_ENCODER_ID_MAX
+} DPTX_ENCODER_ID;
+
+void mtk_dptx_write(uintptr_t offset, u32 value)
+{
+	if ((offset % 4 != 0) || offset > 0x8000) {
+		pr_err("[DPTX][Autotest] %s, error reg:0x%p, offset:0x%lx, value:0x%x\n",
+		       __func__, mtk_dp->regs, offset, value);
+		return;
+	}
+
+	writel(value, mtk_dp->regs + offset);
+}
+
+u32 mtk_dptx_read(uintptr_t offset)
+{
+	u32 read_val = 0;
+
+	if (offset > 0x8000) {
+		pr_err("[DPTX][Autotest] %s, error reg:0x%p, offset:0x%lx\n",
+		       __func__, mtk_dp->regs, offset);
+		return 0;
+	}
+
+	read_val = readl(mtk_dp->regs + offset - (offset % 4))
+			>> ((offset % 4) * 8);
+
+	return read_val;
+}
+
+void mtk_dptx_mask(uintptr_t addr, u32 value, u32 mask)
+{
+	u32 read_val = mtk_dptx_read(addr);
+
+	read_val = ((read_val & ~mask) | (value & mask));
+	mtk_dptx_write(addr, read_val);
+}
+
+u8 dptx_read_byte(u32 offset)
+{
+	uintptr_t addr = mtk_dp->base + offset;
+	u32 data = 0;
+
+	if (offset > 0x8000) {
+		pr_err("[DPTX][Autotest] %s, error offset 0x%x\n", __func__, offset);
+		return 0;
+	}
+
+	data = mtk_dptx_read((addr - (offset % 4)));
+	return (u8)(data >> ((offset % 4) * 8));
+}
+
+u16 dptx_read_2byte(u32 offset)
+{
+	uintptr_t addr = mtk_dp->base + offset;
+	u32 data = 0;
+
+	data = mtk_dptx_read((addr - (offset % 4)));
+	return (u16)(data >> ((offset % 4) * 8));
+}
+
+u32 dptx_read_4byte(u32 offset)
+{
+	uintptr_t addr = mtk_dp->base + offset;
+	u32 data;
+
+	data = mtk_dptx_read(addr);
+	return data;
+}
+
+//only used for access AUX/TRANS/ENCODER
+void dptx_write_byte(u32 offset, u8 val)
+{
+	uintptr_t addr = mtk_dp->base + offset;
+	u32 mask = 0xff << ((offset % 2) * 8);
+
+	if (offset % 2) {
+		//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x12);
+		mtk_dptx_mask((addr - 1), ((u32)val << 8), mask);
+	} else {
+		//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x11);
+		mtk_dptx_mask(addr, (u32)val, mask);
+	}
+
+	//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x00);
+}
+
+void dptx_write_2byte(u32 offset, u16 val)
+{
+	uintptr_t addr = mtk_dp->base + offset;
+	u32 mask = 0xffff;
+
+	mtk_dptx_mask(addr, val, mask);
+	//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x00);
+}
+
+void dptx_write_4byte(u32 offset, u32 val)
+{
+	uintptr_t addr = mtk_dp->base + offset;
+
+	mtk_dptx_write(addr, val);
+	//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x00);
+}
+
+void dptx_write_mask(u32 offset, u8 val, u8 mask)
+{
+	u8  data;
+
+	data = dptx_read_byte(offset);
+	data = (data & ~(mask)) | (val & mask);
+	dptx_write_byte(offset, data);
+}
+
+void dptx_write_2mask(u32 offset, u16 val, u16 mask)
+{
+	u16 data;
+
+	data = dptx_read_2byte(offset);
+	data = (data & ~(mask)) | (val & mask);
+	dptx_write_2byte(offset, data);
+}
+
+void dptx_write_4mask(u32 offset, u32 val, u32 mask)
+{
+	u32 data;
+
+	data = dptx_read_4byte(offset);
+	data = (data & ~(mask)) | (val & mask);
+	dptx_write_4byte(offset, data);
+}
+
+u32 dptx_dhy_read(u32 offset)
+{
+	u32 read_val = 0;
+
+	if (offset > 0x1500) {
+		pr_err("[DPTX][Autotest] %s, error offset:0x%x\n",
+		       __func__, offset);
+		return 0;
+	}
+
+	read_val = readl(mtk_dp->phyd_regs + offset - (offset % 4))
+			>> ((offset % 4) * 8);
+
+	return read_val;
+}
+
+void dptx_dhy_write(uintptr_t offset, u32 value)
+{
+	if ((offset % 4 != 0) || offset > 0x1500) {
+		pr_err("[DPTX][Autotest] %s, error offset:0x%lx, value:0x%x\n",
+		       __func__, offset, value);
+		return;
+	}
+
+	writel(value, mtk_dp->phyd_regs + offset);
+}
+
+void mtk_dptx_phy_mask(uintptr_t addr, u32 value, u32 mask)
+{
+	u32 read_val = dptx_dhy_read(addr);
+
+	read_val = ((read_val & ~mask) | (value & mask));
+	dptx_dhy_write(addr, read_val);
+}
+
+u8 dptx_phy_read_byte(u32 offset)
+{
+	uintptr_t addr = DPTX_PHY_BASE + offset;
+	u32 data = 0;
+
+	if (offset > 0x8000) {
+		pr_err("[DPTX][Autotest] %s, error offset 0x%x\n", __func__, offset);
+		return 0;
+	}
+
+	data = dptx_dhy_read((addr - (offset % 4)));
+	return (u8)(data >> ((offset % 4) * 8));
+}
+
+u16 dptx_phy_read_2byte(u32 offset)
+{
+	uintptr_t addr = DPTX_PHY_BASE + offset;
+	u32 data = 0;
+
+	data = dptx_dhy_read((addr - (offset % 4)));
+	return (u16)(data >> ((offset % 4) * 8));
+}
+
+u32 dptx_phy_read_4byte(u32 offset)
+{
+	uintptr_t addr = DPTX_PHY_BASE + offset;
+	u32 data;
+
+	data = dptx_dhy_read(addr);
+	return data;
+}
+
+//only used for access AUX/TRANS/ENCODER
+void dptx_phy_write_byte(u32 offset, u8 val)
+{
+	uintptr_t addr = DPTX_PHY_BASE + offset;
+	u32 mask = 0xff << ((offset % 2) * 8);
+
+	if (offset % 2) {
+		//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x12);
+		mtk_dptx_phy_mask((addr - 1), ((u32)val << 8), mask);
+	} else {
+		//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x11);
+		mtk_dptx_phy_mask(addr, (u32)val, mask);
+	}
+
+	//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x00);
+}
+
+void dptx_phy_write_2byte(u32 offset, u16 val)
+{
+	uintptr_t addr = DPTX_PHY_BASE + offset;
+	u32 mask = 0xffff;
+
+	mtk_dptx_mask(addr, val, mask);
+	//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x00);
+}
+
+void dptx_phy_write_4byte(u32 offset, u32 val)
+{
+	uintptr_t addr = DPTX_PHY_BASE + offset;
+
+	dptx_dhy_write(addr, val);
+	//mtk_dptx_write(mtk_dp->base + DP_TX_TOP_APB_WSTRB, 0x00);
+}
+
+void dptx_phy_write_mask(u32 offset, u8 val, u8 mask)
+{
+	u8  data;
+
+	data = dptx_phy_read_byte(offset);
+	data = (data & ~(mask)) | (val & mask);
+	dptx_phy_write_byte(offset, data);
+}
+
+void dptx_phy_write_2mask(u32 offset, u16 val, u16 mask)
+{
+	u16 data;
+
+	data = dptx_phy_read_2byte(offset);
+	data = (data & ~(mask)) | (val & mask);
+	dptx_phy_write_2byte(offset, data);
+}
+
+void dptx_phy_write_4mask(u32 offset, u32 val, u32 mask)
+{
+	u32 data;
+
+	data = dptx_phy_read_4byte(offset);
+	data = (data & ~(mask)) | (val & mask);
+	dptx_phy_write_4byte(offset, data);
+}
