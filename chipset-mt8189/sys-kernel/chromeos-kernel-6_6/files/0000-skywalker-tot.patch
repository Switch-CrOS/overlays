+	slbc_ipi_d.arg1 = d->uid;
+	slbc_ipi_d.arg2 = d->type;
+	slbc_ipi_d.arg3 = d->flag;
+	if (d->type == TP_CACHE) {
+		ret = slbc_scmi_ctrl(&slbc_ipi_d, &rvalue);
+		if (!ret) {
+			d->paddr = (void __iomem *)(long long)rvalue.slbc_resv1;
