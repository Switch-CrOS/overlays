+static int clkdbg_pvdck_is_on(struct provider_clk *pvdck)
+{
+	int val = 0;
+
+	val = clkchk_pvdck_is_on(pvdck);
+	if (val != -1)
+		return val;
+
+	if (!pvdck || !pvdck->pwr_mask)
+		return -1;
+
+	return false;
