+
+	data = ((dptx_read_2byte(REG_364C_AUX_TX_P0) &
+					HPD_STATUS_AUX_TX_P0_FLDMASK) >>
+						HPD_STATUS_AUX_TX_P0_FLDMASK_POS);
+	return data;
