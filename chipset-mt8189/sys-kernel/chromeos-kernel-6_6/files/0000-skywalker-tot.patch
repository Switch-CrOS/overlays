+static void mtk_dptx_hal_fec_enable(u8 enable)
+{
+	if (enable)
+		// [0] : FEC Enable
+		dptx_write_mask(REG_3540_DP_TRANS_P0, BIT(0), BIT(0));
+	else
+		// FEC Disable
+		dptx_write_mask(REG_3540_DP_TRANS_P0, 0, BIT(0));
+}
+
+void mtk_dptx_hal_set_lane_count(const DPTX_LANE_COUNT lane_count)
+{
+	/*4Lane: 2, 2Lane: 1, 1Lane: 0*/
+	const u8 val = (lane_count >> 1);
+	DPTX_ENCODER_ID encoder_id;
+	u32 reg_offset_enc;
+
+	if (val == 0)
+		dptx_write_mask(REG_35F0_DP_TRANS_P0, 0, (BIT(3) | BIT(2)));
+	else if (val < mtk_dp->training_info.max_link_lane_count)
+		dptx_write_mask(REG_35F0_DP_TRANS_P0, BIT(3), (BIT(3) | BIT(2)));
+	else {
+		pr_err("[DPTX][Autotest] Un-expected lane count %d\n", lane_count);
+		return;
+	}
+
+	for (encoder_id = 0; encoder_id < DPTX_ENCODER_ID_MAX; encoder_id++) {
+		reg_offset_enc = DP_ENC_REG_OFFSET(encoder_id);
+
+		dptx_write_mask(REG_3000_DP_ENCODER0_P0 + reg_offset_enc,
+				val << LANE_NUM_DP_ENCODER0_P0_FLDMASK_POS,
+		LANE_NUM_DP_ENCODER0_P0_FLDMASK);
+	}
+
+	dptx_write_mask(REG_34A4_DP_TRANS_P0,
+			val << LANE_NUM_DP_TRANS_P0_FLDMASK_POS,
+		LANE_NUM_DP_TRANS_P0_FLDMASK);
+
+	pr_info("[DPTX][Autotest] set lane count:0x%x", dptx_read_byte(REG_34A4_DP_TRANS_P0));
+}
+
+void mtk_dptx_hal_fec_init_setting(void)
+{
+	dptx_write_4mask(REG_3540_DP_TRANS_P0,
+			 1 << FEC_CLOCK_EN_MODE_DP_TRANS_P0_FLDMASK_POS,
+				FEC_CLOCK_EN_MODE_DP_TRANS_P0_FLDMASK);
+	dptx_write_4mask(REG_3540_DP_TRANS_P0,
+			 2 << FEC_FIFO_UNDER_POINT_DP_TRANS_P0_FLDMASK_POS,
+				FEC_FIFO_UNDER_POINT_DP_TRANS_P0_FLDMASK);
+}
+
+void  mtk_dptx_hal_init_setting(void)
+{
+	DPTX_ENCODER_ID encoder_id;
+	u32 reg_offset_enc;
+
+	dptx_write_byte(REG_342C_DP_TRANS_P0, 0x68);//26M xtal clock
+	mtk_dptx_hal_fec_init_setting();
+
+	for (encoder_id = 0; encoder_id < DPTX_ENCODER_ID_MAX; encoder_id++) {
+		reg_offset_enc = DP_ENC_REG_OFFSET(encoder_id);
+		dptx_write_4mask(REG_31EC_DP_ENCODER0_P0  + reg_offset_enc, BIT4, BIT4);
+		dptx_write_4mask(REG_304C_DP_ENCODER0_P0  + reg_offset_enc, 0, BIT8);
+		dptx_write_4mask(REG_304C_DP_ENCODER0_P0  + reg_offset_enc, BIT3, BIT3);
+	}
+	//31C4[13] : DSC bypass [11]pps bypass
+	dptx_write_2mask(REG_31C4_DP_ENCODER0_P0 + reg_offset_enc,
+			 0,
+			PPS_HW_BYPASS_MASK_DP_ENCODER0_P0_FLDMASK);
+
+	dptx_write_2mask(REG_31C4_DP_ENCODER0_P0 + reg_offset_enc,
+			 0,
+			DSC_BYPASS_EN_DP_ENCODER0_P0_FLDMASK);
+
+	dptx_write_2mask(REG_336C_DP_ENCODER1_P0 + reg_offset_enc,
+			 0,
+			DSC_BYTE_SWAP_DP_ENCODER1_P0_FLDMASK);
+}
+
+void mtk_dptx_hal_lane_pn_swap(u8 enable)
+{
+	pr_info("[DPTX][Autotest] %s, enable:%d", __func__, enable);
+	if (enable) {
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				1 << POST_MISC_PN_SWAP_EN_LANE0_DP_TRANS_P0_FLDMASK_POS,
+				POST_MISC_PN_SWAP_EN_LANE0_DP_TRANS_P0_FLDMASK);
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				1 << POST_MISC_PN_SWAP_EN_LANE1_DP_TRANS_P0_FLDMASK_POS,
+				POST_MISC_PN_SWAP_EN_LANE1_DP_TRANS_P0_FLDMASK);
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				1 << POST_MISC_PN_SWAP_EN_LANE2_DP_TRANS_P0_FLDMASK_POS,
+				POST_MISC_PN_SWAP_EN_LANE2_DP_TRANS_P0_FLDMASK);
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				1 << POST_MISC_PN_SWAP_EN_LANE3_DP_TRANS_P0_FLDMASK_POS,
+				POST_MISC_PN_SWAP_EN_LANE3_DP_TRANS_P0_FLDMASK);
+	} else {
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				0, POST_MISC_PN_SWAP_EN_LANE0_DP_TRANS_P0_FLDMASK);
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				0, POST_MISC_PN_SWAP_EN_LANE1_DP_TRANS_P0_FLDMASK);
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				0, POST_MISC_PN_SWAP_EN_LANE2_DP_TRANS_P0_FLDMASK);
+		dptx_write_mask(REG_3428_DP_TRANS_P0,
+				0, POST_MISC_PN_SWAP_EN_LANE3_DP_TRANS_P0_FLDMASK);
+	}
+}
