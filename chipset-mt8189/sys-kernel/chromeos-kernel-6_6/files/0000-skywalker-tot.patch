+u8 mtk_dptx_hal_set_swing_pre(DPTX_LANE_NUM lane_num,
+			      DPTX_SWING_LEVEL swing_level,
+				 DPTX_PREEMPHASIS_LEVEL pre_emphasis_level)
+{
+	pr_info("[DPTX][Autotest] lane%d, set Swing = %x, Emp =%x\n",
+	       lane_num, swing_level, pre_emphasis_level);
+
+	switch (lane_num) {
+	case DPTX_LANE0:
+		dptx_phy_write_4mask(PHYD_DIG_LAN0_OFFSET + DRIVING_FORCE,
+				     (swing_level << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+		dptx_phy_write_4mask(PHYD_DIG_LAN0_OFFSET + DRIVING_FORCE,
+				     (pre_emphasis_level << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+		break;
+
+	case DPTX_LANE1:
+		dptx_phy_write_4mask(PHYD_DIG_LAN1_OFFSET + DRIVING_FORCE,
+				     (swing_level << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+		dptx_phy_write_4mask(PHYD_DIG_LAN1_OFFSET + DRIVING_FORCE,
+				     (pre_emphasis_level << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+		break;
+
+	case DPTX_LANE2:
+		dptx_phy_write_4mask(PHYD_DIG_LAN2_OFFSET + DRIVING_FORCE,
+				     (swing_level << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+		dptx_phy_write_4mask(PHYD_DIG_LAN2_OFFSET + DRIVING_FORCE,
+				     (pre_emphasis_level << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+		break;
+
+	case DPTX_LANE3:
+		dptx_phy_write_4mask(PHYD_DIG_LAN3_OFFSET + DRIVING_FORCE,
+				     (swing_level << DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_VOLT_SWING_VAL_FLDMASK);
+		dptx_phy_write_4mask(PHYD_DIG_LAN3_OFFSET + DRIVING_FORCE,
+				     (pre_emphasis_level << DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK_POS),
+				 DP_TX_FORCE_PRE_EMPH_VAL_FLDMASK);
+
+		break;
+
+	default:
+		pr_err("[DPTX][Autotest] lane number is error\n");
+		return FALSE;
+	}
+	return TRUE;
+}
