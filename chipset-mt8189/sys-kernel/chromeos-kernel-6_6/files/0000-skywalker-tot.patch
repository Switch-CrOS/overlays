 #include "../pci.h"
 
+#define PCIE_SW_MAC_CTR_1		0x74
+#define BYPASS_SYS_CLK_RDY_RLOCK	BIT(13)
+
 #define PCIE_SETTING_REG		0x80
 #define PCIE_PCI_IDS_1			0x9c
 #define PCI_CLASS(class)		(class << 8)
@@ -85,6 +88,7 @@
 
 #define PCIE_LOW_POWER_CTRL_REG		0x194
 #define PCIE_FORCE_DIS_L0S		BIT(8)
+#define PCIE_FORCE_DIS_L1		BIT(9)
 
 #define PCIE_AXI_IF_CTRL_REG		0x1a8
 #define PCIE_AXI0_SLV_RESP_MASK		BIT(12)
@@ -1449,10 +1453,33 @@ static const struct mtk_gen3_pcie_pdata mtk_pcie_soc_en7581 = {
 	},
 };
 
+static int mtk_pcie_mt8189_pre_init(struct mtk_gen3_pcie *pcie)
+{
+	u32 val;
+
+	/* Bypass SYS_CLK_RDY, just a workaround solution */
+	val = readl_relaxed(pcie->base + PCIE_SW_MAC_CTR_1);
+	val |= BYPASS_SYS_CLK_RDY_RLOCK;
+	writel_relaxed(val, pcie->base + PCIE_SW_MAC_CTR_1);
+
+	/* Disable PCIe L0s and L1 since SPM driver not ready yet */
+	val = readl_relaxed(pcie->base + PCIE_LOW_POWER_CTRL_REG);
+	val |= PCIE_FORCE_DIS_L1 | PCIE_FORCE_DIS_L0S;
+	writel_relaxed(val, pcie->base + PCIE_LOW_POWER_CTRL_REG);
+
+	return 0;
+}
+
+static const struct mtk_gen3_pcie_pdata mtk_pcie_soc_mt8189 = {
+	.power_up = mtk_pcie_power_up,
+	.pre_init = mtk_pcie_mt8189_pre_init,
+};
+
 static const struct of_device_id mtk_pcie_of_match[] = {
 	{ .compatible = "airoha,en7581-pcie", .data = &mtk_pcie_soc_en7581 },
 	{ .compatible = "mediatek,mt8192-pcie", .data = &mtk_pcie_soc_mt8192 },
 	{ .compatible = "mediatek,mt8196-pcie", .data = &mtk_pcie_soc_mt8196 },
+	{ .compatible = "mediatek,mt8189-pcie", .data = &mtk_pcie_soc_mt8189 },
 	{},
 };
 MODULE_DEVICE_TABLE(of, mtk_pcie_of_match);
