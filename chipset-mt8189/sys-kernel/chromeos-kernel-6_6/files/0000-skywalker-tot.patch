+static bool pdchk_is_retry_bug_on(bool reset_cnt)
+{
+	if (pdchk_ops == NULL || pdchk_ops->is_suspend_retry_stop == NULL)
+		return true;
+
+	return pdchk_ops->is_suspend_retry_stop(reset_cnt);
+}
