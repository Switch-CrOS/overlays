 tests/unittests/test_datasource/test_ovf.py | 72 +++++++++++++++++++--
 tests/unittests/test_ds_identify.py         | 15 +++++
 tools/ds-identify                           | 21 ++++++
 4 files changed, 121 insertions(+), 21 deletions(-)

