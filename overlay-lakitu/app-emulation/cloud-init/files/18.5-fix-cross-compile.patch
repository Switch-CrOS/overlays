From 684046ae9ddd8fbe3d719b63d3c1d22a4ec1587c Mon Sep 17 00:00:00 2001
From: Wei Xu <weixugc@google.com>
Date: Tue, 21 Jan 2020 23:08:53 -0800
Subject: [PATCH] Replace pkg-config with PKG_CONFIG to fix cross-compile of
 cloud-init.

---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index ea37efc3..3e790684 100755
--- a/setup.py
+++ b/setup.py
@@ -56,7 +56,7 @@ def pkg_config_read(library, var):
             'systemdsystemgeneratordir': '/lib/systemd/system-generators',
         }
     }
-    cmd = ['pkg-config', '--variable=%s' % var, library]
+    cmd = [os.getenv('PKG_CONFIG', 'pkg-config'), '--variable=%s' % var, library]
     try:
         (path, err) = tiny_p(cmd)
         path = path.strip()
