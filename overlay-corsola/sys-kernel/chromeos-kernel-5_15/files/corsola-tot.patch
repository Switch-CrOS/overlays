+void mt8169_device_enable_and_init(struct lvts_data *lvts_data)
+{
+	unsigned int i;
+
+	for (i = 0; i < lvts_data->num_tc; i++) {
+		lvts_write_device(lvts_data, STOP_COUNTING_V4, i);
+		lvts_write_device(lvts_data, SET_COUNTING_WINDOW_20US2_V4, i);
+		lvts_write_device(lvts_data, SET_COUNTING_WINDOW_20US1_V4, i);
+		lvts_write_device(lvts_data, SET_RG_TSFM_LPDLY_V4, i);
+		lvts_write_device(lvts_data, MT8169_TSBG_DEM_CKSEL_X_TSBG_CHOP_EN, i);
+		lvts_write_device(lvts_data, MT8169_TSV2F_CHOP_CKSEL_AND_TSV2F_EN, i);
+		lvts_write_device(lvts_data, SET_TS_RSV_V4, i);
+		lvts_write_device(lvts_data, MT8169_SET_TS_CHOP, i);
+		lvts_write_device(lvts_data, MT8169_SET_TSV2F_RSV, i);
+	}
+
+	lvts_data->counting_window_us = 20;
+}
+
+
+static void mt8169_efuse_to_cal_data(struct lvts_data *lvts_data)
+{
+	struct sensor_cal_data *cal_data = &lvts_data->cal_data;
+
+	cal_data->golden_temp = GET_CAL_DATA_BITMASK(0, 31, 24);
+	cal_data->count_r[MT8169_TS1_0] = GET_CAL_DATA_BITMASK(1, 31, 8);
+	cal_data->count_r[MT8169_TS1_1] = (GET_CAL_DATA_BITMASK(1, 7, 0) << 16) +
+						GET_CAL_DATA_BITMASK(2, 31, 16);
+	cal_data->count_r[MT8169_TS1_2] = (GET_CAL_DATA_BITMASK(2, 15, 0) << 8) +
+						GET_CAL_DATA_BITMASK(3, 31, 24);
+	cal_data->count_r[MT8169_TS1_3] = GET_CAL_DATA_BITMASK(3, 23, 0);
+
+	cal_data->count_r[MT8169_TS2_0] = (GET_CAL_DATA_BITMASK(4, 7, 0) << 16) +
+						GET_CAL_DATA_BITMASK(5, 31, 16);
+	cal_data->count_r[MT8169_TS2_1] = (GET_CAL_DATA_BITMASK(5, 15, 0) << 8) +
+						GET_CAL_DATA_BITMASK(6, 31, 24);
+
+	cal_data->count_r[MT8169_TS3_0] = GET_CAL_DATA_BITMASK(7, 31, 8);
+	cal_data->count_r[MT8169_TS3_1] = (GET_CAL_DATA_BITMASK(7, 7, 0) << 16) +
+						GET_CAL_DATA_BITMASK(8, 31, 16);
+	cal_data->count_r[MT8169_TS3_2] = (GET_CAL_DATA_BITMASK(8, 15, 0) << 8) +
+						GET_CAL_DATA_BITMASK(9, 31, 24);
+
+	cal_data->count_rc[MT8169_TS1_0] = GET_CAL_DATA_BITMASK(4, 31, 8);
+	cal_data->count_rc[MT8169_TS2_0] = GET_CAL_DATA_BITMASK(6, 23, 0);
+	cal_data->count_rc[MT8169_TS3_0] = GET_CAL_DATA_BITMASK(9, 23, 0);
+}
