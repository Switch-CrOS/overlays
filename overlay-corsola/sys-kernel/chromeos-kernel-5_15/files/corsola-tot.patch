diff --git a/drivers/soc/mediatek/mt8195-mmsys.h b/drivers/soc/mediatek/mt8195-mmsys.h
new file mode 100644
index 0000000000000000000000000000000000000000..486c2e382722cc55f1db39dd9b33121322cd1533
--- /dev/null
