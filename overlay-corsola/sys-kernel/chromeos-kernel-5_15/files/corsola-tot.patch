+static int anx7625_aux_transfer_msg(struct drm_dp_aux *aux,
+				    struct drm_dp_aux_msg *msg)
+{
+	struct anx7625_data *ctx = container_of(aux, struct anx7625_data, aux);
+	struct device *dev = &ctx->client->dev;
+	int ret = 0;
+	int len = msg->size;
+	u8 request = msg->request & ~DP_AUX_I2C_MOT;
+	u8 cmd;
+	u8 *buf = msg->buffer;
+
+	if (len > MAX_DPCD_BUFFER_SIZE) {
+		DRM_DEV_ERROR(dev, "exceed aux buffer len.\n");
+		return -EINVAL;
+	}
+
+	msg->reply = 0;
+
+	if (!len)
+		return len;
+
+	if (request == DP_AUX_NATIVE_WRITE || request == DP_AUX_I2C_WRITE)
+		cmd = ((len - 1) << 4) | AP_AUX_WRITE;
+	else if (request == DP_AUX_NATIVE_READ || request == DP_AUX_I2C_READ)
+		cmd = ((len - 1) << 4) | AP_AUX_READ;
+	else
+		return -EINVAL;
+
+	/* Set command and length */
+	ret = anx7625_reg_write(ctx, ctx->i2c.rx_p0_client,
+				AP_AUX_COMMAND, cmd);
+
+	/* Set aux access address */
+	ret |= anx7625_reg_write(ctx, ctx->i2c.rx_p0_client,
+				 AP_AUX_ADDR_7_0, msg->address & 0xff);
+	ret |= anx7625_reg_write(ctx, ctx->i2c.rx_p0_client,
+				 AP_AUX_ADDR_15_8, (msg->address >> 8) & 0xff);
+	ret |= anx7625_write_and(ctx, ctx->i2c.rx_p0_client,
+				 AP_AUX_ADDR_19_16, 0xf0);
+
+	if (ret < 0) {
+		DRM_DEV_ERROR(dev, "cannot set aux access address.\n");
+		return -EIO;
+	}
+
+	if (request == DP_AUX_NATIVE_WRITE || request == DP_AUX_I2C_WRITE) {
+		/* Set write data */
+		ret = anx7625_reg_block_write(ctx, ctx->i2c.rx_p0_client,
+					AP_AUX_BUFF_START, len, buf);
+		if (ret < 0) {
+			DRM_DEV_ERROR(dev, "write to aux register failed.\n");
+			return ret;
+		}
+	}
+
+	/* Enable aux access */
+	ret = anx7625_write_or(ctx, ctx->i2c.rx_p0_client,
+				AP_AUX_CTRL_STATUS, AP_AUX_CTRL_OP_EN);
+	if (ret < 0) {
+		DRM_DEV_ERROR(dev, "cannot enable aux access.\n");
+		return ret;
+	}
+
+	ret = wait_aux_op_finish(ctx);
+	if (ret < 0) {
+		DRM_DEV_ERROR(dev, "aux IO error: wait aux op finish.\n");
+		return ret;
+	}
+
+	if (request == DP_AUX_NATIVE_READ || request == DP_AUX_I2C_READ) {
+		ret = anx7625_reg_block_read(ctx, ctx->i2c.rx_p0_client,
+				     AP_AUX_BUFF_START, len, buf);
+		if (ret < 0) {
+			DRM_DEV_ERROR(dev, "read to aux register failed.\n");
+			return ret;
+		}
+	}
+
+	return len;
+}
