+static void dump_pwr_status(void)
+{
+	static const char * const pwr_names[] = {
+		[0] = "WPE",
+		[1] = "CONN_ON",
+		[2] = "MFG0",
+		[3] = "MFG1",
+		[4] = "MFG2",
+		[5] = "MFG3",
+		[6] = "CSIRX_TOP",
+		[7] = "MGF5",
