+		pinctrl-17 = <&aud_gpio_tdm_on>;
+		pinctrl-18 = <&aud_gpio_pcm_off>;
+		pinctrl-19 = <&aud_gpio_pcm_on>;
+		status = "disabled";
+	};
+
+	usb_p1_vbus: vbus-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vbus1";
