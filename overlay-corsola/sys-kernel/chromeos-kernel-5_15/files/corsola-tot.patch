+static unsigned int mtk_get_src_freq_mode(struct mtk_base_afe *afe, int rate)
+{
+	switch (rate) {
+	case 8000:
+		return 0x00050000;
+	case 11025:
+		return 0x0006E400;
+	case 12000:
+		return 0x00078000;
+	case 16000:
+		return 0x000A0000;
+	case 22050:
+		return 0x000DC800;
+	case 24000:
+		return 0x000F0000;
+	case 32000:
+		return 0x00140000;
+	case 44100:
+		return 0x001B9000;
+	case 48000:
+		return 0x001E0000;
+	case 88200:
+		return 0x00372000;
+	case 96000:
+		return 0x003C0000;
+	case 176400:
+		return 0x006E4000;
+	case 192000:
+		return 0x00780000;
+	default:
+		dev_info(afe->dev, "%s(), rate %d invalid!!!\n",
+			 __func__, rate);
+		return 0;
+	}
+}
