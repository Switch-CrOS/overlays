+static void setup_provider_clk(struct provider_clk *pvdck)
+{
+	static const struct {
+		const char *pvdname;
+		u32 pwr_sta_group;
+		u32 pwr_mask;
+	} pvd_pwr_mask[] = {
+		{"adspsys", 0, BIT(17)},
+		{"nnasys", 0, BIT(30)},
+		{"usb3_sif", 0, BIT(19)},
+		{"mfgsys", 0, BIT(3)},
+		{"mmsys", 0, BIT(21)},
+		{"wpesys", 0, BIT(0)},
+		{"imgsys1", 0, BIT(13)},
+		{"imgsys2", 0, BIT(14)},
+		{"vdecsys", 0, BIT(16)},
+		{"vencsys", 0, BIT(18)},
+		{"camsys", 0, BIT(23)},
+		{"camsys_rawa", 0, BIT(24)},
+		{"camsys_rawb", 0, BIT(25)},
+		{"ipesys", 0, BIT(15)},
+		{"mdpsys", 0, BIT(21)},
+	};
+
+	size_t i;
+	const char *pvdname = pvdck->provider_name;
+
+	if (pvdname == NULL)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(pvd_pwr_mask); i++) {
+		if (strcmp(pvdname, pvd_pwr_mask[i].pvdname) == 0) {
+			pvdck->pwr_sta_group = pvd_pwr_mask[i].pwr_sta_group;
+			pvdck->pwr_mask = pvd_pwr_mask[i].pwr_mask;
+			return;
+		}
+	}
+}
