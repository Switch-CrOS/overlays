+	cal_data->count_r[MT8169_TS2_0] = (GET_CAL_DATA_BITMASK(4, 7, 0) << 16) +
+						GET_CAL_DATA_BITMASK(5, 31, 16);
+	cal_data->count_r[MT8169_TS2_1] = (GET_CAL_DATA_BITMASK(5, 15, 0) << 8) +
+						GET_CAL_DATA_BITMASK(6, 31, 24);
+
+	cal_data->count_r[MT8169_TS3_0] = GET_CAL_DATA_BITMASK(7, 31, 8);
+	cal_data->count_r[MT8169_TS3_1] = (GET_CAL_DATA_BITMASK(7, 7, 0) << 16) +
+						GET_CAL_DATA_BITMASK(8, 31, 16);
+	cal_data->count_r[MT8169_TS3_2] = (GET_CAL_DATA_BITMASK(8, 15, 0) << 8) +
+						GET_CAL_DATA_BITMASK(9, 31, 24);
+
+	cal_data->count_rc[MT8169_TS1_0] = GET_CAL_DATA_BITMASK(4, 31, 8);
+	cal_data->count_rc[MT8169_TS2_0] = GET_CAL_DATA_BITMASK(6, 23, 0);
