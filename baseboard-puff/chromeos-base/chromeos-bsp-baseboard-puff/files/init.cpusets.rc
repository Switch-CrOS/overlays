# Puff has 0-11 cpus instead of the default 0-3, so it needs custom
# cpus assignment.
on property:sys.boot_completed=1
    copy /dev/cpuset/cpus /dev/cpuset/foreground/cpus
    copy /dev/cpuset/cpus /dev/cpuset/top-app/cpus
