+	usleep_range(500, 1000);
+
+	/* de-assert reset signals*/
+	val &= ~(PCIE_MAC_RSTB_V3 | PCIE_PHY_RSTB_V3 | PCIE_BRG_RSTB_V3);
+	writel(val, port->base + PCIE_RST_CTRL_V3);
