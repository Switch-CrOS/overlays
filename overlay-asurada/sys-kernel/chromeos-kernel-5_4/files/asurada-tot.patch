+
+	ret = regmap_read_poll_timeout(map, sta_ofs,
+			val, !(val & mask),
+			MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+
+	if (ret < 0)
+		pr_err("[NG workaround] scpsys clear_bus_protection val=%x, mask=%x, (val & mask)=%x\n", val, mask, (val & mask));
