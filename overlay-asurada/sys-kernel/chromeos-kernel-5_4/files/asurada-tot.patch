+
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/iopoll.h>
+#include "mtk_mcupm.h"
+
+char* mcupm_device_name[] = {
+	"mcupm-plt-rpmsg",
+	"mcupm-dvfs-rpmsg",
+	"mcupm-fhctl-rpmsg",
+	"mcupm-mcdi-rpmsg",
