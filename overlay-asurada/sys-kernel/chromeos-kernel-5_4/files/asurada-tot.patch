--- /dev/null
+++ b/drivers/soc/mediatek/mtk-dvfsrc-sysfs.c
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2018 MediaTek Inc.
+ */
+
+#include <linux/device.h>
+#include <linux/sysfs.h>
+#include <linux/pm_qos.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_opp.h>
+#include <linux/clk.h>
+#include <linux/interconnect.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/pm_qos.h>
+#include <linux/random.h>
+#include <dt-bindings/power/mt8183-power.h>
+#include <linux/regulator/consumer.h>
+
+#define ICC
+#define REGULATORT
+#define REGULATORT_PMIC
+#define TEST_TIMER 1
+
+struct mtk_dvfsrc_test_perf {
+	struct device *dev;
+	struct hrtimer stress_timer;
+	struct icc_path *path;
+	struct regulator *dvfsrc_vcore_power;
+#ifdef REGULATORT_PMIC
+	struct regulator *pmic_vcore_power;
+#endif
+};
+
+struct mtk_dvfsrc_test_perf *dvfsrc_p;
+
+static void dvfsrc_stress_work(struct work_struct *dummy);
+static DECLARE_WORK(stress_work, dvfsrc_stress_work);
+
+static void dvfsrc_stress_work(struct work_struct *dummy)
+{
+	int ret;
+	u32 i;
+#ifdef ICC
+	u32 bw;
+	/* From excel */
+	u32 emi[] = {1000, 2600, 4000, 5500, 6500, 8000, 10300, 10300};
+	u32 curr[] = {0x00100000, 0x00010000, 0x00001000, 0x00000100,
+		      0x00000020, 0x00000004, 0x00000001, 0x00000001};
+#endif
+	i = get_random_u32();
+	i = i % 4 + 1;
+#ifdef PSTATE
+	dev_err(dvfsrc_p->dev, "dev_pm_genpd_set_performance_state %d.\n", i);
+	ret = dev_pm_genpd_set_performance_state(dvfsrc_p->dev, i);
+	if (ret) {
+		dev_err(dvfsrc_p->dev, "Invalid operating-points in device tree.\n");
+		return;
+	}
+#endif
+#ifdef REGULATORT
+	switch (i) {
+	case 1:
+		ret = 725000;
+		break;
+	case 2:
+		ret = 650000;
+		break;
+	case 3:
+		ret = 600000;
+		break;
+	case 4:
+		ret = 575000;
+		break;
+	default:
+		ret = 725000;
+		return;
+	}
+	regulator_set_voltage(dvfsrc_p->dvfsrc_vcore_power, ret, ret);
+#ifdef REGULATORT_PMIC
+	if (IS_ERR(dvfsrc_p->pmic_vcore_power))
+#endif
+		dev_err(dvfsrc_p->dev, "set vcore %d %d, pmic: %d\n", i % 2,
+			ret, regulator_get_voltage(dvfsrc_p->dvfsrc_vcore_power));
+#ifdef REGULATORT_PMIC
+	else
+		dev_err(dvfsrc_p->dev, "set vcore %d %d, pmic: %d\n", i % 2,
+			ret, regulator_get_voltage(dvfsrc_p->pmic_vcore_power));
+#endif
+#endif
+
+#ifdef ICC
+	i = get_random_u32() % ARRAY_SIZE(emi);
+	bw = emi[i] * 1000;
+	ret = icc_set_bw(dvfsrc_p->path, bw, bw);
+	if (ret) {
+		dev_err(dvfsrc_p->dev, "Interconnect setup failed (%d)\n", ret);
+		return;
+	}
+	dev_err(dvfsrc_p->dev, "set bw %d, CURRENT need to less than %08x\n", bw, curr[i]);
+#endif
+	hrtimer_start(&dvfsrc_p->stress_timer, ktime_set(TEST_TIMER, 0),
+			HRTIMER_MODE_REL);
+}
+
+enum hrtimer_restart stress_timer_func(struct hrtimer *timer)
+{
+	queue_work(system_highpri_wq, &stress_work);
+	return HRTIMER_NORESTART;
+}
+
+static int mtk_dvfsrc_test_perf_probe(struct platform_device *pdev)
+{
+	struct mtk_dvfsrc_test_perf *dvfsrc;
+#ifdef ICC
+	int ret;
+#endif
+	dvfsrc = devm_kzalloc(&pdev->dev, sizeof(*dvfsrc), GFP_KERNEL);
+	if (!dvfsrc)
+		return -ENOMEM;
+
+	dvfsrc->dev = &pdev->dev;
+	dvfsrc_p = dvfsrc;
+
+	dev_pm_domain_attach(dvfsrc->dev, true);
+#ifdef ICC
+	dvfsrc_p->path = of_icc_get(&pdev->dev, "mm-cam");
+	if (IS_ERR(dvfsrc_p->path)) {
+		ret = PTR_ERR(dvfsrc_p->path);
+		dev_warn(&pdev->dev, "of_icc_get failed (%d)\n", ret);
+		return -ENOMEM;
+	}
+
+	ret = icc_set_bw(dvfsrc_p->path, 1000000, 2000000);
+	if (ret) {
+		dev_warn(&pdev->dev, "Interconnect setup failed (%d)\n", ret);
+		return -ENOMEM;
+	}
+#endif
+#ifdef REGULATORT
+	dvfsrc->dvfsrc_vcore_power =
+		regulator_get_optional(&pdev->dev, "rc-vcore");
+	if (IS_ERR(dvfsrc->dvfsrc_vcore_power)) {
+		dev_warn(&pdev->dev, "get dvfsrc_vcore failed = %ld\n",
+			PTR_ERR(dvfsrc->dvfsrc_vcore_power));
+		dvfsrc->dvfsrc_vcore_power = NULL;
+		return -ENOMEM;
+	}
+#ifdef REGULATORT_PMIC
+	dvfsrc->pmic_vcore_power =
+		regulator_get_optional(&pdev->dev, "pmic-vcore");
+	if (IS_ERR(dvfsrc->pmic_vcore_power)) {
+		dev_warn(&pdev->dev, "get dvfsrc_vcore failed = %ld\n",
+			PTR_ERR(dvfsrc->pmic_vcore_power));
+		dvfsrc->pmic_vcore_power = NULL;
+		return -ENOMEM;
+	}
+#endif
+#endif
+	hrtimer_init(&dvfsrc->stress_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	dvfsrc->stress_timer.function = stress_timer_func;
+	hrtimer_start(&dvfsrc->stress_timer, ktime_set(1, 0),
+			HRTIMER_MODE_REL);
+
+	dev_warn(&pdev->dev, "Henry Success mtk_dvfsrc_test_perf_probe\n");
+	return 0;
+}
+
+static int mtk_dvfsrc_test_perf_remove(struct platform_device *pdev)
+{
+	return 0;
+}
+
+static const struct of_device_id mtk_dvfsrc_test_perf_of_match[] = {
+	{
+		.compatible = "mediatek,dvfsrc_test-perf",
+	}, {
+		/* sentinel */
+	},
+};
+
+static struct platform_driver mtk_dvfsrc_test_perf_driver = {
+	.probe	= mtk_dvfsrc_test_perf_probe,
+	.remove	= mtk_dvfsrc_test_perf_remove,
+	.driver = {
+		.name = "mtk-dvfsrc_test-perf",
+		.of_match_table = of_match_ptr(mtk_dvfsrc_test_perf_of_match),
+	},
+};
+
+module_platform_driver(mtk_dvfsrc_test_perf_driver);
