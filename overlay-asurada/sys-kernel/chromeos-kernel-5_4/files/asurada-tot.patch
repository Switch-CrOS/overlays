+static int mtk_pcie_device_link_add(struct device *dev)
+{
+	struct device_node *supplier_node;
+	struct platform_device *supplier_pdev;
+	struct device_link *link;
+	unsigned int dl_flags = 0;
+
+	supplier_node = of_find_compatible_node(NULL, NULL, "ti,syscon-reset");
+	if (!supplier_node) {
+		pr_err("find node failed!\n");
+	}
+
+	supplier_pdev = of_find_device_by_node(supplier_node);
+	if (!supplier_pdev) {
+		pr_err("find parent node failed!\n");
+	}
+
+	dl_flags = DL_FLAG_AUTOPROBE_CONSUMER;
+	link = device_link_add(dev, &supplier_pdev->dev, dl_flags);
+	if (!link) {
+		pr_err("device link add fail.probe fail\n");
+		return -1;
+	}
+	if (link->status == DL_STATE_DORMANT) {
+		return -EPROBE_DEFER;
+	}
+
+	return 0;
+}
