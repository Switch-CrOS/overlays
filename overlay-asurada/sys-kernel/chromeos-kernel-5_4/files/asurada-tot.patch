+		u32 pwr_mask;
+	} pvd_pwr_mask[] = {
+		{"scp_adsp", BIT(22)},
+		{"audsys", BIT(21)},
+		{"msdc_top", BIT(30)},
+		{"msdc", BIT(30)},
+		{"mfgcfg", BIT(2)},
+		{"mmsys", BIT(20)},
+		{"imgsys", BIT(12)},
+		{"imgsys2", BIT(13)},
+		{"vdecsys_soc", BIT(15)},
+		{"vdecsys", BIT(16)},
+		{"vencsys", BIT(17)},
+#if 0 // other_pwr_status
+		{"apu_conn", BIT(5)},
+		{"apu_vcore", BIT(5)},
+		{"apu0", BIT(5)},
+		{"apu1", BIT(5)},
+		{"apu_mdla0", BIT(5)},
+#endif
+		{"camsys", BIT(23)},
+		{"camsys_rawa", BIT(24)},
+		{"camsys_rawb", BIT(25)},
+		{"camsys_rawc", BIT(26)},
+		{"ipesys", BIT(14)},
+		{"mdpsys", BIT(19)},
+	};
+
+	size_t i;
+	const char *pvdname = pvdck->provider_name;
+
+	if (pvdname == NULL)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(pvd_pwr_mask); i++) {
+		if (strcmp(pvdname, pvd_pwr_mask[i].pvdname) == 0) {
+			pvdck->pwr_mask = pvd_pwr_mask[i].pwr_mask;
+			return;
+		}
+	}
