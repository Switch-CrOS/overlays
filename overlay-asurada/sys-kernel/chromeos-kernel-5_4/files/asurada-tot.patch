diff --git a/drivers/cpufreq/mediatek-mcupm-cpufreq.c b/drivers/cpufreq/mediatek-mcupm-cpufreq.c
new file mode 100755
index 0000000000000000000000000000000000000000..5048c52c8bf7c7e4462c74bb208a40ea38b6ae23
--- /dev/null
+++ b/drivers/cpufreq/mediatek-mcupm-cpufreq.c
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * mediatek-mcupm-cpufreq.c - MCUPM based CPUFreq Driver
+ *
+ * Copyright (c) 2020 MediaTek Inc.
+ * Wei-Chia Su <Wei-Chia.Su@mediatek.com>
+ */
+
+#include <linux/cpufreq.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/of_device.h>
+#include <linux/pm_opp.h>
+#include <linux/rpmsg.h>
+#include "../remoteproc/mtk_mcupm.h"
+
+unsigned int target_index_addr = 0;
+
+// global rpmsg endpoint variable
+struct rpmsg_endpoint *cpufreq_ept;
+
+enum cpu_dvfs_ipi_type {
+	IPI_DVFS_INIT,
+	NR_DVFS_IPI,
+};
+
+/* MCUPM IPI define */
+struct cdvfs_data {
+	unsigned int cmd;
+	union {
+		struct {
+			unsigned int arg[3];
+		} set_fv;
+	} u;
+};
+
+struct mtk_cpu_dvfs_info {
+	struct cpumask cpus;
+	struct device *cpu_dev;
+	struct list_head list_head;
+	struct mutex lock;
+	void __iomem *csram_base;
+};
+
+static LIST_HEAD(dvfs_info_list);
+
+static struct mtk_cpu_dvfs_info *mtk_cpu_dvfs_info_lookup(int cpu)
+{
+	struct mtk_cpu_dvfs_info *info;
+	struct list_head *list;
+
+	list_for_each(list, &dvfs_info_list) {
+		info = list_entry(list, struct mtk_cpu_dvfs_info, list_head);
+		if (cpumask_test_cpu(cpu, &info->cpus))
+			return info;
+	}
+	return NULL;
+}
+
+static int mtk_cpufreq_set_target(struct cpufreq_policy *policy,
+				  unsigned int index)
+{
+	struct mtk_cpu_dvfs_info *info = policy->driver_data;
+	unsigned int cluster_id = policy->cpu / 4;
+
+	writel_relaxed(index, info->csram_base + (target_index_addr + (cluster_id * 4))
+		       );
+	arch_set_freq_scale(policy->related_cpus,
+			    policy->freq_table[index].frequency,
+			    policy->cpuinfo.max_freq);
+
+	return 0;
+}
+
+static int mtk_cpu_dvfs_info_init(struct mtk_cpu_dvfs_info *info, int cpu)
+{
+	struct device *cpu_dev;
+	int ret;
+
+	cpu_dev = get_cpu_device(cpu);
+	if (!cpu_dev)
+		return -ENODEV;
+
+	/* Get OPP-sharing information from "operating-points-v2" bindings */
+	ret = dev_pm_opp_of_get_sharing_cpus(cpu_dev, &info->cpus);
+	if (ret)
+		goto out_free_resources;
+
+	ret = dev_pm_opp_of_cpumask_add_table(&info->cpus);
+	if (ret)
+		goto out_free_resources;
+
+	info->cpu_dev = cpu_dev;
+	mutex_init(&info->lock);
+
+	return 0;
+
+out_free_resources:
+
+	return ret;
+}
+
+static void mtk_cpu_dvfs_info_release(struct mtk_cpu_dvfs_info *info)
+{
+	dev_pm_opp_of_cpumask_remove_table(&info->cpus);
+}
+
+static int mtk_cpufreq_init(struct cpufreq_policy *policy)
+{
+	struct mtk_cpu_dvfs_info *info;
+	struct cpufreq_frequency_table *freq_table;
+	int ret;
+
+	info = mtk_cpu_dvfs_info_lookup(policy->cpu);
+	if (!info)
+		return -EINVAL;
+
+	ret = dev_pm_opp_init_cpufreq_table(info->cpu_dev, &freq_table);
+	if (ret)
+		return ret;
+
+	cpumask_copy(policy->cpus, &info->cpus);
+	policy->driver_data = info;
+	policy->freq_table = freq_table;
+	policy->transition_delay_us = 1000; /* us */
+	dev_pm_opp_of_register_em(policy->cpus);
+
+	return 0;
+}
+
+static int mtk_cpufreq_exit(struct cpufreq_policy *policy)
+{
+	struct mtk_cpu_dvfs_info *info = policy->driver_data;
+
+	dev_pm_opp_free_cpufreq_table(info->cpu_dev, &policy->freq_table);
+
+	return 0;
+}
+
+static struct cpufreq_driver mtk_cpufreq_driver = {
+	.flags = CPUFREQ_STICKY | CPUFREQ_NEED_INITIAL_FREQ_CHECK |
+		 CPUFREQ_HAVE_GOVERNOR_PER_POLICY,
+	.verify = cpufreq_generic_frequency_table_verify,
+	.target_index = mtk_cpufreq_set_target,
+	.init = mtk_cpufreq_init,
+	.exit = mtk_cpufreq_exit,
+	.name = "mtk-cpufreq",
+	.attr = cpufreq_generic_attr,
+};
+
+int andrew_rpmsg_done = 0;
+static int mtk_cpufreq_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct mtk_cpu_dvfs_info *info;
+	struct cdvfs_data cdvfs_d;
+	struct list_head *list, *tmp;
+	unsigned int val;
+	int cpu, ret;
+
+	if (!of_property_read_u32(np, "TARGET_INDEX_ADDR", &val)) {
+		target_index_addr = val;
+		dev_err(&pdev->dev, "TARGET_INDEX_ADDR=0x%x\n", __func__, __LINE__, target_index_addr);
+	} else {
+		dev_err(&pdev->dev, "TARGET_INDEX_ADDR fail\n", __func__, __LINE__);
+		return -EINVAL;
+	}
+
+	if(andrew_rpmsg_done == 0){
+		pr_emerg("%s[%d], mediatek,mcupm-dvfsp probe defer\n", __func__, __LINE__);
+		return -EPROBE_DEFER;
+	}
+	cdvfs_d.cmd = IPI_DVFS_INIT;
+	cdvfs_d.u.set_fv.arg[0] = 1;
+	ret = rpmsg_send(cpufreq_ept, &cdvfs_d, sizeof(struct cdvfs_data));
+	if(ret) {
+		dev_err(&pdev->dev, "rpmsg_send failed: %d\n", ret);
+		return ret;
+	}
+
+	for_each_possible_cpu(cpu) {
+		info = mtk_cpu_dvfs_info_lookup(cpu);
+		if (info)
+			continue;
+
+		info = devm_kzalloc(&pdev->dev, sizeof(*info), GFP_KERNEL);
+		if (!info) {
+			ret = -ENOMEM;
+			goto release_dvfs_info_list;
+		}
+
+		info->csram_base = of_iomap(pdev->dev.of_node, 0);
+		if (!info->csram_base) {
+			ret = -ENOMEM;
+			goto release_dvfs_info_list;
+		}
+
+		ret = mtk_cpu_dvfs_info_init(info, cpu);
+		if (ret)
+			goto release_dvfs_info_list;
+
+		list_add(&info->list_head, &dvfs_info_list);
+	}
+
+	ret = cpufreq_register_driver(&mtk_cpufreq_driver);
+	if (ret)
+		goto release_dvfs_info_list;
+
+	return 0;
+
+release_dvfs_info_list:
+	list_for_each_safe(list, tmp, &dvfs_info_list) {
+		info = list_entry(list, struct mtk_cpu_dvfs_info, list_head);
+		mtk_cpu_dvfs_info_release(info);
+		list_del(list);
+	}
+
+	return ret;
+}
+
+/* List of machines supported by this driver */
+static const struct of_device_id mtk_cpufreq_machines[] = {
+	{ .compatible = "mediatek,mcupm-dvfsp", },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, mtk_cpufreq_machines);
+
+static struct platform_driver mtk_cpufreq_platdrv = {
+	.probe		= mtk_cpufreq_probe,
+	.driver = {
+		.name	= "dvfsp",
+		.of_match_table = of_match_ptr(mtk_cpufreq_machines),
+	},
+};
+module_platform_driver(mtk_cpufreq_platdrv);
+
+
+
+struct mtk_rpmsg_rproc_subdev {
+	struct platform_device *pdev;
+	struct mtk_rpmsg_info *info;
+	struct rpmsg_endpoint *ns_ept;
+	struct rproc_subdev subdev;
+
+	struct work_struct register_work;
+	struct list_head channels;
+	struct mutex channels_lock;
+};
+#define to_mtk_subdev(d) container_of(d, struct mtk_rpmsg_rproc_subdev, subdev)
+
+int mtk_rpmsg_create_device(struct mtk_rpmsg_rproc_subdev *mtk_subdev,
+				   char *name, u32 addr);
+
+/* mtk_rpmsg need empty callback */
+static int cpufreq_mcupm_platform_rpmsg_callback(struct rpmsg_device *rpdev, void *data,
+				  int len, void *priv, u32 src)
+{
+	return 0;
+}
+
+static struct rpmsg_endpoint *
+cpufreq_mcupm_platform_rpmsg_create_ept(struct rpmsg_device *rpdev)
+{
+	struct rpmsg_channel_info chinfo = {};
+
+	strscpy(chinfo.name, rpdev->id.name, RPMSG_NAME_SIZE);
+	chinfo.src = rpdev->src;
+	chinfo.dst = RPMSG_ADDR_ANY;
+	pr_info("%s ept name(%s) (%d)\n", __func__, chinfo.name, rpdev->src);
+
+	return rpmsg_create_ept(rpdev, cpufreq_mcupm_platform_rpmsg_callback, NULL, chinfo);
+}
+
+static int cpufreq_mcupm_plt_rpmsg_probe(struct rpmsg_device *rpdev)
+{
+	struct rpmsg_endpoint *plt_ept;
+
+	pr_info("%s probe\n", __func__);
+
+	plt_ept = cpufreq_mcupm_platform_rpmsg_create_ept(rpdev);
+	if (!plt_ept) {
+		return -ENOMEM;
+	}
+	cpufreq_ept = plt_ept;
+
+andrew_rpmsg_done = 1;
+
+	return 0;
+}
+
+static void cpufreq_mcupm_plt_rpmsg_remove(struct rpmsg_device *rpdev)
+{
+	pr_info("%s remove\n", __func__);
+	return;
+}
+
+static const struct rpmsg_device_id cpufreq_mcupm_plt_rpmsg_match[] = {
+	{ "mcupm-dvfs-rpmsg" },
+	{}
+};
+
+static struct rpmsg_driver cpufreq_mcupm_plt_driver_rpmsg = {
+	.drv = {
+		.name   = "mcupm-dvfs-rpmsg",
+	},
+	.probe		= cpufreq_mcupm_plt_rpmsg_probe,
+	.remove		= cpufreq_mcupm_plt_rpmsg_remove,
+	.id_table   = cpufreq_mcupm_plt_rpmsg_match,
+};
+
+module_rpmsg_driver(cpufreq_mcupm_plt_driver_rpmsg);
+
+static int cpufreq_mcupm_device_probe(struct platform_device *pdev)
+{
+	int ret;
+	phandle phandle;
+	struct device *dev = &pdev->dev;
+	struct rproc *rproc;
+	struct rproc_subdev *subdev;
+	struct mtk_rpmsg_rproc_subdev *mtk_subdev;
+
+	ret = of_property_read_u32(dev->of_node, "mediatek,rproc", &phandle);
+	if (ret) {
+		dev_err(dev, "DT missing \"mediatek,rproc\" property\n");
+		return -EINVAL;
+	}
+
+	rproc = rproc_get_by_phandle(phandle);
+	if (!rproc) {
+		dev_err(dev, "rproc is empty\n");
+		//Consider build time error and makesure mtk_mcupm was create before this driver
+		return -EINVAL;
+	}
+
+	subdev = list_first_entry_or_null(&rproc->subdevs, struct rproc_subdev, node);
+	mtk_subdev = to_mtk_subdev(subdev);
+	ret = mtk_rpmsg_create_device((void *)mtk_subdev, "mcupm-dvfs-rpmsg", MCUPM_IPI_CPU_DVFS);
+	if(ret) {
+		pr_info("unable to create rpmsg deivce mcupm-dvfs-rpmsg ret=%d\n", ret);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id cpufreq_mcupm_of_match[] = {
+	{ .compatible = "mediatek,cpufreq-mcupm-platform", },
+	{},
+};
+
+static struct platform_driver mtk_cpufreq_mcupm_driver = {
+	.probe = cpufreq_mcupm_device_probe,
+	.remove = NULL,
+	.driver = {
+		.name = "cpufreq-mcupm-platform",
+		.owner = THIS_MODULE,
+		.of_match_table = cpufreq_mcupm_of_match,
+	},
+};
+
+static int __init cpufreq_mcupm_module_init(void)
+{
+	return platform_driver_register(&mtk_cpufreq_mcupm_driver);
+}
+late_initcall(cpufreq_mcupm_module_init);
+
+
+MODULE_AUTHOR("Wei-Chia Su <Wei-Chia.Su@mediatek.com>");
+MODULE_DESCRIPTION("Medaitek MCUPM CPUFreq Platform driver");
+MODULE_LICENSE("GPL v2");
