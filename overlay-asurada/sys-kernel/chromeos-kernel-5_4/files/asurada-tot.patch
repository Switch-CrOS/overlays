+	u32 other_pwr_sta;
+	const char *st;
+
+	scpsys_base = ioremap(0x10006000, PAGE_SIZE);
+	other_pwr_sta = clk_readl(scpsys_base + 0x178);
+
+	seq_printf(s, "OTHER_PWR_STATUS: 0x%08x\n", other_pwr_sta);
+
+	st = (other_pwr_sta & BIT(5)) != 0U ? "ON" : "off";
+
+	seq_printf(s, "[%2d]: %3s: %s\n", 5, st, "VPU");
