+				      unsigned int devfn, int where)
+{
+	struct mtk_pcie_port *port;
+
+	port = mtk_pcie_find_port(bus, devfn);
+	if (!port)
+		return NULL;
+
+	writel(CFG_HEADER(devfn, bus->number), port->base + PCIE_CFGNUM);
+
+	return port->base + CFG_OFFSET_ADDR + where;
+}
