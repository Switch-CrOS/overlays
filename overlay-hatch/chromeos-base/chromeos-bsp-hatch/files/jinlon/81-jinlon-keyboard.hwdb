# Special keyboard mapping for the Jinlon project. Jinlon has
# different top level keys (Vivaldi) as compared to the rest.

evdev:atkbd:dmi:bvn*:bvr*:bd*:svnGoogle:pnJinlon:pvr*
 KEYBOARD_KEY_42=privacy_screen_toggle
