+
+	mutex_lock(&mtk_dp->update_plugged_status_lock);
+	connected = mhal_DPTx_GetHPDPinLevel(mtk_dp);
+	if (mtk_dp->plugged_cb && mtk_dp->codec_dev)
+		mtk_dp->plugged_cb(mtk_dp->codec_dev, connected);
