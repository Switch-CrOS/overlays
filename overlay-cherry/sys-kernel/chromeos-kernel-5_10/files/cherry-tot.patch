 {
 	struct mu3c_ippc_regs __iomem *ippc = mtk->ippc_regs;
@@ -139,6 +199,8 @@ static int xhci_mtk_host_enable(struct xhci_hcd_mtk *mtk)
 		dev_err(mtk->dev, "clocks are not stable (0x%x)\n", value);
 		return ret;
