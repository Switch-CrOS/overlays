+	HDMI_FUNC();
+
+	mtk_hdmi_write(hdmi, TOP_AUD_MAP,
+			  C_SD7 + C_SD6 + C_SD5 + C_SD4 +
+			  C_SD3 + C_SD2 + C_SD1 + C_SD0);
