+inline unsigned int mtk_cec_rx_data_len(struct mtk_cec *cec)
+{
+	unsigned int val;
+
+	val = mtk_cec_read(cec, CEC2_RX_BUF_HEADER);
+	if (val & CEC2_RX_HEADER_EOM)
+		return 0;
+	if (val & CEC2_RX_BUF_CNT)
+		return ((val & CEC2_RX_BUF_CNT) >> 12);
+	else
+		return 0;
+}
