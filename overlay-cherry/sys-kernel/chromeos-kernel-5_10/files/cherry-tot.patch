+static int adsp_must_setting_early(struct device *dev)
+{
+	void __iomem *vaddr_scp_con;
+	/* support adsp-power at 'probe' phase */
+	adsp_pm_register_early(dev);
+
+	vaddr_scp_con = ioremap(SYS_CTRL, 0x4);
+	writel((readl(vaddr_scp_con) | (1 << AUTO_BUS_REG)), vaddr_scp_con);
+	iounmap(vaddr_scp_con);
+	return 0;
+}
+
+static int adsp_must_setting_late(struct device *dev)
+{
+	adsp_pm_unregister_last(dev);
+	return 0;
+}
