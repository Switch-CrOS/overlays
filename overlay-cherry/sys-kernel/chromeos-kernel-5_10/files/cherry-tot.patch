+static irqreturn_t mtk_hdmi_htplg_isr(int irq, void *arg)
+{
+	struct device *dev = arg;
+	//can.zeng todo verify
+	struct mtk_hdmi *hdmi = global_mtk_hdmi;
+	bool hpd;
+
+	HDMI_LOG("hdmi IRQ!!\n");
+
+	if (hdmi == NULL) {
