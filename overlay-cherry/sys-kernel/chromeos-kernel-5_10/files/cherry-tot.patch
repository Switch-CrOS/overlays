+bool mhal_DPTx_GetHPDPinLevel(struct mtk_dp *mtk_dp)
+{
+	bool ret = (msReadByte(mtk_dp, REG_3414_DP_TRANS_P0) & BIT2) ? 1 : 0;
+
+	dev_info(mtk_dp->dev, "%s\n", __func__);
+
+	return ret;
+}
