+
+/*********HDMI21 tx analog register start*******/
+
+#define HDMI_1_CFG_0	0x00
+
+#define	RG_HDMITX21_SER_EN (0xf << 28)
+#define	RG_HDMITX21_DRV_EN (0xf << 24)
