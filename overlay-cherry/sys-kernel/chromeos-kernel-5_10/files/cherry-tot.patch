+	else if (hdmi->hdr_type == HDR_TYPE_SAMSUNG_HDR10PLUS_VSIF)
+		mtk_hdmi_setup_hdr10plus_vsif(hdmi);
+	else if (hdmi->hdr_type == HDR_TYPE_DOLBY_VISION_LOWLATENCY)
+		mtk_hdmi_setup_dolby_lowlatency_vsif(hdmi);
