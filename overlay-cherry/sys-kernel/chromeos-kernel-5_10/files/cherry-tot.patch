+	mtk_hdmi_write(hdmi, TOP_INT_CLR00, 0x00000000);
+	HDMI_HDCP_LOG("0x14025c8c = 0x%08x\n",
+		mtk_hdmi_read(hdmi, HDCP2X_STATUS_0));
+	_bHdcpStatus = SV_FAIL;
