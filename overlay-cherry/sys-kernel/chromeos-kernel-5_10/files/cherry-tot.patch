+unsigned char mtk_hdmi_log = 1;
+
+#define HDMI_LOG(fmt, arg...) \
+	do {	if (mtk_hdmi_log) { \
+		pr_info("[HDMI] %s,%d "fmt, __func__, __LINE__, ##arg); \
+		} \
+	} while (0)
+
+#define HDMI_FUNC()	\
+	do {	if (mtk_hdmi_log) \
+		pr_info("[HDMI] %s\n", __func__); \
+	} while (0)
