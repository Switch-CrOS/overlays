+	for (i = 0; i < ARRAY_SIZE(mtk_hdmi_clk_names); i++) {
+		if (i == MTK_HDMI_CLK_HDMI_TXPLL)
+			hdmi->clk[i] = hdmi->hdmi_phy_base->txpll;
+		else
+			hdmi->clk[i] = of_clk_get_by_name(np,
+				mtk_hdmi_clk_names[i]);
