+
+	HDMI_DDC_FUNC();
+
+	if ((pucValue == NULL) || (u4Count == 0) || (u4ClkDiv == 0))
+		return 0;
+
+	ucReturnVaule = _DDCMRead(ddc, 1, u4ClkDiv, ucDev, 0,
+		SIF_8_BIT, pucValue, u4Count);
+
+	return (unsigned int)ucReturnVaule;
+}
