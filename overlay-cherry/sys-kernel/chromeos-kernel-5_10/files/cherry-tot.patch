+
+	hdmi->hpd_wq = create_singlethread_workqueue("hdmitx_hpd_wq");
+	if (!hdmi->hpd_wq) {
+		HDMI_LOG("Failed to create dptx workqueue\n");
+		return -ENOMEM;
+	}
+
+	INIT_WORK(&hdmi->hpd_work, mtk_hdmi_hpd_work_handle);
+	return 0;
+}
