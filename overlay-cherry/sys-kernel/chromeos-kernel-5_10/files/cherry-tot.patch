+static struct cmdq_pkt *mdp_cmdq_pkt_get(struct cmdq_client *client)
+{
+	int i;
+
+	if (cmdq_pool.clt == client) {
+		for (i = 0; i < MDP_CMDQ_PKT_SIZE; i++) {
+			if (!cmdq_pool.occupied[i]) {
