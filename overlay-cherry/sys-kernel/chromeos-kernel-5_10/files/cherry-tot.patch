+		vBT2020Enable(false);
+		mtk_hdmi_hw_dolby_vsif(hdmi, true, 0, 0, 0, 0);
+		//low latency Dolby Vision use DolbyVSIF
+		//mtk_hdmi_setup_h14b_vsif(hdmi, &hdmi->mode);
+		_bHdrType = VID_PLA_DR_TYPE_SDR;
+	}
+
+	hdmi_hdr_mutex_unlock(&hdmi->hdr_mutex);
