+void mtk_merge_config(struct device *dev, unsigned int w,
+				  unsigned int h, unsigned int vrefresh,
+				  unsigned int bpc, struct cmdq_pkt *handle)
+{
+	struct mtk_merge_config_struct merge_config;
+	//enum EN_ETHDR_HDR_TYPE eOutputHdrType = 0;
+	struct mtk_disp_merge *priv = dev_get_drvdata(dev);
+	struct mtk_ddp_comp *comp = &priv->ddp_comp;
+
+	/*golden setting*/
+	if (priv->data != NULL) {
+		if (priv->data->need_golden_setting &&
+			priv->data->gs_comp_id == comp->id)
+			mtk_merge_golden_setting(priv, handle);
+	}
+
+	/*if ((comp->fb) && (comp->fb->format))
+		merge_config.fmt = comp->fb->format->format;
+	else
+		merge_config.fmt = DRM_FORMAT_ARGB8888;*/
+
+	switch (comp->id) {
+	case DDP_COMPONENT_MERGE0:
+		merge_config.mode = 5;
+		merge_config.width_left = w;
+		merge_config.width_right = w;
+		merge_config.height = h;
+		merge_config.swap = 0;
+		break;
+	/*case DDP_COMPONENT_MERGE1:
+	case DDP_COMPONENT_MERGE2:
+	case DDP_COMPONENT_MERGE3:
+	case DDP_COMPONENT_MERGE4:
+		if (merge_config.fmt == DRM_FORMAT_ARGB8888 ||
+		    merge_config.fmt == DRM_FORMAT_YVU444) {
+			merge_config.mode = 18;
+			merge_config.width_left = w / 2;
+			merge_config.width_right = w / 2;
+			merge_config.height = h;
+		} else if (merge_config.fmt == DRM_FORMAT_RGB888) {
+			mtk_merge_YUV422_12Bit(comp, cfg, handle);
+			return;
+		}
+		if (merge_config.fmt == DRM_FORMAT_YVU444)
+			merge_config.swap = 4;
+		else
+			merge_config.swap = 0;
+		break;*/
+	case DDP_COMPONENT_MERGE5:
+		//mtk_ethdr_get_output_hdr_type(&eOutputHdrType);
+		merge_config.mode = 8;
+		merge_config.width_left = w;
+		merge_config.width_right = w;
+		merge_config.height = h;
+		merge_config.swap = /*(eOutputHdrType == EN_ETHDR_HDR_TYPE_DOLBY_VISION) ? 0x08:*/0x10;
+		break;
+	default:
+		pr_err("No find component merge %d\n", comp->id);
+		return;
+	}
+
+	mtk_merge_check_params(&merge_config);
+
+	switch (merge_config.mode) {
+	case 5:
+	case 8:
+		mtk_ddp_write_mask(handle,
+			(merge_config.height << 16 | merge_config.width_left),
+			&priv->cmdq_reg, priv->regs,
+			MT8195_DISP_MERGE_CFG_0, ~0);
+
+		mtk_ddp_write_mask(handle,
+			(merge_config.height << 16 | merge_config.width_left),
+			&priv->cmdq_reg, priv->regs,
+			MT8195_DISP_MERGE_CFG_4, ~0);
+
+		mtk_ddp_write_mask(handle,
+			(merge_config.height << 16 | merge_config.width_left),
+			&priv->cmdq_reg, priv->regs,
+			MT8195_DISP_MERGE_CFG_24, ~0);
+
+		mtk_ddp_write_mask(handle,
+			(merge_config.height << 16 | merge_config.width_left),
+			&priv->cmdq_reg, priv->regs,
+			MT8195_DISP_MERGE_CFG_25, ~0);
+
+		mtk_ddp_write_mask(handle,
+			merge_config.swap,
+			&priv->cmdq_reg, priv->regs,
+			MT8195_DISP_MERGE_CFG_10, 0x1f);
+	break;
+	/*case 18:
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_0,
+		(merge_config.height << 16 | merge_config.width_left),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_1,
+		(merge_config.height << 16 | merge_config.width_right),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_4,
+		(merge_config.height << 16 | w),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_24,
+		(merge_config.height << 16 | merge_config.width_left),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_25,
+		(merge_config.height << 16 | merge_config.width_right),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_26,
+		(merge_config.height << 16 | merge_config.width_left),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_27,
+		(merge_config.height << 16 | merge_config.width_right),
+		~0);
+		cmdq_pkt_write(handle, priv->cmdq_reg.subsys,
+		priv->cmdq_reg.offset + MT8195_DISP_MERGE_CFG_10,
+		merge_config.swap, 0x1f);
+	break;*/
+	default:
+	break;
+	}
+	mtk_ddp_write_mask(NULL, merge_config.mode,
+		&priv->cmdq_reg, priv->regs, MT8195_DISP_MERGE_CFG_12, 0x1f);
+	mtk_ddp_write_mask(NULL, 0x1,
+		&priv->cmdq_reg, priv->regs, MT8195_DISP_MERGE_ENABLE, 0x1);
+}
