+#define CEC2_RX_ACK_SEL			BIT(8)
+#define CEC2_TX_RESET_WRITE				BIT(1)
+#define CEC2_TX_RESET_READ				BIT(0)
+#define CEC2_RX_RESET_WRITE				BIT(0)
+#define CEC2_RX_RESET_READ				BIT(1)
