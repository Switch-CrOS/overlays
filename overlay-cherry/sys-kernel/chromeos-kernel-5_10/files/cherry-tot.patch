+#define RX_REG_TMDS_CONFIG     0x20
+#define SCRAMBLING_ENABLE     (1<<0)
+#define TMDS_BIT_CLOCK_RATION  (1<<1)
+
+/* Ri register (total 2 bytes, address from 0x08 ~ 0x09) */
+#define RX_REG_RI             0x08
+#define RX_REG_SCRAMBLE             0xA8
+
