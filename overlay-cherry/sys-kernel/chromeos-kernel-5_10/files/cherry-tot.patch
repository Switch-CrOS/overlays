+		err = mtk_gpio_create_attr(&pdev->dev);
+		if (err < 0)
+			pr_warn("mtk_gpio create attribute error\n");
+#endif
+
 	return 0;
 }
 EXPORT_SYMBOL_GPL(mtk_paris_pinctrl_probe);
