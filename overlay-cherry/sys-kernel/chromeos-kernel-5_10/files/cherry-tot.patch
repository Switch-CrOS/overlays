+	unsigned char *pucValue, unsigned int u4Count)
+{
+	unsigned int u4ReadCount = 0;
+	unsigned char ucReturnVaule = 0;
+
+	HDMI_DDC_FUNC();
+	if ((pucValue == NULL) ||
+	    (u4Count == 0) ||
+	    (u4ClkDiv == 0) ||
+	    (ucAddrType > SIF_16_BIT) ||
+	    ((ucAddrType == SIF_8_BIT) && (u4Addr > 255)) ||
+	    ((ucAddrType == SIF_16_BIT) && (u4Addr > 65535))) {
+		return 0;
