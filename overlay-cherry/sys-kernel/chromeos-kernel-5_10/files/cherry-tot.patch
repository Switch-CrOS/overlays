+static void mtk_hdmi_audio_shutdown(struct device *dev, void *data)
+{
+	struct mtk_hdmi *hdmi = dev_get_drvdata(dev);
+
+	HDMI_FUNC();
+
+	mtk_hdmi_audio_disable(hdmi);
