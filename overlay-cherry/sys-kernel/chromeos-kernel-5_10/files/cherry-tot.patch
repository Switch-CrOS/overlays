+static void mdp_cmdq_pkt_free(struct cmdq_pkt *pkt)
+{
+	int i;
+
+	for (i = 0; i < MDP_CMDQ_PKT_SIZE; i++) {
+		if (cmdq_pool.pkt[i] == pkt) {
