+		value = MOUT_DISP_OVL0_TO_DISP_RDMA0;
+	} else if (cur == DDP_COMPONENT_OVL1 && next == DDP_COMPONENT_RDMA1) {
+		addr = MT8195_VDO0_OVL_MOUT_EN;
+		value = MOUT_DISP_OVL1_TO_DISP_RDMA1;
+	} else {
+		value = 0;
+	}
+	if (value) {
+		reg = readl_relaxed(config_regs + addr);
+		if (enable)
+			reg |= value;
+		else
+			reg &= ~value;
+		writel_relaxed(reg, config_regs + addr);
+	}
+}
+static void mtk_mmsys_ddp_sel_in(void __iomem *config_regs,
+				 enum mtk_ddp_comp_id cur,
+				 enum mtk_ddp_comp_id next,
+				 bool enable)
+{
+	unsigned int addr, value, reg;
+
+	if (cur == DDP_COMPONENT_DSC0 &&
+		next == DDP_COMPONENT_MERGE0) {
+		addr = MT8195_VDO0_SEL_IN;
+		value = SEL_IN_VPP_MERGE_FROM_DSC_WRAP0_OUT;
+	} else if (cur == DDP_COMPONENT_DITHER &&
+		next == DDP_COMPONENT_DSC0) {
+		addr = MT8195_VDO0_SEL_IN;
+		value = SEL_IN_DSC_WRAP0_IN_FROM_DISP_DITHER0;
+	}
+#ifdef CONFIG_MTK_DPTX_SUPPORT
+	else if (cur == DDP_COMPONENT_MERGE0 &&
+		next == DDP_COMPONENT_DP_INTF0) {
+		addr = MT8195_VDO0_SEL_IN;
+		value = SEL_IN_DP_INTF0_FROM_VPP_MERGE;
+	}
+#endif
+	else if (cur == DDP_COMPONENT_DSC0 &&
+		next == DDP_COMPONENT_DSI0) {
+		addr = MT8195_VDO0_SEL_IN;
+		value = SEL_IN_DSI0_FROM_DSC_WRAP0_OUT;
+	} else if (cur == DDP_COMPONENT_DITHER &&
+		next == DDP_COMPONENT_DSI0) {
+		addr = MT8195_VDO0_SEL_IN;
+		value = SEL_IN_DSI0_FROM_DISP_DITHER0;
+	} else {
+		value = 0;
+	}
+	if (value) {
+		reg = readl_relaxed(config_regs + addr);
+		if (enable)
+			reg |= value;
+		else
+			reg &= ~value;
+		writel_relaxed(reg, config_regs + addr);
+	}
+}
+static void mtk_mmsys_ddp_sout_sel(void __iomem *config_regs,
+				   enum mtk_ddp_comp_id cur,
+				   enum mtk_ddp_comp_id next)
+{
+	unsigned int reg = 0, value = 0;
+
+	if (cur == DDP_COMPONENT_DITHER &&
+		next == DDP_COMPONENT_DSI0) {
+		value = SOUT_DISP_DITHER0_TO_DSI0;
+	}
+#ifdef CONFIG_MTK_DPTX_SUPPORT
+	else if (cur == DDP_COMPONENT_MERGE0 &&
+		next == DDP_COMPONENT_DP_INTF0) {
+		value = SOUT_VPP_MERGE_TO_DP_INTF0;
+	}
+#endif
+	else if (cur == DDP_COMPONENT_MERGE0 &&
+		next == DDP_COMPONENT_WDMA0) {
+		value = SOUT_VPP_MERGE_TO_DISP_WDMA0;
+	} else if (cur == DDP_COMPONENT_DSC0 &&
+		next == DDP_COMPONENT_DSI0) {
+		value = SOUT_DSC_WRAP0_OUT_TO_DSI0;
+	} else if (cur == DDP_COMPONENT_DSC0 &&
+		next == DDP_COMPONENT_MERGE0) {
+		value = SOUT_DSC_WRAP0_OUT_TO_VPP_MERGE;
+	}
+	reg = readl_relaxed(config_regs + MT8195_VDO0_SEL_OUT);
+	reg |= value;
+	writel_relaxed(reg, config_regs + MT8195_VDO0_SEL_OUT);
+}
+struct mtk_mmsys_conn_funcs mt8195_mmsys_funcs = {
+	.mout_en = mtk_mmsys_ddp_mout_en,
+	.sel_in = mtk_mmsys_ddp_sel_in,
+	.sout_sel = mtk_mmsys_ddp_sout_sel,
+};
