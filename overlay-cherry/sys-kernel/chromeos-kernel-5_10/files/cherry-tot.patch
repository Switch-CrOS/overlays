+int mtk_merge_clk_enable(struct device *dev)
+{
+	int ret = 0;
+	struct mtk_disp_merge *priv = dev_get_drvdata(dev);
+
+	pr_info("%s\n", __func__);
+
+	if (priv->clk != NULL) {
+		ret = clk_prepare_enable(priv->clk);
+		if (ret)
+			pr_err("async clk prepare enable failed\n");
+	}
+
+	return ret;
+}
