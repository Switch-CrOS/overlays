+static int mt8195_dsp_runtime_suspend(struct snd_sof_dev *sdev)
+{
+	struct platform_device *pdev =
+		container_of(sdev->dev, struct platform_device, dev);
+
+	dev_info(sdev->dev, "%s\n", __func__);
+
+	/*stall and reset dsp*/
+	hifixdsp_shutdown();
+	adsp_clock_power_off(&pdev->dev);
+	adsp_sram_power_on(&pdev->dev, false);
+	adsp_must_setting_late(&pdev->dev);
+
+	return 0;
+}
+
+static int mt8195_dsp_suspend(struct snd_sof_dev *sdev, u32 target_state)
+{
+	return mt8195_dsp_runtime_suspend(sdev);
+}
+
+static int mt8195_dsp_resume(struct snd_sof_dev *sdev)
+{
+	struct platform_device *pdev =
+		container_of(sdev->dev, struct platform_device, dev);
+	int ret = 0;
+
+	dev_info(sdev->dev, "%s\n", __func__);
+
+	ret = adsp_must_setting_early(&pdev->dev);
+	if (ret) {
+		dev_err(sdev->dev, "adsp_must_setting_early failed\n");
+		return -EINVAL;
+	}
+
+	ret = adsp_clock_power_on(&pdev->dev);
+	if (ret) {
+		dev_err(sdev->dev, "adsp_clock_power_on fail!\n");
+		return -EINVAL;
+	}
+
+	ret = adsp_sram_power_on(sdev->dev, true);
+	if (ret) {
+		dev_err(sdev->dev, "[ADSP] adsp_sram_power_on fail!\n");
+		return -EINVAL;
+	}
+
+	ret = adsp_memory_remap_init(&pdev->dev);
+	if (ret) {
+		dev_err(sdev->dev, "adsp_memory_remap_init fail!\n");
+		return -EINVAL;
+	}
+
+	return ret;
+}
