+void mhal_DPTx_SetTxRate(struct mtk_dp *mtk_dp, int Value)
+{
+	DPTXFUNC();
+
+	msWrite4Byte(mtk_dp, 0x2000, 0x00000001); // power off TPLL and Lane;
+	/// Set gear : 0x0 : RBR, 0x1 : HBR, 0x2 : HBR2, 0x3 : HBR3
+	switch (Value) {
+	case 0x06:
+		msWrite4Byte(mtk_dp,
+			0x103C,
+			0x00000000);
+		break;
+	case 0x0A:
+		msWrite4Byte(mtk_dp,
+			0x103C,
+			0x00000001);
+		break;
+	case 0x14:
+		msWrite4Byte(mtk_dp,
+			0x103C,
+			0x00000002);
+		break;
+	case 0x1E:
+		msWrite4Byte(mtk_dp,
+			0x103C,
+			0x00000003);
+		break;
+	default:
+		break;
+	}
+
+	msWrite4Byte(mtk_dp,
+		0x2000,
+		0x00000003); // power on BandGap, TPLL and Lane;
+}
