+	}
+
+	param[0].value.a = u4addr;
+	param[0].value.b = 0;
+	param[1].value.a = u4data;
+	param[1].value.b = 0;
+
+	tz_ret = KREE_TeeServiceCall(ca_hdmi_session, HDMI_TA_HDCP_RST,
+				     TZ_ParamTypes2(TZPT_VALUE_INPUT,
+				     TZPT_VALUE_INPUT), param);
+
+	if (tz_ret != TZ_RESULT_SUCCESS)
