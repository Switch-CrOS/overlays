+		break;
+
+	case DPTx_SDPTYP_PPS0:
+		msWriteByte(mtk_dp, REG_31E8_DP_ENCODER0_P0, 0x00);
+		if (bEnable) {
+			msWriteByteMask(mtk_dp, REG_3280_DP_ENCODER1_P0,
+				DPTx_SDPTYP_PPS0, BIT4|BIT3|BIT2|BIT1|BIT0);
+			msWriteByteMask(mtk_dp, REG_3280_DP_ENCODER1_P0,
