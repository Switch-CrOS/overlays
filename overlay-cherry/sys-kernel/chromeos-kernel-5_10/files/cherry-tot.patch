+void mhal_DPTx_HPDDetectSetting(struct mtk_dp *mtk_dp)
+{
+	msWriteByteMask(mtk_dp,
+		REG_3410_DP_TRANS_P0,
+		0x8,
+		MASKBIT(3 : 0));
+	msWriteByteMask(mtk_dp,
+		REG_3410_DP_TRANS_P0,
+		(0x0A << 4),
+		MASKBIT(7 : 4));
+
+	// [7 : 4] Con Thd = 1.5ms+Vx0.1ms[3 : 0] : DisCon Thd = 1.5ms+Vx0.1ms
+	msWriteByte(mtk_dp,
+		REG_3410_DP_TRANS_P0 + 1,
+		0x55);
+	msWriteByte(mtk_dp,
+		REG_3430_DP_TRANS_P0,
+		0x02); //1113 MK
+}
