+void mtk_merge_clk_disable(struct device *dev)
+{
+	struct mtk_disp_merge *priv = dev_get_drvdata(dev);
+
+	pr_info("%s\n", __func__);
+
+	if (priv->clk != NULL)
+		clk_disable_unprepare(priv->clk);
+}
