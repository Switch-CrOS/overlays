+
+	if (fgEnable == _fgLowLatencyDolbyVisionEnable)
+		return;
+
+	hdmi_hdr_mutex_lock(&hdmi->hdr_mutex);
+
+	HDMI_HDR_LOG("fgEnable=%d\n", fgEnable);
