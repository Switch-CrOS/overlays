+	HDMI_LOG("hsync_start:%d,hsync_end:%d, htotal:%d",
+		adjusted_mode->hsync_start, adjusted_mode->hsync_end,
+		adjusted_mode->htotal);
+	HDMI_LOG("hskew:%d, vdisplay:%d\n",
