+void __iomem *get_mbox_reg_base(u32 id)
+{
+	struct adsp_chip_info *adsp;
+
+	adsp = get_adsp_chip_data();
+	if (!adsp)
+		return NULL;
+
+	if (id >= DSP_MBOX_NUM)
+		return NULL;
+
+	return adsp->va_mboxreg[id];
+}
+EXPORT_SYMBOL(get_mbox_reg_base);
