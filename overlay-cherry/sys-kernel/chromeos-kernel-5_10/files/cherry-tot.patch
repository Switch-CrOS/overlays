+static inline void mtk_hdmi_hw_i2s_fifo_map(struct mtk_hdmi *hdmi,
+	unsigned int fifo_mapping)
+{
+	mtk_hdmi_mask(hdmi, AIP_I2S_CTRL, fifo_mapping,
+		FIFO3_MAP |	FIFO2_MAP | FIFO1_MAP | FIFO0_MAP);
+}
