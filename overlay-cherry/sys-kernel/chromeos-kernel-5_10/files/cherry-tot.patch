+unsigned int mtk_pseudo_ovl_layer_nr(struct device *dev)
+{
+	struct mtk_disp_pseudo_ovl *pseudo_ovl = dev_get_drvdata(dev);
+
+	return pseudo_ovl->data->layer_nr;
+}
