+
+	if (mode->clock < 27000) {
+		HDMI_LOG("MODE_CLOCK_LOW!\n");
+		return MODE_CLOCK_LOW;
+	}
+	if (mode->clock > 594000) {
+		HDMI_LOG("MODE_CLOCK_HIGH!\n");
+		return MODE_CLOCK_HIGH;
+	}
+
+	return drm_mode_validate_size(mode, 0x1fff, 0x1fff);
+}
