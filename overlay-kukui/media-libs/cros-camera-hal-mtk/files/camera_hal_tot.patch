+BaseImageBufferHeap::~BaseImageBufferHeap() {
+  CAM_LOGD("~BaseImageBufferHeap");
+  if (0 != mLockCount) {
+    MY_LOGE(
+        "Not unlock before release heap - LockCount:%d, username:%s, "
+        "va=%#" PRIxPTR "",
+        mLockCount, mCallerName.c_str(), getBufVA(0));
+  }
+
+  if (mCreator != NULL) {
+    delete mCreator;
+  }
+}
