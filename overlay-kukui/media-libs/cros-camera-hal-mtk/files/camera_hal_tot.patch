+ protected:  ////
+  virtual char const* impGetMagicName() const { return magicName(); }
+  virtual HeapInfoVect_t const& impGetHeapInfo() const { return mvHeapInfo; }
+  virtual MBOOL impInit(BufInfoVect_t const& rvBufInfo);
