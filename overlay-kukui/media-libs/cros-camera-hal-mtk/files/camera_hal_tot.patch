+#undef LOG_TAG
+#define LOG_TAG "mtkcam-CaptureInFlightRequest"
+//
+//
+#include <mtkcam/pipeline/model/capture/CaptureInFlightRequest.h>
+#include <sys/prctl.h>
+#include <sys/resource.h>
