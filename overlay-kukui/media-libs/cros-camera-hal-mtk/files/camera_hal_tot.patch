+  MBOOL needReConfig(const P2ConfigInfo& oldConfig,
+                     const P2ConfigInfo& newConfig);
+  MBOOL initFeaturePipe(const P2ConfigInfo& config);
+  MVOID uninitFeaturePipe();
+  MBOOL init3A();
+  MVOID uninit3A();
