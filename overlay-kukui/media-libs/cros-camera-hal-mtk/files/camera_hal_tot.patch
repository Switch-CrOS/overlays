+
+  this->addWaitQueue(&mRequests);
+
+  m3dnrLogLevel = getPropertyValue("vendor.camera.3dnr.log.level", 0);
+  bDump3DNR = getPropertyValue("debug.3dnr.dump.enable", 0);
+  TRACE_FUNC_EXIT();
