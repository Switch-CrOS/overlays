+MVOID
+JpegNodeImp::unlockImage(
+    std::shared_ptr<NSCam::v3::IImageStreamBuffer>* rpStreamBuffer,
+    std::shared_ptr<IImageBuffer>* rpImageBuffer,
+    std::shared_ptr<IImageBuffer>* rpImageBuffer1) {
