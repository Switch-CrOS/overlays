+   */
+  virtual MINT64 GetTsForAlgoDebug() = 0;
+
+  /**
+   *@brief  Get statistic of LMV HW
+   *@param[in,out] apLmvStat : EIS_STATISTIC_T struct
+   *@param[in] aTimeStamp : time stamp of  pass1 image
