+    E_SYNCAF_MODE_ON = 1,
+    E_SYNCAF_MODE_OFF = 2,
+  };
+
+  enum E_HW_FRM_SYNC_MODE {
+    E_HW_FRM_SYNC_MODE_IDLE = 0,
+    E_HW_FRM_SYNC_MODE_ON = 1,
+    E_HW_FRM_SYNC_MODE_OFF = 2,
+  };
