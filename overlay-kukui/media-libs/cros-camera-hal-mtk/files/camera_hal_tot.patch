+MVOID P2FrameRequest::registerImgPlugin(
+    const std::shared_ptr<P2ImgPlugin>& plugin, MBOOL needSWRW) {
+  mImgPlugin.push_back(plugin);
+  mNeedImageSWRW |= needSWRW;
