+  FID_PRE_BEGIN_SI = FID_PRE_BEGIN,
+  /* --------------------------------------------------------------------------
+   */
+  /* Misc. feature id. */
+  FID_PRE_BEGIN_MISC_SI = FID_PRE_BEGIN_SI,
+  FID_ZOOM_FACTOR, /* Legacy symbol (Remove if possible) */
