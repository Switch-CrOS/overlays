+/******************************************************************************
+ *
+ ******************************************************************************/
+MINT32
+HardwareStateControl::getDropNum(void) {
+  if (!isActive()) {
+    return 0;
+  }
+  //
+  std::lock_guard<std::mutex> _l(mLock);
+  MINT32 num = 0;
+  if (!mvStoreNum.empty()) {
+    std::vector<MINT32>::iterator it = mvStoreNum.begin();
+    num = *it;
+    mvStoreNum.erase(it);
+  }
+  return num;
+}
