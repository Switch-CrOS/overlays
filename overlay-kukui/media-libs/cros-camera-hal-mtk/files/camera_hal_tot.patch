+
+  /**
+   *  @brief          get Frame number of this EffectFrameInfo object
+   *  @return         Frame number
+   */
+  frame_no getFrameNo() const { return mFrameNo; }
+  /**
+   *  @brief          get Request number of this EffectFrameInfo object of
