+/******************************************************************************
+ *
+ ******************************************************************************/
+MVOID
+NSCam::v3::Utils::StreamBufferImp::dumpState() const {
+  if (mBufMutex.try_lock_for(std::chrono::milliseconds(100))) {
+    printLocked();
+    mBufMutex.unlock();
+  }
+}
