+/******************************************************************************
+ *
+ ******************************************************************************/
+MERROR
+P1NodeImp::setNodeCallBack(std::weak_ptr<INodeCallbackToPipeline> pCallback) {
+  std::lock_guard<std::mutex> _l(mPipelineCbLock);
+  MY_LOGI("PipelineNodeCallBack=%d", pCallback.expired());
+  mwpPipelineCb = pCallback;
+  return OK;
+}
