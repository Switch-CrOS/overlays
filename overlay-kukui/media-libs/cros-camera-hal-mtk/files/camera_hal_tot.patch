+struct CameraFacesDeleter {
+  inline void operator()(MtkCameraFaceMetadata* faces) {
+    // Delete face metadata buffer
+    if (faces != nullptr) {
+      if (faces->faces != nullptr) {
+        delete[] faces->faces;
+      }
+      if (faces->posInfo != nullptr) {
+        delete[] faces->posInfo;
+      }
+      delete faces;
+    }
+  }
+};
