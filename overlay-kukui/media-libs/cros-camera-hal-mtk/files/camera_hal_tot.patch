+/******************************************************************************
+ *
+ ******************************************************************************/
+MERROR
+P1NodeImp::onProcessEnqueFrame(P1QueJob* job) {
+  FUNCTION_IN;
+
+  // (1) todo
+  // pass request directly if it's a reprocessing one
+  //
+  // if( mInHalMeta == NULL) {
+  //    onDispatchFrame(pFrame);
+  //    return;
+  // }
+
+  // (2)
+  MERROR status = hardwareOps_enque(job);
+
+  FUNCTION_OUT;
+  return status;
+}
