+auto customer_get_streaming_scenario(int32_t* pScenario, /*eCameraScenario*/
+                                     const ScenarioHint& scenarioHint,
+                                     IMetadata const* pAppMetadata) -> bool {
+  if (!gForceCustomerScenarioMgr) {
