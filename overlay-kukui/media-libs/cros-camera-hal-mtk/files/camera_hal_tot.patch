+  MUINT32 bs_ratio;          // bayer scaler scaling ratio, unit:%
+  MUINT32 pipelinebitdepth;  // how many bits pipeline deal with
+  MBOOL D_TWIN;              // 1: dynamic twin is ON, 0: dynamic twin is OFF.
