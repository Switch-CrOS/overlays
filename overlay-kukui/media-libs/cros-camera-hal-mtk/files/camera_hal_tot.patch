+/******************************************************************************
+ *
+ ******************************************************************************/
+ACT_TYPE
+P1NodeAct::getType() const {
+  ACT_TYPE type = ACT_TYPE_NULL;
+  switch (reqType) {
+    case REQ_TYPE_NORMAL:
+      type = ACT_TYPE_NORMAL;
+      break;
+    case REQ_TYPE_INITIAL:
+    case REQ_TYPE_PADDING:
+    case REQ_TYPE_DUMMY:
+      type = ACT_TYPE_INTERNAL;
+      break;
+    case REQ_TYPE_REDO:
+    case REQ_TYPE_YUV:
+    case REQ_TYPE_ZSL:
+      type = ACT_TYPE_BYPASS;
+      break;
+    default:
+      // case REQ_TYPE_UNKNOWN:
+      type = ACT_TYPE_NULL;
+      break;
+  }
+  return type;
+}
