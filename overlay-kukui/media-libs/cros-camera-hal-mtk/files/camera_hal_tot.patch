+MINT32 FDVT_CloseDriverWithUserCount() {
+  std::lock_guard<std::mutex> lock(g_FDInitMutex);
+
+  --g_UserCount;
+  if (g_UserCount == 0) {
+    MY_LOGI("FDVT_Uninit, HW FD Close CLK\n");
+    FDVT_Close_Driver();
+  }
+
+  return g_UserCount;
+}
