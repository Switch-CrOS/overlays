+#define CAMERA_HAL_MEDIATEK_MTKCAM_INCLUDE_MTKCAM_FEATURE_EFFECTHALBASE_IEFFECTHAL_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+#include <mtkcam/utils/imgbuf/IImageBuffer.h>
