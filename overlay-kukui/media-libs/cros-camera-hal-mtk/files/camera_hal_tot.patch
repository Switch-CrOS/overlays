+  //  IPipelineBufferSetFrameControl::IAppCallback Interfaces.
+  //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ public:  ////
+  MVOID updateFrame(MUINT32 const requestNo,
+                    MINTPTR const userId,
+                    Result const& result) override;
