+MBOOL
+BaseImageBufferHeap::onCreate(std::shared_ptr<BaseImageBufferHeap> heap,
+                              MSize const& imgSize,
+                              MINT const imgFormat,
+                              size_t const bitstreamSize,
+                              MBOOL const enableLog) {
+  MBOOL ret = onCreate(imgSize, imgFormat, bitstreamSize, enableLog);
+  dummy(heap);
+  //
+  return ret;
+}
