+        bs_ratio(_bs_ratio),
+        pipelinebitdepth(_pipelinebitdepth),
+        D_TWIN(0),
+        IQlv(0),
+        sen_num(2),
+        uni_num(1),
+        D_Pak(MFALSE),
+        burstNum(0),
+        pattern(0) {
