+  //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ public:
+  // e.g. mpOnRequestProcessed(mpTag, this);
+  PFN_CALLBACK_T mpOnFrameProcessed;
+  // callback tag; it shouldn't be modified by the client(user).
+  // e.g. the tag may be a pointer to client(this).
