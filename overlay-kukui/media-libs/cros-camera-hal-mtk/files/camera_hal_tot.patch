+  VIDEO_CFG vdo_cfg = is4K2K ? VIDEO_CFG_4K2K : VIDEO_CFG_FHD;
+  if (isEnabledEIS25() && isEnabledGyroMode() && !is4K2K && !isVHDR) {
+    EIS_MODE_ENABLE_EIS_25(*eisMode);
+    EIS_MODE_ENABLE_EIS_GYRO(*eisMode);
+    if (isEnabledForwardMode(vdo_cfg)) {
