+std::vector<NodeID_T> CaptureFeatureRequest::getPreviousNodes(NodeID_T nodeId) {
+  std::vector<NodeID_T> vec;
+  for (int i = 0; i < NUM_OF_NODE; i++) {
+    if (mNodePath[i][nodeId] != NULL_PATH) {
+      vec.push_back(i);
+    }
+  }
+  return vec;
+}
