+                                 const SimpleIn& in,
+                                 std::shared_ptr<IHal3A> hal3A,
+                                 P2MetaSet* metaSet);
+  static MVOID xmakeDpPqParam(const P2Pack& p2Pack,
+                              const SimpleOut& out,
+                              FD_DATATYPE* const& pFdData);
+};
