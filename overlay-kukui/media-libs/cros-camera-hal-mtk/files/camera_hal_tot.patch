+static MINT32 getIso3DNR(const std::shared_ptr<P2::P2Request>& request) {
+  const MINT32 DEFAULT_ISO = 100;
+  MINT iso = request->mP2Pack.getSensorData().mISO;
+  if (iso == INVALID_P1_ISO_VAL) {
+    iso = DEFAULT_ISO;
+  }
+  return iso;
+}
+}  // namespace
