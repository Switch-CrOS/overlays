+/******************************************************************************
+ *
+ ******************************************************************************/
+void HardwareStateControl::checkThreadWeakup(void) {
+  if (!isActive()) {
+    return;
+  }
+  //
+  std::lock_guard<std::mutex> _l(mLock);
+  if (mState == STATE_RES_WAIT_SYNC) {
+    MY_LOGI("[SUS-RES] Recover-Loop-W");
+    mThreadCond.notify_all();
+  }
+  return;
+}
