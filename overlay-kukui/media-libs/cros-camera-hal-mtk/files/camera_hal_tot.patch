+static std::string bufferStatusToString(const MUINT32 o) {
+  std::string os;
+  if (o) {
+    os += "status={";
+    if (o & NSCam::v3::STREAM_BUFFER_STATUS::WRITE) {
+      os += " WRITE";
+    }
+    if (o & NSCam::v3::STREAM_BUFFER_STATUS::ERROR) {
+      os += " ERROR";
+    }
+    os += " } ";
+  }
+  return os;
+}
