+/******************************************************************************
+ * 0 <= Heap ID count <= plane count.
+ * Legal only after lock().
+ ******************************************************************************/
+size_t BaseImageBufferHeap::getHeapIDCount() const {
+  std::lock_guard<std::mutex> _l(mLockMtx);
+  //
+  if (0 >= mLockCount) {
+    MY_LOGE("This call is legal only after lock()");
+    return 0;
+  }
+  //
+  return impGetHeapInfo().size();
+}
