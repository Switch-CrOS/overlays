+QParams makeQParams(const P2Pack& p2Pack,
+                    ENormalStreamTag tag,
+                    const P2IOPack& io,
+                    const P2ObjPtr& obj,
+                    const TuningParam& tuning) {
+  QParams qparams;
+  qparams.mvFrameParams.push_back(
+      makeFrameParams(p2Pack, tag, io, obj, tuning));
+  return qparams;
+}
