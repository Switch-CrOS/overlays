+/******************************************************************************
+ *
+ ******************************************************************************/
+IHalSensor* HalSensorList::createSensor(char const* szCallerName,
+                                        MUINT const index) {
+  std::unique_lock<std::mutex> lk(mEnumSensorMutex);
+  vector<MUINT> vSensorIndex;
