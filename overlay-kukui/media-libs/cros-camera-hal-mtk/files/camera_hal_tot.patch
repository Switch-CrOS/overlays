+
+      {CP_OP_START_DRV_START_END, "OpStart.DrvStart---", {"", "", "", ""}},
+
+      {CP_OP_START_REQ_WAIT_BGN, "OpStart.ReqWait+++", {"Type", "", "", ""}},
+
+      {CP_OP_START_REQ_WAIT_END, "OpStart.ReqWait---", {"Type", "", "", ""}},
+
