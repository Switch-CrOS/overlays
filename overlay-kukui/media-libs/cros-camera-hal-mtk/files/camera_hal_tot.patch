+  MINT32 i4LMV_X[LMV_MAX_WIN_NUM];
+  MINT32 i4LMV_Y[LMV_MAX_WIN_NUM];
+
+  MINT32 i4LMV_X2[LMV_MAX_WIN_NUM];
