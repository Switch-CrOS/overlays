+MVOID moveAppend(std::vector<SFPOutput>* source, std::vector<SFPOutput>* dest) {
+  if (dest->empty()) {
+    *dest = std::move(*source);
+  } else {
+    dest->reserve(dest->size() + source->size());
+    std::move(std::begin(*source), std::end(*source),
+              std::back_inserter(*dest));
+    source->clear();
+  }
+}
