+MBOOL WaitNotifyCB::onNotify() {
+  TRACE_FUNC_ENTER();
+  std::lock_guard<std::mutex> lock(mMutex);
+  mDone = MTRUE;
+  mCondition.notify_all();
+  TRACE_FUNC_EXIT();
+  return MTRUE;
+}
+
+MBOOL WaitNotifyCB::wait() {
+  TRACE_FUNC_ENTER();
+  std::unique_lock<std::mutex> lck(mMutex);
+  while (!mDone) {
+    mCondition.wait(lck);
+  }
+  TRACE_FUNC_EXIT();
+  return MTRUE;
+}
