+bool FdNodeImp::_threadLoop() {
+  MY_LOGD("ThreadLoop In !!!");
+
+  std::shared_ptr<NSCam::v3::IPipelineFrame> pFrame;
+  if (OK == onDequeRequest(&pFrame) && pFrame != nullptr) {
+    onProcessFrame(pFrame);
