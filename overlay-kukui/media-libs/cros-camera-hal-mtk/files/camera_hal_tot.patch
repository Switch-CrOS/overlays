+/******************************************************************************
+ *
+ ******************************************************************************/
+MBOOL
+StuffBufferPool::compareLayout(MINT32 format,
+                               MSize size,
+                               MUINT32 stride0,
+                               MUINT32 stride1,
+                               MUINT32 stride2) {
+  return ((format == mFormat) && (stride0 == mStride0) &&
+          (stride1 == mStride1) && (stride2 == mStride2) && (size == mSize));
+}
