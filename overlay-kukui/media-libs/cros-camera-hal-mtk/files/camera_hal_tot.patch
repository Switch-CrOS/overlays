+MBOOL getOutBuffer(const SFPIOMap& ioMap, IO_TYPE target, SFPOutput* output) {
+  TRACE_FUNC_ENTER();
+  if (!ioMap.isValid()) {
+    return MFALSE;
+  }
+  unsigned count = 0;
+  for (auto&& out : ioMap.mOutList) {
+    if (isTargetOutput(target, out)) {
+      if (++count == 1) {
+        *output = out;
+      }
+    }
+  }
+  if (count > 1) {
+    MY_LOGW("suspicious output number = %d, type = %d", count, target);
+  }
+  TRACE_FUNC_EXIT();
+  return count >= 1;
+}
