+                             MINT usage,
+                             BufInfoVect_t const& rvBufInfo);
+
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+  //  Definitions.
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ protected:  ////                    Heap Info.
+  typedef HeapInfo MyHeapInfo;
+  typedef std::vector<std::shared_ptr<MyHeapInfo> > MyHeapInfoVect_t;
+
+ protected:  ////                    Buffer Info.
+  typedef std::vector<std::shared_ptr<BufInfo> > MyBufInfoVect_t;
