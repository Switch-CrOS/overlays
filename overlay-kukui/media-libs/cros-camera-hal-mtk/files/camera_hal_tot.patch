+                   std::vector<SFPOutput>* outList) {
+  TRACE_FUNC_ENTER();
+  if (!ioMap.isValid()) {
+    return MFALSE;
+  }
+  unsigned count = 0;
+  for (auto&& out : ioMap.mOutList) {
+    if (isTargetOutput(target, out)) {
+      outList->push_back(out);
+      count++;
+    }
+  }
+  TRACE_FUNC_EXIT();
+  return count >= 1;
+}
