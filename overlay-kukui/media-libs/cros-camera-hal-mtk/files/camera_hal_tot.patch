+void halFDVT::LockFTBuffer(void* arg) {
+  halFDVT* _this = reinterpret_cast<halFDVT*>(arg);
+  ::sem_wait(&(_this->mSemFTLock));  // lock FT Buffer
+}
+void halFDVT::UnlockFTBuffer(void* arg) {
+  halFDVT* _this = reinterpret_cast<halFDVT*>(arg);
+  ::sem_post(&(_this->mSemFTLock));  // lock FT Buffer
+}
