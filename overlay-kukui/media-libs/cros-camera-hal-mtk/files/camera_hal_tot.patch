+ *1 stands for MDP_CROP2.
+ *
+ ******************************************************************************/
+struct MCrpRsInfo {
+  MUINT32 mFrameGroup;
+  MINT32 mGroupID;
+  MUINT32 mMdpGroup;
+  MCropRect mCropRect;
+  MSize mResizeDst;
+  MCrpRsInfo()
+      : mFrameGroup(0), mGroupID(0), mMdpGroup(0), mResizeDst(mCropRect.s) {}
+};
