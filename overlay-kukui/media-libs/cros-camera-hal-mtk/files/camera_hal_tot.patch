+  virtual uint32_t getFrameNo();
+  virtual void resetFrameNo();
+
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+  //  Data Members.
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ protected:  //                       Data Members
+  mutable std::mutex mFrameNoLock;
+  int32_t mFrameNo;
+};
