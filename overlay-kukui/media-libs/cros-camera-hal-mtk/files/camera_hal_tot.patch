diff --git a/camera/hal/mediatek/mtkcam/feature/common/3dnr/lmv_state_uni.cpp b/camera/hal/mediatek/mtkcam/feature/common/3dnr/lmv_state_uni.cpp
new file mode 100644
index 000000000..5404bff2c
--- /dev/null
+++ b/camera/hal/mediatek/mtkcam/feature/common/3dnr/lmv_state_uni.cpp
@@ -0,0 +1,204 @@
+/*
+ * Copyright (C) 2019 MediaTek Inc.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
