+
+#define LOG_TAG "mtkcam-RequestSettingPolicyMediator"
+
+#include <memory>
+#include <mtkcam/pipeline/policy/InterfaceTableDef.h>
+#include <mtkcam/pipeline/policy/IRequestSettingPolicyMediator.h>
+
+#include "MyUtils.h"
