+}
+
+std::vector<uint8_t>::const_iterator IMetadata::Memory::cend() const {
+#if IMETADATA_MEMORY_THREAD_SAFE_SUPPORT
+  std::lock_guard<std::mutex> lk(this->_data_lock);
