+  //
+  typedef TimingChecker::Record* RecPtr;
+  //
+ private:
+  class RecCmp {
+   public:
+    RecCmp() {}
+    virtual ~RecCmp() {}
+    MBOOL operator()(const RecPtr& rpL, const RecPtr& rpR) {
+      return (rpL->mTimeMarkNs > rpR->mTimeMarkNs);
