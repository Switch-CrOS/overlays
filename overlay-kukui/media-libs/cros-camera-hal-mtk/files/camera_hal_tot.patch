+#ifndef CAMERA_HAL_MEDIATEK_MTKCAM_PIPELINE_UTILS_STREAMBUF_STREAMBUFFERSETCONTROLIMP_H_
+#define CAMERA_HAL_MEDIATEK_MTKCAM_PIPELINE_UTILS_STREAMBUF_STREAMBUFFERSETCONTROLIMP_H_
+//
+#include <list>
+#include <memory>
