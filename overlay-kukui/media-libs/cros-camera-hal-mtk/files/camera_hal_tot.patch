+/******************************************************************************
+ *
+ ******************************************************************************/
+void HardwareStateControl::setDropNum(MINT32 num) {
+  if (!isActive()) {
+    return;
+  }
+  //
+  std::lock_guard<std::mutex> _l(mLock);
+  mvStoreNum.push_back(num);
+  MY_LOGI("[SUS-RES] CurNum(%d) (%d/%d) @(%d)", num, mStandbySetNum,
+          mStreamingSetNum, mState);
