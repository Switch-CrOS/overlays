+#ifndef CAMERA_HAL_MEDIATEK_MTKCAM_APP_APPSTREAMMGR_H_
+#define CAMERA_HAL_MEDIATEK_MTKCAM_APP_APPSTREAMMGR_H_
+//
+#include <bitset>
+#include <mtkcam/pipeline/stream/StreamId.h>
+
+#include <mtkcam/app/IAppStreamManager.h>
