+/******************************************************************************
+ *
+ ******************************************************************************/
+
+NSCam::v3::Utils::Imp::SyncHelperBase::SyncHelperBase() : mUserCounter(0) {
+  mSyncTimeStart = std::chrono::system_clock::now();
+  mResultTimeStart = std::chrono::system_clock::now();
+}
+
+NSCam::v3::Utils::Imp::SyncHelperBase::~SyncHelperBase() {}
