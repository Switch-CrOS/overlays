+  std::unique_lock<std::mutex> lk(mEnumSensorMutex);
+  MY_LOGF_IF(0 == uCountOfIndex || 0 == pArrayOfIndex,
+             "<%s> Bad uCountOfIndex:%d pArrayOfIndex:%p", szCallerName,
+             uCountOfIndex, pArrayOfIndex);
