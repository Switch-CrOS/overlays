+    E_SYNC2A_MODE_NONE = 1,
+    E_SYNC2A_MODE_VSDOF = 2,
+    E_SYNC2A_MODE_DENOISE = 3,
+    E_SYNC2A_MODE_DUAL_ZOOM = 4,
