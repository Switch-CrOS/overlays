+  mStreamBuffers_Image.clear();
+  mStreamBuffers_HalImage.clear();
+  mStreamBuffers_Meta.clear();
+  mStreamBuffers_HalMeta.clear();
+  //
+  mFlag = FLAG_NO_CHANGE;
