+/******************************************************************************
+ *
+ ******************************************************************************/
+MERROR
+Cam3DeviceImp::onFlushLocked() {
+  MY_LOGD("");
+  //
+  if (!waitUntilOpenDoneLocked()) {
+    MY_LOGE("Flush, initialize fail.");
+    return -ENODEV;
+  }
+
+  //
+  MERROR err = flushAndWait(getSafeAppContext());
+  //
+  return err;
+}
