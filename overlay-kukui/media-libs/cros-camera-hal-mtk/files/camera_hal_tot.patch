+IOPolicyType P2ANode::getIOPolicy(StreamType /*stream*/,
+                                  const StreamingReqInfo& reqInfo) const {
+  IOPolicyType policy = IOPOLICY_INOUT;
+  if (HAS_3DNR(reqInfo.mFeatureMask) && reqInfo.isMaster()) {
+    policy = IOPOLICY_LOOPBACK;
+  }
+
+  return policy;
