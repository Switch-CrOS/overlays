+                                P2Util::SimpleIn* input,
+                                P2MetaSet const& metaSet,
+                                MUINT8 ispProfile,
+                                const ILog& log) const;
+  MBOOL getInputCrop3DNR(MBOOL* isEIS4K,
+                         MBOOL* isIMGO,
+                         MRect* inputCrop,
+                         P2Util::SimpleIn const& input,
+                         const ILog& log) const;
+  MBOOL is3DNRFlowEnabled(MINT32 force3DNR,
+                          IMetadata* appInMeta,
+                          IMetadata* halInMeta,
+                          const ILog& log) const;
