+#define CAMERA_HAL_MEDIATEK_MTKCAM_FEATURE_FEATURECORE_FEATUREPIPE_COMMON_INCLUDE_SEQUTIL_H_
+
+#include <mtkcam/feature/featurePipe/util/VarMap.h>
