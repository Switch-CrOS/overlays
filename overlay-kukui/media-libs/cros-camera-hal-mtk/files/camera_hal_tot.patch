+MBOOL V4L2PipeBase::uninit() {
+  PIPE_BASE_LOGD("+");
+
+  PIPE_BASE_LOGD("flush poller +");
+  if (mp_poller) {
+    mp_poller->flush(true);
+    mp_poller = nullptr;
+  }
+  PIPE_BASE_LOGD("flush poller -");
+
+  msp_pipev4l2mgr = nullptr;
+
+  PIPE_BASE_LOGD("-");
+
+  return MTRUE;
+}
