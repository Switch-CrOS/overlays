+  FID_OVER_LAST_RAW_ONLY_SD,
+  /* RAW-YUV-shared feature id. */
+  FID_PRE_BEGIN_RAW_YUV_SD = FID_OVER_LAST_RAW_ONLY_SD - 1,
+  FID_AE_SCENE_MODE,
+  FID_AE_METERING,
+  FID_AE_ISO,
+  FID_AE_EV,
+  FID_AF_MODE,
+  FID_AF_METERING,
+  FID_AWB_MODE,
+  FID_ISP_EDGE,
