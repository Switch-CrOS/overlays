+  return isValid(mIMGI);
+}
+
+MBOOL P2Util::SimpleIO::hasOutput() const {
+  return isValid(mIMG2O) || isValid(mIMG3O) || isValid(mWROTO) ||
+         isValid(mWDMAO);
+}
