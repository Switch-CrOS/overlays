+namespace NSCam {
+namespace v3 {
+/**
+ * An implementation of pipeline frameNo generator.
+ */
+class PipelineFrameNumberGenerator : public IPipelineFrameNumberGenerator {
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+  //  Operations.
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ public:  //                       Instantiation
+  ~PipelineFrameNumberGenerator();
+  PipelineFrameNumberGenerator();
+
