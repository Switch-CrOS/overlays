+    mMeta.ImgHeight = 0;
+  }
+
+  MyFace(const MyFace& src) {
+    mMeta = src.mMeta;
+    mMeta.faces = mFaceBuffer;
+    mMeta.posInfo = mPosBuffer;
+    for (int i = 0; i < 15; ++i) {
+      mFaceBuffer[i] = src.mFaceBuffer[i];
+      mPosBuffer[i] = src.mPosBuffer[i];
+    }
+  }
+
+  MyFace operator=(const MyFace& src) {
+    mMeta = src.mMeta;
+    mMeta.faces = mFaceBuffer;
+    mMeta.posInfo = mPosBuffer;
+    for (int i = 0; i < 15; ++i) {
