+      return pMetadata;
+    }
+  }
+
+  if (mMetadataItems.find(metaId) == mMetadataItems.end()) {
+    return nullptr;
+  }
+
+  pMetadata = mMetadataItems.at(metaId).mpHandle;
+
+  if (!mMetadataItems.at(metaId).mAcquired) {
