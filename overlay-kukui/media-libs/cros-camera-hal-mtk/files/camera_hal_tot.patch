+#undef LOG_TAG
+#define LOG_TAG "mtkcam-NextCaptureListener"
+//
+#include "MyUtils.h"
+//
+#include <impl/ResultUpdateHelper.h>
+//
+#include <memory>
+#include <mtkcam/pipeline/hwnode/StreamId.h>
