+/******************************************************************************
+ *
+ ******************************************************************************/
+size_t PipelineDAGImp::getNumOfNodes() const {
+  pthread_rwlock_rdlock(&mRWLock);
+  size_t ret = mNodesVec.size();
+  pthread_rwlock_unlock(&mRWLock);
+  return ret;
+}
