+    (void)zEnable;
+  }
+  /**
+   * @brief config DCPN.DCPN2 initialize Parameter
+   */
+  virtual MVOID configDCPN_DCPN2(MINT32 sensorIndex, MBOOL zEnable) {
+    (void)sensorIndex;
+    (void)zEnable;
+  }
