+
+#define LOG_TAG "MtkCam/HalSensor"
+
+#include "MyUtils.h"
+#ifdef USING_MTK_LDVT
+#include <uvvf.h>
+#endif
+#include <fcntl.h>
+#include <mtkcam/def/common.h>
+#include <mtkcam/v4l2/IPCIHalSensor.h>
