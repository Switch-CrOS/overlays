+/******************************************************************************
+ *
+ ******************************************************************************/
+MVOID
+NSCam::v3::Imp::AppStreamMgr::FrameHandler::update(
+    ResultQueueT const& rvResult, std::list<CallbackParcel>* rCbList) {
+  update(rvResult);
+  update(rCbList);
+}
