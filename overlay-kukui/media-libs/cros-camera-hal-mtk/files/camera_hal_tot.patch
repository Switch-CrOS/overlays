+  params->lcsoParam.size.h = lcsoParam.size.h;
+  params->lcsoParam.format = lcsoParam.format;
+  params->lcsoParam.stride = lcsoParam.stride;
+  params->lcsoParam.bitDepth = lcsoParam.bitDepth;
