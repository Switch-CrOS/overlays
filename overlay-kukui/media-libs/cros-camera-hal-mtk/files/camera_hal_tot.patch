+#define LOG_TAG "mtkcam-ConfigStreamInfoPolicy"
+
+#include "mtkcam/pipeline/policy/config/ConfigStreamInfoPolicy.h"
+#include <mtkcam/pipeline/policy/IConfigStreamInfoPolicy.h>
+//
+#include <array>
+#include <compiler.h>
