+/******************************************************************************
+ *
+ ******************************************************************************/
+MBOOL
+BaseImageBufferHeap::lockBuf(char const* szCallerName, MINT usage) {
+  std::lock_guard<std::mutex> _l(mLockMtx);
+  return lockBufLocked(szCallerName, usage);
