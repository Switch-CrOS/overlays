diff --git a/camera/hal/mediatek/mtkcam/main/hal/module/devicemgr/CamDeviceManagerBase.openDevice.cpp b/camera/hal/mediatek/mtkcam/main/hal/module/devicemgr/CamDeviceManagerBase.openDevice.cpp
