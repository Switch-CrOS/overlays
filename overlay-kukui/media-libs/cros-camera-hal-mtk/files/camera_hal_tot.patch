+  }
+  MY_LOGD("[Destroy] mpMTKFDVTObj->destroyInstance");
+  sem_destroy(&mSemFTLock);
+  MY_LOGD("[Destroy] mSemFTLock");
+  mpMTKFDVTObj = NULL;
+}
