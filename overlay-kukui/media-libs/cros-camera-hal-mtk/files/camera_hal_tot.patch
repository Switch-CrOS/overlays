+MVOID StreamingFeaturePipe::releaseGeneralPipe() {
+  P2_CAM_TRACE_CALL(TRACE_DEFAULT);
+  TRACE_FUNC_ENTER();
+  mP2A->setNormalStream(NULL, mDipVersion);
+  if (mNormalStream) {
+    mNormalStream->uninit(NORMAL_STREAM_NAME);
+  }
+  TRACE_FUNC_EXIT();
+}
