+    return -1;
+  LOG1("%s sensor idx:%d e3ACtrl:lensConfig 0x%x ++++", __func__, sensor_index,
+       params->e3ACtrl);
+
+  if (params->e3ACtrl == E3ACtrl_IPC_AF_ExchangeLensConfig) {
+    lensConfig.cmd = params->lensConfig.cmd;
