+  (static_cast<unsigned int>(-(0x0201)))  // unsupport file format
+#define LIBEXIF_APP1_ERR0001 \
+  (static_cast<unsigned int>(-(0x0301)))  // no thumbnail image
+#define LIBEXIF_APP1_ERR0002 \
+  (static_cast<unsigned int>(-(0x0302)))  // tiffer header error found
+#define LIBEXIF_APPN_ERR0003 \
+  (static_cast<unsigned int>(-(0x0303)))  // unrecognised Appn marker
+#define LIBEXIF_APPN_ERR0004 \
+  (static_cast<unsigned int>(-(0x0304)))  // Appn is not added
+#define LIBEXIF_APP1_ERR0005 \
+  (static_cast<unsigned int>(-(0x0305)))  // Unsupport thumb compression mode
+#define LIBEXIF_DQT_ERR0001 \
+  (static_cast<unsigned int>(-(0x0401)))  // too mamy QTs
+#define LIBEXIF_DQT_ERR0002 \
+  (static_cast<unsigned int>(-(0x0402)))  // no DQT Marker
+#define LIBEXIF_DQT_ERR0003 \
+  (static_cast<unsigned int>(-(0x0403)))  // unsupport DQT format
+#define LIBEXIF_DHT_ERR0001 \
+  (static_cast<unsigned int>(-(0x0501)))  // no DHT marker
+#define LIBEXIF_DHT_ERR0002 \
+  (static_cast<unsigned int>(-(0x0502)))  // unsupport DHT00 format
+#define LIBEXIF_DHT_ERR0003 \
+  (static_cast<unsigned int>(-(0x0503)))  // unsupport DHT10 format
+#define LIBEXIF_DHT_ERR0004 \
+  (static_cast<unsigned int>(-(0x0504)))  // unsupport DHT01 format
+#define LIBEXIF_DHT_ERR0005 \
+  (static_cast<unsigned int>(-(0x0505)))  // unsupport DHT11 format
+#define LIBEXIF_DHT_ERR0006 \
+  (static_cast<unsigned int>(-(0x0506)))  // unsupport DHT format
+#define LIBEXIF_SOI_ERR0001 \
+  (static_cast<unsigned int>(-(0x0601)))  // no SOI marker
+#define LIBEXIF_EOI_ERR0001 \
+  (static_cast<unsigned int>(-(0x0701)))  // no EOI marker
+#define LIBEXIF_SOF_ERR0001 \
+  (static_cast<unsigned int>(-(0x0801)))  // no SOF marker
+#define LIBEXIF_SOF_ERR0002 \
+  (static_cast<unsigned int>(-(0x0802)))  // no SOF length error
+#define LIBEXIF_SOF_ERR0003 \
+  (static_cast<unsigned int>(-(0x0803)))  // unsupport data format
+#define LIBEXIF_SOF_ERR0004 \
+  (static_cast<unsigned int>(-(0x0804)))  // unsupport compression mode
+#define LIBEXIF_SOS_ERR0001 \
+  (static_cast<unsigned int>(-(0x0901)))  // no SOS marker
+#define LIBEXIF_SOS_ERR0002 \
+  (static_cast<unsigned int>(-(0x0902)))  // no SOS length error
+#define LIBEXIF_MISC_ERR0001 \
+  (static_cast<unsigned int>(-(0x0A01)))  // unknow error
+#define LIBEXIF_MISC_ERR0002 \
+  (static_cast<unsigned int>(-(0x0A02)))  // file overflow
+#define LIBEXIF_IFD_ERR0001 \
+  (static_cast<unsigned int>(-(0x0B01)))  // unsupport IFD list
+#define LIBEXIF_IFD_ERR0002 \
+  (static_cast<unsigned int>(-(0x0B02)))  // unsupport tag
