+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+  //  Implementations.
+  //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
+ public:  ////                                            Definitions.
+  typedef std::vector<std::shared_ptr<IMetaStreamInfo> > MetaStreamInfoSetT;
+  typedef std::vector<std::shared_ptr<IImageStreamInfo> > ImageStreamInfoSetT;
+  typedef NSCam::v3::Utils::IStreamBufferPool<IImageStreamBuffer>
