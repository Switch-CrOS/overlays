+halFDVT::halFDVT(int openId) {
+  mpMTKFDVTObj = NULL;
+
+  mFDW = 0;
+  mFDH = 0;
+  mInited = 0;
+  mDoDumpImage = 0;
+  mFDRefresh = 3;
+
+  mFDModelVer = 0;
+  sem_init(&mSemFTLock, 0, 1);
+#if (USE_HW_FD)
+  mpMTKFDVTObj = FDIpcClientAdapter::createInstance(DRV_FD_OBJ_HW, openId);
+#else
