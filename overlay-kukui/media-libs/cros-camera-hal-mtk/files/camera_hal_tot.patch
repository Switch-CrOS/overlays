+  for (i = 0; i < num; i++) {
+    info = getImgsensorInfo(i);
+    if (sensor_id == info->sensor_id) {
+      CAM_LOGI("type %d %d 0x%x\n", idx, i, sensor_id);
+      return getImgsensorType(i);
+    }
+  }
+  return IMAGE_SENSOR_TYPE_UNKNOWN;
