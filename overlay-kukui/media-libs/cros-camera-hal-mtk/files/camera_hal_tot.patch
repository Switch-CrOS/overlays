+/****************************************************************************
+ *
+ ****************************************************************************/
+static inline void setDebugTag(void* buffer,
+                               MUINT32 module_id,
+                               MINT32 fieldID,
+                               MINT32 fieldValue) {
+  debug_exif_field* tag = reinterpret_cast<debug_exif_field*>(buffer);
+  tag[fieldID].u4FieldID = DBGEXIF_TAG(module_id, fieldID, 0);
+  tag[fieldID].u4FieldValue = fieldValue;
+}
