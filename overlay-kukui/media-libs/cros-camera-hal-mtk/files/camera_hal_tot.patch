+#ifdef CC_ENUM
+#undef CC_ENUM
+#endif
+#define CC_ENUM(code) e_##code
+  //
+#ifdef CCLT
+#undef CCLT
+#endif
+#define CCLT(code, type, name, info, ...) \
+  CC_ENUM(code) = (MUINT64)(type << code),
+  enum ClueCode {
+    CC_NONE = (MUINT64)(0x0000000000000000),
+    //
+    ClueCodeListTable
+        //
+        CC_ALL = (MUINT64)(0xFFFFFFFFFFFFFFFF)
