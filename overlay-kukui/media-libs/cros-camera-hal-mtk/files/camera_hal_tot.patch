+MVOID MWInfo::initMetaInfo(
+    ID_META id, const std::vector<std::shared_ptr<IMetaStreamInfo>>& infos) {
+  TRACE_FUNC_ENTER();
+  for (auto&& info : infos) {
+    if (info != nullptr) {
+      mMetaInfoMap[id].push_back(info);
+      mMetaIDMap[info->getStreamId()] = id;
+    }
+  }
