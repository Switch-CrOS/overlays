+ public:
+  class AutoMemo {
+   public:
+    AutoMemo(LogInfo* logInfo,
+             LogInfo::CheckPoint cpEnter,
+             LogInfo::CheckPoint cpExit,
+             MINT64 param0 = 0,
+             MINT64 param1 = 0,
+             MINT64 param2 = 0,
+             MINT64 param3 = 0)
+        : mLogInfo(*logInfo),
+          mCpEnter(cpEnter),
+          mCpExit(cpExit),
+          mP0(param0),
+          mP1(param1),
+          mP2(param2),
+          mP3(param3) {
+      mLogInfo.setMemo(mCpEnter, mP0, mP1, mP2, mP3);
+    }
+    virtual ~AutoMemo() { mLogInfo.setMemo(mCpExit, mP0, mP1, mP2, mP3); }
+
+   private:
+    LogInfo& mLogInfo;
+    LogInfo::CheckPoint mCpEnter;
+    LogInfo::CheckPoint mCpExit;
+    MINT64 mP0;
+    MINT64 mP1;
+    MINT64 mP2;
+    MINT64 mP3;
+  };
