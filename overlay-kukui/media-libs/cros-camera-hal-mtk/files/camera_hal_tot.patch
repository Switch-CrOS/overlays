+PathID_T FindPath(NodeID_T src, NodeID_T dst) {
+  for (PathID_T pid = PID_ENQUE + 1; pid < NUM_OF_PATH; pid++) {
+    if (sPathMap[pid][0] == src && sPathMap[pid][1] == dst) {
+      return pid;
+    }
+  }
+  return NULL_PATH;
+}
