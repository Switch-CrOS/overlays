+class INodeActor {
+ public:
+  enum {
+    // eNodeState_None,
+    eNodeState_Create,
+    eNodeState_Init,
+    eNodeState_Config,
+  };
+  //
+ public:
+  virtual ~INodeActor() {}
+  // protected:
+  explicit INodeActor(MUINT32 st) : muStatus(st) {}
+
+ public:
+  MUINT32 getStatus() const;
+
+ public:
+  MERROR init();
+  MERROR config();
+  MERROR uninit();
+
+ protected:  // template methods: to be implmented by derived class
