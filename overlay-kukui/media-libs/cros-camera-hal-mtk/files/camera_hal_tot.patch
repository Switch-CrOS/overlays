+                          const IPipelineNode::NodeId_T& nodeID);
+  MUINT32 getMWFrameID() const;
+  MUINT32 getMWFrameRequestID() const;
+  MUINT32 getFrameID() const;
+  MVOID notifyRelease();
+  MVOID beginBatchRelease();
+  MVOID endBatchRelease();
