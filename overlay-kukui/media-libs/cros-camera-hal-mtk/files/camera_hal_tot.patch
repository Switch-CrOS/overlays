+/******************************************************************************
+ *
+ ******************************************************************************/
+void HardwareStateControl::clean(void) {
+  mIsLegacyStandby = MFALSE;
+  mState = STATE_NORMAL;
+  mStandbySetNum = 0;
+  mStreamingSetNum = 0;
+  mShutterTimeUs = 0;
+  mRequestPass = MFALSE;
+  mvStoreNum.clear();
+  mRequestCond.notify_all();
+  mThreadCond.notify_all();
+  return;
+}
