+/*******************************************************************************
+ *
+ ******************************************************************************/
+struct DbgInfo {
+  mutable MUINT8* puDbgBuf;
+  MUINT32 u4BufSize;
+
+  explicit DbgInfo(MUINT8* _puDbgBuf = NULL, MUINT32 _u4BufSize = 0)
+      : puDbgBuf(_puDbgBuf), u4BufSize(_u4BufSize) {}
+};
