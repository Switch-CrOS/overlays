+
+// MTKCAM
+#include <mtkcam/aaa/IHal3A.h>
+#include <mtkcam/drv/iopipe/CamIO/V4L2IIOPipe.h>
+#include <mtkcam/utils/imgbuf/IImageBuffer.h>
