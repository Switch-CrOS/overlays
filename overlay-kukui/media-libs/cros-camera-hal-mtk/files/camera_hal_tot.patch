+  MVOID releaseV4l2Buffer();
+
+  struct BufferItem {
+    IImageBuffer* mpImageBuffer;
+    MUINT32 mTransform;
+    MRect mCrop;
+    MBOOL mIsCapture;
+  };
+  std::vector<BufferItem> mBufferItems;
+
+ private:
+  WaitQueue<RequestPtr> mRequests;
+  V4l2MdpInfo mV4l2MdpInfo;
+  MBOOL mDebugDump;
+  MBOOL mM2MMdpDump;
+};
