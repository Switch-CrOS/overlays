+    static std::string StreamInfoSetControl(
+        std::shared_ptr<const IStreamInfoSetControl> s) {
+      std::string os;
+      os += " .AppImage={ ";
+      os += dump::StreamInfo(s->getAppImage());
+      os += "}";
