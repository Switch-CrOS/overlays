+MVOID
+NSCam::v3::Imp::AppStreamMgr::updateResult(
+    MUINT32 const frameNo,
+    MINTPTR const userId,
+    std::vector<std::shared_ptr<IMetaStreamBuffer> > resultMeta,
+    bool hasLastPartial) {
+  enqueResult(frameNo, userId, resultMeta, hasLastPartial);
+}
