+#define MTK_SCP_CACHED_MMAP
+
+/********************************************
+ * DMA ops for cacheable mmap               *
+ ********************************************/
+#ifdef MTK_SCP_CACHED_MMAP
+struct dma_coherent_mem {
+	void		*virt_base;
+	dma_addr_t	device_base;
+	unsigned long	pfn_base;
+	int		size;
+	int		flags;
+	unsigned long	*bitmap;
+	spinlock_t	spinlock; /* protect dma_coherent_mem member */
+	bool		use_dev_dma_pfn_offset;
+};
+
+static struct dma_coherent_mem *dev_get_coherent_memory(struct device *dev)
+{
+	if (dev && dev->dma_mem)
+		return dev->dma_mem;
+	return NULL;
+}
+
+static void *mtk_scp_sync_get_cpu_addr(struct mtk_scp *scp,
+				       struct scatterlist *sgl)
+{
+	struct device *dev = scp->dev;
+	struct dma_coherent_mem *dma_mem = dev_get_coherent_memory(dev);
+	phys_addr_t addr;
+	void *cpu_addr;
+
+	if (!dma_mem) {
+		dev_info(dev, "%s, return: dma_mem:%p\n", __func__, dma_mem);
+		return NULL;
+	}
+
+	addr = (phys_addr_t)sg_phys(sgl);
+	if (addr < dma_mem->device_base ||
+	    addr >= dma_mem->device_base + (dma_mem->size << PAGE_SHIFT)) {
+		dev_err(dev,
+			"%s: Invalid paddr(%pa), s(%d), dma_mem(%p, %pad, %d)\n",
+			__func__, &addr, sgl->length, dma_mem->virt_base,
+			&dma_mem->device_base, dma_mem->size << PAGE_SHIFT);
+		return NULL;
+	}
+
+	cpu_addr = dma_mem->virt_base + (addr - dma_mem->device_base);
+
+	dev_dbg(dev, "%s: paddr(%pa),vaddr(%p),size(%d)\n",
+		__func__, &addr, cpu_addr, sgl->length);
+
+	return cpu_addr;
+}
+
+static void mtk_scp_sync_sg_for_cpu(struct device *dev,
+				    struct scatterlist *sgl,
+				    int nelems,
+				    enum dma_data_direction dir)
+{
+	struct mtk_scp *scp = dev_get_drvdata(dev);
+	phys_addr_t addr = (phys_addr_t) sg_phys(sgl);
+	void *cpu_addr = mtk_scp_sync_get_cpu_addr(scp, sgl);
+
+	dev_dbg(dev, "%s: paddr(%pa),vaddr(%p),size(%d)\n",
+		__func__, &addr, cpu_addr, sgl->length);
+
+	if (cpu_addr)
+		__dma_unmap_area(cpu_addr, sgl->length, dir);
+}
+
+static void mtk_scp_sync_sg_for_device(struct device *dev,
+				       struct scatterlist *sgl,
+				       int nelems,
+				       enum dma_data_direction dir)
+{
+	struct mtk_scp *scp = dev_get_drvdata(dev);
+	phys_addr_t addr = (phys_addr_t) sg_phys(sgl);
+	void *cpu_addr = mtk_scp_sync_get_cpu_addr(scp, sgl);
+
+	dev_dbg(dev, "%s: paddr(%pa),vaddr(%p),size(%d)\n",
+		__func__, &addr, cpu_addr, sgl->length);
+
+	if (cpu_addr)
+		__dma_map_area(cpu_addr, sgl->length, dir);
+}
+
+static int mtk_scp_setup_dma_ops(struct mtk_scp *scp)
+{
+	memcpy((void *)&scp->dma_ops, scp->dev->dma_ops,
+	       sizeof(scp->dma_ops));
+
+	scp->dma_ops.sync_sg_for_device =
+		mtk_scp_sync_sg_for_device;
+	scp->dma_ops.sync_sg_for_cpu =
+		mtk_scp_sync_sg_for_cpu;
+
+	scp->dev->dma_ops = &scp->dma_ops;
+
+	return 0;
+}
+#endif /* MTK_SCP_CACHED_MMAP */
+
 static int scp_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -531,6 +635,10 @@ static int scp_probe(struct platform_device *pdev)
 	if (ret)
 		goto remove_subdev;
 
