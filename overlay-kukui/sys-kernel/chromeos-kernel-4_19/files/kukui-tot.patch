+#ifndef _MTK_FD_SMEM_H_
+#define _MTK_FD_SMEM_H_
+
+#include <linux/dma-mapping.h>
+#include <linux/device.h>
+#include "mtk_fd-dev.h"
+
+phys_addr_t mtk_fd_smem_iova_to_phys(struct device *dev, dma_addr_t iova);
