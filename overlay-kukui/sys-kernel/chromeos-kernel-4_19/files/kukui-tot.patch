+/* MIPI sensor pad usage */
+struct seninf_csi_info {
+	unsigned int port;
+	unsigned int         seninf;
+};
+
+struct seninf_csi_mipi {
+	struct seninf_csi_info  *csi_info;
+	unsigned int     data_lane_num;
+	unsigned int     dpcm;
+};
+
+#endif /*__SENINF_DRV_DEF_H__ */
