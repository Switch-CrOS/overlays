+		value[30], value[31], value[51]);
+	mdp_err("WDMA_DEBUG_C +014: 0x%08x , +0ac: 0x%08x , +0b8: 0x%08x\n",
+		value[32], value[33], value[52]);
+	mdp_err("WDMA_DEBUG_D +014: 0x%08x , +0ac: 0x%08x , +0b8: 0x%08x\n",
