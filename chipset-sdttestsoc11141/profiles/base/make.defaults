# Initial value just for style purposes.
LINUX_FIRMWARE=""
USE=""

CHROMEOS_KERNEL_ARCH="arm_64" #"x86_64", "arm64", etc...
# Specify default kernel
USE="${USE} kernel-5_15" # kernel-5_15, kernel-5_10, etc...

# Identify the vendor
USE="${USE} mediatek_cpu" # intel, amd, etc...

# Enable fscrypt v2 usage on 5.4+
USE="${USE} direncription_allow_v2"