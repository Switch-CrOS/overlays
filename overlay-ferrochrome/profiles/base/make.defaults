# Initial value just for style purposes.
USE=""
LINUX_FIRMWARE=""

LINUX_FIRMWARE="${LINUX_FIRMWARE} -iwlwifi-all -keyspan_usb"

# Disable rootfs Lacros.
USE="${USE} -lacros_rootfs"

# Disable non-essential networking services.
USE="${USE} -attestation -cellular"

# Disable filesystem extensions.
USE="${USE} -drivefs -fusebox -samba -smbprovider"

TTY_CONSOLE="ttyS0 -ttyAMA0"

EXTRA_GN_ARGS="arm_control_flow_integrity=\"none\""
