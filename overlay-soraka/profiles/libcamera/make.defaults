# Initial value just for style purposes.
USE=""

# Select libcamera
USE="${USE} libcamera"

# libcamera requires a recent kernel
USE="${USE} -kernel-4_4 kernel-5_4"

# Enable fscrypt v2 usage on 5.4+
USE="${USE} direncription_allow_v2"
