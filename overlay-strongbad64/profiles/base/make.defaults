# Initial value just for style purposes.
USE=""

USE="${USE} -tpm tpm2"

USE="${USE} strongbad64"

# Don't build coreboot firmware
USE="${USE} -bootimage -coreboot"

# VIDEO_CARDS gets reset to the default value in the arm64 base chromeos
# profile because it is inherited after overlay-strongbad (see parent in this
# directory). Add back what overlay-strongbad would have.
VIDEO_CARDS="msm"

# INPUT_DEVICES gets reset to the default value in the arm64 base chromeos
# profile because it is inherited after overlay-strongbad (see parent in this
# directory). Add back what overlay-strongbad would have.
INPUT_DEVICES="${INPUT_DEVICES} elan_i2chid"
INPUT_DEVICES="${INPUT_DEVICES} goodix"
INPUT_DEVICES="${INPUT_DEVICES} nvt_ts"

# The `armv8-a` RUSTFLAG from chipset-qc7180 is a nop for us, and causes a lot
# of noise since LLVM doesn't know what to do with it. Just use +crc here.
BOARD_RUSTFLAGS="-Ctarget-feature=+crc"
