# Initial value just for style purposes.
USE=""

# Inherit the USE flags from both the public and private veyron
# overlays. Only add USE flags specific to speedy here.
USE="${USE} veyron_speedy"

USE="${USE} -veyron-brcmfmac-nvram"

# Don't perform bluetooth suspension procedure on this platform.
# Refer to crbug.com/953860
USE="${USE} -bluetooth_suspend_management"

# The EC board name is speedy
EC_FIRMWARE="speedy"
