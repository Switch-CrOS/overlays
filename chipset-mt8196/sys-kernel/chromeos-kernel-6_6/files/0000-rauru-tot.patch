--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_kinstr_prfcnt.h
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
