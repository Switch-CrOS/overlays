+	}
+
+	/* check input params */
+	if (mdw_cmd_sanity_check(c)) {
+		mdw_drv_err("cmd sanity check fail\n");
+		goto put_execinfos;
+	}
+
+	/* subcmds/ksubcmds */
+	c->subcmds = kzalloc(c->num_subcmds * sizeof(*c->subcmds), GFP_KERNEL);
+	if (!c->subcmds)
+		goto put_execinfos;
+	if (copy_from_user(c->subcmds, (void __user *)in->exec.subcmd_infos,
