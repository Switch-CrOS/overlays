+	KBASE_KTRACE_CODE_MAKE_CODE(SCHEDULER_TICK_START),
+	KBASE_KTRACE_CODE_MAKE_CODE(SCHEDULER_TICK_END),
+	KBASE_KTRACE_CODE_MAKE_CODE(SCHEDULER_RESET_START),
+	KBASE_KTRACE_CODE_MAKE_CODE(SCHEDULER_RESET_END),
