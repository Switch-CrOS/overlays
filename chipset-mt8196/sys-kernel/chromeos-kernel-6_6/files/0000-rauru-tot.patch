+void memcpy_to_vcp(void __iomem *trg, const void *src, int size)
+{
+	int i;
+	u32 __iomem *t = trg;
+	const u32 *s = src;
+
+	for (i = 0; i < ((size + 3) >> 2); i++)
+		*t++ = *s++;
+}
