+static void ged_timer_switch_work_handle(struct work_struct *psWork)
+{
+	struct GED_NOTIFY_SW_SYNC *psNotify =
+		GED_CONTAINER_OF(psWork, struct GED_NOTIFY_SW_SYNC, sWork);
+	if (psNotify) {
+		ged_sw_vsync_event(false);
+
+		psNotify->bUsed = false;
