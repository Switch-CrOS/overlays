+	do { \
+		char info[150];\
+		mdw_drv_err(reason, args); \
+		if (snprintf(info, 150, "apu_mdw:" reason, args) > 0) { \
+			aee_kernel_exception(info, \
+				"\nCRDISPATCH_KEY:%s\n", key); \
+		} else { \
+			mdw_drv_err("apu_mdw: %s snprintf fail(%d)\n", __func__, __LINE__); \
+		} \
+	} while (0)
