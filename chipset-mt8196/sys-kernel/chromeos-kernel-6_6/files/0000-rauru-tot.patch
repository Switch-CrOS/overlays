+void gpu_pdma_vma_open(struct vm_area_struct *vma)
+{
+	pr_debug("gpu_pdma VMA open, virt %lx, phys %lx\n", vma->vm_start, vma->vm_pgoff << PAGE_SHIFT);
+}
