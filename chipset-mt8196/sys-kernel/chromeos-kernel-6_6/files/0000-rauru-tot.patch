diff --git a/drivers/gpu/mediatek/arm/midgard/hwcnt/backend/mali_kbase_hwcnt_backend.h b/drivers/gpu/mediatek/arm/midgard/hwcnt/backend/mali_kbase_hwcnt_backend.h
