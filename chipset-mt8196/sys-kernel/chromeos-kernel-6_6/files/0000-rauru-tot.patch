+enum ipi_debug_opt {
+	IPI_TRACKING_OFF,
+	IPI_TRACKING_ON,
+	IPIMON_SHOW,
+	IPI_PROFILING,
+	IPI_PBFR,
+	IPI_VCP_TEST = 100,
+	IPI_VCP_TEST_END = 199,
+	IPI_MMUP_TEST = 200,
+	IPI_MMUP_TEST_END = 299,
+	IPI_DEBUG_MAX = 300,
+};
