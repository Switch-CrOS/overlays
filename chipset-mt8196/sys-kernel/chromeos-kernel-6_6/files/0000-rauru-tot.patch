+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_hwaccess_jm.h
@@ -0,0 +1,308 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ *
