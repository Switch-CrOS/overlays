+mtk_dp_mst_connector_late_register(struct drm_connector *connector)
+{
+	struct mtk_dp_con *mtk_con = container_of(connector, struct mtk_dp_con, connector);
+	int ret;
+
+	ret = drm_dp_mst_connector_late_register(connector,
+						 mtk_con->port);
+	if (ret < 0)
+		return ret;
+
+	return ret;
+}
