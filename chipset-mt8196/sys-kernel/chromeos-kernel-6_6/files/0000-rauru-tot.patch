+
+	*log_size += scnprintf(log_buf + *log_size,
+		LOG_BUF_OUT_SZ - *log_size,
+		" sw_flag = 0x%x 0x%x\n",
+		wakesrc->sw_flag0, wakesrc->sw_flag1);
+
+	*log_size += scnprintf(log_buf + *log_size,
+		LOG_BUF_OUT_SZ - *log_size,
+		" b_sw_flag = 0x%x 0x%x",
+		wakesrc->b_sw_flag0, wakesrc->b_sw_flag1);
+}
