+	if (g_mdw_klog & MDW_DBG_CMD) {
+		print_hex_dump(KERN_INFO, "[apusys] adj matrix: ",
+			DUMP_PREFIX_OFFSET, 16, 1, c->adj_matrix,
+			c->num_subcmds * c->num_subcmds, 0);
+	}
+	if (mdw_cmd_adj_check(c))
