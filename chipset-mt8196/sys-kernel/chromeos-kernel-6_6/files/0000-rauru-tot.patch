+static ssize_t write_ctx_force_same_va(struct file *f, const char __user *ubuf, size_t size,
+				       loff_t *off)
+{
+	struct kbase_context *kctx = f->private_data;
+	int err;
+	bool value;
+
+	CSTD_UNUSED(off);
