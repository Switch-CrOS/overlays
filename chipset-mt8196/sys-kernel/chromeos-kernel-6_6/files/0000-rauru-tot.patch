+/*
+ * set vcp_A_logger_inited
+ */
+void vcp_logger_init_set(unsigned int value)
+{
+	/*vcp_A_logger_inited
+	 *  0: logger not init
+	 *  1: logger inited
+	 */
+	vcp_A_logger_inited = value;
+}
