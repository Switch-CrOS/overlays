+/*
+ * void timer_switch(bool bTock)
+ * only set the staus, not really operating on real timer
+ */
+void timer_switch(bool bTock)
+{
+	mutex_lock(&gsVsyncStampLock);
+	g_timer_on = bTock;
+	if (bTock)
+		g_timer_on_ts = ged_get_time();
+	mutex_unlock(&gsVsyncStampLock);
+}
+
+void timer_switch_locked(bool bTock)
+{
+	g_timer_on = bTock;
+	if (bTock)
+		g_timer_on_ts = ged_get_time();
+}
