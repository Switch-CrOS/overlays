+	IPI_OUT_VENC_0                 = 16,
+	IPI_IN_VENC_0                  = 17,
+//	IPI_OUT_VCP_MPOOL_0            = 18,
+//	IPI_IN_VCP_MPOOL_0             = 19,
+	IPI_OUT_C_SLEEP_1              = 20,
+	IPI_OUT_TEST_1                 = 21,
+	IPI_OUT_LOGGER_CTRL_0          = 22,
+	IPI_OUT_VCPCTL_1               = 23,
+//	IPI_IN_VCP_ERROR_INFO_1        = 24,
+	IPI_IN_LOGGER_CTRL_0           = 25,
+	IPI_IN_VCP_READY_1             = 26,
