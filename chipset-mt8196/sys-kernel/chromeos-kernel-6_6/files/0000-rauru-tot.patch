diff --git a/drivers/gpu/drm/mediatek/mtk_dp_dsc.c b/drivers/gpu/drm/mediatek/mtk_dp_dsc.c
new file mode 100644
index 0000000000000000000000000000000000000000..7f1f01317685ce1a9ef1271c9244700b55f961c2
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_dp_dsc.c
@@ -0,0 +1,516 @@
+// SPDX-License-Identifier: GPL-2.0
