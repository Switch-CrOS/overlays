+	VDEC_IPI_MSG_STATUS_ILSEQ   = -3,
+	VDEC_IPI_MSG_STATUS_INVALID_ID  = -4,
+	VDEC_IPI_MSG_STATUS_DMA_FAIL    = -5,
+};
