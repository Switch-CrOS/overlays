+ap_i2c_tchpad: &i2c0 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_pins>;
+
+	status = "okay";
+
+	trackpad: trackpad@15 {
+		compatible = "elan,ekth3000";
+		reg = <0x15>;
+		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tchpad_int_odl>;
+		vcc-supply = <&pp3300_tchpad>;
+		wakeup-source;
+	};
+};
+
+ap_i2c_tpm: &i2c1 {
+	clock-frequency = <1000000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_pins>;
+
+	status = "okay";
+
+	tpm@50 {
+		/* TODO: Upstream adding the "ti50" compatible */
+		compatible = "google,ti50", "google,cr50";
+		reg = <0x50>;
+		interrupts-extended = <&pio 18 IRQ_TYPE_EDGE_RISING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&gsc_ap_int_odl>;
+	};
+};
+
+ap_i2c_tchscr: &i2c2 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2_pins>;
+
+	status = "okay";
+
+	touchscreen: touchscreen@41 {
+		compatible = "ilitek,ili2901";
+		reg = <0x41>;
+		interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchscreen_pins>;
+		reset-gpios = <&pio 31 GPIO_ACTIVE_LOW>;
+		vcc33-supply = <&pp3300_tchscr>;
+	};
+};
+
+ap_i2c_aud: &i2c3 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3_pins>;
+
+	status = "okay";
+
+	nau8825: nau8825@1a {
+		#sound-dai-cells = <0>;
+		compatible = "nuvoton,nau8825";
+		reg = <0x1a>;
+		interrupts-extended = <&pio 10 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&nau8825_pins_default>;
+
+		nuvoton,jkdet-enable;
+		nuvoton,jkdet-polarity = <1>;
+		nuvoton,vref-impedance = <2>;
+		nuvoton,micbias-voltage = <6>;
+		nuvoton,sar-threshold-num = <4>;
+		nuvoton,sar-threshold = <0xc 0x1e 0x38 0x60>;
+		nuvoton,sar-hysteresis = <1>;
+		nuvoton,sar-voltage = <0>;
+		nuvoton,sar-compare-time = <0>;
+		nuvoton,sar-sampling-time = <0>;
+		nuvoton,short-key-debounce = <2>;
+		nuvoton,jack-insert-debounce = <7>;
+		nuvoton,jack-eject-debounce = <7>;
+		nuvoton,adc-delay-ms = <300>;
+		status = "disabled";
+	};
+
+	rt5682s: rt5682s@1a {
+		compatible = "realtek,rt5682s";
+		reg = <0x1a>;
+		interrupt-parent = <&pio>;
+		interrupts = <10 IRQ_TYPE_EDGE_BOTH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&nau8825_pins_default>;
+		realtek,jd-src = <1>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	/* example with quad tas2781s, such as tablet or pad device */
+	quad_tas2563: tas2563@4c {
+		compatible = "ti,tas2563";
+		reg = <0x4c>, /* Audio slot 0 */
+			<0x4d>, /* Audio slot 1 */
+			<0x4e>, /* Audio slot 2 */
+			<0x4f>; /* Audio slot 3 */
+
+		#sound-dai-cells = <0>;
+		reset-gpios = <&pio 174 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pio 9 IRQ_TYPE_LEVEL_LOW>;
+		status = "disabled";
+	};
+};
