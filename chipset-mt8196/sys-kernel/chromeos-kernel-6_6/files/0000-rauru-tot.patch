diff --git a/drivers/gpu/drm/mediatek/mtk_edp_debug.c b/drivers/gpu/drm/mediatek/mtk_edp_debug.c
new file mode 100644
index 0000000000000000000000000000000000000000..d1028748279bd67ccac5f6faa8700b7aabc0ae44
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/mtk_edp_debug.c
@@ -0,0 +1,445 @@
+// SPDX-License-Identifier: GPL-2.0
