+#define OVL_OP_8BIT_MODE				BIT(4)
+#define OVL_HG_FOVL_CK_ON				BIT(8)
+#define OVL_HF_FOVL_CK_ON				BIT(10)
+#define DISP_REG_OVL_DATAPATH_CON		0x014
+#define DATAPATH_CON_LAYER_SMI_ID_EN			BIT(0)
