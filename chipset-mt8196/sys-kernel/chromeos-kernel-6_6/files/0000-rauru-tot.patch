+		return g_virtual_table[oppidx].freq;
+
+	if (g_working_table == NULL)
+		return gpufreq_get_freq_by_idx(TARGET_DEFAULT, oppidx);
+
+	if (unlikely(oppidx > g_min_working_oppidx))
