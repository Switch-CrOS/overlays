+// choose the smallest oppidx (highest freq) for same stack freq
+static int get_max_oppidx_with_same_stack(int oppidx)
+{
+	if (!oppidx)
+		return oppidx;
+
+	while (oppidx > 1 &&
+		  ged_get_sc_freq_by_virt_opp(oppidx) == ged_get_sc_freq_by_virt_opp(oppidx - 1))
+		oppidx--;
+
+	return oppidx;
+}
