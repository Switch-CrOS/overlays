+++ b/drivers/gpu/mediatek/arm/midgard/device/mali_kbase_device_hw.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
+ *
+ * (C) COPYRIGHT 2014-2024 ARM Limited. All rights reserved.
+ *
