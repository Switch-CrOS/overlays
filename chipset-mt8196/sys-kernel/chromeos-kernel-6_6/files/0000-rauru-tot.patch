+	*res_bits  = APUMMU_SEGMENT_GET_OFFSET0_RSRV(vsid_idx, seg_idx);
+	*page_sel  = APUMMU_SEGMENT_GET_PAGESEL(vsid_idx, seg_idx);
+	*page_len  = APUMMU_SEGMENT_GET_PAGELEN(vsid_idx, seg_idx);
+
+	return 0; //indicate success or fail
+}
