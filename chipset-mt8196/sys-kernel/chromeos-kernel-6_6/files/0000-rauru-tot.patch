--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/device/backend/mali_kbase_device_jm.c
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
