--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_regs_history_debugfs.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ *
+ * (C) COPYRIGHT 2014-2023 ARM Limited. All rights reserved.
+ *
