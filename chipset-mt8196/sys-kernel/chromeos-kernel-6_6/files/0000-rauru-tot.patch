+#define LPM_LOGGER_NODE_INIT(_n, _priv) ({\
+	_n.op.fs_read = lpm_logger_debugfs_read;\
+	_n.op.fs_write = lpm_logger_debugfs_write;\
+	_n.op.priv = _priv; })\
+
