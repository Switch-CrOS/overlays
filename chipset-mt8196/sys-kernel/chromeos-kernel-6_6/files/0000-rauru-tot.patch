diff --git a/drivers/gpu/mediatek/arm/midgard/platform/mt8196/mtk_proprietary/base/arm/Makefile b/drivers/gpu/mediatek/arm/midgard/platform/mt8196/mtk_proprietary/base/arm/Makefile
