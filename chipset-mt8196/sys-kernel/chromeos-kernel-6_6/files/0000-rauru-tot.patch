+//#define MVPU_SEC_MPU_NUM_BLOCK  // Forbidden buffer num > MVPU_MPU_SEGMENT_NUMS
+#define MVPU_SEC_UPDT_MPU       // Use mem pool's MPU region setting instead of engine's setting
