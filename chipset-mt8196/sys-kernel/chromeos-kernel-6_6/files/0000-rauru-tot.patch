+				ret = -ENOMEM;
+				goto END_WITH_MUTEX;
+			}
+
+			primem_dst_buf_id_kva =
+				apusys_mem_query_kva_by_sess(session, mvpu_req->primem_dst_buf_id);
+
+			if (primem_dst_buf_id_kva != NULL)
+				memcpy(primem_dst_buf_id, primem_dst_buf_id_kva,
