+#define SSPM_PLT_LOGGER_BUF_LEN 0x100000
+
+#ifdef _SSPM_INTERNAL_
+/* The total size of sspm_reserve_mblock should less equal than
+ * reserve-memory-sspm_share of device tree
+ */
