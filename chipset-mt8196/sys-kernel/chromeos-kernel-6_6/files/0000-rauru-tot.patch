diff --git a/drivers/gpu/mediatek/arm/midgard/include/uapi/gpu/arm/midgard/gpu/mali_kbase_gpu_id.h b/drivers/gpu/mediatek/arm/midgard/include/uapi/gpu/arm/midgard/gpu/mali_kbase_gpu_id.h
