index 0000000000000000000000000000000000000000..1af173c0e0b966eb14a036af9eb5fb4aba30699b
--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/csf/mali_kbase_csf_firmware_log.c
@@ -0,0 +1,546 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
+ *
+ * (C) COPYRIGHT 2021-2023 ARM Limited. All rights reserved.
+ *
