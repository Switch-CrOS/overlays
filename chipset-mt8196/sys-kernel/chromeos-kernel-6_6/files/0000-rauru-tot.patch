+#if KERNEL_VERSION(5, 5, 0) <= LINUX_VERSION_CODE
+/* Adapting to the upstream debugfs_create_x32() change */
+static int ktufp_u32_get(void *data, u64 *val)
+{
+	*val = *(u32 *)data;
+	return 0;
+}
