+
+	for (i = 0; i < vcp_mboxdev.count; i++)
+		disable_irq(vcp_mboxdev.info_table[i].irq_num);
+
+	if (vcpreg.core_nums == 2)
+		mmup_disable_irqs();
+
+	tasklet_disable(&vcp_A_irq0_tasklet);
+	tasklet_disable(&vcp_A_irq1_tasklet);
+
