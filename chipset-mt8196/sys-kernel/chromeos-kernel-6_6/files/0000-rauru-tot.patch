+static void mtk_set_ged_ready_handler(struct work_struct *work)
+{
+	static int retry_count;
+	int ret = 0;
+
+	do {
+		retry_count += 1;
+		ret = mtk_set_ged_ready(1);
+		GPUFDVFS_LOGI("(attempt %d) mtk_set_ged_ready return %d", retry_count,
+			ret);
+	} while (ret != 0);
