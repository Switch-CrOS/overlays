+static void mtk_dvo_pm_ctl(struct mtk_dvo *dvo, bool enable)
+{
+	/* DISP_EDPTX_PWR_CON */
+	void *address = ioremap(0x31B50074, 0x1);
+
+	if (enable)
+		writel(0xC2FC224D, address);
+	else
+		writel(0xC2FC2372, address);
+
+	if (address)
+		iounmap(address);
+}
