+	{ .compatible = "mediatek,mt8196-slbc", .data = &slbc_pdata_mt8196 },
+	{}
+};
+
+static struct platform_driver slbc_pdrv = {
+	.probe = slbc_probe,
+	.remove = slbc_remove,
+	.driver = {
+		.name = "slbc",
+		.owner = THIS_MODULE,
