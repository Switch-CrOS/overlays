--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_linux_trace.h
@@ -0,0 +1,427 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ *
