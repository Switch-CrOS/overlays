+static void __iomem *__gpufreq_of_ioremap(const char *node_name, int idx)
+{
+	struct device_node *node;
+	void __iomem *base;
+
+	node = of_find_compatible_node(NULL, NULL, node_name);
+
+	if (node)
+		base = of_iomap(node, idx);
+	else
+		base = NULL;
+
+	return base;
+}
