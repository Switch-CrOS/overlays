+		.name = "clk-chk-mt8196",
+		.owner = THIS_MODULE,
+		.pm = &clk_chk_dev_pm_ops,
+		.of_match_table = of_match_clkchk_mt8196,
+	},
+};
+
+/*
+ * init functions
+ */
+
+static int __init clkchk_mt8196_init(void)
+{
+	return platform_driver_register(&clk_chk_mt8196_drv);
+}
+
+static void __exit clkchk_mt8196_exit(void)
+{
+	platform_driver_unregister(&clk_chk_mt8196_drv);
+}
+
+subsys_initcall(clkchk_mt8196_init);
+module_exit(clkchk_mt8196_exit);
+MODULE_LICENSE("GPL");
