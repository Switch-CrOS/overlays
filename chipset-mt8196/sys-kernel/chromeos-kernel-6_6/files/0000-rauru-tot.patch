diff --git a/drivers/soc/mediatek/mtk-vdisp.c b/drivers/soc/mediatek/mtk-vdisp.c
new file mode 100644
index 0000000000000000000000000000000000000000..cc03363a0cddaf5447bad876b63e0e36b8279617
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-vdisp.c
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 MediaTek Inc.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#if IS_ENABLED(CONFIG_MTK_TINYSYS_VCP_SUPPORT)
+#include "vcp_status.h"
+#endif
+
+#define VOTE_DELAY_US			2
+#define HW_CCF_AP_VOTER_BIT		0
+#define HW_CCF_XPU0_BACKUP1_SET		0x230
+#define HW_CCF_XPU0_BACKUP1_CLR		0x234
+#define HW_CCF_BACKUP1_DONE		0x143c
+#define HW_CCF_BACKUP1_SET_STATUS	0x1484
+#define HW_CCF_BACKUP1_CLR_STATUS	0x1488
+
+static const char * const mtk_vdisp_clks[] = {"apb", "dpc", "smi-subcomm"};
+
+struct mtk_vdisp_ctrl {
+	struct device		*dev;
+	struct mutex		lock;
+	struct regmap		*hwccf_regmap;
+	atomic_t		mtcmos_status;
+	struct notifier_block	pd_nb;
+	bool			vcp_is_alive;
+	bool			need_update;
+	struct notifier_block	vcp_nb;
+	struct clk_bulk_data	clks[ARRAY_SIZE(mtk_vdisp_clks)];
+};
+
+static void vdisp_hwccf_ctrl(struct mtk_vdisp_ctrl *priv, bool enable)
+{
+	u32 val;
+	int ret;
+	u32 ctrl_reg = (enable) ? HW_CCF_XPU0_BACKUP1_SET : HW_CCF_XPU0_BACKUP1_CLR;
+	u32 hwccf_ctrl_status = (enable) ? HW_CCF_BACKUP1_SET_STATUS : HW_CCF_BACKUP1_CLR_STATUS;
+
+	if (IS_ERR_OR_NULL(priv->hwccf_regmap))
+		return;
+
+	dev_dbg(priv->dev, "vdisp buck enable:%d+", enable);
+	ret = regmap_read_poll_timeout(priv->hwccf_regmap, HW_CCF_BACKUP1_DONE, val,
+				       (val & BIT(HW_CCF_AP_VOTER_BIT)), VOTE_DELAY_US, 100000);
+	if (ret)
+		dev_err(priv->dev, "vdisp hwccf backup1-1 done timeout");
+
+	ret = regmap_write(priv->hwccf_regmap, ctrl_reg, BIT(HW_CCF_AP_VOTER_BIT));
+	if (ret)
+		dev_err(priv->dev, "vdisp hwccf voter fail");
+
+	ret = regmap_read_poll_timeout(priv->hwccf_regmap, HW_CCF_BACKUP1_DONE, val,
+				       (val & BIT(HW_CCF_AP_VOTER_BIT)), VOTE_DELAY_US, 100000);
+	if (ret)
+		dev_err(priv->dev, "vdisp hwccf backup1-2 done timeout");
+
+	ret = regmap_read_poll_timeout(priv->hwccf_regmap, hwccf_ctrl_status, val,
+				       !(val & BIT(HW_CCF_AP_VOTER_BIT)), VOTE_DELAY_US, 100000);
+	if (ret)
+		dev_err(priv->dev, "vdisp wait ctrl status cleared timeout");
+
+	priv->need_update = false;
+	dev_dbg(priv->dev, "vdisp buck enable:%d-", enable);
+}
+
+static int genpd_event_notifier(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct mtk_vdisp_ctrl *priv = container_of(nb, struct mtk_vdisp_ctrl, pd_nb);
+	int ret;
+
+	mutex_lock(&priv->lock);
+	if (!priv->vcp_is_alive)
+		priv->need_update = true;
+
+	switch (event) {
+	case GENPD_NOTIFY_PRE_ON:
+		if ((atomic_read(&priv->mtcmos_status) == 0 || priv->need_update) &&
+		    priv->vcp_is_alive)
+			vdisp_hwccf_ctrl(priv, true);
+		atomic_set(&priv->mtcmos_status, 1);
+		break;
+	case GENPD_NOTIFY_ON:
+		ret = clk_bulk_prepare_enable(ARRAY_SIZE(mtk_vdisp_clks), priv->clks);
+		if (ret)
+			dev_err(priv->dev, "fail to enable vdisp ctrl clock, ret:%d\n", ret);
+		break;
+	case GENPD_NOTIFY_PRE_OFF:
+		clk_bulk_disable_unprepare(ARRAY_SIZE(mtk_vdisp_clks), priv->clks);
+		break;
+	case GENPD_NOTIFY_OFF:
+		atomic_set(&priv->mtcmos_status, 0);
+		vdisp_hwccf_ctrl(priv, false);
+		break;
+	default:
+		break;
+	}
+	mutex_unlock(&priv->lock);
+	return 0;
+}
+
+#if IS_ENABLED(CONFIG_MTK_TINYSYS_VCP_SUPPORT)
+static int vdisp_vcp_notifier(struct notifier_block *nb, unsigned long vcp_event, void *unused)
+{
+	struct mtk_vdisp_ctrl *priv = container_of(nb, struct mtk_vdisp_ctrl, vcp_nb);
+
+	mutex_lock(&priv->lock);
+	switch (vcp_event) {
+	case VCP_EVENT_SUSPEND:
+	case VCP_EVENT_STOP:
+		dev_info(priv->dev, "vcp suspend-%ld",vcp_event);
+		break;
+	case VCP_EVENT_READY:
+	case VCP_EVENT_RESUME:
+		priv->vcp_is_alive = true;
+		if (priv->need_update)
+			vdisp_hwccf_ctrl(priv, !!atomic_read(&priv->mtcmos_status));
+		dev_info(priv->dev, "vcp is alive-%ld", vcp_event);
+		break;
+	}
+	mutex_unlock(&priv->lock);
+	return NOTIFY_DONE;
+}
+#endif
+
+static int mtk_vdisp_ctrl_remove(struct platform_device *pdev)
+{
+	return 0;
+}
+
+static int mtk_vdisp_ctrl_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct mtk_vdisp_ctrl *priv;
+	struct regmap *regmap;
+	int i, ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	mutex_init(&priv->lock);
+	atomic_set(&priv->mtcmos_status, 1);
+	priv->need_update = true;
+
+	regmap = syscon_regmap_lookup_by_phandle(np, "mm-hw-ccf-regmap");
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+	priv->hwccf_regmap = regmap;
+
+	for (i = 0; i < ARRAY_SIZE(mtk_vdisp_clks); i++)
+		priv->clks[i].id = mtk_vdisp_clks[i];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(mtk_vdisp_clks), priv->clks);
+	if (ret) {
+		dev_err(dev, "fail to get vdisp ctrl clock");
+		return ret;
+	}
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(mtk_vdisp_clks), priv->clks);
+	if (ret) {
+		dev_err(dev, "fail to enable vdisp ctrl clock");
+		return ret;
+	}
+
+	pm_runtime_enable(dev);
+	priv->pd_nb.notifier_call = genpd_event_notifier;
+	ret = dev_pm_genpd_add_notifier(dev, &priv->pd_nb);
+	if (ret) {
+		clk_bulk_disable_unprepare(ARRAY_SIZE(mtk_vdisp_clks), priv->clks);
+		pm_runtime_disable(dev);
+		dev_err(dev, "dev_pm_genpd_add_notifier fail(%d)", ret);
+		return ret;
+	}
+
+#if IS_ENABLED(CONFIG_MTK_TINYSYS_VCP_SUPPORT)
+	priv->vcp_nb.notifier_call = vdisp_vcp_notifier;
+	vcp_A_register_notify_ex(VDISP_FEATURE_ID, &priv->vcp_nb);
+#endif
+	return 0;
+}
+
+static const struct of_device_id mtk_vdisp_ctrl_dt_match[] = {
+	{.compatible = "mediatek,mt8196-vdisp-ctrl"},
+	{},
+};
+MODULE_DEVICE_TABLE(of, mtk_vdisp_ctrl_dt_match);
+
+struct platform_driver mtk_vdisp_ctrl_driver = {
+	.probe = mtk_vdisp_ctrl_probe,
+	.remove = mtk_vdisp_ctrl_remove,
+	.driver = {
+		.name = "mediatek-vdisp-ctrl",
+		.owner = THIS_MODULE,
+		.of_match_table = mtk_vdisp_ctrl_dt_match,
+	},
+};
+MODULE_DEVICE_TABLE(of, mtk_vdisp_dt_match);
+
+module_platform_driver(mtk_vdisp_ctrl_driver);
+
+MODULE_AUTHOR("Nancy Lin <nancy.lin@mediatek.com>");
+MODULE_DESCRIPTION("MediaTek VDISP Driver");
+MODULE_LICENSE("GPL");
