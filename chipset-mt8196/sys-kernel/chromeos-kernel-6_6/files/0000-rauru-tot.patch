+		 * mtk_gpueb_sysram_write(SYSRAM_GPU_COMMIT_TYPE, eCommitType);
+		 * mtk_gpueb_sysram_write(SYSRAM_GPU_COMMIT_VIRTUAL_FREQ, virtual_freq_in_MHz);
