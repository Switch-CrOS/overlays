+int tokenizer(char *pcSrc, int i32len, int *pi32IndexArray, int i32NumToken)
+{
+	int i = 0;
+	int j = 0;
+	int head = -1;
+
+	for ( ; i < i32len; i++) {
+		if (pcSrc[i] != ' ') {
+			if (head == -1)
+				head = i;
+		} else {
+			if (head != -1) {
+				pi32IndexArray[j] = head;
+				j++;
+				if (j == i32NumToken)
+					return j;
+				head = -1;
+			}
+			pcSrc[i] = 0;
+		}
+	}
+
+	if (head != -1) {
+		pi32IndexArray[j] = head;
+		j++;
+		return j;
+	}
+
+	return -1;
+}
