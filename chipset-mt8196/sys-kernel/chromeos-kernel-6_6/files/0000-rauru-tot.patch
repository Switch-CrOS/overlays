+	return val;
+}
+KBASE_EXPORT_TEST_API(kbase_csf_fw_io_global_read);
+
+void kbase_csf_fw_io_group_write(struct kbase_csf_fw_io *fw_io, u32 group_id, u32 offset, u32 value)
