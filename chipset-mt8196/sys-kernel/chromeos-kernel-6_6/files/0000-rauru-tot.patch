+	}
+
+	if (algo_in_pool == true)
+		goto REPLACE_MEM;
+
+	// special case: check flow with image
+	if ((sec_level != SEC_LVL_PROTECT) && (algo_in_img == true)) {
+		ret = mvpu25_replace_img_knl(session,
+					buf_num,
+					sec_chk_addr,
+					sec_buf_attr,
+					rp_num,
+					target_buf_old_map,
+					target_buf_old_base,
+					target_buf_old_offset,
