--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_platform_fake.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
