+DEFINE_SEQ_ATTRIBUTE(mtk_apu_hw_logger_log);
+
+static const struct file_operations hw_loggerSeqLogL_ops = {
+	.owner   = THIS_MODULE,
+	.open    = debug_sqopen_lock,
+	.poll    = mtk_apu_hw_logger_seq_poll,
+	.read    = seq_read,
+	.llseek  = seq_lseek,
+	.release = seq_release
+};
