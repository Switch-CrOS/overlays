+static void mtk_dvo_power_off(struct mtk_dvo *dvo)
+{
+	if (WARN_ON(dvo->refcount == 0))
+		return;
+
+	if (--dvo->refcount != 0)
+		return;
+
+	mtk_dvo_disable(dvo);
+
+	clk_disable_unprepare(dvo->engine_clk);
+	clk_disable_unprepare(dvo->tvd_clk);
+	clk_disable_unprepare(dvo->pixel_clk);
+}
+
+static int mtk_dvo_power_on(struct mtk_dvo *dvo)
+{
+	int ret;
+
+	if (++dvo->refcount != 1)
+		return 0;
+
+	if(!dvo->pixel_clk_enable) {
+		ret = clk_prepare_enable(dvo->pixel_clk);
+		if (ret) {
+			dev_err(dvo->dev, "Failed to enable pixel clock: %d\n", ret);
+			goto err_pixel;
+		}
+	} else
+		dvo->pixel_clk_enable= false;
+
+	clk_set_parent(dvo->pixel_clk, dvo->dvo_clk);
+
+	ret = clk_prepare_enable(dvo->tvd_clk);
+	if (ret) {
+		dev_err(dvo->dev, "[eDPTX]Failed to enable tvd_clk clock: %d\n", ret);
+		goto err_refcount;
+	}
+
+	ret = clk_prepare_enable(dvo->engine_clk);
+	if (ret) {
+		dev_err(dvo->dev, "Failed to enable engine clock: %d\n", ret);
+		goto err_refcount;
+	}
+
+	return 0;
+
+err_pixel:
+	clk_disable_unprepare(dvo->engine_clk);
+err_refcount:
+	dvo->refcount--;
+	return ret;
+}
