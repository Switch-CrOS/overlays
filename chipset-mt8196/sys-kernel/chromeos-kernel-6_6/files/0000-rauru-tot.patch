+					ret = -EINVAL;
+					goto END_WITH_MUTEX;
+				}
+			} //(primem_num != 0)
+		} //(kerarg_num != 0)
+
+		if (apusys_mem_validate_by_cmd(session, cmd_hnd->cmd,
+				(uint64_t)mvpu_req->target_buf_old_base,
