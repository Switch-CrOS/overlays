index 0000000000000000000000000000000000000000..531993d9704a3fff1a622a431251c1207dfd2da6
--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/hwcnt/backend/mali_kbase_hwcnt_backend.h
@@ -0,0 +1,254 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ *
