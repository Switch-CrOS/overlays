+	ret |= anx7625_reg_write(ctx, ctx->i2c.rx_p0_client,
+			HORIZON_SYNC_WIDTH_L_7E, ctx->dt.hsync_len.min);
+	ret |= anx7625_reg_write(ctx, ctx->i2c.rx_p0_client,
+			HORIZON_SYNC_WIDTH_H_7E, ctx->dt.hsync_len.min >> 8);
