+			return g_ultra_step_size_by_platform[GED_STEP_FREQ_LOW];
+		else if (gpu_freq < g_step_size_freq_th[GED_STEP_FREQ_HIGH])
+			return g_ultra_step_size_by_platform[GED_STEP_FREQ_MID];
+		else
