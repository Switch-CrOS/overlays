+#define MMUP_DRAM_IMG_OFFSET        (0x1600000)    /* 22.0MB dram image offset */
+#define MMUP_SRAM_OFFSET            (0x31000)
+
+#define REGION_OFFSET               (0x4)
+#define ALIGN_1024                  (1024)
+#define VCP_HFRP_SECTION_NAME       "tinysys-vcp-RV55_A"
+#define VCP_MMUP_SECTION_NAME       "tinysys-mmup-RV33_A"
+#define VCP_HFRP_DRAM_SECTION_NAME  "tinysys-vcp-RV55_A_dram"
+#define VCP_MMUP_DRAM_SECTION_NAME  "tinysys-mmup-RV33_A_dram"
+
+#define ALIGN_TO(x, n)  \
+	(((x) + ((n) - 1)) & ~((n) - 1))
+
+unsigned int core_nums = 1;
+unsigned int g_mmup_fw_size;
+
+struct mkimg_hdr {
+	unsigned int magic;
+	unsigned int dsz;
+	char name[VCM_IMAGE_NAME_MAXSZ];
+};
+
+static struct delayed_work vcp_loader_image_work;
+
+static void boot_vcp(void)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_VCP_KERNEL_OP_RESET_SET,
+		1, 0, 0, 0, 0, 0, &res);
+
+	/* core 1 */
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_MMUP_KERNEL_OP_RESET_SET,
+		1, 0, 0, 0, 0, 0, &res);
+
+	if (vcp_register_feature(RTOS_FEATURE_ID) < 0)
+		pr_notice("[VCP] bootup fail\n");
+	else
+		pr_notice("[VCP] bootup successfully\n");
+
+	pr_notice("[VCP] %s core0 status: 0x%x, core1 status: 0x%x\n",
+		__func__, readl(R_CORE0_STATUS), readl(R_CORE1_STATUS));
+}
+
+unsigned int loader_partition(void *fw_src, const char *section_name,
+	void *image_buf, size_t size)
+{
+	const u8 *fw_ptr = fw_src;
+	unsigned int offset = 0;
+	unsigned int align_size = 0;
+	struct mkimg_hdr *img_hdr_info;
+
+	if (fw_src == NULL || image_buf == NULL || size < VCP_IMAGE_HEADER_SIZE) {
+		pr_info("[VCP] %s illegal parameter\n", __func__);
+		return 0;
+	}
+
+	while (offset < size) {
+		img_hdr_info = (struct mkimg_hdr *)(fw_ptr + offset);
+		img_hdr_info->name[31] = '\0';
+		align_size = ALIGN_TO(img_hdr_info->dsz, 16);
+		offset += VCP_IMAGE_HEADER_SIZE;
+		if (img_hdr_info->magic != VCM_IMAGE_MAGIC ||
+			strcmp((img_hdr_info->name), section_name) != 0)
+			offset += align_size;
+		else {
+			memcpy_toio((void *)image_buf , (void *)(fw_ptr + offset), img_hdr_info->dsz);
+			pr_info("[VCP] load %s to image-buf(0x%llx), size(0x%x)\n",
+				img_hdr_info->name, (phys_addr_t)image_buf, img_hdr_info->dsz);
+			offset += align_size;
+			return img_hdr_info->dsz;
+		}
+	}
+
+	return 0;
+}
+
+static int load_hfrp_bin(void *fw_src, phys_addr_t img_buf_va,
+	phys_addr_t img_buf_pa, phys_addr_t img_buf_iova, size_t size )
+{
+	void *ld_ptr;
+	void *dram_img_ptr;
+	phys_addr_t ld_ptr_phy;
+	phys_addr_t dram_img_ptr_phy;
+	void *dram_img_backup_ptr;
+	unsigned int fw_size;
+	unsigned int ld_size;
+	unsigned int dram_img_size;
+#ifndef VCP_SECLOAD_SUPPORT
+	unsigned int dram_img_offset = 0;
+	unsigned int dram_backup_img_offset = 0;
+	struct vcp_region_info_st *vcp_region_info;
+#endif
+	struct arm_smccc_res res;
+
+	/*
+	 * Layout of VCP reserved DRAM memory.
+	 ************************
+	 * +------------------+ *
+	 * |  VCP Loader	  | *
+	 * +------------------+ *
+	 * |  VCP Firmware	  | *
+	 * +------------------+ *
+	 ************************
+	 *	  VCP DRAM			*
+	 ************************
+	 *	  VCP DRAM backup	*
+	 ************************
+	 */
+
+	/* step 2: load/verify firmware */
+	ld_ptr = img_buf_va;
+	ld_ptr_phy = img_buf_pa;
+	ld_size = VCP_LOADER_SIZE;
+	fw_size = loader_partition((void *)fw_src, VCP_HFRP_SECTION_NAME, img_buf_va, size);
+	pr_info("[VCP][HFRP] ld_ptr %p ld_ptr_phy 0x%llx ld_size %u fw_size %u\n", ld_ptr, ld_ptr_phy, ld_size, fw_size);
+	if (!fw_size) {
+		pr_info("[VCP] load vcp hfrp bin failed\n");
+		return -1;
+	}
+
+	/* step 3: load/verify vcp dram section binary */
+	dram_img_size = loader_partition((void *)fw_src, VCP_HFRP_DRAM_SECTION_NAME,
+		img_buf_va + VCP_DRAM_OFFSET, size);
+	if (!dram_img_size)
+		pr_info("[VCP] no support hfrp dram bin\n");
+
+	dram_img_ptr = img_buf_va + VCP_DRAM_OFFSET;
+	dram_img_ptr_phy = img_buf_pa + VCP_DRAM_OFFSET;
+	dram_img_backup_ptr = dram_img_ptr + ALIGN_TO(dram_img_size, ALIGN_1024);
+	pr_info("[VCP][HFRP] dram_img_ptr %p dram_img_ptr_phy 0x%llx dram_img_backup_ptr %p\n", 
+							dram_img_ptr, dram_img_ptr_phy, dram_img_backup_ptr);
+#ifndef VCP_SECLOAD_SUPPORT
+	/* need no flush for non-cachable mmap */
+#ifdef AP_LOAD_FW
+	/* copy loader and fw to sram */
+	memcpy_toio(VCP_TCM, (void *)img_buf_va, fw_size);
+#else
+	/* copy loader to sram */
+	memcpy_toio(VCP_TCM, (void *)img_buf_va, ld_size);
+#endif
+	/* save firmware/cache info to sram */
+	vcp_region_info = (struct vcp_region_info_st *)(VCP_TCM + REGION_OFFSET);
+	/* Let vcp check if the struct matches the one in tinysys */
+	vcp_region_info->struct_size = sizeof(struct vcp_region_info_st);
+
+#if (!ENABLE_NORMAL_IOVA_MODE)
+	/* keep *_addr[35:4] in region info for region info accommodate 32 bits data only*/
+	vcp_region_info->ap_loader_start_pa = (uint32_t)img_buf_pa;
+	vcp_region_info->ap_loader_start   = VCP_PACK_IOVA(img_buf_iova);
+	//vcp_region_info->ap_loader_start   = (uint32_t)img_buf_pa;
+	vcp_region_info->ap_loader_size    = (uint32_t)ld_size;
+	vcp_region_info->ap_firmware_start = VCP_PACK_IOVA(img_buf_iova + ld_size);
+	//vcp_region_info->ap_firmware_start = (uint32_t)(img_buf_pa + ld_size);
+
+	pr_info("[VCP]: %s ap_loader_start_pa 0x%x\n",
+		__func__, vcp_region_info->ap_loader_start_pa);
+	pr_info("[VCP]: %s sram base=0x%p, size=0x%x(0x%x)\n",
+		__func__, VCP_TCM, VCP_TCM_SIZE, fw_size);
+
+	vcp_region_info->ap_firmware_size = (uint32_t)fw_size;
+
+	if ((dram_img_ptr != 0) && (dram_img_size != 0)) {
+		dram_img_offset = dram_img_ptr - img_buf_va;
+		dram_backup_img_offset =
+			dram_img_offset + ALIGN_TO(dram_img_size, 1024) * core_nums;
+		if ((void *)img_buf_va > dram_img_ptr) {
+			pr_info( "[VCP]: %s dram img addr is not valid  0x%llx > 0x%llx\n",
+					__func__, img_buf_va, (phys_addr_t)dram_img_ptr);
+		}
+		//vcp_region_info->ap_dram_start = (uint32_t)(img_buf_pa + dram_img_offset);
+		//vcp_region_info->ap_dram_backup_start = (uint32_t)(img_buf_pa + dram_backup_img_offset);
+		vcp_region_info->ap_dram_start = VCP_PACK_IOVA(img_buf_iova + dram_img_offset);
+		vcp_region_info->ap_dram_backup_start = VCP_PACK_IOVA(img_buf_iova + dram_backup_img_offset);
+		vcp_region_info->ap_dram_size  = (uint32_t)dram_img_size;
+	} else {
+		pr_info("[VCP]: %s No dram image\n",__func__);
+		vcp_region_info->ap_dram_start = 0;
+		vcp_region_info->ap_dram_size  = 0;
+		vcp_region_info->ap_dram_backup_start = 0;
+	}
+
+	vcp_region_info->l2tcm_offset = (uint32_t)MMUP_SRAM_OFFSET;
+
+	pr_info("[VCP]: %s img_off offset 0x%x backup_off 0x%x\n",
+		__func__, dram_img_offset, dram_backup_img_offset);
+	pr_info("[VCP]: %s img_off addr 0x%llx sz 0x%x buf 0x%llx\n",
+		__func__, (phys_addr_t)dram_img_ptr, dram_img_size, img_buf_va);
+
+#endif
+
+#ifdef AP_LOAD_FW
+	/* set size to 0 to prevent vcp loader load fw */
+	vcp_region_info->ap_loader_size = 0;
+	vcp_region_info->ap_firmware_size = 0;
+#endif
+	pr_info("[VCP]: ap_loader_start 0x%x\n", vcp_region_info->ap_loader_start);
+	pr_info("[VCP]: ap_loader_size 0x%x\n", vcp_region_info->ap_loader_size);
+	pr_info("[VCP]: ap_firmware_start 0x%x\n", vcp_region_info->ap_firmware_start);
+	pr_info("[VCP]: ap_firmware_size 0x%x\n", vcp_region_info->ap_firmware_size);
+	pr_info("[VCP]: ap_dram_start 0x%x\n", vcp_region_info->ap_dram_start);
+	pr_info("[VCP]: ap_dram_size 0x%x\n", vcp_region_info->ap_dram_size);
+	pr_info("[VCP]: ap_dram_backup_start 0x%x\n",vcp_region_info->ap_dram_backup_start);
+
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_MMUP_KERNEL_OP_SET_L2TCM_OFFSET,
+		MMUP_SRAM_OFFSET, 0, 0, 0, 0, 0, &res);
+#else
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_VCP_KERNEL_OP_SECURE_INIT_VCP,
+		vcp_mem_image_size, ld_ptr_phy, ld_size, fw_size, dram_img_ptr_phy, dram_img_size, &res);
+#endif
+
+	return 0;
+}
+
+static int load_mmup_bin(void *fw_src, phys_addr_t img_buf_va,
+	phys_addr_t img_buf_pa, phys_addr_t img_buf_iova, size_t size )
+{
+	void *ld_ptr;
+	void *dram_img_ptr;
+	phys_addr_t ld_ptr_phy;
+	phys_addr_t dram_img_ptr_phy;
+	void *dram_img_backup_ptr;
+	unsigned int fw_size;
+	unsigned int ld_size;
+	unsigned int dram_img_size;
+#ifndef VCP_SECLOAD_SUPPORT
+	unsigned int dram_img_offset = 0;
+	unsigned int dram_backup_img_offset = 0;
+	struct vcp_region_info_st *vcp_region_info;
+#endif
+	struct arm_smccc_res res;
+
+	/*
+	 * Layout of VCP reserved DRAM memory.
+	 ************************
+	 * +------------------+ *
+	 * |  MMUP Loader	  | *
+	 * +------------------+ *
+	 * |  MMUP Firmware   | *
+	 * +------------------+ *
+	 ************************
+	 *	  MMUP DRAM			*
+	 ************************
+	 *	  MMUP DRAM backup	*
+	 ************************
+	 */
+
+	/* step 2: load/verify firmware */
+	ld_ptr = img_buf_va;
+	ld_ptr_phy = img_buf_pa + MMUP_SRAM_OFFSET;
+	ld_size = VCP_LOADER_SIZE;
+	fw_size = loader_partition((void *)fw_src, VCP_MMUP_SECTION_NAME, img_buf_va + MMUP_SRAM_OFFSET, size);
+	pr_info("[VCP][MMUP] ld_ptr %p ld_ptr_phy 0x%llx ld_size %u fw_size %u\n", ld_ptr, ld_ptr_phy, ld_size, fw_size);
+	if (!fw_size) {
+		pr_info("[VCP] load vcp partition failed\n");
+		return -1;
+	}
+
+	/* step 3: load/verify vcp dram section binary */
+	dram_img_size = loader_partition((void *)fw_src, VCP_MMUP_DRAM_SECTION_NAME,
+		img_buf_va + MMUP_DRAM_IMG_OFFSET, size);
+	if (!dram_img_size)
+		pr_info("[VCP] load vcp partition failed\n");
+
+	dram_img_ptr = img_buf_va + MMUP_DRAM_IMG_OFFSET;
+	dram_img_ptr_phy = img_buf_pa + MMUP_DRAM_IMG_OFFSET;
+	dram_img_backup_ptr = dram_img_ptr + ALIGN_TO(dram_img_size, ALIGN_1024);
+	pr_info("[VCP][MMUP] dram_img_ptr %p dram_img_ptr_phy 0x%llx dram_img_backup_ptr %p\n", 
+							dram_img_ptr, dram_img_ptr_phy, dram_img_backup_ptr);
+#ifndef VCP_SECLOAD_SUPPORT
+	/* need no flush for non-cachable mmap */
+#ifdef AP_LOAD_FW
+	/* copy loader and fw to sram */
+	memcpy_toio((void *)(VCP_TCM + MMUP_SRAM_OFFSET), (void *)(img_buf_va + MMUP_SRAM_OFFSET), fw_size);
+#else
+	/* copy loader to sram */
+	memcpy_toio((void *)(VCP_TCM + MMUP_SRAM_OFFSET), (void *)(img_buf_va + MMUP_SRAM_OFFSET), ld_size);
+#endif
+	/* save firmware/cache info to sram */
+	vcp_region_info = (struct vcp_region_info_st *)(VCP_TCM + MMUP_SRAM_OFFSET + REGION_OFFSET);
+	/* Let vcp check if the struct matches the one in tinysys */
+	vcp_region_info->struct_size = sizeof(struct vcp_region_info_st);
+
+#if (!ENABLE_NORMAL_IOVA_MODE)
+	/* keep *_addr[35:4] in region info for region info accommodate 32 bits data only*/
+	vcp_region_info->ap_loader_start_pa = (uint32_t)(img_buf_pa + MMUP_SRAM_OFFSET);
+	vcp_region_info->ap_loader_start   = VCP_PACK_IOVA(img_buf_iova + MMUP_SRAM_OFFSET);
+	//vcp_region_info->ap_loader_start   = (uint32_t)(img_buf_pa + MMUP_SRAM_OFFSET);
+	vcp_region_info->ap_loader_size    = (uint32_t)ld_size;
+	vcp_region_info->ap_firmware_start = VCP_PACK_IOVA(img_buf_iova + MMUP_SRAM_OFFSET + ld_size);
+	//vcp_region_info->ap_firmware_start = (uint32_t)(img_buf_pa + MMUP_SRAM_OFFSET + ld_size);
+	pr_info("[VCP]: %s ap_loader_start_pa 0x%x\n",
+		__func__, vcp_region_info->ap_loader_start_pa);
+	pr_info("[VCP]: %s sram base=0x%p, size=0x%x(0x%x)\n",
+		__func__, VCP_TCM, VCP_TCM_SIZE, fw_size);
+
+	vcp_region_info->ap_firmware_size = (uint32_t)fw_size;
+	g_mmup_fw_size = fw_size;
+
+	if ((dram_img_ptr != 0) && (dram_img_size != 0)) {
+		dram_img_offset = dram_img_ptr - img_buf_va;
+		dram_backup_img_offset =
+			dram_img_offset + ALIGN_TO(dram_img_size, ALIGN_1024) * core_nums;
+		if ((void *)img_buf_va > dram_img_ptr) {
+			pr_info( "[VCP]: %s dram img addr is not valid  0x%llx > 0x%llx\n",
+					__func__, img_buf_va, (phys_addr_t)dram_img_ptr);
+		}
+		vcp_region_info->ap_dram_start = VCP_PACK_IOVA(img_buf_iova + dram_img_offset);
+		vcp_region_info->ap_dram_backup_start = VCP_PACK_IOVA(img_buf_iova + dram_backup_img_offset);
+		//vcp_region_info->ap_dram_start = (uint32_t)(img_buf_pa + dram_img_offset);
+		//vcp_region_info->ap_dram_backup_start = (uint32_t)(img_buf_pa + dram_backup_img_offset);
+		vcp_region_info->ap_dram_size  = (uint32_t)dram_img_size;
+	} else {
+		pr_info("[VCP]: %s No dram image\n",__func__);
+		vcp_region_info->ap_dram_start = 0;
+		vcp_region_info->ap_dram_size  = 0;
+		vcp_region_info->ap_dram_backup_start = 0;
+	}
+
+	pr_info("[VCP]: %s img_off offset 0x%x backup_off 0x%x\n",
+		__func__, dram_img_offset, dram_backup_img_offset);
+	pr_info("[VCP]: %s img_off addr 0x%llx sz 0x%x buf 0x%llx\n",
+		__func__, (phys_addr_t)dram_img_ptr, dram_img_size, img_buf_va);
+
+#endif
+
+#ifdef AP_LOAD_FW
+	/* set size to 0 to prevent vcp loader load fw */
+	vcp_region_info->ap_loader_size = 0;
+	vcp_region_info->ap_firmware_size = 0;
+#endif
+	pr_info("[VCP]: ap_loader_start 0x%x\n", vcp_region_info->ap_loader_start);
+	pr_info("[VCP]: ap_loader_size 0x%x\n", vcp_region_info->ap_loader_size);
+	pr_info("[VCP]: ap_firmware_start 0x%x\n", vcp_region_info->ap_firmware_start);
+	pr_info("[VCP]: ap_firmware_size 0x%x\n", vcp_region_info->ap_firmware_size);
+	pr_info("[VCP]: ap_dram_start 0x%x\n", vcp_region_info->ap_dram_start);
+	pr_info("[VCP]: ap_dram_size 0x%x\n", vcp_region_info->ap_dram_size);
+	pr_info("[VCP]: ap_dram_backup_start 0x%x\n",vcp_region_info->ap_dram_backup_start);
+
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_MMUP_KERNEL_OP_SET_FW_SIZE,
+		g_mmup_fw_size, 0, 0, 0, 0, 0, &res);
+#else
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_MMUP_KERNEL_OP_SECURE_INIT_MMUP,
+		vcp_mem_image_size, ld_ptr_phy, ld_size, fw_size, dram_img_ptr_phy, dram_img_size, &res);
+#endif
+	return 0;
+}
+#if IS_ENABLED(CONFIG_MTK_EMI_LEGACY)
+static int post_vcp_set_emi_mpu(uint64_t start, uint32_t end)
+{
+	struct emimpu_region_t rg_info;
+
+	mtk_emimpu_init_region(&rg_info, VCP_EMI_MPU_REGION_ID);
+
+	mtk_emimpu_set_addr(&rg_info, start, end);
+	mtk_emimpu_set_apc(&rg_info, AP_DOMAIN_ID, MTK_EMIMPU_NO_PROTECTION);
+
+	mtk_emimpu_set_apc(&rg_info, VCP_DOMAIN_ID, MTK_EMIMPU_NO_PROTECTION);
+
+	mtk_emimpu_set_protection(&rg_info);
+
+	mtk_emimpu_free_region(&rg_info);
+
+	return 0;
+}
+#endif
+/*
+ * callback function for work struct
+ * notify apps to start their tasks or generate an exception according to flag
+ * NOTE: this function may be blocked and should not be called in interrupt
+ *       context
+ * @param ws:   work struct
+ */
+static void vcp_loader_image_notify_ws(struct work_struct *ws)
+{
+	int ret = 0;
+	const struct firmware *fw;
+	const char *fwname = FIRMWARE_VCP;
+	struct arm_smccc_res res;
+
+	phys_addr_t img_buf_iova;
+	phys_addr_t img_buf_phys;
+	phys_addr_t img_buf_va;
+
+	/* Async load firmware and run HIFIxDSP */
+	ret = request_firmware(&fw, fwname, NULL);
+	if (ret < 0) {
+		pr_info("Failed to load firmware file (%d)", ret);
+		schedule_delayed_work(&vcp_loader_image_work, msecs_to_jiffies(3000));
+		return;
+	}
+
+	/* step 0: set core0/1 RSTN */
+	writel(0x1, VCP_R_CORE0_SW_RSTN_SET);
+	writel(0x1, VCP_R_CORE1_SW_RSTN_SET);
+
+	/* step 1: enable sram, enable 1 block per time */
+	/* No sram PD register in MMup, power on with mtcmos */
+	/* Clean SRAM. */
+	memset_io(VCP_TCM, 0, VCP_TCM_SIZE);
+
+	img_buf_iova = vcp_mem_image_iova;
+	img_buf_phys = vcp_mem_image_phys;
+	img_buf_va = vcp_mem_image_virt;
+
+	pr_info("[VCP] image buf, iova(0x%llx), phys(0x%llx), virt(0x%llx), size(0x%llx)",
+		img_buf_iova, img_buf_phys, img_buf_va, vcp_mem_image_size );
+
+	if (fw->size < VCP_IMAGE_HEADER_SIZE || fw->size > vcp_mem_image_size) {
+		pr_info("[VCP] firmware %s is oversize/undersize\n", fwname);
+		goto err_release_fw;
+	}
+#if IS_ENABLED(CONFIG_MTK_EMI_LEGACY)
+	post_vcp_set_emi_mpu(img_buf_phys, vcp_mem_image_size);
+#endif
+	arm_smccc_smc(MTK_SIP_TINYSYS_VCP_CONTROL,
+		MTK_TINYSYS_VCP_KERNEL_OP_COLD_BOOT_VCP,
+		0, 0, 0, 0, 0, 0, &res);
+	ret = load_hfrp_bin((void *)fw->data, img_buf_va, img_buf_phys,
+		img_buf_iova, fw->size);
+	if (ret)
+		pr_info("[VCP] load hfrp bin failed\n");
+
+	ret = load_mmup_bin((void *)fw->data, img_buf_va, img_buf_phys,
+		img_buf_iova, fw->size);
+	if (ret)
+		pr_info("[VCP] load mmup bin failed\n");
+
+	boot_vcp();
+
+err_release_fw:
+	release_firmware(fw);
+}
+
+/* VCP start to run and load bin. */
+void vcp_loader_image_init(void)
+{
+	/* init work queue */
+	INIT_DELAYED_WORK(&vcp_loader_image_work, vcp_loader_image_notify_ws);
+
+	schedule_delayed_work(&vcp_loader_image_work, msecs_to_jiffies(3000));
+}
+
