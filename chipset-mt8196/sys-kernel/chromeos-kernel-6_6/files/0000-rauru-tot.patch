+static void mtk_edp_phyd_wait_aux_ldo_ready(struct mtk_edp *mtk_edp, unsigned long wait_us)
+{
+	u32 val = 0x0;
+
+	if (mtk_edp->phy_regs) {
+		regmap_read_poll_timeout(mtk_edp->phy_regs, DP_PHY_DIG_GLB_STATUS_0,
+					 val, false, wait_us/100, wait_us);
+	} else {
+		regmap_read_poll_timeout(mtk_edp->regs, DP_PHY_DIG_GLB_STATUS_0,
+					 val, false, wait_us/100, wait_us);
+	}
+}
