+				&lpm_log_timer);
+	mtk_lpm_sysfs_sub_entry_node_add("interval", 0644,
+				&lpm_log_tm_interval.op,
+				&lpm_log_tm_node,
+				&lpm_log_tm_interval.handle);
+	return 0;
+}
