+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_gpu_metrics.h
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ *
