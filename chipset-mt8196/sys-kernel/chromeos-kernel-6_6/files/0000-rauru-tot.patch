+static int mtk_edp_dt_parse(struct mtk_edp *mtk_edp,
+			    struct platform_device *pdev)
+{
+	//struct device_node *endpoint;
+	struct device *dev = &pdev->dev;
+	int ret = 0;
+	void __iomem *base;
+	void __iomem *phy_base;
+	struct resource *regs;
+	u32 linkrate;
+	u32 lane_count;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	mtk_edp->regs = devm_regmap_init_mmio(dev, base, &mtk_edp_regmap_config);
+	if (IS_ERR(mtk_edp->regs))
+		return PTR_ERR(mtk_edp->regs);
+
+	/* eDP PHY ioremap resource */
+	mtk_edp->phy_regs = NULL;
+	phy_base = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(phy_base)) {
+		dev_info(dev, "%s failed to phy ioremap %ld\n", EDPTX_DEBUG_INFO, PTR_ERR(phy_base));
+		return PTR_ERR(phy_base);
+	}
+	mtk_edp->phy_regs = devm_regmap_init_mmio(dev, phy_base, &mtk_edp_phy_regmap_config);
+	if (IS_ERR(mtk_edp->phy_regs)) {
+		dev_info(dev, "%s failed to phy regmap init %ld\n",
+				EDPTX_DEBUG_INFO, PTR_ERR(mtk_edp->phy_regs));
+		return PTR_ERR(mtk_edp->phy_regs);
+	}
+	mtk_edp->power_clk = devm_clk_get(dev, "power");
+	if (IS_ERR(mtk_edp->power_clk)) {
+		pr_info("%s Failed to get power clock\n", EDPTX_DEBUG_INFO);
+		return PTR_ERR(mtk_edp->power_clk);
+	}
+	if (clk_prepare_enable(mtk_edp->power_clk))
+		dev_info(mtk_edp->dev, "%s Failed to enable power clock: %d\n",
+			EDPTX_DEBUG_INFO, ret);
+/*
+ *      endpoint = of_graph_get_endpoint_by_regs(pdev->dev.of_node, 1, -1);
+ *      lane_count = of_property_count_elems_of_size(endpoint,
+ *                              "data-lanes", sizeof(u32));
+ */
+	ret = device_property_read_u32(dev, "max-lane-count", &lane_count);
+	if (ret) {
+		dev_err(dev, "[eDPTX] Failed to read max lane count : %d\n", ret);
+		return ret;
+	}
+	if (lane_count < 0 || lane_count > 4 || lane_count == 3) {
+		dev_err(dev, "[eDPTX] Invalid data lane size: %d\n", lane_count);
+		return -EINVAL;
+	}
+
+	mtk_edp->max_lanes = lane_count;
+	/* example:  max-linkrate-mhz = 2700 == 2.7Gbps*/
+	ret = device_property_read_u32(dev, "max-linkrate-mhz", &linkrate);
+	if (ret) {
+		dev_err(dev, "[eDPTX] Failed to read max linkrate: %d\n", ret);
+		return ret;
+	}
+	regs = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+	mtk_edp->pwr_regs = devm_ioremap(&pdev->dev, regs->start, 0x4);
+	if (IS_ERR(mtk_edp->pwr_regs))
+		dev_err(dev, "[eDPTX] Failed to get pwr_regs: %ld\n", PTR_ERR(mtk_edp->pwr_regs));
+
+	mtk_edp->max_linkrate = drm_dp_link_rate_to_bw_code(linkrate * 100);
+
+	dev_info(dev, "[eDPTX] SoC support max_lanes:%d, max_linkrate:0x%x\n",
+		 mtk_edp->max_lanes, mtk_edp->max_linkrate);
+
+	mtk_edp->external_monitor = of_property_read_bool(dev->of_node,
+							  "external_monitor");
+	mtk_edp->use_edid = of_property_read_bool(dev->of_node,
+						  "use-edid");
+	mtk_edp->use_aux_bus = of_property_read_bool(dev->of_node,
+						  "use-aux-bus");
+	mtk_edp->color_depth_10bit = of_property_read_bool(dev->of_node,
+							   "color_depth_10bit");
+	mtk_edp->use_hpd = of_property_read_bool(dev->of_node,
+					     "use_hpd");
+	dev_info(dev, "[eDPTX] use external monitor:%d, use edid:%d use hpd:%d use aux bus:%d\n",
+		 mtk_edp->external_monitor,
+			mtk_edp->use_edid,
+			mtk_edp->use_hpd, mtk_edp->use_aux_bus);
+
+	return 0;
+}
