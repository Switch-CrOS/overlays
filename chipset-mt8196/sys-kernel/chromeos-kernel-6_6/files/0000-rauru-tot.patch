+static void handle_wake_misc(char *buf, const char *msg, unsigned int *wr, unsigned int wr_value)
+{
+	if (IS_LOGBUF(buf, msg))
+		strncat(buf, msg, strlen(msg));
+
+	*wr = wr_value;
+}
+
+static void handle_twam_pmsr_dvfsrc_ocla(char *buf, struct lpm_spm_wake_status *wakesrc, unsigned int *wr)
+{
+	if (IS_WAKE_MISC(WAKE_MISC_SRCLKEN_RC_ERR_INT))
+		handle_wake_misc(buf, " SRCLKEN_RC_ERR_INT", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_TIMEOUT_WAKEUP_0))
+		handle_wake_misc(buf, " SPM_TIMEOUT_WAKEUP_0", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_TIMEOUT_WAKEUP_1))
+		handle_wake_misc(buf, " SPM_TIMEOUT_WAKEUP_1", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_TIMEOUT_WAKEUP_2))
+		handle_wake_misc(buf, " SPM_TIMEOUT_WAKEUP_2", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_DVFSRC_IRQ))
+		handle_wake_misc(buf, " DVFSRC", wr, WR_DVFSRC);
+
+	if (IS_WAKE_MISC(WAKE_MISC_TWAM_IRQ_B))
+		handle_wake_misc(buf, " TWAM", wr, WR_TWAM);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_ACK_CHK_WAKEUP_0))
+		handle_wake_misc(buf, " SPM_ACK_CHK", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_ACK_CHK_WAKEUP_1))
+		handle_wake_misc(buf, " SPM_ACK_CHK", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_ACK_CHK_WAKEUP_2))
+		handle_wake_misc(buf, " SPM_ACK_CHK", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_ACK_CHK_WAKEUP_3))
+		handle_wake_misc(buf, " SPM_ACK_CHK", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_SPM_ACK_CHK_WAKEUP_ALL))
+		handle_wake_misc(buf, " SPM_ACK_CHK", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_VLP_BUS_TIMEOUT_IRQ))
+		handle_wake_misc(buf, " VLP_BUS_TIMEOUT_IRQ", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_PMIC_EINT_OUT))
+		handle_wake_misc(buf, " PMIC_EINT_OUT", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_PMIC_IRQ_ACK))
+		handle_wake_misc(buf, " PMIC_IRQ_ACK", wr, WR_SPM_ACK_CHK);
+
+	if (IS_WAKE_MISC(WAKE_MISC_PMIC_SCP_IRQ))
+		handle_wake_misc(buf, " PMIC_SCP_IRQ", wr, WR_SPM_ACK_CHK);
+
+}
+
+static void log_wake_reason(char *buf, struct lpm_spm_wake_status *wakesrc, unsigned int *wr)
+{
+	char *local_ptr = NULL;
+	int i;
+
+	if (wakesrc->r12 & R12_PCM_TIMER_B) {
+		if (IS_WAKE_MISC(WAKE_MISC_PCM_TIMER_EVENT)) {
+			local_ptr = " PCM_TIMER";
+			if (IS_LOGBUF(buf, local_ptr))
+				strncat(buf, local_ptr, strlen(local_ptr));
+			*wr = WR_PCM_TIMER;
+		}
+	}
+
+	if (wakesrc->r12 & R12_TWAM_PMSR_DVFSRC_OCLA)
+		handle_twam_pmsr_dvfsrc_ocla(buf, wakesrc, wr);
+
+	for (i = 1; i < 32; i++) {
+		if (wakesrc->r12 & (1U << i)) {
+			if (IS_LOGBUF(buf, wakesrc_str[i]))
+				strncat(buf, wakesrc_str[i], strlen(wakesrc_str[i]));
+			*wr = WR_WAKE_SRC;
+		}
+	}
+}
