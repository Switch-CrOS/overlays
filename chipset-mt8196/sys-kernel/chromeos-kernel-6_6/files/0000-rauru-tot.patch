+static void mtk_edp_pm_ctl(struct mtk_edp *mtk_edp, bool enable)
+{
+	/* DISP_EDPTX_PWR_CON */
+	if (enable) {
+		/* Subsys power-on reset */
+		writel(readl(mtk_edp->pwr_regs) | (1 << 0), mtk_edp->pwr_regs);
+		/* Enable subsys clock */
+		writel(readl(mtk_edp->pwr_regs) & ~(1 << 4), mtk_edp->pwr_regs);
+	} else {
+		writel(readl(mtk_edp->pwr_regs) & ~(1 << 0), mtk_edp->pwr_regs);
+		writel(readl(mtk_edp->pwr_regs) |  (1 << 4), mtk_edp->pwr_regs);
+	}
+}
