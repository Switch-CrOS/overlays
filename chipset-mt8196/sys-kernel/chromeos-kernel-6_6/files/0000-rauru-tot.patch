+enum {
+	MDW_DBG_DRV = 0x01,
+	MDW_DBG_FLW = 0x02,
+	MDW_DBG_CMD = 0x04,
+	MDW_DBG_MEM = 0x08,
+	MDW_DBG_PEF = 0x10,
+	MDW_DBG_SUB = 0x20,
+	MDW_DBG_VLD = 0x40,
