--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/platform/mt8196/mtk_proprietary/base/arm/protected_memory_allocator/protected_memory_allocator.c
@@ -0,0 +1,1083 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
+ *
+ * (C) COPYRIGHT 2019-2023 ARM Limited. All rights reserved.
+ *
