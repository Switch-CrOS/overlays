+DECLARE_EVENT_CLASS(mali_add_template, TP_PROTO(struct kbase_context *kctx, u64 info_val),
+		    TP_ARGS(kctx, info_val),
+		    TP_STRUCT__entry(__field(pid_t, kctx_tgid) __field(u32, kctx_id)
