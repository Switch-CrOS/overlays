--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_config.h
@@ -0,0 +1,586 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ *
