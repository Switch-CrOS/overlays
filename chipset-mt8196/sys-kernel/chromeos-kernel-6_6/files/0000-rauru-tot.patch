+void kbase_mmu_disable_as(struct kbase_device *kbdev, int as_nr)
+{
+	lockdep_assert_held(&kbdev->hwaccess_lock);
+#if !MALI_USE_CSF
+	lockdep_assert_held(&kbdev->mmu_hw_mutex);
