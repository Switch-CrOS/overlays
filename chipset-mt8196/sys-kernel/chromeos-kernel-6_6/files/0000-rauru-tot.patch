+void ged_set_backup_timer_timeout(u64 time_out)
+{
+	if (time_out != 0 && time_out < GED_DVFS_FB_TIMER_TIMEOUT)
+		g_fallback_time_out = time_out;
+	else
+		g_fallback_time_out = GED_DVFS_FB_TIMER_TIMEOUT;
