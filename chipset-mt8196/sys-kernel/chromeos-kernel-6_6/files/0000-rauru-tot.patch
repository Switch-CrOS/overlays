diff --git a/drivers/gpu/mediatek/arm/midgard/ipa/backend/mali_kbase_ipa_counter_common_csf.c b/drivers/gpu/mediatek/arm/midgard/ipa/backend/mali_kbase_ipa_counter_common_csf.c
