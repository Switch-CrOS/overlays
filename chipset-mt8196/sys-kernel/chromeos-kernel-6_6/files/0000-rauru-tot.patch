+pp3300_edp: &pp3300_pmu_edp {};
+
+pp3300_vtp: &mt6373_vtp {
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+
+	status = "okay";
+};
+
+pp3300_tchscr: &pp3300_vtp {};
+
+pp3070_vusb: &mt6373_vusb {
+	regulator-min-microvolt = <3070000>;
+	regulator-max-microvolt = <3070000>;
