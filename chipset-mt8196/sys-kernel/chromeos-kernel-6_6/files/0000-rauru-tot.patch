+#define EDP_TX_LN_VOLT_SWING_VAL_FLDMASK_POS                            1
+#define EDP_TX_LN_PRE_EMPH_VAL_FLDMASK                                  0x18
+#define EDP_TX_LN_PRE_EMPH_VAL_FLDMASK_POS                              3
