--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_hwaccess_time.h
@@ -0,0 +1,208 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
