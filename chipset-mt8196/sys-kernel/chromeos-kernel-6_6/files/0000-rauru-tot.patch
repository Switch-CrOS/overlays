+static void mtk_edp_initialize_hpd_detect_settings(struct mtk_edp *mtk_edp)
+{
+//	u32 val;
+	/* Debounce threshold */
+/*
+ *      mtk_edp_update_bits(mtk_edp, MTK_DP_TRANS_P0_3410,
+ *               8, HPD_DEB_THD_DP_TRANS_P0_MASK);
+ *
+ *      val = (HPD_INT_THD_DP_TRANS_P0_LOWER_500US |
+ *             HPD_INT_THD_DP_TRANS_P0_UPPER_1100US) << 4;
+ *      mtk_edp_update_bits(mtk_edp, MTK_DP_TRANS_P0_3410,
+ *               val, HPD_INT_THD_DP_TRANS_P0_MASK);
+ */
+	/*
+	 * Connect threshold 1.5ms + 5 x 0.1ms = 2ms
+	 * Disconnect threshold 1.5ms + 5 x 0.1ms = 2ms
+	 */
+/*
+ *      val = (5 << 8) | (5 << 12);
+ *      mtk_edp_update_bits(mtk_edp, MTK_DP_TRANS_P0_3410,
+ *               val,
+ *               HPD_DISC_THD_DP_TRANS_P0_MASK |
+ *               HPD_CONN_THD_DP_TRANS_P0_MASK);
+ *      mtk_edp_update_bits(mtk_edp, MTK_DP_TRANS_P0_3430,
+ *               HPD_INT_THD_ECO_DP_TRANS_P0_HIGH_BOUND_EXT,
+ *               HPD_INT_THD_ECO_DP_TRANS_P0_MASK);
+ */
+	mtk_edp_update_bits(mtk_edp, REG_364C_AUX_TX_P0,
+			    HPD_INT_THD_FLDMASK_VAL << 4,
+				HPD_INT_THD_FLDMASK);
+}
