diff --git a/drivers/gpu/mediatek/arm/midgard/platform/mt8196/mtk_proprietary/gpu_bm/gpu_bm.c b/drivers/gpu/mediatek/arm/midgard/platform/mt8196/mtk_proprietary/gpu_bm/gpu_bm.c
