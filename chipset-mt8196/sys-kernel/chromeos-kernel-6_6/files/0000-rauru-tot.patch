+
+pp1800_tchscr: &mt6373_vcn18io {
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+};
+
+pp3300_ucam: &mt6373_vcn33_1 {
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+};
+
+pp3300_tchpad: &mt6373_vcn33_2 {
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+
+	/* HACK: b/333996526 */
+	regulator-always-on;
+
+	status = "okay";
+};
+
+pp3300_pmu_edp: &mt6373_vcn33_3 {
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+
+	status = "okay";
+};
