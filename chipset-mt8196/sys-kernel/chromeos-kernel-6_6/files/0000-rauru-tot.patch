+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_hwaccess_pm.h
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
