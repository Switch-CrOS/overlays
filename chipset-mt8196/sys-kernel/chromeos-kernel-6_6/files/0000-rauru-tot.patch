index 0000000000000000000000000000000000000000..e7e70b5389d897b3f399af6fc377c80b1b421bb2
--- /dev/null
+++ b/drivers/gpu/mediatek/arm/midgard/mali_kbase_pm.c
@@ -0,0 +1,396 @@
+// SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note
+/*
+ *
