diff --git a/drivers/misc/mediatek/vmm/mtk-vmm-notifier-mt8196.c b/drivers/misc/mediatek/vmm/mtk-vmm-notifier-mt8196.c
new file mode 100644
index 0000000000000000000000000000000000000000..52aa0b8a58ce16a5075daa51b4afd95d1bcc11d3
--- /dev/null
+++ b/drivers/misc/mediatek/vmm/mtk-vmm-notifier-mt8196.c
@@ -0,0 +1,358 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (c) 2025 MediaTek Inc.
+ * Author: Yunfei Dong <yunfei.dong@mediatek.com>
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/of_platform.h>
+#include <linux/timekeeping.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/poll.h>
+
+#include "vcp_status.h"
+
+#define mtk_vmm_dbg(fmt, args...) \
+	pr_debug("[vmm] %s(%d): " fmt "\n", __func__, __LINE__, ##args)
+
+#define mtk_vmm_err(fmt, args...) \
+	pr_err("[vmm] err %s(%d): " fmt "\n", __func__, __LINE__, ##args)
+
+#define POLL_DELAY_US                             (1)
+#define TIMEOUT_500US                             (500)
+#define TIMEOUT_1000US                            (1000)
+
+#define HW_CCF_AP_VOTER_BIT                       (1)
+#define MM_HW_CCF_BASE                            (0x31b00000)
+#define HW_CCF_BACKUP2_DONE_OFST                  (0x144c)
+#define HW_CCF_XPU0_BACKUP2_SET_OFST              (0x238)
+#define HW_CCF_BACKUP2_SET_STATUS_OFST            (0x148c)
+#define HW_CCF_XPU0_BACKUP2_CLR_OFST              (0x23c)
+#define HW_CCF_BACKUP2_CLR_STATUS_OFST            (0x1490)
+#define HW_CCF_BACKUP2_ENABLE_OFST                (0x1440)
+#define HW_CCF_BACKUP2_STATUS_OFST                (0x1444)
+#define HW_CCF_BACKUP2_STATUS_DBG_OFST	          (0x1448)
+
+enum POWER_DOMAIN_ID {
+	PD_VDE0,
+	PD_VDE1,
+	PD_VDE_VCORE0,
+	PD_NUM
+};
+
+struct vmm_user_data {
+	struct notifier_block notifier;
+	void __iomem *base;
+	u32 pd_id;
+	struct device *vmm_user_dev;
+	struct device *pm_domain_dev;
+};
+
+struct vmm_drv_data {
+	void __iomem *hwccf_reg_base;
+	struct vmm_user_data user_data[PD_NUM];
+	struct mutex ctrl_mutex;
+	int vmm_user_counter;
+};
+
+static struct vmm_drv_data drv_data = {0};
+
+static void vmm_notifier_timeout_debug_dump(int line)
+{
+	mtk_vmm_dbg("%d: set(0x%x),clr(0x%x),en(0x%x),st(0x%x),std(0x%x)\n", line,
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_XPU0_BACKUP2_SET_OFST),
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_XPU0_BACKUP2_CLR_OFST),
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_BACKUP2_ENABLE_OFST),
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_BACKUP2_STATUS_OFST),
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_BACKUP2_STATUS_DBG_OFST));
+
+	mtk_vmm_dbg("done(0x%x),set_s(0x%x),clr_s(0x%x)\n",
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_BACKUP2_DONE_OFST),
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_BACKUP2_SET_STATUS_OFST),
+		    readl_relaxed(drv_data.hwccf_reg_base + HW_CCF_BACKUP2_CLR_STATUS_OFST));
+}
+
+static void vmm_locked_hwccf_ctrl(bool enable, unsigned int vote_bit)
+{
+	void __iomem *hwccf_done = 0;
+	void __iomem *ctrl_reg = 0;
+	void __iomem *hwccf_ctrl_status = 0;
+	unsigned int val = 0;
+	int tmp = 0;
+
+	if (!drv_data.hwccf_reg_base) {
+		mtk_vmm_err("hwccf_reg_base is null, need to map first.\n");
+		return;
+	}
+
+	hwccf_done = drv_data.hwccf_reg_base + HW_CCF_BACKUP2_DONE_OFST;
+	if (enable) {
+		ctrl_reg = drv_data.hwccf_reg_base + HW_CCF_XPU0_BACKUP2_SET_OFST;
+		hwccf_ctrl_status = drv_data.hwccf_reg_base + HW_CCF_BACKUP2_SET_STATUS_OFST;
+		val = BIT(vote_bit);
+	} else {
+		ctrl_reg = drv_data.hwccf_reg_base + HW_CCF_XPU0_BACKUP2_CLR_OFST;
+		hwccf_ctrl_status = drv_data.hwccf_reg_base + HW_CCF_BACKUP2_CLR_STATUS_OFST;
+	}
+
+	/* polling hwccf write data done */
+	if (readl_poll_timeout_atomic(hwccf_done, tmp,
+	    (tmp & BIT(vote_bit)) == BIT(vote_bit), POLL_DELAY_US, TIMEOUT_1000US) < 0)
+		vmm_notifier_timeout_debug_dump(__LINE__);
+
+	/* set and clr data */
+	writel_relaxed(BIT(vote_bit), ctrl_reg);
+
+	/* polling write data done */
+	if (readl_poll_timeout_atomic(ctrl_reg, tmp, (tmp & BIT(vote_bit)) == val,
+	    POLL_DELAY_US, TIMEOUT_1000US) < 0)
+		vmm_notifier_timeout_debug_dump(__LINE__);
+
+	/* polling hwccf write data done */
+	if (readl_poll_timeout_atomic(hwccf_done, tmp,
+	    (tmp & BIT(vote_bit)) == BIT(vote_bit), POLL_DELAY_US, TIMEOUT_1000US) < 0)
+		vmm_notifier_timeout_debug_dump(__LINE__);
+
+	/* wait for current done */
+	if (readl_poll_timeout_atomic(hwccf_ctrl_status, tmp,
+	    (tmp & BIT(vote_bit)) == 0, POLL_DELAY_US, TIMEOUT_1000US) < 0)
+		vmm_notifier_timeout_debug_dump(__LINE__);
+}
+
+static int vmm_locked_buck_ctrl(bool enable)
+{
+	int pre_cnt = drv_data.vmm_user_counter;
+
+	if (enable)
+		drv_data.vmm_user_counter++;
+	else
+		drv_data.vmm_user_counter--;
+
+	if (pre_cnt == 0 && drv_data.vmm_user_counter == 1)
+		vmm_locked_hwccf_ctrl(true, HW_CCF_AP_VOTER_BIT);
+	else if (pre_cnt == 1 && drv_data.vmm_user_counter == 0)
+		vmm_locked_hwccf_ctrl(false, HW_CCF_AP_VOTER_BIT);
+
+	return 0;
+}
+
+static int mtk_vdec_pd_callback(struct notifier_block *nb, unsigned long flags, void *data)
+{
+	int ret = 0;
+
+	mutex_lock(&drv_data.ctrl_mutex);
+
+	if (flags == GENPD_NOTIFY_PRE_ON)
+		ret = vmm_locked_buck_ctrl(true);
+	else if (flags == GENPD_NOTIFY_OFF)
+		ret = vmm_locked_buck_ctrl(false);
+
+	mutex_unlock(&drv_data.ctrl_mutex);
+
+	return ret;
+}
+
+static int vmm_pm_runtime_enable(struct device *dev, u32 pd_id)
+{
+	int ret;
+	s32 err = 0;
+	struct vmm_user_data *data;
+
+	if (pd_id >= PD_NUM) {
+		mtk_vmm_dbg("pd_id = %d. overflow\n", pd_id);
+		return 0;
+	}
+
+	data = &drv_data.user_data[pd_id];
+	data->pm_domain_dev = dev_pm_domain_attach_by_id(dev, 0);
+	if (data->pm_domain_dev == NULL) {
+		mtk_vmm_dbg("dev is null! id=%d\n", pd_id);
+		return 0;
+	}
+	if (IS_ERR(data->pm_domain_dev)) {
+		err = PTR_ERR(data->pm_domain_dev) ? : -ENODATA;
+		mtk_vmm_dbg("failed to get vmm. error: %d.pd_id=%d\n", err, pd_id);
+		return 0;
+	}
+
+	ret = pm_runtime_get_sync(data->pm_domain_dev);
+	if (ret < 0)
+		mtk_vmm_err("vmm get sync fail pd_id=%d, ret=%d!!\n", pd_id, ret);
+
+	mutex_lock(&drv_data.ctrl_mutex);
+	vmm_locked_buck_ctrl(true);
+	mutex_unlock(&drv_data.ctrl_mutex);
+
+	data->notifier.notifier_call = mtk_vdec_pd_callback;
+	data->pd_id = pd_id;
+	ret = dev_pm_genpd_add_notifier(data->pm_domain_dev, &data->notifier);
+	if (ret)
+		mtk_vmm_err("vmm gen pd add notifier fail(%d)\n", ret);
+
+	return 0;
+}
+
+static int vmm_vcp_init_thread(void *data)
+{
+	int i, retry = 0, ret, retry_cnt = 100;
+	struct device *dev;
+
+	while (!is_vcp_ready_ex(MMDVFS_MMUP_FEATURE_ID) ||
+	       !is_vcp_ready_ex(MMDVFS_VCP_FEATURE_ID)) {
+		if (++retry > retry_cnt) {
+			mtk_vmm_err("vcp and mmup is not ready yet");
+			return -ETIMEDOUT;
+		}
+		ssleep(1);
+	}
+
+	mutex_lock(&drv_data.ctrl_mutex);
+	vmm_locked_buck_ctrl(true);
+	mutex_unlock(&drv_data.ctrl_mutex);
+
+	for (i = 0; i < PD_NUM; i++) {
+		dev = drv_data.user_data[i].vmm_user_dev;
+		if (dev != NULL)
+			vmm_pm_runtime_enable(dev, i);
+		else
+			mtk_vmm_err("vmm_pm_runtime_enable %d failed.", i);
+	}
+
+	for (i = 0; i < PD_NUM; i++) {
+		if (drv_data.user_data[i].pm_domain_dev == NULL) {
+			mtk_vmm_dbg("pm_domain_dev: %d is null\n", i);
+			continue;
+		}
+
+		ret = pm_runtime_put_sync(drv_data.user_data[i].pm_domain_dev);
+		if (ret < 0)
+			mtk_vmm_dbg("fail to put_sync id: %d, ret=%d!!!\n", i, ret);
+	}
+
+	mutex_lock(&drv_data.ctrl_mutex);
+	vmm_locked_buck_ctrl(false);
+	mutex_unlock(&drv_data.ctrl_mutex);
+
+	mtk_vmm_dbg("vmm init thread done vmm_user_counter: %d\n", drv_data.vmm_user_counter);
+
+	return 0;
+}
+
+static int vmm_notifier_probe(struct platform_device *pdev)
+{
+	int ret;
+	struct device *dev = &pdev->dev;
+	u32 pd_id;
+
+	ret = of_property_read_u32(dev->of_node, "pd-id", &pd_id);
+	if (ret) {
+		mtk_vmm_err("get vmm domain id fail %d.", ret);
+		return -ENODEV;
+	}
+
+	if (pd_id >= PD_NUM) {
+		mtk_vmm_err("vmm domain id is invalid: %d.", pd_id);
+		return -EINVAL;
+	}
+
+	drv_data.user_data[pd_id].vmm_user_dev = dev;
+	mtk_vmm_dbg("pd_id: %d vmm user counter:%d.\n", pd_id, drv_data.vmm_user_counter);
+
+	return 0;
+}
+
+static const struct of_device_id of_vmm_notifier_match_tbl[] = {
+	{
+		.compatible = "mediatek,vmm_notifier_mt8196",
+	},
+	{}
+};
+
+static struct platform_driver vmm_notifier_drv = {
+	.probe = vmm_notifier_probe,
+	.driver = {
+		.name = "mtk-vmm-notifier-mt8196",
+		.of_match_table = of_vmm_notifier_match_tbl,
+	},
+};
+MODULE_DEVICE_TABLE(of, of_vmm_notifier_match_tbl);
+
+static int __init mtk_vmm_notifier_init(void)
+{
+	unsigned int ccf_reg_size = 0x10000;
+	struct task_struct *kthr_vcp;
+	s32 status;
+
+	mutex_init(&drv_data.ctrl_mutex);
+	drv_data.vmm_user_counter = 0;
+
+	drv_data.hwccf_reg_base = ioremap(MM_HW_CCF_BASE, ccf_reg_size);
+	if (drv_data.hwccf_reg_base == NULL) {
+		mtk_vmm_err("failed to ioremap reg: 0x%x\n", MM_HW_CCF_BASE);
+		return -ENODEV;
+	}
+
+	status = platform_driver_register(&vmm_notifier_drv);
+	if (status) {
+		mtk_vmm_err("failed to register vmm dbg driver(%d)\n", status);
+		return -ENODEV;
+	}
+
+	mtk_vmm_dbg("register vmm device done. user count: %d\n", drv_data.vmm_user_counter);
+	kthr_vcp = kthread_run(vmm_vcp_init_thread, NULL, "vmm-vcp");
+	if (IS_ERR(kthr_vcp))
+		mtk_vmm_err("create kthread vmm_vcp_init_thread failed");
+
+	return 0;
+}
+
+static void __exit mtk_vmm_notifier_exit(void)
+{
+	if (drv_data.hwccf_reg_base)
+		iounmap(drv_data.hwccf_reg_base);
+	platform_driver_unregister(&vmm_notifier_drv);
+}
+
+int vmm_isp_ctrl_notify(int openIsp)
+{
+	return 0;
+}
+EXPORT_SYMBOL_GPL(vmm_isp_ctrl_notify);
+
+int mtk_vmm_notify_ut_ctrl(const char *val, const struct kernel_param *kp)
+{
+	unsigned int enable;
+	unsigned int vote_bit;
+	int ret;
+
+	ret = sscanf(val, "%u %u", &enable, &vote_bit);
+	if (ret <= 0) {
+		mtk_vmm_dbg("sscanf ret is wrong %d\n", ret);
+		return 0;
+	}
+
+	mtk_vmm_dbg("enable:%d vote_bit: %u\n", enable, vote_bit);
+	vmm_locked_hwccf_ctrl((enable > 0), vote_bit);
+
+	return 0;
+}
+
+static const struct kernel_param_ops vmm_notify_ut_ctrl_ops = {
+	.set = mtk_vmm_notify_ut_ctrl,
+};
+
+module_param_cb(vmm_notify_ut_ctrl, &vmm_notify_ut_ctrl_ops, NULL, 0644);
+MODULE_PARM_DESC(vmm_notify_ut_ctrl, "vmm_notify_ut_ctrl");
+
+module_init(mtk_vmm_notifier_init);
+module_exit(mtk_vmm_notifier_exit);
+MODULE_DESCRIPTION("MTK VMM notifier driver");
+MODULE_LICENSE("GPL");
