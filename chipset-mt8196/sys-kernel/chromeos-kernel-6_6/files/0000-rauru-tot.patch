+
+static int slbc_suspend_cb(struct device *dev)
+{
+	int i;
+	int sid;
+
+	for (i = 0; i < UID_MAX; i++) {
+		sid = _slbc_get_sid_by_uid(i);
+		if (sid != SID_NOT_FOUND && uid_ref[i]) {
+			if (sid == UID_HIFI3) {
+				pr_info("#@# %s(%d) [LVL_QOS] uid_ref %s %x\n",
+					__func__, __LINE__, slbc_uid_str[i], uid_ref[i]);
+			} else if (sid == UID_AOV |
+					sid == UID_AOV_DC |
+					sid == UID_AOV_APU) {
+				pr_info("#@# %s(%d) [LVL_QOS] uid_ref %s %x, screen off user\n",
+					__func__, __LINE__, slbc_uid_str[i], uid_ref[i]);
+			} else {
+				pr_info("#@# %s(%d) [LVL_QOS] uid_ref %s %x, screen on user\n",
+					__func__, __LINE__, slbc_uid_str[i], uid_ref[i]);
+				WARN_ON(uid_ref[i]);
+			}
+		}
+	}
+
+	return 0;
+}
+
+static int slbc_resume_cb(struct device *dev)
+{
+	int i;
+	int sid;
+
+	for (i = 0; i < UID_MAX; i++) {
+		sid = _slbc_get_sid_by_uid(i);
+		if (sid != SID_NOT_FOUND && uid_ref[i]) {
+			if (sid == UID_HIFI3) {
+				pr_info("#@# %s(%d) [LVL_QOS] uid_ref %s %x\n",
+					__func__, __LINE__, slbc_uid_str[i], uid_ref[i]);
+			} else if (sid == UID_AOV |
+					sid == UID_AOV_DC |
+					sid == UID_AOV_APU) {
+				pr_info("#@# %s(%d) [LVL_QOS] uid_ref %s %x, screen off user\n",
+					__func__, __LINE__, slbc_uid_str[i], uid_ref[i]);
+				WARN_ON(uid_ref[i]);
+			} else {
+				pr_info("#@# %s(%d) [LVL_QOS] uid_ref %s %x, screen on user\n",
+					__func__, __LINE__, slbc_uid_str[i], uid_ref[i]);
+			}
+		}
+	}
+
+	return 0;
+}
