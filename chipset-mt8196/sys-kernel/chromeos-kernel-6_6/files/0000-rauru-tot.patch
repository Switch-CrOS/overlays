+	if (t_cpu_target != NULL && main_head != NULL)
+		*t_cpu_target = main_head->t_cpu_target;
+	if (t_gpu_target != NULL && main_head != NULL)
+		*t_gpu_target = main_head->t_gpu_target;
+#endif /* MTK_GED_KPI */
