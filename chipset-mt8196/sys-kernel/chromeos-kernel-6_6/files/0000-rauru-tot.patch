+	case IPI_PIN_BUSY:
+		pr_notice("[VCP] IPI busy. Set log filter failed!\n");
+		return -EBUSY;
+
+	default:
+		pr_notice("[VCP] IPI error. Set log filter failed!\n");
+		return -EIO;
+	}
