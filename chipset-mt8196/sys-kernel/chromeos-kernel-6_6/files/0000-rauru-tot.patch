+#define OVL_CON_CLRFMT_MAN				BIT(4)
+#define OVL_CON_FLD_CLRFMT_NB				GENMASK(9, 8)
+#define OVL_CON_CLRFMT_NB_10_BIT			BIT(8)
+#define OVL_CON_BYTE_SWAP				BIT(16)
+#define OVL_CON_RGB_SWAP				BIT(17)
