+void gpu_pdma_vma_close(struct vm_area_struct *vma)
+{
+	pr_debug("gpu_pdma VMA close, virt %lx, phys %lx\n", vma->vm_start, vma->vm_pgoff << PAGE_SHIFT);
+}
