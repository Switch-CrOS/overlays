+	params[0].u.value.a = heap->resv_paddr;
+	params[0].u.value.b = heap->resv_size;
+	ret = mtk_tee_service_call(data->tee_ctx, data->tee_session,
+				   MTK_TZCMD_SECMEM_GET_REGION_NUM, params);
