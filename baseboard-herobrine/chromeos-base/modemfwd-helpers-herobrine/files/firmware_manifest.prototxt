device {
  device_id: "soc:*:* (Internal)"
  variant: "piglin"
  dlc {
    dlc_id:"modem-fw-dlc-piglin"
    is_dlc_empty: true
  }
  default_main_firmware_version: "MPSS.HI.4.3.3.c1.1-00022-KODIAK_GENLCNG_PACK-1"

  main_firmware {
    filename: "modem-63"
    version: "MPSS.HI.4.3.3.c1.1-00022-KODIAK_GENLCNG_PACK-1"
    compression: NONE
  }
}

